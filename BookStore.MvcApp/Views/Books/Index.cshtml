@{
    ViewData["Title"] = "Books Management";
}

<div class="mb-6">
    <h2 class="text-2xl font-bold text-gray-900">Books Inventory</h2>
    <p class="text-gray-500">Manage your bookstore inventory here.</p>
</div>

<div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
    <div class="flex justify-between items-center mb-6">
        <h3 class="text-lg font-semibold text-gray-800">All Books</h3>
        <button class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-xl font-medium transition-colors text-sm">
            + Add New Book
        </button>
    </div>
    
    <div class="text-center py-12 text-gray-500">
        <p>Book list will be displayed here once connected to Web API.</p>
    </div>
</div>
