@{
    ViewData["Title"] = "Dashboard";
}

<div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div>
        <h2 class="text-2xl md:text-3xl font-bold text-slate-900 mb-1 tracking-tight">Hi, Staff</h2>
        <p class="text-slate-500 font-medium text-sm">Let's manage the store today!</p>
    </div>
    <div class="flex items-center gap-4">
        <button class="relative p-2.5 bg-white rounded-full text-slate-400 hover:text-teal-700 border border-slate-200 shadow-sm transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
            </svg>
            <span class="absolute top-2 right-2 h-2.5 w-2.5 bg-amber-500 rounded-full border-2 border-white"></span>
        </button>
        <button class="bg-teal-700 hover:bg-teal-800 text-white px-5 py-2.5 rounded-xl font-medium shadow-sm transition-all text-sm flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
            </svg>
            New Sale
        </button>
    </div>
</div>

<!-- Summary Cards Row -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <!-- Today Sales -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 flex flex-col justify-between">
        <div class="flex justify-between items-start mb-4">
            <div>
                <p class="text-sm font-semibold text-slate-500 mb-1">Today Sales</p>
                <h3 class="text-2xl font-bold text-slate-900">$1,245.50</h3>
            </div>
            <div class="bg-emerald-50 text-emerald-600 p-2 rounded-lg">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
        </div>
        <div class="flex items-center text-sm">
            <span class="text-emerald-600 font-semibold flex items-center gap-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M12 7a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0V8.414l-4.293 4.293a1 1 0 01-1.414 0L8 10.414l-4.293 4.293a1 1 0 01-1.414-1.414l5-5a1 1 0 011.414 0L11 10.586 14.586 7H12z" clip-rule="evenodd" />
                </svg>
                12.5%
            </span>
            <span class="text-slate-400 ml-2">vs yesterday</span>
        </div>
    </div>
    
    <!-- This Month Sales -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 flex flex-col justify-between">
        <div class="flex justify-between items-start mb-4">
            <div>
                <p class="text-sm font-semibold text-slate-500 mb-1">This Month Sales</p>
                <h3 class="text-2xl font-bold text-slate-900">$24,890.00</h3>
            </div>
            <div class="bg-teal-50 text-teal-700 p-2 rounded-lg">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                </svg>
            </div>
        </div>
        <div class="flex items-center text-sm">
            <span class="text-emerald-600 font-semibold flex items-center gap-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M12 7a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0V8.414l-4.293 4.293a1 1 0 01-1.414 0L8 10.414l-4.293 4.293a1 1 0 01-1.414-1.414l5-5a1 1 0 011.414 0L11 10.586 14.586 7H12z" clip-rule="evenodd" />
                </svg>
                8.2%
            </span>
            <span class="text-slate-400 ml-2">vs last month</span>
        </div>
    </div>

    <!-- Low Stock Items -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 flex flex-col justify-between">
        <div class="flex justify-between items-start mb-4">
            <div>
                <p class="text-sm font-semibold text-slate-500 mb-1">Low Stock Items</p>
                <h3 class="text-2xl font-bold text-slate-900">14</h3>
            </div>
            <div class="bg-amber-50 text-amber-500 p-2 rounded-lg">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
            </div>
        </div>
        <div class="flex items-center text-sm">
            <span class="text-amber-500 font-semibold flex items-center gap-1">
                Action Required
            </span>
            <span class="text-slate-400 ml-2">Check inventory</span>
        </div>
    </div>
</div>

<!-- Detailed Data Rows -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- Recent Orders (Spans 2 columns) -->
    <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="p-6 border-b border-slate-100 flex justify-between items-center">
            <h3 class="text-lg font-bold text-slate-900">Recent Orders</h3>
            <a href="#" class="text-sm font-semibold text-teal-700 hover:text-teal-800">View All</a>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-500">
                <thead class="bg-slate-50 text-slate-600 text-xs uppercase font-semibold">
                    <tr>
                        <th class="px-6 py-4">Order ID</th>
                        <th class="px-6 py-4">Customer</th>
                        <th class="px-6 py-4">Status</th>
                        <th class="px-6 py-4">Total</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="px-6 py-4 font-medium text-slate-900">#ORD-09251</td>
                        <td class="px-6 py-4">Walk-in Customer</td>
                        <td class="px-6 py-4">
                            <span class="bg-emerald-50 text-emerald-600 px-2.5 py-1 rounded-full text-xs font-semibold">Completed</span>
                        </td>
                        <td class="px-6 py-4 font-semibold text-slate-700">$45.98</td>
                    </tr>
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="px-6 py-4 font-medium text-slate-900">#ORD-09250</td>
                        <td class="px-6 py-4">Sarah Jenkins</td>
                        <td class="px-6 py-4">
                            <span class="bg-emerald-50 text-emerald-600 px-2.5 py-1 rounded-full text-xs font-semibold">Completed</span>
                        </td>
                        <td class="px-6 py-4 font-semibold text-slate-700">$128.50</td>
                    </tr>
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="px-6 py-4 font-medium text-slate-900">#ORD-09249</td>
                        <td class="px-6 py-4">Michael Chen</td>
                        <td class="px-6 py-4">
                            <span class="bg-amber-50 text-amber-600 px-2.5 py-1 rounded-full text-xs font-semibold">Pending</span>
                        </td>
                        <td class="px-6 py-4 font-semibold text-slate-700">$32.00</td>
                    </tr>
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="px-6 py-4 font-medium text-slate-900">#ORD-09248</td>
                        <td class="px-6 py-4">Walk-in Customer</td>
                        <td class="px-6 py-4">
                            <span class="bg-emerald-50 text-emerald-600 px-2.5 py-1 rounded-full text-xs font-semibold">Completed</span>
                        </td>
                        <td class="px-6 py-4 font-semibold text-slate-700">$15.99</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Low Stock Books List -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 flex flex-col">
        <div class="p-6 border-b border-slate-100">
            <h3 class="text-lg font-bold text-slate-900">Low Stock Books</h3>
        </div>
        <div class="p-6 flex-1 space-y-6">
            <!-- Book Item -->
            <div class="flex justify-between items-center">
                <div class="flex items-center gap-4">
                    <div class="h-12 w-9 bg-slate-200 rounded shadow-sm flex-shrink-0 flex items-center justify-center text-slate-400">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                        </svg>
                    </div>
                    <div>
                        <h4 class="text-sm font-bold text-slate-900 leading-tight">The Midnight Library</h4>
                        <p class="text-xs text-slate-500 mt-1">Matt Haig</p>
                    </div>
                </div>
                <div class="text-right">
                    <p class="text-sm font-bold text-amber-500">2 left</p>
                </div>
            </div>

            <!-- Book Item -->
            <div class="flex justify-between items-center">
                <div class="flex items-center gap-4">
                    <div class="h-12 w-9 bg-slate-200 rounded shadow-sm flex-shrink-0 flex items-center justify-center text-slate-400">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                        </svg>
                    </div>
                    <div>
                        <h4 class="text-sm font-bold text-slate-900 leading-tight">Atomic Habits</h4>
                        <p class="text-xs text-slate-500 mt-1">James Clear</p>
                    </div>
                </div>
                <div class="text-right">
                    <p class="text-sm font-bold text-red-500">Out of Stock</p>
                </div>
            </div>

            <!-- Book Item -->
            <div class="flex justify-between items-center">
                <div class="flex items-center gap-4">
                    <div class="h-12 w-9 bg-slate-200 rounded shadow-sm flex-shrink-0 flex items-center justify-center text-slate-400">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                        </svg>
                    </div>
                    <div>
                        <h4 class="text-sm font-bold text-slate-900 leading-tight">Project Hail Mary</h4>
                        <p class="text-xs text-slate-500 mt-1">Andy Weir</p>
                    </div>
                </div>
                <div class="text-right">
                    <p class="text-sm font-bold text-amber-500">3 left</p>
                </div>
            </div>
        </div>
        <div class="p-4 border-t border-slate-100 bg-slate-50 rounded-b-2xl text-center">
            <a href="#" class="text-sm font-semibold text-teal-700 hover:text-teal-800">Manage Inventory</a>
        </div>
    </div>
</div>
