@{
    ViewData["Title"] = "Forgot Password - BABYLON";
}

<div class="min-h-[75vh] flex items-center justify-center py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full">
        <!-- Brand Header -->
        <div class="text-center mb-8">
            <a href="/" class="inline-flex items-center gap-2 text-brand-ink mb-3 group">
                <svg class="w-8 h-8 text-brand-accent transition-transform group-hover:scale-105" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                </svg>
                <span class="font-heading font-bold text-3xl tracking-wide">BABYLON</span>
            </a>
            <h1 class="font-heading text-2xl font-semibold text-brand-ink mt-2">Reset Password</h1>
            <p class="text-sm text-brand-inkLight mt-1">Enter your registered Myanmar phone number to receive a 6-digit OTP code.</p>
        </div>

        <!-- Card Container -->
        <div class="bg-brand-surface border border-brand-border rounded-2xl p-8 shadow-sm">
            <!-- Alert Banner (Error) -->
            <div id="forgotAlert" class="hidden mb-6 p-4 rounded-xl text-sm border flex items-start gap-3 bg-red-50 border-red-200 text-red-800" role="alert">
                <svg class="w-5 h-5 text-red-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span id="forgotAlertText"></span>
            </div>

            <!-- Dev Mode OTP Display Modal/Card -->
            <div id="devOtpBox" class="hidden mb-6 p-4 rounded-xl text-sm border bg-amber-50 border-amber-200 text-amber-900">
                <div class="flex items-center gap-2 font-semibold text-amber-800 mb-1">
                    <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span>Development Mode (Demo SMS)</span>
                </div>
                <p class="text-xs text-amber-700 mb-3">Your verification OTP code has been generated:</p>
                <div class="flex items-center justify-between bg-white px-3.5 py-2.5 rounded-lg border border-amber-300">
                    <span class="text-xs text-slate-500 font-medium">OTP Code:</span>
                    <span id="devOtpCode" class="font-mono font-bold text-lg text-amber-900 tracking-widest"></span>
                </div>
                <button type="button" id="btnDevProceed" class="mt-3 w-full inline-flex items-center justify-center gap-1.5 py-2 px-3 rounded-lg bg-amber-600 hover:bg-amber-700 text-white text-xs font-semibold transition-colors">
                    <span>Auto-fill OTP & Proceed</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                </button>
            </div>

            <form id="forgotPasswordForm" novalidate class="space-y-5">
                <!-- Phone Number -->
                <div>
                    <label for="phoneInput" class="block text-xs font-semibold uppercase tracking-wider text-brand-inkLight mb-1.5">
                        Phone Number <span class="text-red-600">*</span>
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-brand-inkLight/60">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                            </svg>
                        </div>
                        <input type="tel" id="phoneInput" name="Phone" autocomplete="tel" required
                               placeholder="09789456123"
                               class="w-full pl-11 pr-4 py-2.5 bg-brand-bg border border-brand-border rounded-xl text-brand-ink text-sm placeholder-brand-inkLight/40 focus:outline-none focus:border-brand-accent focus:ring-2 focus:ring-brand-accent/20 transition-all font-mono" />
                    </div>
                    <span id="phoneError" class="hidden text-xs text-red-600 mt-1 block">Valid Myanmar phone number is required (09...).</span>
                </div>

                <!-- Submit Button -->
                <button type="submit" id="btnForgotSubmit"
                        class="w-full bg-brand-ink hover:bg-brand-accent text-brand-bg font-medium py-3 px-4 rounded-xl transition-all shadow-sm flex items-center justify-center gap-2 font-body text-sm tracking-wide mt-2 cursor-pointer">
                    <span>Send Verification Code</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                </button>
            </form>

            <!-- Navigation Links -->
            <div class="mt-8 pt-6 border-t border-brand-border/60 text-center text-sm text-brand-inkLight">
                Remember your password?
                <a href="/Auth/Login" class="text-brand-accent hover:text-brand-accentHover font-semibold ml-1 underline decoration-brand-accent/30 underline-offset-4 transition-colors">
                    Back to Sign In
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            function normalizeMyanmarPhone(phone) {
                let p = phone.trim().replace(/[\s-]/g, '');
                if (p.startsWith('+959')) p = '09' + p.substring(4);
                else if (p.startsWith('959')) p = '09' + p.substring(3);
                else if (p.startsWith('9') && p.length === 10) p = '0' + p;
                else if (p.length === 9 && !p.startsWith('0')) p = '09' + p;
                return p;
            }

            function isValidMyanmarPhone(phone) {
                const norm = normalizeMyanmarPhone(phone);
                return /^09\d{7,9}$/.test(norm);
            }

            $('#phoneInput').on('input', function() {
                $(this).removeClass('border-red-500 focus:ring-red-500/20');
                $('#phoneError').addClass('hidden');
                $('#forgotAlert').addClass('hidden');
            });

            let generatedOtp = '';
            let targetPhone = '';

            $('#btnDevProceed').on('click', function() {
                window.location.href = `/Auth/ResetPassword?phone=${encodeURIComponent(targetPhone)}&otp=${encodeURIComponent(generatedOtp)}`;
            });

            $('#forgotPasswordForm').on('submit', function(e) {
                e.preventDefault();

                const phone = $('#phoneInput').val().trim();
                if (!phone || !isValidMyanmarPhone(phone)) {
                    $('#phoneInput').addClass('border-red-500 focus:ring-red-500/20');
                    $('#phoneError').removeClass('hidden');
                    return;
                }

                targetPhone = normalizeMyanmarPhone(phone);
                const $btn = $('#btnForgotSubmit');
                $btn.prop('disabled', true).html(`
                    <svg class="animate-spin h-4 w-4 text-brand-bg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                    </svg>
                    <span>Sending code...</span>
                `);

                $.ajax({
                    type: 'POST',
                    url: '/Auth/ForgotPassword',
                    contentType: 'application/json',
                    data: JSON.stringify({ Phone: targetPhone }),
                    success: function(response) {
                        if (response.isSuccess) {
                            const otp = response.data && response.data.otpCode;
                            if (otp) {
                                generatedOtp = otp;
                                $('#devOtpCode').text(otp);
                                $('#devOtpBox').removeClass('hidden');
                                $btn.prop('disabled', false).html(`
                                    <span>Code Sent! Proceeding...</span>
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                    </svg>
                                `);
                            } else {
                                // In production (or no otp returned), redirect directly
                                window.location.href = `/Auth/ResetPassword?phone=${encodeURIComponent(targetPhone)}`;
                            }
                        } else {
                            $('#forgotAlertText').text(response.message || "Failed to request password reset code.");
                            $('#forgotAlert').removeClass('hidden');
                            $btn.prop('disabled', false).html(`
                                <span>Send Verification Code</span>
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                                </svg>
                            `);
                        }
                    },
                    error: function(xhr) {
                        const errMsg = (xhr.responseJSON && xhr.responseJSON.message) || "An error occurred while connecting to server.";
                        $('#forgotAlertText').text(errMsg);
                        $('#forgotAlert').removeClass('hidden');
                        $btn.prop('disabled', false).html(`
                            <span>Send Verification Code</span>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                            </svg>
                        `);
                    }
                });
            });
        });
    </script>
}
