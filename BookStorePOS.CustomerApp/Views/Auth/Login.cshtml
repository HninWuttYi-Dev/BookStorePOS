@{
    ViewData["Title"] = "Customer Sign In";
    var returnUrl = ViewData["ReturnUrl"]?.ToString() ?? "/Books";
}

<div class="min-h-[75vh] flex items-center justify-center py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full">
        <!-- Brand Header -->
        <div class="text-center mb-8">
            <a href="/" class="inline-flex items-center gap-2 text-brand-ink mb-3 group">
                <svg class="w-8 h-8 text-brand-accent transition-transform group-hover:scale-105" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                </svg>
                <span class="font-heading font-bold text-3xl tracking-wide">BABYLON</span>
            </a>
            <h1 class="font-heading text-2xl font-semibold text-brand-ink mt-2">Welcome Back</h1>
            <p class="text-sm text-brand-inkLight mt-1">Sign in to browse our book collection and place orders</p>
        </div>

        <!-- Card Container -->
        <div class="bg-brand-surface border border-brand-border rounded-2xl p-8 shadow-sm">
            <!-- Alert Banner -->
            <div id="loginAlert" class="hidden mb-6 p-4 rounded-xl text-sm border flex items-start gap-3 bg-red-50 border-red-200 text-red-800" role="alert">
                <svg class="w-5 h-5 text-red-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span id="loginAlertText"></span>
            </div>

            <form id="customerLoginForm" novalidate class="space-y-5">
                <!-- Username -->
                <div>
                    <label for="usernameInput" class="block text-xs font-semibold uppercase tracking-wider text-brand-inkLight mb-1.5">
                        Username <span class="text-red-600">*</span>
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-brand-inkLight/60">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                            </svg>
                        </div>
                        <input type="text" id="usernameInput" name="Username" autocomplete="username" required
                               placeholder="e.g. aungaung or suhlaing"
                               class="w-full pl-11 pr-4 py-2.5 bg-brand-bg border border-brand-border rounded-xl text-brand-ink text-sm placeholder-brand-inkLight/40 focus:outline-none focus:border-brand-accent focus:ring-2 focus:ring-brand-accent/20 transition-all" />
                    </div>
                    <span id="usernameError" class="hidden text-xs text-red-600 mt-1 block">Username is required.</span>
                </div>

                <!-- Password -->
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label for="passwordInput" class="block text-xs font-semibold uppercase tracking-wider text-brand-inkLight">
                            Password <span class="text-red-600">*</span>
                        </label>
                    </div>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-brand-inkLight/60">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                            </svg>
                        </div>
                        <input type="password" id="passwordInput" name="Password" autocomplete="current-password" required
                               placeholder="••••••••"
                               class="w-full pl-11 pr-11 py-2.5 bg-brand-bg border border-brand-border rounded-xl text-brand-ink text-sm placeholder-brand-inkLight/40 focus:outline-none focus:border-brand-accent focus:ring-2 focus:ring-brand-accent/20 transition-all" />
                        <button type="button" id="togglePasswordBtn" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-brand-inkLight/60 hover:text-brand-accent transition-colors" aria-label="Toggle password visibility">
                            <svg id="eyeIconOpen" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                            </svg>
                            <svg id="eyeIconClosed" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"></path>
                            </svg>
                        </button>
                    </div>
                    <span id="passwordError" class="hidden text-xs text-red-600 mt-1 block">Password is required.</span>
                </div>

                <!-- Submit Button -->
                <button type="submit" id="btnLoginSubmit"
                        class="w-full bg-brand-ink hover:bg-brand-accent text-brand-bg font-medium py-3 px-4 rounded-xl transition-all shadow-sm flex items-center justify-center gap-2 font-body text-sm tracking-wide mt-2">
                    <span>Sign In</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                </button>
            </form>

            <!-- Register Prompt -->
            <div class="mt-8 pt-6 border-t border-brand-border/60 text-center text-sm text-brand-inkLight">
                Don't have an account yet?
                <a href="/Auth/Register" class="text-brand-accent hover:text-brand-accentHover font-semibold ml-1 underline decoration-brand-accent/30 underline-offset-4 transition-colors">
                    Create an account
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            const returnUrl = '@Html.Raw(returnUrl)';

            // Toggle password visibility
            $('#togglePasswordBtn').on('click', function() {
                const $input = $('#passwordInput');
                const isPassword = $input.attr('type') === 'password';
                $input.attr('type', isPassword ? 'text' : 'password');
                $('#eyeIconOpen').toggleClass('hidden', isPassword);
                $('#eyeIconClosed').toggleClass('hidden', !isPassword);
            });

            // Live username input checking
            $('#usernameInput').on('input', function() {
                const val = $(this).val();
                if (/\s/.test(val)) {
                    $(this).addClass('border-red-500 focus:ring-red-500/20');
                    $('#usernameError').text("Username cannot contain spaces.").removeClass('hidden');
                } else {
                    $(this).removeClass('border-red-500 focus:ring-red-500/20');
                    $('#usernameError').addClass('hidden');
                }
                $('#loginAlert').addClass('hidden');
            });

            $('#passwordInput').on('input', function() {
                $(this).removeClass('border-red-500 focus:ring-red-500/20');
                $('#passwordError').addClass('hidden');
                $('#loginAlert').addClass('hidden');
            });

            // Form Submit via AJAX to /Auth/Login
            $('#customerLoginForm').on('submit', function(e) {
                e.preventDefault();

                const username = $('#usernameInput').val().trim();
                const password = $('#passwordInput').val();
                let hasError = false;

                if (!username) {
                    $('#usernameInput').addClass('border-red-500 focus:ring-red-500/20');
                    $('#usernameError').text("Username is required.").removeClass('hidden');
                    hasError = true;
                } else if (/\s/.test(username)) {
                    $('#usernameInput').addClass('border-red-500 focus:ring-red-500/20');
                    $('#usernameError').text("Username cannot contain spaces.").removeClass('hidden');
                    hasError = true;
                }

                if (!password) {
                    $('#passwordInput').addClass('border-red-500 focus:ring-red-500/20');
                    $('#passwordError').removeClass('hidden');
                    hasError = true;
                }

                if (hasError) return;

                const $btn = $('#btnLoginSubmit');
                $btn.prop('disabled', true).html(`
                    <svg class="animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                    </svg>
                    <span>Signing in...</span>
                `);

                $.ajax({
                    type: 'POST',
                    url: '/Auth/Login',
                    data: {
                        Username: username,
                        Password: password
                    },
                    success: function(response) {
                        if (response.isSuccess) {
                            // Store in client localStorage for auth headers
                            localStorage.setItem('customer_token', response.accessToken || response.AccessToken);
                            localStorage.setItem('customer_user', username);
                            localStorage.setItem('customer_role', response.role || response.Role || 'Customer');

                            // Redirect to destination
                            window.location.href = returnUrl;
                        } else {
                            $('#loginAlertText').text(response.message || response.Message || "Invalid username or password.");
                            $('#loginAlert').removeClass('hidden');

                            // Clear password field and refocus for user convenience
                            $('#passwordInput').val('').focus().addClass('border-red-500 focus:ring-red-500/20');

                            $btn.prop('disabled', false).html(`
                                <span>Sign In</span>
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                                </svg>
                            `);
                        }
                    },
                    error: function(xhr) {
                        const errMsg = (xhr.responseJSON && xhr.responseJSON.message) || "Network or server error occurred.";
                        $('#loginAlertText').text(errMsg);
                        $('#loginAlert').removeClass('hidden');

                        // Clear password field and refocus for user convenience
                        $('#passwordInput').val('').focus().addClass('border-red-500 focus:ring-red-500/20');

                        $btn.prop('disabled', false).html(`
                            <span>Sign In</span>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                            </svg>
                        `);
                    }
                });
            });
        });
    </script>
}
