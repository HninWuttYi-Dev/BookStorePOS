@{
    ViewData["Title"] = "Set New Password - BABYLON";
    var phone = ViewData["Phone"]?.ToString() ?? string.Empty;
    var otp = ViewData["Otp"]?.ToString() ?? string.Empty;
}

<div class="min-h-[75vh] flex items-center justify-center py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full">
        <!-- Brand Header -->
        <div class="text-center mb-8">
            <a href="/" class="inline-flex items-center gap-2 text-brand-ink mb-3 group">
                <svg class="w-8 h-8 text-brand-accent transition-transform group-hover:scale-105" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                </svg>
                <span class="font-heading font-bold text-3xl tracking-wide">BABYLON</span>
            </a>
            <h1 class="font-heading text-2xl font-semibold text-brand-ink mt-2">Create New Password</h1>
            <p class="text-sm text-brand-inkLight mt-1">Enter the 6-digit OTP code sent to your phone and choose a new password.</p>
        </div>

        <!-- Card Container -->
        <div class="bg-brand-surface border border-brand-border rounded-2xl p-8 shadow-sm">
            <!-- Alert Banner -->
            <div id="resetAlert" class="hidden mb-6 p-4 rounded-xl text-sm border flex items-start gap-3 bg-red-50 border-red-200 text-red-800" role="alert">
                <svg class="w-5 h-5 text-red-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span id="resetAlertText"></span>
            </div>

            <!-- Success Banner -->
            <div id="resetSuccess" class="hidden mb-6 p-4 rounded-xl text-sm border flex items-start gap-3 bg-emerald-50 border-emerald-200 text-emerald-800" role="alert">
                <svg class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <div>
                    <p class="font-semibold text-emerald-900">Password Reset Successfully!</p>
                    <p class="text-xs text-emerald-700 mt-0.5">Redirecting you to sign in...</p>
                </div>
            </div>

            <form id="resetPasswordForm" novalidate class="space-y-4">
                <!-- Phone Number -->
                <div>
                    <label for="phoneInput" class="block text-xs font-semibold uppercase tracking-wider text-brand-inkLight mb-1.5">
                        Phone Number <span class="text-red-600">*</span>
                    </label>
                    <input type="tel" id="phoneInput" name="Phone" value="@phone" required
                           placeholder="09789456123"
                           class="w-full px-4 py-2.5 bg-brand-bg border border-brand-border rounded-xl text-brand-ink text-sm placeholder-brand-inkLight/40 focus:outline-none focus:border-brand-accent focus:ring-2 focus:ring-brand-accent/20 transition-all font-mono" />
                    <span id="phoneError" class="hidden text-xs text-red-600 mt-1 block">Valid phone number is required.</span>
                </div>

                <!-- OTP Code -->
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label for="otpInput" class="block text-xs font-semibold uppercase tracking-wider text-brand-inkLight">
                            6-Digit OTP Code <span class="text-red-600">*</span>
                        </label>
                        <a href="/Auth/ForgotPassword" class="text-sm font-medium text-brand-accent hover:text-brand-accentHover hover:underline transition-colors">
                            Resend code
                        </a>
                    </div>
                    <input type="text" id="otpInput" name="Otp" value="@otp" maxlength="6" required autocomplete="one-time-code"
                           placeholder="123456"
                           class="w-full px-4 py-2.5 bg-brand-bg border border-brand-border rounded-xl text-brand-ink text-base tracking-widest text-center font-mono font-bold focus:outline-none focus:border-brand-accent focus:ring-2 focus:ring-brand-accent/20 transition-all placeholder:tracking-normal placeholder:font-normal placeholder:text-sm" />
                    <span id="otpError" class="hidden text-xs text-red-600 mt-1 block">6-digit OTP code is required.</span>
                </div>

                <!-- New Password -->
                <div>
                    <label for="newPasswordInput" class="block text-xs font-semibold uppercase tracking-wider text-brand-inkLight mb-1.5">
                        New Password <span class="text-red-600">*</span>
                    </label>
                    <div class="relative">
                        <input type="password" id="newPasswordInput" name="NewPassword" required minlength="6" autocomplete="new-password"
                               placeholder="At least 6 characters"
                               class="w-full pl-4 pr-11 py-2.5 bg-brand-bg border border-brand-border rounded-xl text-brand-ink text-sm placeholder-brand-inkLight/40 focus:outline-none focus:border-brand-accent focus:ring-2 focus:ring-brand-accent/20 transition-all" />
                        <button type="button" class="btnTogglePassword absolute inset-y-0 right-0 pr-3.5 flex items-center text-brand-inkLight/60 hover:text-brand-accent transition-colors" data-target="#newPasswordInput" aria-label="Toggle password visibility">
                            <svg class="eyeOpen w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                            </svg>
                            <svg class="eyeClosed w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"></path>
                            </svg>
                        </button>
                    </div>
                    <span id="newPasswordError" class="hidden text-xs text-red-600 mt-1 block">Password must be at least 6 characters.</span>
                </div>

                <!-- Confirm Password -->
                <div>
                    <label for="confirmPasswordInput" class="block text-xs font-semibold uppercase tracking-wider text-brand-inkLight mb-1.5">
                        Confirm New Password <span class="text-red-600">*</span>
                    </label>
                    <div class="relative">
                        <input type="password" id="confirmPasswordInput" name="ConfirmPassword" required minlength="6" autocomplete="new-password"
                               placeholder="Re-enter your new password"
                               class="w-full pl-4 pr-11 py-2.5 bg-brand-bg border border-brand-border rounded-xl text-brand-ink text-sm placeholder-brand-inkLight/40 focus:outline-none focus:border-brand-accent focus:ring-2 focus:ring-brand-accent/20 transition-all" />
                        <button type="button" class="btnTogglePassword absolute inset-y-0 right-0 pr-3.5 flex items-center text-brand-inkLight/60 hover:text-brand-accent transition-colors" data-target="#confirmPasswordInput" aria-label="Toggle password visibility">
                            <svg class="eyeOpen w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                            </svg>
                            <svg class="eyeClosed w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"></path>
                            </svg>
                        </button>
                    </div>
                    <span id="confirmPasswordError" class="hidden text-xs text-red-600 mt-1 block">Passwords do not match.</span>
                </div>

                <!-- Submit Button -->
                <button type="submit" id="btnResetSubmit"
                        class="w-full bg-brand-ink hover:bg-brand-accent text-brand-bg font-medium py-3 px-4 rounded-xl transition-all shadow-sm flex items-center justify-center gap-2 font-body text-sm tracking-wide mt-3 cursor-pointer">
                    <span>Reset Password</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                </button>
            </form>

            <!-- Navigation Links -->
            <div class="mt-8 pt-6 border-t border-brand-border/60 text-center text-sm text-brand-inkLight">
                <a href="/Auth/Login" class="text-brand-accent hover:text-brand-accentHover font-semibold underline decoration-brand-accent/30 underline-offset-4 transition-colors">
                    Back to Sign In
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            function normalizeMyanmarPhone(phone) {
                let p = phone.trim().replace(/[\s-]/g, '');
                if (p.startsWith('+959')) p = '09' + p.substring(4);
                else if (p.startsWith('959')) p = '09' + p.substring(3);
                else if (p.startsWith('9') && p.length === 10) p = '0' + p;
                else if (p.length === 9 && !p.startsWith('0')) p = '09' + p;
                return p;
            }

            $('.btnTogglePassword').on('click', function() {
                const target = $(this).data('target');
                const $input = $(target);
                const isPassword = $input.attr('type') === 'password';
                $input.attr('type', isPassword ? 'text' : 'password');
                $(this).find('.eyeOpen').toggleClass('hidden', isPassword);
                $(this).find('.eyeClosed').toggleClass('hidden', !isPassword);
            });

            $('input').on('input', function() {
                $(this).removeClass('border-red-500 focus:ring-red-500/20');
                $('#resetAlert').addClass('hidden');
            });

            $('#resetPasswordForm').on('submit', function(e) {
                e.preventDefault();

                const phone = $('#phoneInput').val().trim();
                const otp = $('#otpInput').val().trim();
                const newPassword = $('#newPasswordInput').val();
                const confirmPassword = $('#confirmPasswordInput').val();

                let hasError = false;
                $('#phoneError, #otpError, #newPasswordError, #confirmPasswordError').addClass('hidden');

                if (!phone) {
                    $('#phoneInput').addClass('border-red-500 focus:ring-red-500/20');
                    $('#phoneError').removeClass('hidden');
                    hasError = true;
                }
                if (!otp || otp.length < 6) {
                    $('#otpInput').addClass('border-red-500 focus:ring-red-500/20');
                    $('#otpError').removeClass('hidden');
                    hasError = true;
                }
                if (!newPassword || newPassword.length < 6) {
                    $('#newPasswordInput').addClass('border-red-500 focus:ring-red-500/20');
                    $('#newPasswordError').removeClass('hidden');
                    hasError = true;
                }
                if (newPassword !== confirmPassword) {
                    $('#confirmPasswordInput').addClass('border-red-500 focus:ring-red-500/20');
                    $('#confirmPasswordError').removeClass('hidden');
                    hasError = true;
                }

                if (hasError) return;

                const normalizedPhone = normalizeMyanmarPhone(phone);
                const $btn = $('#btnResetSubmit');
                $btn.prop('disabled', true).html(`
                    <svg class="animate-spin h-4 w-4 text-brand-bg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                    </svg>
                    <span>Resetting password...</span>
                `);

                $.ajax({
                    type: 'POST',
                    url: '/Auth/ResetPassword',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        Phone: normalizedPhone,
                        Otp: otp,
                        NewPassword: newPassword,
                        ConfirmPassword: confirmPassword
                    }),
                    success: function(response) {
                        if (response.isSuccess) {
                            $('#resetPasswordForm').addClass('hidden');
                            $('#resetSuccess').removeClass('hidden');
                            setTimeout(function() {
                                window.location.href = '/Auth/Login?reset=true';
                            }, 1800);
                        } else {
                            $('#resetAlertText').text(response.message || "Failed to reset password.");
                            $('#resetAlert').removeClass('hidden');
                            $btn.prop('disabled', false).html(`
                                <span>Reset Password</span>
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                                </svg>
                            `);
                        }
                    },
                    error: function(xhr) {
                        const errMsg = (xhr.responseJSON && xhr.responseJSON.message) || "An error occurred while connecting to server.";
                        $('#resetAlertText').text(errMsg);
                        $('#resetAlert').removeClass('hidden');
                        $btn.prop('disabled', false).html(`
                            <span>Reset Password</span>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                            </svg>
                        `);
                    }
                });
            });
        });
    </script>
}
