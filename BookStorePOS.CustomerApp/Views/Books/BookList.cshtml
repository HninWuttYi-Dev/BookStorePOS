@{
    ViewData["Title"] = "Browse Books";
    var books = ViewData["Books"] as List<BookModel> ?? new List<BookModel>();
    var currentPage = ViewData["CurrentPage"] as int? ?? 1;
    var totalPages = ViewData["TotalPages"] as int? ?? 1;
    var searchQuery = ViewData["SearchQuery"] as string ?? "";
    var genreFilter = ViewData["GenreFilter"] as string ?? "";
    var authorFilter = ViewData["AuthorFilter"] as string ?? "";
}

<div class="mb-10">
    <div class="flex items-center gap-2 mb-2">
        <span class="w-2 h-2 rounded-full bg-brand-accent inline-block"></span>
        <span class="text-xs font-semibold uppercase tracking-widest text-brand-accent font-body">Catalog Library</span>
    </div>
    <h1 class="text-4xl sm:text-5xl font-heading font-bold text-brand-ink mb-3">Browse Books</h1>
    <p class="text-brand-inkLight text-base sm:text-lg font-body">Discover our full collection of rare editions and fine literature.</p>
</div>

<!-- Search and Filter -->
<section class="mb-8">
    <form method="get" action="/Books" class="flex flex-col sm:flex-row gap-3 debounce-search-form">
        <div class="relative flex-1">
            <svg class="w-5 h-5 absolute left-4 top-1/2 -translate-y-1/2 text-brand-inkLight/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            <input type="text" name="SearchQuery" value="@searchQuery" placeholder="Search by title, author, or ISBN" class="w-full pl-12 pr-12 py-3.5 bg-white/95 rounded-full focus:outline-none focus:ring-2 focus:ring-brand-accent/30 text-brand-ink placeholder:text-brand-inkLight/60 debounce-search-input font-body text-sm border border-brand-border/70 shadow-xs transition-shadow">
            <button type="button" class="absolute right-4 top-1/2 -translate-y-1/2 text-brand-inkLight hover:text-brand-accent hidden debounce-clear-btn" aria-label="Clear">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
        @if(!string.IsNullOrEmpty(genreFilter)) {
            <input type="hidden" name="genre" value="@genreFilter" />
        }
        @if(!string.IsNullOrEmpty(authorFilter)) {
            <input type="hidden" name="Author" value="@authorFilter" />
        }
    </form>

    <!-- Active Filter Badges -->
    @if(!string.IsNullOrEmpty(authorFilter) || !string.IsNullOrEmpty(genreFilter) || !string.IsNullOrEmpty(searchQuery))
    {
        <div class="flex flex-wrap items-center gap-2 mt-4 pt-3 border-t border-brand-border/50 text-xs font-body">
            <span class="text-brand-inkLight font-medium">Active Filters:</span>

            @if(!string.IsNullOrEmpty(authorFilter))
            {
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-surface border border-brand-accent/40 text-brand-ink font-medium">
                    <span>Author: <strong class="text-brand-accent">@authorFilter</strong></span>
                    <a href="/Books?genre=@Uri.EscapeDataString(genreFilter)&SearchQuery=@Uri.EscapeDataString(searchQuery)" class="text-brand-inkLight hover:text-red-500 font-bold ml-0.5" title="Remove author filter">&times;</a>
                </span>
            }

            @if(!string.IsNullOrEmpty(genreFilter))
            {
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-surface border border-brand-accent/40 text-brand-ink font-medium">
                    <span>Genre: <strong class="text-brand-accent">@genreFilter</strong></span>
                    <a href="/Books?Author=@Uri.EscapeDataString(authorFilter)&SearchQuery=@Uri.EscapeDataString(searchQuery)" class="text-brand-inkLight hover:text-red-500 font-bold ml-0.5" title="Remove genre filter">&times;</a>
                </span>
            }

            @if(!string.IsNullOrEmpty(searchQuery))
            {
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-surface border border-brand-accent/40 text-brand-ink font-medium">
                    <span>Search: &ldquo;@searchQuery&rdquo;</span>
                    <a href="/Books?Author=@Uri.EscapeDataString(authorFilter)&genre=@Uri.EscapeDataString(genreFilter)" class="text-brand-inkLight hover:text-red-500 font-bold ml-0.5" title="Clear search query">&times;</a>
                </span>
            }

            <a href="/Books" class="text-brand-accent hover:underline text-[11px] font-semibold ml-2">Clear All</a>
        </div>
    }
</section>

<!-- Books Catalog Grid (Clean, Airy Modern Grid with 3D Standing Book Mockups) -->
<section class="mb-16">
    <style>
        /* 3D Standing Book Presentation (Clean Transparent Stage) */
        .book-stage-wrapper {
            position: relative;
            width: 100%;
            height: 220px;
            background: transparent;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: visible;
        }
        @@media (min-width: 640px) {
            .book-stage-wrapper {
                height: 240px;
            }
        }
        @@media (min-width: 1024px) {
            .book-stage-wrapper {
                height: 250px;
            }
        }

        /* 3D Perspective Stage */
        .book-3d-stage {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            perspective: 1000px;
        }

        /* The Standing 3D Book in 3/4 Angle */
        .book-3d-stand {
            position: relative;
            width: 120px;
            height: 174px;
            transform-style: preserve-3d;
            transform: rotateY(-18deg) rotateX(2deg);
            filter: drop-shadow(2px 3px 5px rgba(0,0,0,0.10));
            transition: transform 0.38s cubic-bezier(0.2, 1, 0.3, 1), filter 0.38s ease;
        }
        @@media (min-width: 640px) {
            .book-3d-stand {
                width: 130px;
                height: 188px;
            }
        }
        @@media (min-width: 1024px) {
            .book-3d-stand {
                width: 138px;
                height: 200px;
            }
        }
        .group:hover .book-3d-stand {
            transform: translateY(-8px) rotateY(-22deg) rotateX(3deg) scale(1.03);
        }

        /* Front Book Cover */
        .book-3d-front {
            position: absolute;
            inset: 0;
            border-radius: 0 3px 3px 0;
            overflow: hidden;
            background: #2C2621;
            box-shadow: inset 1.5px 0 2px rgba(255,255,255,0.35), inset -1px 0 2px rgba(0,0,0,0.18);
            z-index: 10;
        }

        /* Spine Crease Highlight on Left Edge */
        .book-3d-spine-fold {
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 15px;
            background: linear-gradient(to right, rgba(255,255,255,0.4) 0%, rgba(255,255,255,0.06) 18%, rgba(0,0,0,0.2) 24%, transparent 100%);
            pointer-events-none;
            z-index: 20;
        }

        /* Right Paper Pages Block (Realistic 3D Thickness - Top slopes DOWN, Bottom slopes UPWARD matching reference photo) */
        .book-3d-side-pages {
            position: absolute;
            top: 2px;
            bottom: 2px;
            right: -13px;
            width: 14px;
            background: repeating-linear-gradient(to right, #FAF8F5, #FAF8F5 1.5px, #D6D0C5 1.5px, #D6D0C5 2.5px);
            -webkit-clip-path: polygon(0% 0px, 100% 4.5px, 100% calc(100% - 7.5px), 0% 100%);
            clip-path: polygon(0% 0px, 100% 4.5px, 100% calc(100% - 7.5px), 0% 100%);
            box-shadow: inset 1px 0 3px rgba(0,0,0,0.22), inset -1px 0 2px rgba(0,0,0,0.10);
            z-index: 5;
        }

        /* Floor Ambient Ground Shadow */
        .book-3d-floor-shadow {
            position: absolute;
            bottom: -12px;
            left: 50%;
            transform: translateX(-48%) skewX(-24deg) scaleY(0.65);
            width: 145px;
            height: 18px;
            background: radial-gradient(ellipse at center, rgba(30, 25, 20, 0.45) 0%, rgba(30, 25, 20, 0.16) 45%, transparent 75%);
            filter: blur(5px);
            pointer-events-none;
            transition: transform 0.38s ease, opacity 0.38s ease;
            z-index: 1;
        }
        @@media (min-width: 640px) {
            .book-3d-floor-shadow {
                width: 160px;
                bottom: -14px;
            }
        }
        .group:hover .book-3d-floor-shadow {
            transform: translateX(-48%) translateY(6px) skewX(-27deg) scale(1.08) scaleY(0.6);
            opacity: 0.75;
        }
    </style>

    @if(books.Any())
    {
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-x-5 sm:gap-x-6 gap-y-10 sm:gap-y-12">
            @foreach(var book in books)
            {
                var activeEditions = book.Editions?.Where(e => !e.IsDeleted).ToList() ?? new List<BookEditionModel>();
                var editionCount = activeEditions.Count;
                var singleEdition = editionCount == 1 ? activeEditions[0] : null;
                var coverImg = activeEditions.FirstOrDefault(e => !string.IsNullOrEmpty(e.CoverImageUrl))?.CoverImageUrl;

                <div class="flex flex-col items-center group">
                    <!-- 3D Standing Book (Clean Transparent Stage) -->
                    <a href="/Books/Detail/@book.BookId" class="book-stage-wrapper cursor-pointer block" aria-label="Book: @book.Title by @book.Author">
                        
                        <div class="book-3d-stage">
                            <!-- Floor Ground Shadow -->
                            <div class="book-3d-floor-shadow"></div>

                            <!-- 3D Standing Book Body -->
                            <div class="book-3d-stand">
                                <!-- Right Paper Page Block Thickness -->
                                <div class="book-3d-side-pages"></div>

                                <!-- Front Cover -->
                                <div class="book-3d-front">
                                    <!-- Spine Crease Fold -->
                                    <div class="book-3d-spine-fold"></div>

                                    @if(!string.IsNullOrEmpty(coverImg))
                                    {
                                        <img src="@coverImg" alt="@book.Title" 
                                             onerror="this.style.display='none'; this.nextElementSibling.classList.remove('hidden');"
                                             class="w-full h-full object-cover">
                                        <div class="hidden w-full h-full bg-gradient-to-br from-[#2D241E] via-[#3E322A] to-[#1E1712] flex flex-col justify-between p-3 rounded-r-xs border-l-2 border-[#8C6F45]/50 shadow-inner">
                                            <div class="w-full flex justify-end">
                                                <span class="text-[7px] uppercase tracking-widest text-[#C8A265]/70 font-semibold font-body">Babylon</span>
                                            </div>
                                            <div class="text-center my-auto px-1">
                                                <p class="font-heading font-bold text-[#F4F1EA] text-xs leading-tight line-clamp-3">@book.Title</p>
                                                <p class="text-[9px] text-[#C8A265] mt-1 font-heading italic truncate">@book.Author</p>
                                            </div>
                                            <div class="w-full flex justify-center">
                                                <span class="w-4 h-[1px] bg-[#C8A265]/40"></span>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="w-full h-full bg-gradient-to-br from-[#2D241E] via-[#3E322A] to-[#1E1712] flex flex-col justify-between p-3 rounded-r-xs border-l-2 border-[#8C6F45]/50 shadow-inner">
                                            <div class="w-full flex justify-end">
                                                <span class="text-[7px] uppercase tracking-widest text-[#C8A265]/70 font-semibold font-body">Babylon</span>
                                            </div>
                                            <div class="text-center my-auto px-1">
                                                <p class="font-heading font-bold text-[#F4F1EA] text-xs leading-tight line-clamp-3">@book.Title</p>
                                                <p class="text-[9px] text-[#C8A265] mt-1 font-heading italic truncate">@book.Author</p>
                                            </div>
                                            <div class="w-full flex justify-center">
                                                <span class="w-4 h-[1px] bg-[#C8A265]/40"></span>
                                            </div>
                                        </div>
                                    }
                                    
                                    <!-- Hover Quick Action Button -->
                                    <div class="absolute inset-0 bg-brand-ink/85 opacity-0 group-hover:opacity-100 transition-opacity z-30 flex flex-col items-center justify-center p-2 text-center backdrop-blur-[1px]">
                                        @if (editionCount == 1 && singleEdition != null)
                                        {
                                            <span class="text-brand-surface font-bold mb-2.5 font-heading text-xs sm:text-sm">@singleEdition.Price.ToString("N0") MMK</span>
                                            @if (singleEdition.StockQuantity > 0)
                                            {
                                                <button type="button" 
                                                        onclick="window.addToCartDirect({ bookId: @book.BookId, bookEditionId: @singleEdition.BookEditionId, title: '@Html.Raw(book.Title.Replace("'", "\\'"))', editionName: '@Html.Raw(singleEdition.EditionName.Replace("'", "\\'"))', publisher: '@Html.Raw((singleEdition.Publisher ?? "").Replace("'", "\\'"))', price: @singleEdition.Price, coverImageUrl: '@singleEdition.CoverImageUrl', stockQuantity: @singleEdition.StockQuantity }, event)" 
                                                        class="bg-brand-accent text-white px-3.5 py-1.5 rounded-full text-[11px] font-semibold font-body hover:bg-brand-surface hover:text-brand-ink transition-colors shadow-md transform hover:scale-105 duration-200">
                                                    Add to Cart
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="bg-red-500/90 text-white px-3 py-1 rounded-full text-[10px] font-semibold font-body shadow-sm">
                                                    Out of Stock
                                                </span>
                                            }
                                        }
                                        else if (editionCount > 1)
                                        {
                                            <span class="text-brand-surface font-bold mb-0.5 font-heading text-xs sm:text-sm">From @book.StartingPrice.ToString("N0") MMK</span>
                                            <span class="text-[10px] text-brand-surface/75 font-body mb-2">@editionCount Editions Available</span>
                                            <span class="bg-brand-surface text-brand-ink px-3.5 py-1.5 rounded-full text-[11px] font-semibold font-body hover:bg-brand-accent hover:text-white transition-colors shadow-md transform hover:scale-105 duration-200 inline-flex items-center gap-1">
                                                <span>Choose Edition</span>
                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-brand-surface font-bold mb-2 font-heading text-xs sm:text-sm">@book.StartingPrice.ToString("N0") MMK</span>
                                            <span class="bg-brand-surface/90 text-brand-ink px-3.5 py-1 rounded-full text-[10px] font-semibold font-body">
                                                View Details
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                    </a>
                    
                    <!-- Title / Author / Price -->
                    <div class="text-center mt-3.5 w-full px-2">
                        <div class="text-amber-500 text-xs tracking-wider mb-1 font-body">★★★★★</div>
                        <a href="/Books/Detail/@book.BookId" class="block max-w-full">
                            <h3 class="font-heading font-semibold text-brand-ink text-base leading-snug truncate group-hover:text-brand-accent transition-colors" title="@book.Title">
                                @book.Title
                            </h3>
                        </a>
                        <p class="text-xs text-brand-inkLight font-heading italic mt-0.5 truncate max-w-full" title="@book.Author">
                            @book.Author
                        </p>
                        
                        @if (editionCount == 1 && singleEdition != null)
                        {
                            <div class="flex items-center justify-center gap-1.5 mt-1.5">
                                <span class="text-xs sm:text-sm font-bold text-brand-accent font-body">
                                    @singleEdition.Price.ToString("N0") MMK
                                </span>
                                @if (singleEdition.StockQuantity <= 0)
                                {
                                    <span class="px-2 py-0.5 rounded-full text-[9px] font-bold bg-red-50 text-red-600 border border-red-200">
                                        Out of stock
                                    </span>
                                }
                            </div>
                        }
                        else if (editionCount > 1)
                        {
                            <div class="flex items-center justify-center gap-1.5 mt-1.5 flex-wrap">
                                <span class="text-xs sm:text-sm font-bold text-brand-accent font-body">
                                    From @book.StartingPrice.ToString("N0") MMK
                                </span>
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-brand-surface text-brand-inkLight border border-brand-border/80 shadow-2xs">
                                    @editionCount Editions
                                </span>
                            </div>
                        }
                        else
                        {
                            <p class="text-xs sm:text-sm font-bold text-brand-accent font-body mt-1.5">
                                @book.StartingPrice.ToString("N0") MMK
                            </p>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-24 bg-brand-surface border border-brand-border rounded-xl">
            <svg class="w-16 h-16 text-brand-inkLight mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
            <h3 class="text-2xl font-heading font-bold text-brand-ink mb-2">No books found</h3>
            <p class="text-brand-inkLight font-body">We couldn't find any books matching your search criteria.</p>
        </div>
    }
</section>

<!-- Pagination -->
@if(totalPages > 1)
{
    var filterParams = $"&SearchQuery={Uri.EscapeDataString(searchQuery)}&genre={Uri.EscapeDataString(genreFilter)}&Author={Uri.EscapeDataString(authorFilter)}";

    <div class="flex items-center justify-center my-12 font-body">
        <div class="inline-flex items-center gap-1 bg-white rounded-full p-1.5 shadow-[0_4px_20px_-4px_rgba(44,38,33,0.08)] border border-brand-border/80">
            <!-- Previous Button -->
            @if (currentPage > 1)
            {
                <a href="/Books?page=@(currentPage - 1)@filterParams" 
                   class="w-8 h-8 sm:w-9 sm:h-9 flex items-center justify-center rounded-full bg-brand-surface text-brand-ink hover:bg-brand-accent hover:text-white transition-all mr-0.5 shadow-2xs" 
                   title="Previous Page" aria-label="Previous Page">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                </a>
            }
            else
            {
                <span class="w-8 h-8 sm:w-9 sm:h-9 flex items-center justify-center rounded-full bg-brand-surface/40 text-brand-inkLight/40 mr-0.5 cursor-not-allowed select-none" aria-disabled="true">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                </span>
            }
            
            <!-- Page Numbers with Ellipsis -->
            @for (int i = 1; i <= totalPages; i++)
            {
                if (i == currentPage)
                {
                    <span class="w-8 h-8 sm:w-9 sm:h-9 flex items-center justify-center rounded-full bg-brand-accent text-white text-xs sm:text-sm font-semibold shadow-xs select-none">
                        @i
                    </span>
                }
                else if (i == 1 || i == totalPages || Math.Abs(i - currentPage) <= 1)
                {
                    <a href="/Books?page=@i@filterParams" 
                       class="w-8 h-8 sm:w-9 sm:h-9 flex items-center justify-center rounded-full text-brand-ink text-xs sm:text-sm hover:bg-brand-surface font-medium transition-colors">
                        @i
                    </a>
                }
                else if (Math.Abs(i - currentPage) == 2)
                {
                    <span class="w-8 h-8 sm:w-9 sm:h-9 flex items-center justify-center text-brand-inkLight/50 tracking-widest text-xs select-none">...</span>
                }
            }

            <!-- Next Button -->
            @if (currentPage < totalPages)
            {
                <a href="/Books?page=@(currentPage + 1)@filterParams" 
                   class="w-8 h-8 sm:w-9 sm:h-9 flex items-center justify-center rounded-full bg-brand-accent text-white hover:bg-brand-ink transition-all ml-0.5 shadow-2xs" 
                   title="Next Page" aria-label="Next Page">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </a>
            }
            else
            {
                <span class="w-8 h-8 sm:w-9 sm:h-9 flex items-center justify-center rounded-full bg-brand-accent/40 text-white/60 ml-0.5 cursor-not-allowed shadow-2xs select-none" aria-disabled="true">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </span>
            }
        </div>
    </div>
}
