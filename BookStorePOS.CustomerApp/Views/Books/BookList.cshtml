@{
    ViewData["Title"] = "Browse Books";
    var books = ViewData["Books"] as List<BookModel> ?? new List<BookModel>();
    var currentPage = ViewData["CurrentPage"] as int? ?? 1;
    var totalPages = ViewData["TotalPages"] as int? ?? 1;
    var searchQuery = ViewData["SearchQuery"] as string ?? "";
    var genreFilter = ViewData["GenreFilter"] as string ?? "";
}

<div class="mb-10">
    <div class="flex items-center gap-2 mb-2">
        <span class="w-2 h-2 rounded-full bg-brand-accent inline-block"></span>
        <span class="text-xs font-semibold uppercase tracking-widest text-brand-accent font-body">Catalog Library</span>
    </div>
    <h1 class="text-4xl sm:text-5xl font-heading font-bold text-brand-ink mb-3">Browse Books</h1>
    <p class="text-brand-inkLight text-base sm:text-lg font-body">Discover our full collection of rare editions and fine literature.</p>
</div>

<!-- Search and Filter -->
<section class="mb-12">
    <form method="get" action="/Books" class="flex flex-col sm:flex-row gap-3 debounce-search-form">
        <div class="relative flex-1">
            <svg class="w-5 h-5 absolute left-4 top-1/2 -translate-y-1/2 text-brand-inkLight/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            <input type="text" name="SearchQuery" value="@searchQuery" placeholder="Search by title, author, or ISBN..." class="w-full pl-12 pr-12 py-3.5 bg-brand-surface rounded-full focus:outline-none text-brand-ink placeholder:text-brand-inkLight/60 debounce-search-input font-body text-sm border border-brand-border/40">
            <button type="button" class="absolute right-4 top-1/2 -translate-y-1/2 text-brand-inkLight hover:text-brand-accent hidden debounce-clear-btn" aria-label="Clear">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
        @if(!string.IsNullOrEmpty(genreFilter)) {
            <input type="hidden" name="genre" value="@genreFilter" />
        }
    </form>
</section>

<!-- Books Catalog Grid (Clean, Airy Modern Grid - No Bookshelf) -->
<section class="mb-16">
    @if(books.Any())
    {
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-x-6 gap-y-12">
            @foreach(var book in books)
            {
                <div class="flex flex-col items-center group">
                    <!-- Book Container -->
                    <a href="/Books/Detail/@book.BookId" class="relative w-36 sm:w-40 md:w-44 h-52 sm:h-56 md:h-64 shadow-[0_10px_25px_-4px_rgba(44,38,33,0.18),0_4px_8px_-2px_rgba(44,38,33,0.08)] hover:shadow-[0_18px_32px_-6px_rgba(44,38,33,0.25)] transition-all hover:-translate-y-2 duration-300 cursor-pointer rounded-r-md rounded-l-xs block overflow-hidden bg-brand-surface">
                        
                        <!-- Book Spine Highlight -->
                        <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-gradient-to-r from-white/35 to-transparent z-20 rounded-l-xs"></div>
                        <!-- Book Page Edge Crease -->
                        <div class="absolute right-0 top-0 bottom-0 w-[1px] bg-black/15 z-20 rounded-r-sm"></div>
                        
                        <!-- Cover Image or Luxury Cloth Fallback -->
                        @if(!string.IsNullOrEmpty(book.Editions?.FirstOrDefault()?.CoverImageUrl))
                        {
                            <img src="@(book.Editions?.FirstOrDefault()?.CoverImageUrl)" alt="@book.Title" 
                                 onerror="this.style.display='none'; this.nextElementSibling.classList.remove('hidden');"
                                 class="w-full h-full object-cover rounded-r-md rounded-l-xs z-10 relative">
                            <div class="hidden w-full h-full bg-gradient-to-br from-[#2D241E] via-[#3E322A] to-[#1E1712] flex flex-col justify-between p-3.5 rounded-r-md rounded-l-xs z-10 relative border-l-2 border-[#8C6F45]/50 shadow-inner">
                                <div class="w-full flex justify-end">
                                    <span class="text-[8px] uppercase tracking-widest text-[#C8A265]/70 font-semibold font-body">Babylon</span>
                                </div>
                                <div class="text-center my-auto px-1">
                                    <p class="font-heading font-bold text-[#F4F1EA] text-xs sm:text-sm leading-snug line-clamp-3">@book.Title</p>
                                    <p class="text-[10px] text-[#C8A265] mt-1 font-heading italic truncate">@book.Author</p>
                                </div>
                                <div class="w-full flex justify-center">
                                    <span class="w-6 h-[1px] bg-[#C8A265]/40"></span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="w-full h-full bg-gradient-to-br from-[#2D241E] via-[#3E322A] to-[#1E1712] flex flex-col justify-between p-3.5 rounded-r-md rounded-l-xs z-10 relative border-l-2 border-[#8C6F45]/50 shadow-inner">
                                <div class="w-full flex justify-end">
                                    <span class="text-[8px] uppercase tracking-widest text-[#C8A265]/70 font-semibold font-body">Babylon</span>
                                </div>
                                <div class="text-center my-auto px-1">
                                    <p class="font-heading font-bold text-[#F4F1EA] text-xs sm:text-sm leading-snug line-clamp-3">@book.Title</p>
                                    <p class="text-[10px] text-[#C8A265] mt-1 font-heading italic truncate">@book.Author</p>
                                </div>
                                <div class="w-full flex justify-center">
                                    <span class="w-6 h-[1px] bg-[#C8A265]/40"></span>
                                </div>
                            </div>
                        }
                        
                        <!-- Hover Overlay for Add to Cart -->
                        <div class="absolute inset-0 bg-brand-ink/90 opacity-0 group-hover:opacity-100 transition-opacity z-30 flex flex-col items-center justify-center rounded-r-md rounded-l-xs backdrop-blur-[2px] p-2 text-center">
                            <span class="text-brand-surface font-bold mb-3 font-heading text-sm md:text-base">@book.StartingPrice.ToString("N0") MMK</span>
                            <button type="button" onclick="window.handleAddToCart('@book.BookId', event)" class="bg-brand-accent text-white px-4 py-1.5 rounded-full text-xs font-semibold font-body hover:bg-brand-surface hover:text-brand-ink transition-colors shadow-lg transform hover:scale-105 duration-200">
                                Add to Cart
                            </button>
                        </div>
                    </a>
                    
                    <!-- Title / Author / Price -->
                    <div class="text-center mt-3.5 w-full px-2">
                        <div class="text-amber-500 text-xs tracking-wider mb-1 font-body">★★★★★</div>
                        <a href="/Books/Detail/@book.BookId" class="block max-w-full">
                            <h3 class="font-heading font-semibold text-brand-ink text-base leading-snug truncate group-hover:text-brand-accent transition-colors" title="@book.Title">
                                @book.Title
                            </h3>
                        </a>
                        <p class="text-xs text-brand-inkLight font-heading italic mt-0.5 truncate max-w-full" title="@book.Author">
                            @book.Author
                        </p>
                        <p class="text-xs sm:text-sm font-bold text-brand-accent font-body mt-1.5">
                            @book.StartingPrice.ToString("N0") MMK
                        </p>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-24 bg-brand-surface border border-brand-border rounded-xl">
            <svg class="w-16 h-16 text-brand-inkLight mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
            <h3 class="text-2xl font-heading font-bold text-brand-ink mb-2">No books found</h3>
            <p class="text-brand-inkLight font-body">We couldn't find any books matching your search criteria.</p>
        </div>
    }
</section>

<!-- Pagination -->
@if(totalPages > 1)
{
    <div class="flex justify-center items-center gap-2 mb-12 font-body">
        @if (currentPage > 1)
        {
            <a href="/Books?page=@(currentPage - 1)&SearchQuery=@searchQuery&genre=@genreFilter" class="px-4 py-2 border border-brand-border rounded-lg text-brand-ink hover:bg-brand-accent hover:text-white transition-colors shadow-sm text-sm">Previous</a>
        }
        
        @for (int i = 1; i <= totalPages; i++)
        {
            if (i == currentPage)
            {
                <span class="px-4 py-2 bg-brand-accent text-white rounded-lg shadow-sm font-semibold text-sm">@i</span>
            }
            else
            {
                <a href="/Books?page=@i&SearchQuery=@searchQuery&genre=@genreFilter" class="px-4 py-2 border border-brand-border rounded-lg text-brand-ink hover:bg-brand-surface transition-colors text-sm">@i</a>
            }
        }
        
        @if (currentPage < totalPages)
        {
            <a href="/Books?page=@(currentPage + 1)&SearchQuery=@searchQuery&genre=@genreFilter" class="px-4 py-2 border border-brand-border rounded-lg text-brand-ink hover:bg-brand-accent hover:text-white transition-colors shadow-sm text-sm">Next</a>
        }
    </div>
}
