@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="py-6 sm:py-10">
    <!-- Breadcrumb & Page Header -->
    <div class="text-center mb-10 sm:mb-14">
        <h1 class="font-heading text-3xl sm:text-5xl font-bold text-brand-ink mb-3 tracking-tight">Shopping Cart</h1>
        <nav class="flex items-center justify-center gap-2 text-xs sm:text-sm text-brand-inkLight font-body">
            <a href="/" class="hover:text-brand-accent transition-colors">Home</a>
            <span class="text-brand-border">/</span>
            <span class="text-brand-accent font-semibold">Shopping Cart</span>
        </nav>
    </div>

    <!-- Empty Cart State -->
    <div id="emptyCartView" class="hidden text-center py-16 px-4 bg-brand-surface rounded-3xl border border-brand-border/70 max-w-2xl mx-auto shadow-xs">
        <div class="w-20 h-20 mx-auto mb-5 rounded-full bg-brand-accent/10 border border-brand-accent/20 flex items-center justify-center text-brand-accent">
            <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
            </svg>
        </div>
        <h2 class="font-heading text-2xl sm:text-3xl font-bold text-brand-ink mb-2">Your Shopping Cart is Empty</h2>
        <p class="text-sm text-brand-inkLight mb-8 max-w-md mx-auto font-body leading-relaxed">
            Looks like you haven't added any books to your cart yet. Explore our curated catalog of classics, literature, and rare editions.
        </p>
        <a href="/Books" class="inline-flex items-center gap-2 bg-brand-ink hover:bg-brand-accent text-brand-bg px-8 py-3.5 rounded-full font-semibold text-sm transition-all shadow-md hover:shadow-lg hover:-translate-y-0.5 font-body">
            <span>Explore Books</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
        </a>
    </div>

    <!-- Active Cart Layout (Table + Order Summary) -->
    <div id="activeCartView" class="hidden grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
        
        <!-- Cart Items Table Section (Left: 8 Cols) -->
        <div class="lg:col-span-8 flex flex-col gap-6">
            <div class="bg-white rounded-2xl border border-brand-border/70 shadow-xs overflow-hidden">
                
                <!-- Table Header Bar -->
                <div class="bg-brand-accent text-white px-4 sm:px-6 py-3.5 flex items-center font-bold text-xs uppercase tracking-wider font-body select-none shadow-xs">
                    <div class="w-10 sm:w-12 text-center shrink-0"></div>
                    <div class="flex-1 min-w-0 pr-4">Product</div>
                    <div class="w-24 sm:w-28 text-right hidden sm:block">Price</div>
                    <div class="w-28 sm:w-32 text-center">Quantity</div>
                    <div class="w-24 sm:w-32 text-right">Subtotal</div>
                </div>

                <!-- Table Body Items -->
                <div id="cartItemsContainer" class="divide-y divide-brand-border/50">
                    <!-- Populated dynamically via JS -->
                </div>
            </div>

            <!-- Table Actions: Continue Shopping & Clear Cart -->
            <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-2">
                <a href="/Books" class="inline-flex items-center gap-2 text-brand-ink font-semibold text-sm hover:text-brand-accent transition-colors font-body group">
                    <svg class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                    </svg>
                    <span>Continue Shopping</span>
                </a>

                <button type="button" id="btnClearCart" onclick="window.clearEntireCart()" class="text-xs font-semibold uppercase tracking-wider text-brand-inkLight hover:text-brand-danger transition-colors font-body flex items-center gap-1.5 cursor-pointer">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                    </svg>
                    <span>Clear Shopping Cart</span>
                </button>
            </div>
        </div>

        <!-- Order Summary Card (Right: 4 Cols) -->
        <div class="lg:col-span-4 sticky top-28">
            <div class="bg-brand-surface rounded-2xl border border-brand-border/80 p-6 sm:p-7 shadow-xs">
                <h2 class="font-heading text-xl sm:text-2xl font-bold text-brand-ink pb-4 border-b border-brand-border/70 mb-5">
                    Order Summary
                </h2>

                <div class="space-y-4 font-body text-sm">
                    <div class="flex justify-between items-center text-brand-inkLight">
                        <span>Items</span>
                        <span id="summaryTotalQty" class="font-semibold text-brand-ink">0</span>
                    </div>

                    <div class="flex justify-between items-center text-brand-inkLight">
                        <span>Sub Total</span>
                        <span id="summarySubTotal" class="font-bold text-brand-ink">0 MMK</span>
                    </div>

                    <div class="pt-4 border-t border-brand-border/70 flex justify-between items-baseline">
                        <span class="text-base font-bold text-brand-ink font-heading">Total</span>
                        <div class="text-right">
                            <span id="summaryGrandTotal" class="text-2xl font-bold text-brand-ink font-heading">0</span>
                            <span class="text-xs font-semibold text-brand-accent ml-1 font-body">MMK</span>
                        </div>
                    </div>
                </div>

                <div class="mt-8">
                    <button type="button" id="btnProceedCheckout" onclick="window.proceedToCheckout()" 
                            class="w-full bg-brand-ink hover:bg-brand-accent text-brand-bg py-4 px-6 rounded-full font-bold text-sm sm:text-base tracking-wide transition-all shadow-[0_10px_25px_-5px_rgba(44,38,33,0.3)] hover:shadow-[0_15px_30px_-5px_rgba(140,111,69,0.4)] hover:-translate-y-0.5 flex items-center justify-center gap-2 cursor-pointer font-body">
                        <span>Proceed to Checkout</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                        </svg>
                    </button>
                    <p class="text-[11px] text-center text-brand-inkLight/80 mt-3 font-body">
                        Secure checkout & verified bank payment
                    </p>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Clear Cart Confirmation Modal Card -->
<dialog id="clearCartModal" class="m-auto rounded-3xl p-0 border border-brand-border bg-brand-surface shadow-2xl backdrop:bg-slate-900/60 backdrop:backdrop-blur-sm max-w-md w-[92%] sm:w-full transition-all overflow-hidden" aria-labelledby="clearCartModalTitle" aria-describedby="clearCartModalDesc">
    <div class="p-6 sm:p-8 text-center relative">
        <!-- Close Button -->
        <button type="button" onclick="window.closeClearCartModal()" class="absolute top-4 right-4 text-brand-inkLight/60 hover:text-brand-ink p-1.5 rounded-xl hover:bg-brand-bg transition-colors cursor-pointer" aria-label="Close modal">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>

        <!-- Trash / Warning Icon -->
        <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-600 flex items-center justify-center shadow-xs">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
        </div>
        
        <h3 id="clearCartModalTitle" class="font-heading text-2xl font-bold text-brand-ink mb-2">Clear Shopping Cart?</h3>
        <p id="clearCartModalDesc" class="text-sm text-brand-inkLight leading-relaxed mb-6 font-body">
            Are you sure you want to remove all books from your shopping cart? This will clear all items you have selected.
        </p>

        <div class="flex flex-col sm:flex-row gap-3 font-body">
            <button type="button" onclick="window.closeClearCartModal()" class="w-full order-2 sm:order-1 inline-flex items-center justify-center py-2.5 px-5 rounded-xl border border-brand-border bg-brand-bg hover:bg-brand-border/30 text-brand-ink font-semibold text-sm transition-all shadow-xs cursor-pointer">
                Cancel
            </button>
            <button type="button" onclick="window.confirmClearCart()" class="w-full order-1 sm:order-2 inline-flex items-center justify-center gap-2 bg-rose-600 hover:bg-rose-700 text-white font-semibold py-2.5 px-5 rounded-xl transition-all shadow-sm text-sm cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
                <span>Clear Cart</span>
            </button>
        </div>
    </div>
</dialog>

@section Scripts {
<script>
    const CART_KEY = 'customer_cart';

    function getLocalCart() {
        if (typeof window.getCustomerCart === 'function') {
            return window.getCustomerCart();
        }
        try {
            const raw = localStorage.getItem('customer_cart');
            return raw ? JSON.parse(raw) : [];
        } catch (e) {
            return [];
        }
    }

    function saveLocalCart(cart) {
        if (typeof window.saveCustomerCart === 'function') {
            window.saveCustomerCart(cart);
            return;
        }
        try {
            localStorage.setItem('customer_cart', JSON.stringify(cart));
            if (typeof window.updateCartBadge === 'function') {
                window.updateCartBadge();
            }
        } catch (e) {}
    }

    function renderCartTable() {
        const cart = getLocalCart();
        const $emptyView = document.getElementById('emptyCartView');
        const $activeView = document.getElementById('activeCartView');
        const $itemsContainer = document.getElementById('cartItemsContainer');

        if (!cart || cart.length === 0) {
            if ($emptyView) $emptyView.classList.remove('hidden');
            if ($activeView) $activeView.classList.add('hidden');
            return;
        }

        if ($emptyView) $emptyView.classList.add('hidden');
        if ($activeView) $activeView.classList.remove('hidden');

        let totalQty = 0;
        let totalPrice = 0;
        let html = '';

        cart.forEach((item, index) => {
            const qty = parseInt(item.quantity, 10) || 1;
            const price = parseFloat(item.price) || 0;
            const subtotal = qty * price;
            const maxStock = parseInt(item.stockQuantity, 10) || 999;
            const cover = item.coverImageUrl && item.coverImageUrl.trim() !== '' 
                ? item.coverImageUrl 
                : '/images/book-placeholder.png';

            totalQty += qty;
            totalPrice += subtotal;

            html += `
                <div class="px-4 sm:px-6 py-5 flex items-center gap-3 sm:gap-4 hover:bg-brand-surface/40 transition-colors">
                    <!-- Delete (X) Button -->
                    <div class="w-8 sm:w-10 text-center shrink-0">
                        <button type="button" onclick="window.removeItemFromCart(${item.bookEditionId})" 
                                class="w-8 h-8 rounded-full flex items-center justify-center text-brand-inkLight/60 hover:text-rose-600 hover:bg-rose-50 transition-all cursor-pointer" 
                                title="Remove item">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                    </div>

                    <!-- Product Image + Title + Edition -->
                    <div class="flex-1 min-w-0 flex items-center gap-3 sm:gap-4 pr-2">
                        <div class="w-14 h-18 sm:w-16 sm:h-22 rounded-lg bg-brand-surface border border-brand-border/60 overflow-hidden shrink-0 shadow-2xs flex items-center justify-center">
                            ${item.coverImageUrl ? `<img src="${item.coverImageUrl}" alt="${escapeHtml(item.title)}" class="w-full h-full object-cover">` : `<svg class="w-6 h-6 text-brand-border" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>`}
                        </div>
                        <div class="min-w-0">
                            <a href="/Books/Detail/${item.bookId || 0}" class="font-heading font-bold text-sm sm:text-base text-brand-ink hover:text-brand-accent transition-colors truncate block" title="${escapeHtml(item.title)}">
                                ${escapeHtml(item.title)}
                            </a>
                            <div class="flex flex-wrap items-center gap-2 mt-1">
                                <span class="text-[11px] font-semibold font-body bg-brand-surface border border-brand-border/80 text-brand-inkLight px-2 py-0.5 rounded-md">
                                    ${escapeHtml(item.editionName || 'Standard')}
                                </span>
                                <span class="text-xs text-brand-accent font-semibold sm:hidden font-body">
                                    ${price.toLocaleString()} MMK
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Price Column (Desktop) -->
                    <div class="w-24 sm:w-28 text-right hidden sm:block font-body text-sm font-semibold text-brand-ink shrink-0">
                        ${price.toLocaleString()} <span class="text-[11px] text-brand-inkLight font-normal">MMK</span>
                    </div>

                    <!-- Quantity Controls: - [Qty] + -->
                    <div class="w-28 sm:w-32 flex justify-center shrink-0">
                        <div class="inline-flex items-center border border-brand-border rounded-xl bg-brand-surface/70 p-1 shadow-2xs font-body">
                            <button type="button" onclick="window.changeItemQty(${item.bookEditionId}, -1)" 
                                    class="w-7 h-7 flex items-center justify-center rounded-lg bg-white hover:bg-brand-accent hover:text-white text-brand-ink text-sm font-bold shadow-2xs border border-brand-border/60 transition-all cursor-pointer">
                                -
                            </button>
                            <span class="w-8 text-center text-xs sm:text-sm font-bold text-brand-ink select-none">
                                ${qty}
                            </span>
                            <button type="button" onclick="window.changeItemQty(${item.bookEditionId}, 1)" 
                                    class="w-7 h-7 flex items-center justify-center rounded-lg bg-white hover:bg-brand-accent hover:text-white text-brand-ink text-sm font-bold shadow-2xs border border-brand-border/60 transition-all cursor-pointer">
                                +
                            </button>
                        </div>
                    </div>

                    <!-- Subtotal Column -->
                    <div class="w-24 sm:w-32 text-right font-body text-sm sm:text-base font-bold text-brand-ink shrink-0">
                        ${subtotal.toLocaleString()} <span class="text-[11px] text-brand-inkLight font-normal">MMK</span>
                    </div>
                </div>
            `;
        });

        if ($itemsContainer) $itemsContainer.innerHTML = html;

        // Update Summary Card
        const $summaryQty = document.getElementById('summaryTotalQty');
        const $summarySubTotal = document.getElementById('summarySubTotal');
        const $summaryGrandTotal = document.getElementById('summaryGrandTotal');

        if ($summaryQty) $summaryQty.textContent = totalQty;
        if ($summarySubTotal) $summarySubTotal.textContent = totalPrice.toLocaleString() + ' MMK';
        if ($summaryGrandTotal) $summaryGrandTotal.textContent = totalPrice.toLocaleString();
    }

    window.changeItemQty = function(editionId, delta) {
        let cart = getLocalCart();
        const item = cart.find(i => i.bookEditionId === editionId);
        if (!item) return;

        const maxStock = parseInt(item.stockQuantity, 10) || 999;
        const newQty = (item.quantity || 1) + delta;

        if (newQty > maxStock) {
            if (typeof window.showToast === 'function') {
                window.showToast(`Only ${maxStock} items available in stock.`, false);
            }
            return;
        }

        if (newQty <= 0) {
            window.removeItemFromCart(editionId);
            return;
        }

        item.quantity = newQty;
        saveLocalCart(cart);
        renderCartTable();
    };

    window.removeItemFromCart = function(editionId) {
        let cart = getLocalCart();
        cart = cart.filter(i => i.bookEditionId !== editionId);
        saveLocalCart(cart);
        renderCartTable();
        if (typeof window.showToast === 'function') {
            window.showToast("Item removed from cart.", true);
        }
    };

    window.openClearCartModal = function() {
        const cart = getLocalCart();
        if (!cart || cart.length === 0) {
            if (typeof window.showToast === 'function') {
                window.showToast("Your cart is already empty.", false);
            }
            return;
        }
        const modal = document.getElementById('clearCartModal');
        if (!modal) return;
        if (typeof modal.showModal === 'function') {
            modal.showModal();
        } else {
            modal.setAttribute('open', '');
        }
    };

    window.closeClearCartModal = function() {
        const modal = document.getElementById('clearCartModal');
        if (!modal) return;
        if (typeof modal.close === 'function') {
            modal.close();
        } else {
            modal.removeAttribute('open');
        }
    };

    window.confirmClearCart = function() {
        window.closeClearCartModal();
        if (typeof window.clearCustomerCart === 'function') {
            window.clearCustomerCart();
        } else {
            localStorage.removeItem('customer_cart');
            if (typeof window.updateCartBadge === 'function') {
                window.updateCartBadge();
            }
        }
        renderCartTable();
        if (typeof window.showToast === 'function') {
            window.showToast("Shopping cart cleared.", true);
        }
    };

    window.clearEntireCart = function() {
        window.openClearCartModal();
    };

    window.proceedToCheckout = function() {
        const cart = getLocalCart();
        if (!cart || cart.length === 0) {
            if (typeof window.showToast === 'function') {
                window.showToast("Your cart is empty. Please add books before checkout.", false);
            }
            return;
        }

        if (typeof window.isCustomerLoggedIn === 'function' && !window.isCustomerLoggedIn()) {
            if (typeof window.openLoginRequiredModal === 'function') {
                window.openLoginRequiredModal('/Cart/Checkout');
            } else {
                window.location.href = '/Auth/Login?returnUrl=/Cart/Checkout';
            }
            return;
        }

        window.location.href = '/Cart/Checkout';
    };

    function escapeHtml(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    document.addEventListener('DOMContentLoaded', function() {
        renderCartTable();
        const clearCartModal = document.getElementById('clearCartModal');
        if (clearCartModal) {
            clearCartModal.addEventListener('click', function(e) {
                if (e.target === clearCartModal) {
                    window.closeClearCartModal();
                }
            });
        }
    });

    window.addEventListener('pageshow', function() {
        renderCartTable();
    });
</script>
}
