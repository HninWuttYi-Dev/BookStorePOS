@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section class="py-16 md:py-24 text-center max-w-4xl mx-auto px-4">
    <div class="inline-flex justify-center mb-8 opacity-70 text-brand-accent">
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m8-8H4M12 2a10 10 0 100 20 10 10 0 000-20z"></path></svg>
    </div>
    <h1 class="text-5xl md:text-7xl font-heading font-bold text-brand-ink mb-6 tracking-tight leading-tight">
        Discover Your Next <br /> Great Story
    </h1>
    <p class="text-brand-inkLight text-lg md:text-xl leading-relaxed font-body mb-10 max-w-2xl mx-auto">
        Browse through our carefully curated selection of fine literature, rare editions, and modern classics.
    </p>
    <a href="/Books" class="inline-block bg-brand-ink hover:bg-brand-accent text-brand-bg px-8 py-3.5 rounded-full text-base font-semibold transition-colors shadow-md">
        Browse Books
    </a>
</section>

<!-- Search Bar Section -->
<section class="max-w-3xl mx-auto mb-20 px-4">
    <div class="bg-brand-surface p-4 rounded-2xl shadow-sm border border-brand-border/50">
        <form action="/Books" method="get" class="flex flex-col sm:flex-row gap-3 debounce-search-form">
            <div class="relative flex-1">
                <svg class="w-5 h-5 absolute left-4 top-1/2 -translate-y-1/2 text-brand-inkLight" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                <input type="text" name="SearchQuery" placeholder="Search by title, author, or ISBN..." class="w-full pl-12 pr-12 py-3 bg-brand-bg border border-brand-border rounded-xl focus:outline-none focus:border-brand-accent text-brand-ink placeholder:text-brand-inkLight/60 debounce-search-input">
                <button type="button" class="absolute right-4 top-1/2 -translate-y-1/2 text-brand-inkLight hover:text-brand-accent hidden debounce-clear-btn" aria-label="Clear">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
        </form>
    </div>
</section>

<!-- Genres Section -->
<section class="max-w-7xl mx-auto px-4 mb-24">
    <div class="flex justify-between items-end mb-8">
        <h2 class="text-3xl font-heading font-bold text-brand-ink">Explore by Genre</h2>
        <a href="/Genres" class="text-brand-accent hover:text-brand-ink font-medium text-sm flex items-center gap-1 transition-colors uppercase tracking-widest">
            View All
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </a>
    </div>
    
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
        @foreach(var genre in new[] { "Fiction", "History", "Philosophy", "Science", "Biography", "Poetry" })
        {
            <a href="/Books?genre=@genre" class="bg-brand-surface border border-brand-border/60 rounded-xl p-5 text-center hover:border-brand-accent hover:shadow-md transition-all group">
                <span class="font-heading font-semibold text-lg text-brand-ink group-hover:text-brand-accent transition-colors">@genre</span>
            </a>
        }
    </div>
</section>

<!-- Bestsellers Section -->
<section class="max-w-7xl mx-auto px-4 mb-24">
    <div class="flex justify-between items-end mb-8">
        <h2 class="text-3xl font-heading font-bold text-brand-ink">Bestsellers</h2>
        <a href="/Books?filter=bestsellers" class="text-brand-accent hover:text-brand-ink font-medium text-sm flex items-center gap-1 transition-colors uppercase tracking-widest">
            View All
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </a>
    </div>
    
    <div class="flex flex-wrap bg-brand-surface border border-brand-border/40 rounded-xl overflow-hidden shadow-inner pt-8 pb-16 px-2 md:px-8">
        @for(int i = 1; i <= 5; i++)
        {
            <div class="w-1/2 md:w-1/3 lg:w-1/5 flex flex-col justify-end pt-12 pb-8">
                <!-- Book Container -->
                <div class="px-2 md:px-4 flex justify-center mb-0 relative z-10">
                    <div class="group relative w-32 md:w-44 h-48 md:h-64 shadow-[4px_6px_15px_rgba(0,0,0,0.25)] transition-all hover:-translate-y-6 duration-300 cursor-pointer rounded-r-md rounded-l-sm">
                        
                        <!-- Book Spine Highlight -->
                        <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-r from-white/40 to-transparent z-20 rounded-l-sm"></div>
                        
                        <!-- Static Mock Cover -->
                        <div class="w-full h-full bg-brand-ink flex items-center justify-center rounded-r-md rounded-l-sm z-10 relative p-4 text-center">
                            <span class="font-heading text-brand-surface font-bold text-sm">Bestseller @i</span>
                        </div>
                        
                        <!-- Hover Overlay for Add to Cart -->
                        <div class="absolute inset-0 bg-brand-ink/90 opacity-0 group-hover:opacity-100 transition-opacity z-30 flex flex-col items-center justify-center rounded-r-md rounded-l-sm backdrop-blur-[2px]">
                            <span class="text-brand-surface font-bold mb-4 font-heading text-lg">15,000 MMK</span>
                            <button type="button" class="bg-brand-accent text-white px-5 py-2 rounded-full text-sm font-semibold hover:bg-brand-surface hover:text-brand-ink transition-colors shadow-lg transform hover:scale-105 duration-200">
                                Add to Cart
                            </button>
                        </div>
                    </div>
                </div>
                
                <!-- The Continuous Shelf -->
                <div class="w-full h-5 bg-[#e2d5c4] shadow-[0_12px_20px_-5px_rgba(140,111,69,0.4)] border-t-2 border-[#f5ece1] relative z-0">
                    <!-- Shelf wood grain subtle texture -->
                    <div class="absolute inset-0 opacity-20 bg-[url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.85%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E')]"></div>
                </div>
                
                <!-- Title / Author -->
                <div class="text-center mt-8 px-4 h-16">
                    <h3 class="font-heading font-bold text-brand-ink text-lg truncate" title="The Great Book @i">The Great Book @i</h3>
                    <p class="text-sm text-brand-inkLight font-medium mt-1 truncate" title="Author Name">Author Name</p>
                </div>
            </div>
        }
    </div>
</section>

<!-- Trending Section -->
<section class="max-w-7xl mx-auto px-4 mb-24">
    <div class="flex justify-between items-end mb-8">
        <h2 class="text-3xl font-heading font-bold text-brand-ink">Trending Now</h2>
    </div>
    
    <div class="flex flex-wrap bg-brand-surface border border-brand-border/40 rounded-xl overflow-hidden shadow-inner pt-8 pb-16 px-2 md:px-8">
        @for(int i = 6; i <= 10; i++)
        {
            <div class="w-1/2 md:w-1/3 lg:w-1/5 flex flex-col justify-end pt-12 pb-8">
                <!-- Book Container -->
                <div class="px-2 md:px-4 flex justify-center mb-0 relative z-10">
                    <div class="group relative w-32 md:w-44 h-48 md:h-64 shadow-[4px_6px_15px_rgba(0,0,0,0.25)] transition-all hover:-translate-y-6 duration-300 cursor-pointer rounded-r-md rounded-l-sm">
                        
                        <!-- Book Spine Highlight -->
                        <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-r from-white/40 to-transparent z-20 rounded-l-sm"></div>
                        
                        <!-- Static Mock Cover -->
                        <div class="w-full h-full bg-brand-inkLight flex items-center justify-center rounded-r-md rounded-l-sm z-10 relative p-4 text-center">
                            <span class="font-heading text-brand-surface font-bold text-sm">Trending @i</span>
                        </div>
                        
                        <!-- Hover Overlay for Add to Cart -->
                        <div class="absolute inset-0 bg-brand-ink/90 opacity-0 group-hover:opacity-100 transition-opacity z-30 flex flex-col items-center justify-center rounded-r-md rounded-l-sm backdrop-blur-[2px]">
                            <span class="text-brand-surface font-bold mb-4 font-heading text-lg">22,500 MMK</span>
                            <button type="button" class="bg-brand-accent text-white px-5 py-2 rounded-full text-sm font-semibold hover:bg-brand-surface hover:text-brand-ink transition-colors shadow-lg transform hover:scale-105 duration-200">
                                Add to Cart
                            </button>
                        </div>
                    </div>
                </div>
                
                <!-- The Continuous Shelf -->
                <div class="w-full h-5 bg-[#e2d5c4] shadow-[0_12px_20px_-5px_rgba(140,111,69,0.4)] border-t-2 border-[#f5ece1] relative z-0">
                    <!-- Shelf wood grain subtle texture -->
                    <div class="absolute inset-0 opacity-20 bg-[url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.85%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E')]"></div>
                </div>
                
                <!-- Title / Author -->
                <div class="text-center mt-8 px-4 h-16">
                    <h3 class="font-heading font-bold text-brand-ink text-lg truncate" title="Trending Book @i">Trending Book @i</h3>
                    <p class="text-sm text-brand-inkLight font-medium mt-1 truncate" title="Another Author">Another Author</p>
                </div>
            </div>
        }
    </div>
</section>
