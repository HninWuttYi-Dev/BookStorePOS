@model BookListResponseModel
@{
    ViewData["Title"] = "Home";
}

<!-- 1. Hero Section: Editorial Literary Spread & Botanical Open Book with Quote -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-10 pb-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
        
        <!-- Left: Editorial Story & Actions -->
        <div class="lg:col-span-7 flex flex-col justify-center text-center lg:text-left">
            <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-brand-surface border border-brand-border/70 text-brand-accent text-xs font-semibold uppercase tracking-widest font-body mb-6 shadow-2xs self-center lg:self-start">
                <span class="w-2 h-2 rounded-full bg-brand-accent animate-pulse"></span>
                <span>Curated Literary Haven • Babylon</span>
            </div>

            <h1 class="text-4xl sm:text-6xl lg:text-7xl font-heading font-bold text-brand-ink mb-6 tracking-tight leading-[1.08]">
                Discover Your Next <br class="hidden sm:inline" />
                <span class="relative inline-block">
                    <span class="relative z-10">Great Story</span>
                    <span class="absolute bottom-1.5 left-0 right-0 h-3 bg-brand-accent/20 -rotate-1 rounded-sm -z-0"></span>
                </span>
            </h1>

            <p class="text-brand-inkLight text-base sm:text-lg md:text-xl leading-relaxed font-body mb-8 max-w-xl mx-auto lg:mx-0">
                Browse through our carefully curated selection of fine literature, rare editions, and modern classics bound for discerning readers.
            </p>

            <div class="flex flex-wrap items-center justify-center lg:justify-start gap-4 mb-10">
                <a href="/Books" class="inline-flex items-center gap-2 bg-brand-ink hover:bg-brand-accent text-brand-bg px-8 py-3.5 rounded-full text-sm font-semibold font-body transition-all duration-300 shadow-md hover:shadow-lg hover:-translate-y-0.5">
                    <span>Browse Books</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </a>
                <a href="/Authors" class="inline-flex items-center gap-2 bg-brand-surface hover:bg-brand-surface/80 border border-brand-border text-brand-ink hover:text-brand-accent px-7 py-3.5 rounded-full text-sm font-semibold font-body transition-colors">
                    <span>Explore Authors</span>
                </a>
            </div>

            <!-- Literary Stats -->
            <div class="grid grid-cols-3 gap-4 pt-6 border-t border-brand-border/60 max-w-lg mx-auto lg:mx-0">
                <div>
                    <span class="block text-2xl sm:text-3xl font-heading font-bold text-brand-ink">10,000+</span>
                    <span class="text-[11px] text-brand-inkLight font-body uppercase tracking-wider">Curated Titles</span>
                </div>
                <div>
                    <span class="block text-2xl sm:text-3xl font-heading font-bold text-brand-ink">500+</span>
                    <span class="text-[11px] text-brand-inkLight font-body uppercase tracking-wider">Acclaimed Authors</span>
                </div>
                <div>
                    <span class="block text-2xl sm:text-3xl font-heading font-bold text-brand-ink">100%</span>
                    <span class="text-[11px] text-brand-inkLight font-body uppercase tracking-wider">Authentic Editions</span>
                </div>
            </div>
        </div>

        <!-- Right: Botanical Watercolor Open Book with Myanmar Quote Above -->
        <div class="lg:col-span-5 flex flex-col items-center justify-center py-6">
            <style>
                @@keyframes openBookFloat {
                    0%, 100% {
                        transform: translateY(0px) rotate(0deg);
                    }
                    50% {
                        transform: translateY(-8px) rotate(0.6deg);
                    }
                }
                .animate-open-book {
                    animation: openBookFloat 5.5s ease-in-out infinite;
                }
            </style>

            <div class="relative w-full max-w-[420px] sm:max-w-[460px] flex flex-col items-center justify-center group animate-open-book">
                
                <!-- Ambient Warm Parchment Glow -->
                <div class="absolute inset-0 bg-gradient-to-tr from-[#EADBC8]/30 via-[#F5EBE1]/50 to-transparent rounded-full blur-3xl -z-10 transform scale-95 pointer-events-none"></div>

                <!-- Myanmar Quote from User Image (Above the Book) -->
                <div class="mb-4 bg-brand-surface/95 backdrop-blur-md border border-brand-border/80 px-5 py-3 rounded-2xl shadow-sm text-center max-w-sm sm:max-w-md transition-transform duration-300 group-hover:-translate-y-1">
                    <p class="text-xs sm:text-sm font-body text-brand-ink leading-relaxed">
                        &ldquo;မေတ္တာဆိုတာ ပြန်ရဖို့မျှော်လင့်ပြီး ပေးရတဲ့ အရာမဟုတ်ဘူး ပေးလိုက်ရရုံနဲ့တင် စိတ်ချမ်းသာရတဲ့အရာ.....။&rdquo;
                    </p>
                    <span class="text-[11px] font-semibold text-brand-accent font-body mt-1.5 block">
                        &mdash; &ldquo;လယ်တွင်းသားစောချစ်&rdquo;
                    </span>
                </div>

                <!-- The Watercolor Open Book with Sprouting Flowers & Butterfly -->
                <div class="relative w-full flex items-center justify-center transition-transform duration-500 group-hover:scale-[1.03]">
                    <img src="/images/hero-open-book-floral.png" 
                         alt="Open book with wildflowers and fluttering butterfly" 
                         class="w-full h-auto max-h-[380px] sm:max-h-[420px] object-contain drop-shadow-[0_22px_36px_rgba(44,38,33,0.16)] select-none">
                </div>

                <!-- Ground Ambient Shadow -->
                <div class="w-56 sm:w-68 h-6 bg-black/15 rounded-full blur-lg -mt-3 pointer-events-none"></div>

            </div>
        </div>

    </div>
</section>

<!-- 2. Search Bar Section -->
<section class="max-w-3xl mx-auto mb-16 px-4">
    <form action="/Books" method="get" class="debounce-search-form">
        <div class="relative flex-1">
            <svg class="w-5 h-5 absolute left-4 top-1/2 -translate-y-1/2 text-brand-inkLight/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            <input type="text" name="SearchQuery" placeholder="Search by title, author, or ISBN..." class="w-full pl-12 pr-12 py-3.5 bg-brand-surface rounded-full focus:outline-none text-brand-ink placeholder:text-brand-inkLight/60 debounce-search-input font-body text-sm border border-brand-border/40">
            <button type="button" class="absolute right-4 top-1/2 -translate-y-1/2 text-brand-inkLight hover:text-brand-accent hidden debounce-clear-btn" aria-label="Clear">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>
    </form>
</section>

<!-- 3. Explore by Genre (Curated Categories directly under Search Bar) -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
    <div class="flex justify-between items-end mb-6">
        <div>
            <span class="text-xs font-semibold uppercase tracking-widest text-brand-accent font-body">Curated Categories</span>
            <h2 class="text-2xl sm:text-3xl font-heading font-bold text-brand-ink mt-1">Explore by Genre</h2>
        </div>
        <a href="/Genres" class="text-brand-accent hover:text-brand-ink font-medium text-xs sm:text-sm flex items-center gap-1 transition-colors uppercase tracking-widest font-body">
            View All
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </a>
    </div>
    
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
        @foreach(var genre in new[] { "Fiction", "History", "Philosophy", "Science", "Biography", "Poetry" })
        {
            <a href="/Books?genre=@genre" class="bg-brand-surface border border-brand-border/60 rounded-xl p-5 text-center hover:border-brand-accent hover:shadow-md transition-all group">
                <span class="font-heading font-semibold text-base sm:text-lg text-brand-ink group-hover:text-brand-accent transition-colors">@genre</span>
            </a>
        }
    </div>
</section>

<!-- Sleek Section Divider -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="w-full h-px bg-brand-border/50 mb-14"></div>
</div>

<!-- 4. New & Trending (Showcase with large font, book, author, audiobook, NO search bar) -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-8 items-center">
        
        <!-- Left: Large Typography Info (Without Search Bar) -->
        <div class="lg:col-span-5 flex flex-col justify-center">
            <div class="flex items-center gap-2 mb-3">
                <span class="w-2 h-2 rounded-full bg-brand-accent inline-block"></span>
                <span class="text-xs font-semibold uppercase tracking-widest text-brand-accent font-body">Curated Collection</span>
            </div>
            
            <h2 class="text-5xl sm:text-6xl font-heading font-bold text-brand-ink leading-[1.08] tracking-tight mb-4">
                New &amp;<br />Trending
            </h2>
            
            <p class="text-brand-inkLight text-base sm:text-lg leading-relaxed max-w-sm font-body">
                Explore rare editions, modern classics, and timeless literature.
            </p>
        </div>

        <!-- Right: 3D Book, Author of the Week, Audiobook Cards on Gallery Ledge -->
        <div class="lg:col-span-7 flex flex-col items-center lg:items-end">
            <div class="flex items-end justify-center gap-2 sm:gap-4 pb-2 w-full max-w-2xl">
                
                <!-- 1. The Featured Book (3D Book Cover) -->
                <a href="/Books?search=The+Last+Thing+He+Told+Me" class="w-44 sm:w-52 h-64 sm:h-76 shrink-0 rounded-r-lg rounded-l-xs shadow-[0_18px_32px_-8px_rgba(30,24,18,0.35)] overflow-hidden bg-gradient-to-br from-[#1C2C25] via-[#283E34] to-[#14221C] p-3.5 sm:p-4 flex flex-col justify-between text-white relative hover:-translate-y-2 transition-all duration-300 group cursor-pointer">
                    <!-- Spine Highlight -->
                    <div class="absolute left-0 top-0 bottom-0 w-2 bg-gradient-to-r from-white/25 via-transparent to-black/35 pointer-events-none rounded-l-xs"></div>
                    <div class="absolute left-2 top-0 bottom-0 w-[0.5px] bg-black/30 pointer-events-none"></div>

                    <!-- Top Meta -->
                    <div class="flex justify-between items-center text-[9px] uppercase tracking-wider font-semibold text-amber-200/90 font-body relative z-10 pl-1">
                        <span>#1 Bestseller</span>
                        <span>Babylon</span>
                    </div>

                    <!-- Center Title & Author -->
                    <div class="my-auto text-center px-1 relative z-10">
                        <h3 class="font-heading font-bold text-white text-lg sm:text-xl leading-tight drop-shadow-xs">
                            The Last<br />Thing He<br />Told Me
                        </h3>
                        <p class="font-heading italic text-amber-300/90 text-xs sm:text-sm mt-2">Laura Dave</p>
                    </div>

                    <!-- Bottom Details -->
                    <div class="flex justify-between items-end border-t border-white/15 pt-2 text-[10px] font-body relative z-10 pl-1">
                        <span class="text-gray-300 text-[9px] leading-tight">Hardcover<br />Edition</span>
                        <span class="text-amber-300 font-bold text-xs sm:text-sm leading-tight text-right">24,000<br /><span class="text-[9px] font-semibold tracking-wider text-amber-400">MMK</span></span>
                    </div>
                </a>

                <!-- Vertical Divider Label: Author of the Week -->
                <div class="hidden sm:flex items-center justify-center h-56 text-[9px] font-bold tracking-widest text-brand-inkLight/60 uppercase select-none [writing-mode:vertical-rl] rotate-180 font-body shrink-0">
                    Author of the Week
                </div>

                <!-- 2. Featured Author Card (Stephen King) -->
                <div class="w-36 sm:w-44 h-60 sm:h-72 shrink-0 rounded-3xl bg-gradient-to-b from-[#C48F47] to-[#A97534] text-white shadow-[0_14px_28px_-6px_rgba(169,117,52,0.32)] p-4 flex flex-col justify-between items-center text-center hover:-translate-y-2 transition-all duration-300 group">
                    <div class="w-full">
                        <span class="text-[9px] uppercase tracking-widest font-semibold text-amber-100/90 font-body">Featured Author</span>
                        <h4 class="font-heading font-bold text-base sm:text-lg text-white mt-1 leading-snug">Stephen King</h4>
                        <p class="text-[11px] text-amber-100/80 font-body">78 Classic Works</p>
                    </div>

                    <!-- Author Icon Avatar -->
                    <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-white/20 border border-white/30 flex items-center justify-center text-white my-auto shadow-inner group-hover:scale-105 transition-transform">
                        <svg class="w-6 h-6 sm:w-7 sm:h-7 opacity-90" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                        </svg>
                    </div>

                    <!-- Explore Button -->
                    <a href="/Authors" class="w-full py-2 bg-white/20 hover:bg-white/30 text-white rounded-full text-xs font-semibold font-body transition-colors shadow-2xs">
                        Explore Author
                    </a>
                </div>

                <!-- Vertical Divider Label: Audiobook -->
                <div class="hidden sm:flex items-center justify-center h-56 text-[9px] font-bold tracking-widest text-brand-inkLight/60 uppercase select-none [writing-mode:vertical-rl] rotate-180 font-body shrink-0">
                    Audiobook
                </div>

                <!-- 3. Audiobook Card (False Witness) -->
                <div class="w-36 sm:w-44 h-60 sm:h-72 shrink-0 rounded-3xl bg-white border border-brand-border/60 shadow-[0_14px_28px_-6px_rgba(44,38,33,0.12)] p-4 flex flex-col justify-between items-center text-center hover:-translate-y-2 transition-all duration-300 group">
                    <div class="w-full">
                        <h4 class="font-heading font-bold text-base sm:text-lg text-brand-ink leading-tight">False Witness</h4>
                        <p class="font-heading italic text-[11px] text-brand-inkLight mt-0.5">Karin Slaughter</p>
                    </div>

                    <!-- Vinyl Record Graphic with Grooves and Center Label -->
                    <div class="relative w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-[#181615] flex items-center justify-center shadow-md my-auto ring-2 ring-black/5 group-hover:rotate-45 transition-transform duration-700">
                        <div class="absolute inset-1 rounded-full border border-white/10 pointer-events-none"></div>
                        <div class="absolute inset-2.5 rounded-full border border-white/5 pointer-events-none"></div>
                        <div class="w-5 h-5 sm:w-6 sm:h-6 rounded-full bg-[#D4A359] border-2 border-[#181615] flex items-center justify-center shadow-xs">
                            <div class="w-1.5 h-1.5 rounded-full bg-[#181615]"></div>
                        </div>
                    </div>

                    <!-- Play Audio Button -->
                    <button type="button" onclick="alert('Audiobook preview: False Witness by Karin Slaughter')" class="w-9 h-9 rounded-full bg-[#1A1817] hover:bg-brand-accent text-white flex items-center justify-center transition-colors shadow-md hover:scale-105" aria-label="Play audiobook preview">
                        <svg class="w-4 h-4 translate-x-0.5 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                    </button>
                </div>

            </div>
        </div>
    </div>
</section>

<!-- Sleek Section Divider -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="w-full h-px bg-brand-border/50 mb-14"></div>
</div>

<!-- 5. Recent Bestsellers Section (Horizontal Cards) -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-24">
    <div class="flex justify-between items-center mb-6">
        <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-brand-accent inline-block"></span>
            <h2 class="text-xs sm:text-sm font-bold uppercase tracking-widest text-brand-ink font-body">Recent Bestsellers</h2>
        </div>
        <a href="/Books?filter=bestsellers" class="text-brand-accent hover:text-brand-ink font-semibold text-xs uppercase tracking-widest flex items-center gap-1 transition-colors font-body">
            View All
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </a>
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Bestseller 1: Left to Fear -->
        <div class="flex items-center gap-4 bg-brand-surface border border-brand-border/70 hover:border-brand-accent/50 p-4 rounded-2xl transition-all duration-300 hover:shadow-md group">
            <div class="w-20 sm:w-24 h-28 sm:h-34 shrink-0 rounded-r-md rounded-l-xs shadow-[0_8px_18px_rgba(45,33,24,0.18)] overflow-hidden bg-gradient-to-br from-[#1C2C38] via-[#2A3E4E] to-[#121E28] p-2.5 flex flex-col justify-between text-white relative group-hover:-translate-y-1 transition-transform">
                <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-r from-white/30 to-transparent pointer-events-none"></div>
                <div class="absolute left-1 top-0 bottom-0 w-[0.5px] bg-black/25 pointer-events-none"></div>
                <span class="text-[8px] uppercase tracking-wider text-amber-200 font-semibold font-body">Bestseller</span>
                <p class="font-heading font-bold text-xs sm:text-sm leading-tight text-center px-1">Left to Fear</p>
                <span class="text-[8px] text-gray-300 font-heading italic text-center">Blake Pierce</span>
            </div>
            <div class="flex-1 min-w-0">
                <div class="text-amber-500 text-xs tracking-wider mb-1 font-body">★★★★★</div>
                <h4 class="font-heading font-bold text-brand-ink text-sm sm:text-base truncate" title="Left to Fear">Left to Fear</h4>
                <p class="text-xs text-brand-inkLight font-heading italic truncate mt-0.5">Blake Pierce</p>
                <p class="text-xs sm:text-sm font-semibold text-brand-accent font-body mt-1.5">15,000 MMK</p>
                <button type="button" onclick="window.handleAddToCart(null, event)" class="inline-block mt-2 px-3.5 py-1 rounded-full border border-brand-accent/60 text-brand-accent hover:bg-brand-accent hover:text-white transition-colors text-xs font-semibold font-body shadow-2xs">
                    Buy Now
                </button>
            </div>
        </div>

        <!-- Bestseller 2: Malibu Rising -->
        <div class="flex items-center gap-4 bg-brand-surface border border-brand-border/70 hover:border-brand-accent/50 p-4 rounded-2xl transition-all duration-300 hover:shadow-md group">
            <div class="w-20 sm:w-24 h-28 sm:h-34 shrink-0 rounded-r-md rounded-l-xs shadow-[0_8px_18px_rgba(45,33,24,0.18)] overflow-hidden bg-gradient-to-br from-[#20404C] via-[#336170] to-[#162D36] p-2.5 flex flex-col justify-between text-white relative group-hover:-translate-y-1 transition-transform">
                <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-r from-white/30 to-transparent pointer-events-none"></div>
                <div class="absolute left-1 top-0 bottom-0 w-[0.5px] bg-black/25 pointer-events-none"></div>
                <span class="text-[8px] uppercase tracking-wider text-teal-200 font-semibold font-body">Trending</span>
                <p class="font-heading font-bold text-xs sm:text-sm leading-tight text-center px-1">Malibu Rising</p>
                <span class="text-[8px] text-gray-300 font-heading italic text-center">Taylor Jenkins Reid</span>
            </div>
            <div class="flex-1 min-w-0">
                <div class="text-amber-500 text-xs tracking-wider mb-1 font-body">★★★★★</div>
                <h4 class="font-heading font-bold text-brand-ink text-sm sm:text-base truncate" title="Malibu Rising">Malibu Rising</h4>
                <p class="text-xs text-brand-inkLight font-heading italic truncate mt-0.5">Taylor Jenkins Reid</p>
                <p class="text-xs sm:text-sm font-semibold text-brand-accent font-body mt-1.5">18,500 MMK</p>
                <button type="button" onclick="window.handleAddToCart(null, event)" class="inline-block mt-2 px-3.5 py-1 rounded-full border border-brand-accent/60 text-brand-accent hover:bg-brand-accent hover:text-white transition-colors text-xs font-semibold font-body shadow-2xs">
                    Buy Now
                </button>
            </div>
        </div>

        <!-- Bestseller 3: Black Ice -->
        <div class="flex items-center gap-4 bg-brand-surface border border-brand-border/70 hover:border-brand-accent/50 p-4 rounded-2xl transition-all duration-300 hover:shadow-md group">
            <div class="w-20 sm:w-24 h-28 sm:h-34 shrink-0 rounded-r-md rounded-l-xs shadow-[0_8px_18px_rgba(45,33,24,0.18)] overflow-hidden bg-gradient-to-br from-[#1C1824] via-[#2F293E] to-[#120F18] p-2.5 flex flex-col justify-between text-white relative group-hover:-translate-y-1 transition-transform">
                <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-r from-white/30 to-transparent pointer-events-none"></div>
                <div class="absolute left-1 top-0 bottom-0 w-[0.5px] bg-black/25 pointer-events-none"></div>
                <span class="text-[8px] uppercase tracking-wider text-purple-200 font-semibold font-body">Thriller</span>
                <p class="font-heading font-bold text-xs sm:text-sm leading-tight text-center px-1">Black Ice</p>
                <span class="text-[8px] text-gray-300 font-heading italic text-center">Brad Thor</span>
            </div>
            <div class="flex-1 min-w-0">
                <div class="text-amber-500 text-xs tracking-wider mb-1 font-body">★★★★★</div>
                <h4 class="font-heading font-bold text-brand-ink text-sm sm:text-base truncate" title="Black Ice">Black Ice</h4>
                <p class="text-xs text-brand-inkLight font-heading italic truncate mt-0.5">Brad Thor</p>
                <p class="text-xs sm:text-sm font-semibold text-brand-accent font-body mt-1.5">20,000 MMK</p>
                <button type="button" onclick="window.handleAddToCart(null, event)" class="inline-block mt-2 px-3.5 py-1 rounded-full border border-brand-accent/60 text-brand-accent hover:bg-brand-accent hover:text-white transition-colors text-xs font-semibold font-body shadow-2xs">
                    Buy Now
                </button>
            </div>
        </div>

        <!-- Bestseller 4: Blind Tiger -->
        <div class="flex items-center gap-4 bg-brand-surface border border-brand-border/70 hover:border-brand-accent/50 p-4 rounded-2xl transition-all duration-300 hover:shadow-md group">
            <div class="w-20 sm:w-24 h-28 sm:h-34 shrink-0 rounded-r-md rounded-l-xs shadow-[0_8px_18px_rgba(45,33,24,0.18)] overflow-hidden bg-gradient-to-br from-[#3D2817] via-[#523720] to-[#25180D] p-2.5 flex flex-col justify-between text-white relative group-hover:-translate-y-1 transition-transform">
                <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-r from-white/30 to-transparent pointer-events-none"></div>
