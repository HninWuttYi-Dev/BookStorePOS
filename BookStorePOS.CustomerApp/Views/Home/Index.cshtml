@model HomeViewModel
@{
    ViewData["Title"] = "Home";

    var trendingBooks = Model?.TrendingBooks ?? new List<BookModel>();
    var bestsellerBooks = Model?.BestsellerBooks ?? new List<BookModel>();
}

<!-- 1. Hero Section: Editorial Literary Spread & Botanical Open Book with Quote -->
<section class="relative bg-brand-bg pt-6 sm:pt-10 pb-12 sm:pb-16 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
            
            <!-- Left: Editorial Story & Actions -->
            <div class="lg:col-span-7 flex flex-col justify-center text-center lg:text-left">
                <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-brand-surface border border-brand-border/70 text-brand-accent text-xs font-semibold uppercase tracking-widest font-body mb-6 shadow-2xs self-center lg:self-start">
                    <span class="w-2 h-2 rounded-full bg-brand-accent animate-pulse"></span>
                    <span>Curated Literary Haven • Babylon</span>
                </div>

                <h1 class="text-4xl sm:text-6xl lg:text-7xl font-heading font-bold text-brand-ink mb-6 tracking-tight leading-[1.08]">
                    Discover Your Next <br class="hidden sm:inline" />
                    <span class="relative inline-block">
                        <span class="relative z-10">Great Story</span>
                        <span class="absolute bottom-1.5 left-0 right-0 h-3 bg-brand-accent/20 -rotate-1 rounded-sm -z-0"></span>
                    </span>
                </h1>

                <p class="text-brand-inkLight text-base sm:text-lg md:text-xl leading-relaxed font-body mb-8 max-w-xl mx-auto lg:mx-0">
                    Browse through our carefully curated selection of fine literature, rare editions, and modern classics bound for discerning readers.
                </p>

                <div class="flex flex-wrap items-center justify-center lg:justify-start gap-4 mb-10">
                    <a href="/Books" class="inline-flex items-center gap-2 bg-brand-ink hover:bg-brand-accent text-brand-bg px-8 py-3.5 rounded-full text-sm font-semibold font-body transition-all duration-300 shadow-md hover:shadow-lg hover:-translate-y-0.5">
                        <span>Browse Books</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                    </a>
                    <a href="/Authors" class="inline-flex items-center gap-2 bg-brand-surface hover:bg-brand-surface/80 border border-brand-border text-brand-ink hover:text-brand-accent px-7 py-3.5 rounded-full text-sm font-semibold font-body transition-colors">
                        <span>Explore Authors</span>
                    </a>
                </div>

                <!-- Literary Stats -->
                <div class="grid grid-cols-3 gap-4 pt-6 border-t border-brand-border/60 max-w-lg mx-auto lg:mx-0">
                    <div>
                        <span class="block text-2xl sm:text-3xl font-heading font-bold text-brand-ink">10,000+</span>
                        <span class="text-[11px] text-brand-inkLight font-body uppercase tracking-wider">Curated Titles</span>
                    </div>
                    <div>
                        <span class="block text-2xl sm:text-3xl font-heading font-bold text-brand-ink">500+</span>
                        <span class="text-[11px] text-brand-inkLight font-body uppercase tracking-wider">Acclaimed Authors</span>
                    </div>
                    <div>
                        <span class="block text-2xl sm:text-3xl font-heading font-bold text-brand-ink">100%</span>
                        <span class="text-[11px] text-brand-inkLight font-body uppercase tracking-wider">Authentic Editions</span>
                    </div>
                </div>
            </div>

            <!-- Right: Botanical Watercolor Open Book with Myanmar Quote Above -->
            <div class="lg:col-span-5 flex flex-col items-center justify-center py-6">
                <style>
                    @@keyframes openBookFloat {
                        0%, 100% {
                            transform: translateY(0px) rotate(0deg);
                        }
                        50% {
                            transform: translateY(-8px) rotate(0.6deg);
                        }
                    }
                    .animate-open-book {
                        animation: openBookFloat 5.5s ease-in-out infinite;
                    }
                </style>

                <div class="relative w-full max-w-[420px] sm:max-w-[460px] flex flex-col items-center justify-center group animate-open-book">
                    
                    <!-- Ambient Warm Parchment Glow -->
                    <div class="absolute inset-0 bg-gradient-to-tr from-[#EADBC8]/30 via-[#F5EBE1]/50 to-transparent rounded-full blur-3xl -z-10 transform scale-95 pointer-events-none"></div>

                    <!-- Myanmar Quote from User Image (Above the Book) -->
                    <div class="mb-4 bg-brand-surface/95 backdrop-blur-md border border-brand-border/80 px-5 py-3 rounded-2xl shadow-sm text-center max-w-sm sm:max-w-md transition-transform duration-300 group-hover:-translate-y-1">
                        <p class="text-xs sm:text-sm font-body text-brand-ink leading-relaxed">
                            &ldquo;မေတ္တာဆိုတာ ပြန်ရဖို့မျှော်လင့်ပြီး ပေးရတဲ့ အရာမဟုတ်ဘူး ပေးလိုက်ရရုံနဲ့တင် စိတ်ချမ်းသာရတဲ့အရာ.....။&rdquo;
                        </p>
                        <span class="text-[11px] font-semibold text-brand-accent font-body mt-1.5 block">
                            &mdash; &ldquo;လယ်တွင်းသားစောချစ်&rdquo;
                        </span>
                    </div>

                    <!-- The Watercolor Open Book with Sprouting Flowers & Butterfly -->
                    <div class="relative w-full flex items-center justify-center transition-transform duration-500 group-hover:scale-[1.03]">
                        <img src="/images/hero-open-book-floral.png" 
                             alt="Open book with wildflowers and fluttering butterfly" 
                             class="w-full h-auto max-h-[380px] sm:max-h-[420px] object-contain drop-shadow-[0_22px_36px_rgba(44,38,33,0.16)] select-none">
                    </div>

                    <!-- Ground Ambient Shadow -->
                    <div class="w-56 sm:w-68 h-6 bg-black/15 rounded-full blur-lg -mt-3 pointer-events-none"></div>

                </div>
            </div>

        </div>
    </div>
</section>

<!-- WAVE DIVIDER 1: Hero (Ivory #FDFBF7) into Curated Categories & Search (Parchment #F4F1EA) -->
<div class="w-full overflow-hidden leading-none pointer-events-none bg-brand-bg -mb-px">
    <svg viewBox="0 0 1440 84" fill="none" preserveAspectRatio="none" class="w-full h-10 sm:h-16 lg:h-20 block text-brand-surface">
        <path d="M0,32 C280,78 520,12 800,52 C1080,92 1280,22 1440,42 L1440,84 L0,84 Z" fill="currentColor"></path>
    </svg>
</div>

<!-- 2. Curated Categories & Search Section (Parchment Surface Island) -->
<section class="bg-brand-surface pt-4 sm:pt-6 pb-12 sm:pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Search Bar -->
        <div class="max-w-3xl mx-auto mb-12 sm:mb-14">
            <form action="/Books" method="get" class="debounce-search-form">
                <div class="relative flex-1">
                    <svg class="w-5 h-5 absolute left-4 top-1/2 -translate-y-1/2 text-brand-inkLight/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                    <input type="text" name="SearchQuery" placeholder="Search by title, author, or ISBN..." class="w-full pl-12 pr-12 py-3.5 bg-white/95 rounded-full focus:outline-none focus:ring-2 focus:ring-brand-accent/30 text-brand-ink placeholder:text-brand-inkLight/60 debounce-search-input font-body text-sm border border-brand-border/70 shadow-xs transition-shadow">
                    <button type="button" class="absolute right-4 top-1/2 -translate-y-1/2 text-brand-inkLight hover:text-brand-accent hidden debounce-clear-btn" aria-label="Clear">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
            </form>
        </div>

        <!-- Curated Categories -->
        <div class="flex justify-between items-end mb-6">
            <div>
                <span class="text-xs font-semibold uppercase tracking-widest text-brand-accent font-body">Curated Categories</span>
                <h2 class="text-2xl sm:text-3xl font-heading font-bold text-brand-ink mt-1">Explore by Genre</h2>
            </div>
            <a href="/Genres" class="text-brand-accent hover:text-brand-ink font-medium text-xs sm:text-sm flex items-center gap-1 transition-colors uppercase tracking-widest font-body">
                View All
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </a>
        </div>
        
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4">
            @{
                var curatedGenres = new[]
                {
                    (Name: "Fantasy", Label: "Fantasy", Subtitle: "Magic & Myth"),
                    (Name: "Classic", Label: "Classics", Subtitle: "Timeless Literature"),
                    (Name: "Dystopian", Label: "Dystopian", Subtitle: "Future & Society"),
                    (Name: "သမိုင်း", Label: "သမိုင်းနောက်ခံ", Subtitle: "Historical Masterworks"),
                    (Name: "ရသဝတ္ထု", Label: "ရသဝတ္ထုရှည်", Subtitle: "Literary Novels"),
                    (Name: "စုံထောက်", Label: "စုံထောက်နှင့် စွန့်စားခန်း", Subtitle: "Mystery & Adventure")
                };
            }
            @foreach(var item in curatedGenres)
            {
                <a href="/Books?genre=@Uri.EscapeDataString(item.Name)" class="bg-white/90 hover:bg-white border border-brand-border/70 hover:border-brand-accent rounded-xl p-4 sm:p-5 text-center shadow-xs hover:shadow-md transition-all group hover:-translate-y-0.5 flex flex-col items-center justify-center min-h-[95px]">
                    <span class="font-heading font-bold text-sm sm:text-base text-brand-ink group-hover:text-brand-accent transition-colors leading-tight">@item.Label</span>
                    <span class="text-[10px] text-brand-inkLight/75 font-body uppercase tracking-wider mt-1.5 group-hover:text-brand-ink transition-colors">@item.Subtitle</span>
                </a>
            }
        </div>
    </div>
</section>

<!-- WAVE DIVIDER 2: Categories (Parchment #F4F1EA) into New & Trending (Ivory #FDFBF7) -->
<div class="w-full overflow-hidden leading-none pointer-events-none bg-brand-bg -mt-px">
    <svg viewBox="0 0 1440 84" fill="none" preserveAspectRatio="none" class="w-full h-10 sm:h-16 lg:h-20 block text-brand-surface">
        <path d="M0,0 L1440,0 L1440,38 C1200,82 960,15 680,58 C420,92 200,18 0,42 Z" fill="currentColor"></path>
    </svg>
</div>

<!-- 3. New & Trending (Curated 3D Standing Books Fan-Stack & Physics Drop Animation) -->
<section class="bg-brand-bg pt-10 sm:pt-14 pb-16 sm:pb-22 overflow-hidden" id="trendingSection">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <style>
            /* 3D Overlapping Fan Stack Container */
            .fan-stack-stage {
                position: relative;
                width: 100%;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
            }

            .fan-stack-wrapper {
                position: relative;
                width: 320px;
                height: 380px;
                perspective: 1200px;
            }
            @@media (min-width: 640px) {
                .fan-stack-wrapper {
                    width: 370px;
                    height: 410px;
                }
            }

            /* Each Fan Item is a 3D Standing Book */
            .fan-card {
                position: absolute;
                top: 15px;
                left: 50%;
                margin-left: -95px;
                width: 190px;
                height: 275px;
                transform-origin: 50% 90%;
                transition: transform 0.65s cubic-bezier(0.22, 1, 0.36, 1), filter 0.4s ease, opacity 0.4s ease;
                will-change: transform, opacity, filter;
                cursor: pointer;
                user-select: none;
                opacity: 0;
                transform: translate3d(0, -750px, 0) scale(0.85);
            }
            @@media (min-width: 640px) {
                .fan-card {
                    margin-left: -105px;
                    width: 210px;
                    height: 305px;
                }
            }

            /* Falling Entrance Keyframes from Above */
            @@keyframes dropLeftBook {
                0% {
                    transform: translate3d(-75px, -800px, 0) rotate(0deg) scale(0.85);
                    opacity: 0;
                }
                65% {
                    transform: translate3d(-75px, 22px, 0) rotate(-16deg) scale(0.96);
                    opacity: 1;
                }
                82% {
                    transform: translate3d(-75px, 6px, 0) rotate(-13deg) scale(0.92);
                }
                100% {
                    transform: translate3d(-75px, 12px, 0) rotate(-14deg) scale(0.92);
                    opacity: 1;
                }
            }

            @@keyframes dropRightBook {
                0% {
                    transform: translate3d(75px, -800px, 10px) rotate(0deg) scale(0.85);
                    opacity: 0;
                }
                65% {
                    transform: translate3d(75px, 22px, 10px) rotate(18deg) scale(0.96);
                    opacity: 1;
                }
                82% {
                    transform: translate3d(75px, 6px, 10px) rotate(15deg) scale(0.92);
                }
                100% {
                    transform: translate3d(75px, 12px, 10px) rotate(16deg) scale(0.92);
                    opacity: 1;
                }
            }

            @@keyframes dropCenterBook {
                0% {
                    transform: translate3d(0, -850px, 25px) rotate(0deg) scale(0.88);
                    opacity: 0;
                }
                65% {
                    transform: translate3d(0, 20px, 25px) rotate(-4deg) scale(1.08);
                    opacity: 1;
                }
                82% {
                    transform: translate3d(0, -6px, 25px) rotate(-1deg) scale(1.03);
                }
                100% {
                    transform: translate3d(0, 0px, 25px) rotate(-2deg) scale(1.04);
                    opacity: 1;
                }
            }

            /* Active Falling State (Triggered on Scroll or Replay) */
            .fan-stack-wrapper.is-animating .fan-card.pos-left {
                animation: dropLeftBook 0.85s cubic-bezier(0.22, 1, 0.36, 1) 0.06s both;
                z-index: 10;
            }
            .fan-stack-wrapper.is-animating .fan-card.pos-right {
                animation: dropRightBook 0.85s cubic-bezier(0.22, 1, 0.36, 1) 0.22s both;
                z-index: 15;
            }
            .fan-stack-wrapper.is-animating .fan-card.pos-center {
                animation: dropCenterBook 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.40s both;
                z-index: 30;
            }

            /* Settled Positions */
            .fan-stack-wrapper.is-settled .fan-card {
                opacity: 1;
            }
            .fan-stack-wrapper.is-settled .fan-card.pos-left {
                transform: translate3d(-75px, 12px, 0) rotate(-14deg) scale(0.92);
                z-index: 10;
                filter: brightness(0.88) drop-shadow(0 14px 22px rgba(25, 20, 15, 0.26));
            }
            .fan-stack-wrapper.is-settled .fan-card.pos-center {
                transform: translate3d(0, 0px, 25px) rotate(-2deg) scale(1.04);
                z-index: 30;
                filter: brightness(1.0) drop-shadow(0 24px 40px rgba(25, 20, 15, 0.36));
            }
            .fan-stack-wrapper.is-settled .fan-card.pos-right {
                transform: translate3d(75px, 12px, 10px) rotate(16deg) scale(0.92);
                z-index: 15;
                filter: brightness(0.88) drop-shadow(0 14px 22px rgba(25, 20, 15, 0.26));
            }

            /* Interactive Hover Fan-Out Physics */
            .fan-stack-wrapper.is-settled:hover .fan-card.pos-left {
                transform: translate3d(-105px, 6px, 0) rotate(-19deg) scale(0.95);
            }
            .fan-stack-wrapper.is-settled:hover .fan-card.pos-center {
                transform: translate3d(0, -14px, 35px) rotate(0deg) scale(1.08);
                filter: brightness(1.03) drop-shadow(0 32px 55px rgba(25, 20, 15, 0.42));
            }
            .fan-stack-wrapper.is-settled:hover .fan-card.pos-right {
                transform: translate3d(105px, 6px, 10px) rotate(21deg) scale(0.95);
            }

            /* Authentic 3D Book Construction (Matches User Attached Image) */
            .fan-book-3d {
                position: relative;
                width: 100%;
                height: 100%;
                transform-style: preserve-3d;
            }

            .fan-book-front {
                position: absolute;
                inset: 0;
                border-radius: 0 4px 4px 0;
                overflow: hidden;
                background: #2D241E;
                box-shadow: inset 2px 0 3px rgba(255,255,255,0.35), inset -1.5px 0 3px rgba(0,0,0,0.30);
                z-index: 10;
            }

            .fan-book-spine-fold {
                position: absolute;
                left: 0;
                top: 0;
                bottom: 0;
                width: 18px;
                background: linear-gradient(to right, rgba(255,255,255,0.42) 0%, rgba(255,255,255,0.08) 18%, rgba(0,0,0,0.22) 24%, transparent 100%);
                pointer-events-none;
                z-index: 20;
            }

            .fan-book-side-pages {
                position: absolute;
                top: 3px;
                bottom: 3px;
                right: -15px;
                width: 16px;
                background: repeating-linear-gradient(to right, #FAF8F5, #FAF8F5 1.5px, #D6D0C5 1.5px, #D6D0C5 2.5px);
                -webkit-clip-path: polygon(0% 0px, 100% 5px, 100% calc(100% - 9px), 0% 100%);
                clip-path: polygon(0% 0px, 100% 5px, 100% calc(100% - 9px), 0% 100%);
                box-shadow: inset 1px 0 3px rgba(0,0,0,0.25), inset -1px 0 2px rgba(0,0,0,0.12);
                z-index: 5;
            }

            .fan-book-floor-shadow {
                position: absolute;
                bottom: -15px;
                left: 50%;
                transform: translateX(-48%) skewX(-24deg) scaleY(0.65);
                width: 210px;
                height: 22px;
                background: radial-gradient(ellipse at center, rgba(25, 20, 15, 0.50) 0%, rgba(25, 20, 15, 0.18) 50%, transparent 75%);
                filter: blur(6px);
                pointer-events-none;
                z-index: 1;
            }
        </style>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
            
            <!-- Left Column: Editorial Information & Controls -->
            <div class="lg:col-span-5 flex flex-col justify-center text-center lg:text-left">
                <div class="inline-flex items-center gap-2 mb-3.5 self-center lg:self-start">
                    <span class="w-2 h-2 rounded-full bg-brand-accent inline-block animate-pulse"></span>
                    <span class="text-xs font-semibold uppercase tracking-widest text-brand-accent font-body">Curated Collection</span>
                </div>
                
                <h2 class="text-3xl sm:text-5xl lg:text-6xl font-heading font-bold text-brand-ink leading-[1.08] tracking-tight mb-4">
                    New &amp;<br class="hidden lg:inline" /> Trending
                </h2>
                
                <p class="text-brand-inkLight text-sm sm:text-base leading-relaxed font-body mb-8 max-w-md mx-auto lg:mx-0">
                    Handpicked literary masterpieces that are capturing readers&rsquo; hearts this week.
                </p>

                <!-- Stack Switcher & Replay Controls -->
                @if (trendingBooks.Any())
                {
                    <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2.5 mb-8">
                        <div class="inline-flex p-1 bg-brand-surface rounded-full border border-brand-border/80 shadow-2xs">
                            @for (int i = 0; i < trendingBooks.Count; i++)
                            {
                                var b = trendingBooks[i];
                                var pillActive = i == 0 ? "bg-brand-ink text-brand-bg shadow-xs" : "text-brand-inkLight hover:text-brand-ink";
                                <button type="button" class="fan-pill px-3 py-1.5 text-xs font-semibold rounded-full transition-all duration-300 font-body @pillActive truncate max-w-[130px]" data-index="@i">
                                    0@(i + 1) • @(b.Genre ?? "Book")
                                </button>
                            }
                        </div>
                        
                        <!-- Quick Prev/Next Shuffle -->
                        <div class="inline-flex items-center gap-1">
                            <button type="button" id="fanPrevBtn" class="w-8 h-8 rounded-full bg-brand-surface hover:bg-brand-ink hover:text-white border border-brand-border/80 text-brand-ink flex items-center justify-center text-xs transition-colors shadow-2xs" aria-label="Previous card">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                            </button>
                            <button type="button" id="fanNextBtn" class="w-8 h-8 rounded-full bg-brand-surface hover:bg-brand-ink hover:text-white border border-brand-border/80 text-brand-ink flex items-center justify-center text-xs transition-colors shadow-2xs" aria-label="Next card">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                            </button>
                            
                            <!-- Replay Drop Animation Button -->
                            <button type="button" id="fanReplayBtn" title="Replay Drop Animation" class="w-8 h-8 rounded-full bg-brand-surface hover:bg-brand-accent hover:text-white border border-brand-border/80 text-brand-ink flex items-center justify-center text-xs transition-colors shadow-2xs ml-1" aria-label="Replay fall animation">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                            </button>
                        </div>
                    </div>
                }

                <!-- View All Trending Books Action -->
                <div class="flex items-center justify-center lg:justify-start">
                    <a href="/Books" class="inline-flex items-center gap-2 bg-brand-ink hover:bg-brand-accent text-brand-bg px-7 py-3.5 rounded-full text-xs sm:text-sm font-semibold font-body transition-all duration-300 shadow-md hover:shadow-lg hover:-translate-y-0.5">
                        <span>View All Trending Books</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                    </a>
                </div>
            </div>

            <!-- Right Column: Overlapping 3D Books Fan Stack (No Cards, Pure 3D Books) -->
            <div class="lg:col-span-7 flex flex-col justify-center items-center py-6 sm:py-8 overflow-visible relative">
                
                @if (trendingBooks.Any())
                {
                    <div class="fan-stack-stage">
                        
                        <!-- 3D Fan Stack Wrapper -->
                        <div class="fan-stack-wrapper" id="trendingFanStack">
                            @for (int i = 0; i < trendingBooks.Count; i++)
                            {
                                var book = trendingBooks[i];
                                var activeEditions = book.Editions?.Where(e => !e.IsDeleted).ToList() ?? new List<BookEditionModel>();
                                var bestsellerEdition = activeEditions.FirstOrDefault(); // First edition is #1 bestseller from BookService
