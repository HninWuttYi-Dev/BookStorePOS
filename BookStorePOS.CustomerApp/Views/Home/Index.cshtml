                                        Choose Edition &rarr;
                                    </a>
                                }
                            </div>

                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="p-8 text-center bg-white rounded-2xl border border-brand-border text-brand-inkLight font-body">
                No bestseller books found at the moment.
            </div>
        }
