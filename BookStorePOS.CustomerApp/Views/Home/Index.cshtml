<!-- Interactive Fan Stack Script with Falling Entrance Animation -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const wrapper = document.getElementById('trendingFanStack');
        const section = document.getElementById('trendingSection');
        if (!wrapper) return;

        const cards = Array.from(wrapper.querySelectorAll('.fan-card'));
        const pills = document.querySelectorAll('.fan-pill');
        const prevBtn = document.getElementById('fanPrevBtn');
        const nextBtn = document.getElementById('fanNextBtn');
        const replayBtn = document.getElementById('fanReplayBtn');

        // Dynamic Active Meta Elements
        const metaTitle = document.getElementById('activeBookTitle');
        const metaTitleLink = document.getElementById('activeBookTitleLink');
        const metaAuthor = document.getElementById('activeBookAuthor');
        const metaPrice = document.getElementById('activeBookPrice');
        const metaDetailBtn = document.getElementById('activeBookDetailBtn');
        const metaAddToCartBtn = document.getElementById('activeAddToCartBtn');
        const metaEditionBadge = document.getElementById('activeBookEditionBadge');

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }

        let activeIndex = 0; // Front/center card index

        function updateStackPositions() {
            cards.forEach((card, i) => {
                card.classList.remove('pos-left', 'pos-center', 'pos-right');
                
                const total = cards.length;
                const offset = (i - activeIndex + total) % total;

                if (offset === 0) {
                    card.classList.add('pos-center');

                    // Synchronize Active Meta below the 3D book stack
                    if (metaTitle) metaTitle.textContent = card.dataset.title || '';
                    if (metaTitleLink) metaTitleLink.href = '/Books/Detail/' + card.dataset.id;
                    if (metaAuthor) metaAuthor.textContent = card.dataset.author || '';
                    if (metaPrice) metaPrice.textContent = card.dataset.price || '';
                    if (metaDetailBtn) metaDetailBtn.href = '/Books/Detail/' + card.dataset.id;
                    
                    const count = parseInt(card.dataset.editionCount, 10) || 0;
                    const editionName = card.dataset.editionName || '';
                    const editionId = parseInt(card.dataset.editionId, 10) || 0;
                    const stock = parseInt(card.dataset.stock, 10) || 0;

                    if (metaEditionBadge) {
                        if (count > 1 && editionName) {
                            metaEditionBadge.innerHTML = `
                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-brand-surface text-brand-ink border border-brand-border/80 shadow-2xs">
                                    <span class="text-amber-500">★</span> Bestseller Edition: <span class="text-brand-accent font-bold">${escapeHtml(editionName)}</span>
                                </span>
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-medium bg-brand-bg text-brand-inkLight border border-brand-border/60">
                                    ${count} Editions Available
                                </span>
                            `;
                        } else if (count === 1 && editionName) {
                            metaEditionBadge.innerHTML = `
                                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-brand-surface text-brand-inkLight border border-brand-border/60">
                                    ${escapeHtml(editionName)}
                                </span>
                            `;
                        } else {
                            metaEditionBadge.innerHTML = '';
                        }
                    }

                    if (metaAddToCartBtn) {
                        if (stock <= 0 && editionId > 0) {
                            metaAddToCartBtn.textContent = 'Out of Stock';
                            metaAddToCartBtn.disabled = true;
                            metaAddToCartBtn.className = 'px-4 py-2 rounded-full bg-red-50 text-red-500 border border-red-200 text-xs font-semibold font-body cursor-not-allowed opacity-80';
                            metaAddToCartBtn.onclick = null;
                        } else {
                            metaAddToCartBtn.textContent = 'Add to Cart';
                            metaAddToCartBtn.disabled = false;
                            metaAddToCartBtn.className = 'px-4 py-2 rounded-full bg-brand-surface hover:bg-brand-accent hover:text-white border border-brand-border/80 text-brand-ink text-xs font-semibold font-body transition-colors shadow-2xs cursor-pointer';
                            metaAddToCartBtn.onclick = function(e) {
                                if (editionId > 0) {
                                    window.addToCartDirect({
                                        bookId: parseInt(card.dataset.id, 10),
                                        bookEditionId: editionId,
                                        title: card.dataset.title,
                                        editionName: card.dataset.editionName,
                                        publisher: card.dataset.publisher || '',
                                        price: parseFloat(card.dataset.rawPrice) || 0,
                                        coverImageUrl: card.dataset.cover || '',
                                        stockQuantity: stock
                                    }, e);
                                } else {
                                    window.handleAddToCart(card.dataset.id, e);
                                }
                            };
                        }
                    }
                } else if (offset === 1) {
                    card.classList.add('pos-right');
                } else {
                    card.classList.add('pos-left');
                }
            });

            // Update indicator pills
            pills.forEach((pill, i) => {
                if (i === activeIndex) {
                    pill.classList.add('bg-brand-ink', 'text-brand-bg', 'shadow-xs');
                    pill.classList.remove('text-brand-inkLight');
                } else {
                    pill.classList.remove('bg-brand-ink', 'text-brand-bg', 'shadow-xs');
                    pill.classList.add('text-brand-inkLight');
                }
            });
        }

        // Trigger Falling Drop Animation from Above
        function triggerDropAnimation() {
            wrapper.classList.remove('is-settled');
            wrapper.classList.remove('is-animating');
            
            // Force browser reflow to reset keyframe animation
            void wrapper.offsetWidth;
            
            updateStackPositions();
            wrapper.classList.add('is-animating');

            // After animation completes, mark as settled for hover and click physics
            setTimeout(() => {
                wrapper.classList.remove('is-animating');
                wrapper.classList.add('is-settled');
            }, 1400);
        }

        // Trigger on Scroll Viewport Entry
        let hasAnimated = false;
        if ('IntersectionObserver' in window && section) {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting && !hasAnimated) {
                        hasAnimated = true;
                        triggerDropAnimation();
                    }
                });
            }, { threshold: 0.2 });
            observer.observe(section);
        } else {
            triggerDropAnimation();
        }

        // Card Click Interaction
        cards.forEach((card, index) => {
            card.addEventListener('click', function(e) {
                // If clicking center book, navigate to detail
                if (card.classList.contains('pos-center')) {
                    window.location.href = '/Books/Detail/' + card.dataset.id;
                    return;
                }
                e.preventDefault();
                activeIndex = index;
                updateStackPositions();
            });
        });

        pills.forEach((pill, index) => {
            pill.addEventListener('click', function() {
                activeIndex = index;
                updateStackPositions();
            });
        });

        if (prevBtn) {
            prevBtn.addEventListener('click', function() {
                activeIndex = (activeIndex - 1 + cards.length) % cards.length;
                updateStackPositions();
            });
        }

        if (nextBtn) {
            nextBtn.addEventListener('click', function() {
                activeIndex = (activeIndex + 1) % cards.length;
                updateStackPositions();
            });
        }

        if (replayBtn) {
            replayBtn.addEventListener('click', function() {
                triggerDropAnimation();
            });
        }
    });
</script>

