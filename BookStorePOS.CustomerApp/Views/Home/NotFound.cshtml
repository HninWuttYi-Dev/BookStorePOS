@{
    ViewData["Title"] = "404 - Page Not Found";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="py-12 md:py-16 flex flex-col items-center justify-center">
    <!-- GitHub-Inspired Hero Stage (Aligned with Babylon BookStore Literary UI) -->
    <div class="w-full max-w-4xl bg-gradient-to-br from-brand-surface via-[#EDE7DC] to-[#E3D9C6] rounded-3xl p-8 sm:p-12 md:p-14 shadow-sm border border-brand-border relative overflow-hidden flex flex-col md:flex-row items-center justify-between gap-8 md:gap-12">
        
        <!-- Subtle Vintage Paper Atmosphere -->
        <div class="absolute -top-24 -left-24 w-72 h-72 bg-brand-accent/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -right-24 w-72 h-72 bg-brand-accent/10 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Left: 404 + Speech Bubble + Action -->
        <div class="flex flex-col items-center md:items-start text-center md:text-left z-10 max-w-sm">
            <!-- Large Editorial 404 -->
            <div class="font-heading text-7xl sm:text-8xl md:text-9xl font-black text-brand-ink tracking-tight leading-none drop-shadow-xs select-none">
                404
            </div>

            <!-- Speech Bubble (pointing towards mascot) -->
            <div class="mt-4 relative bg-brand-bg text-brand-ink px-6 py-4 rounded-2xl font-heading font-bold text-base sm:text-lg shadow-xs border border-brand-border max-w-xs">
                This is not the page you are looking for.
                <!-- Pointer right on desktop -->
                <div class="hidden md:block absolute -right-3 top-1/2 -translate-y-1/2 w-0 h-0 border-y-8 border-y-transparent border-l-[12px] border-l-brand-bg"></div>
                <!-- Pointer bottom on mobile -->
                <div class="md:hidden absolute -bottom-3 left-1/2 -translate-x-1/2 w-0 h-0 border-x-8 border-x-transparent border-t-[12px] border-t-brand-bg"></div>
            </div>

            <!-- Action CTA -->
            <div class="mt-8 flex items-center gap-3">
                <a href="/" class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-brand-ink hover:bg-brand-accent text-brand-bg font-medium text-sm transition-all shadow-sm hover:shadow hover:-translate-y-0.5">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                    </svg>
                    <span>Return to Homepage</span>
                </a>
            </div>
        </div>

        <!-- Right: Charming Book Mascot Illustration -->
        <div class="w-full max-w-[280px] sm:max-w-[340px] flex items-center justify-center z-10 shrink-0">
            <svg class="w-full h-auto drop-shadow-md" viewBox="0 0 320 250" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- Ground Shadow -->
                <ellipse cx="160" cy="230" rx="115" ry="12" fill="#2C2621" fill-opacity="0.12"/>

                <!-- Antique Book Stack Base -->
                <rect x="50" y="206" width="220" height="18" rx="4" fill="#8C6F45"/>
                <rect x="54" y="209" width="212" height="4" rx="2" fill="#F4F1EA"/>
                <rect x="65" y="190" width="190" height="17" rx="4" fill="#2C2621"/>
                <rect x="68" y="193" width="184" height="4" rx="2" fill="#F4F1EA"/>

                <!-- The Book Character / Mascot -->
                <!-- Leather Cover Backing -->
                <path d="M100 86 Q160 98 220 86 L226 182 Q160 196 94 182 Z" fill="#8C6F45"/>
                <!-- Open Parchment Pages Left & Right -->
                <path d="M160 102 Q125 96 102 92 L98 178 Q125 186 160 192 Z" fill="#FDFBF7" stroke="#E2DCD0" stroke-width="2"/>
                <path d="M160 102 Q195 96 218 92 L222 178 Q195 186 160 192 Z" fill="#F4F1EA" stroke="#E2DCD0" stroke-width="2"/>
                <!-- Spine center line -->
                <line x1="160" y1="100" x2="160" y2="192" stroke="#8C6F45" stroke-width="3"/>

                <!-- Cute Scholarly Glasses on Book -->
                <circle cx="132" cy="136" r="14" fill="#FDFBF7" stroke="#2C2621" stroke-width="3"/>
                <circle cx="188" cy="136" r="14" fill="#FDFBF7" stroke="#2C2621" stroke-width="3"/>
                <path d="M146 134 Q160 130 174 134" stroke="#2C2621" stroke-width="3" fill="none"/>
                <!-- Glasses Bridge & Arms -->
                <path d="M118 134 L106 130" stroke="#2C2621" stroke-width="2.5" stroke-linecap="round"/>
                <path d="M202 134 L214 130" stroke="#2C2621" stroke-width="2.5" stroke-linecap="round"/>

                <!-- Big Curious Eyes Inside Glasses -->
                <circle cx="134" cy="136" r="6" fill="#2C2621"/>
                <circle cx="136" cy="134" r="2" fill="#ffffff"/>
                <circle cx="186" cy="136" r="6" fill="#2C2621"/>
                <circle cx="188" cy="134" r="2" fill="#ffffff"/>

                <!-- Happy Little Smile -->
                <path d="M152 154 Q160 162 168 154" stroke="#8C6F45" stroke-width="3" stroke-linecap="round" fill="none"/>
                <!-- Rosy Cheeks -->
                <circle cx="120" cy="148" r="4" fill="#8C6F45" fill-opacity="0.3"/>
                <circle cx="200" cy="148" r="4" fill="#8C6F45" fill-opacity="0.3"/>

                <!-- Ribbon Bookmark Hanging Down -->
                <path d="M156 190 Q156 215 148 226 L158 222 L166 226 Q162 215 162 190 Z" fill="#8A3324"/>

                <!-- Floating Little Ink Stars / Constellations -->
                <path d="M96 60 L98 66 L104 68 L98 70 L96 76 L94 70 L88 68 L94 66 Z" fill="#8C6F45"/>
                <path d="M226 64 L227.5 68.5 L232 70 L227.5 71.5 L226 76 L224.5 71.5 L220 70 L224.5 68.5 Z" fill="#8C6F45" fill-opacity="0.75"/>
                <circle cx="160" cy="50" r="3" fill="#8C6F45" fill-opacity="0.6"/>
                <circle cx="240" cy="100" r="2.5" fill="#8C6F45" fill-opacity="0.5"/>
            </svg>
        </div>
    </div>

    <!-- Minimal Back Option -->
    <div class="mt-6 text-center">
        <button type="button" onclick="window.history.length > 1 ? window.history.back() : window.location.href='/'" class="text-xs text-brand-inkLight/70 hover:text-brand-ink font-body transition-colors inline-flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            <span>Or return to the previous page</span>
        </button>
    </div>
</div>
