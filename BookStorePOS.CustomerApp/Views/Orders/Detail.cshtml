@using BookStorePOS.Shared.Models.Order
@{
    ViewData["Title"] = "Order Details";
    var order = ViewData["Order"] as OrderModel;
    if (order == null) return;

    string FormatOrderNo(int id, DateTime? date)
    {
        var d = date ?? DateTime.Now;
        return $"C{d.ToString("yyMMdd")}{id.ToString("0000")}";
    }

    string FormatOrderDate(DateTime? date)
    {
        if (!date.HasValue) return "-";
        return date.Value.ToString("dd MMMM yyyy, hh:mm tt");
    }

    var orderNo = FormatOrderNo(order.OrderId, order.OrderDate);
}

<div class="py-4 sm:py-8 max-w-5xl mx-auto space-y-6">
    <!-- Back to Orders Navigation -->
    <div class="flex items-center">
        <a href="/Orders" class="inline-flex items-center gap-2 text-xs sm:text-sm font-semibold text-brand-inkLight hover:text-brand-accent transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            <span>Back to My Orders</span>
        </a>
    </div>

    <!-- Status Overview Header Card -->
    <div class="bg-brand-surface rounded-3xl border border-brand-border/80 p-6 sm:p-8 shadow-xs">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
                <span class="text-xs uppercase tracking-widest font-bold text-brand-accent">Order Summary</span>
                <h1 class="text-2xl sm:text-3xl font-heading font-bold text-brand-ink mt-0.5">Order #@orderNo</h1>
                <p class="text-xs sm:text-sm text-brand-inkLight mt-1">Placed on @FormatOrderDate(order.OrderDate)</p>
            </div>
            <div>
                @if (order.OrderStatus == OrderStatus.Pending)
                {
                    <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs sm:text-sm font-bold bg-amber-50 text-amber-800 border border-amber-200">
                        <span class="w-2.5 h-2.5 rounded-full bg-amber-500 animate-pulse"></span>
                        Awaiting Verification
                    </span>
                }
                else if (order.OrderStatus == OrderStatus.Completed)
                {
                    <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs sm:text-sm font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
                        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                        Verified & Confirmed
                    </span>
                }
                else if (order.OrderStatus == OrderStatus.Rejected)
                {
                    <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs sm:text-sm font-bold bg-rose-50 text-rose-800 border border-rose-200">
                        <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span>
                        Order Rejected
                    </span>
                }
                else
                {
                    <span class="inline-flex items-center px-4 py-1.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200">
                        @order.OrderStatus
                    </span>
                }
            </div>
        </div>

        <!-- Rejection Notice Banner -->
        @if (order.OrderStatus == OrderStatus.Rejected && !string.IsNullOrWhiteSpace(order.RejectReason))
        {
            <div class="mt-6 p-4 rounded-2xl bg-rose-50/90 border border-rose-200 text-xs sm:text-sm text-rose-800 flex items-start gap-3">
                <svg class="w-5 h-5 text-rose-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                <div>
                    <h4 class="font-bold text-rose-900 mb-0.5">Note from Bookstore Administrator:</h4>
                    <p class="text-rose-700 leading-relaxed">@order.RejectReason</p>
                </div>
            </div>
        }
    </div>

    <!-- Details Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <!-- Left: Itemized Book Editions (7 Cols) -->
        <div class="lg:col-span-7 bg-white rounded-3xl border border-brand-border/80 p-6 sm:p-8 shadow-xs">
            <h3 class="font-heading text-lg font-bold text-brand-ink pb-3 border-b border-brand-border/70 mb-4">
                Purchased Editions
            </h3>

            @if (order.Items != null && order.Items.Any())
            {
                <div class="divide-y divide-brand-border/50">
                    @foreach (var item in order.Items)
                    {
                        var subtotal = item.Subtotal ?? (item.Quantity * item.UnitPrice);
                        <div class="py-4 first:pt-0 last:pb-0 flex items-center justify-between gap-4">
                            <div class="flex-1 min-w-0">
                                <h4 class="font-heading font-bold text-sm sm:text-base text-brand-ink truncate">
                                    @(item.BookTitle ?? "Untitled Book")
                                </h4>
                                <div class="flex items-center gap-2 mt-1">
                                    <span class="text-xs text-brand-inkLight bg-brand-surface px-2 py-0.5 rounded border border-brand-border/60">
                                        @(item.EditionName ?? "Standard Edition")
                                    </span>
                                    <span class="text-xs text-brand-inkLight">
                                        Qty: <strong class="text-brand-ink">@item.Quantity</strong> &times; @item.UnitPrice.ToString("N0") MMK
                                    </span>
                                </div>
                            </div>
                            <div class="text-right shrink-0 text-sm font-bold text-brand-ink font-heading">
                                @subtotal.ToString("N0") <span class="text-xs text-brand-accent font-body">MMK</span>
                            </div>
                        </div>
                    }
                </div>

                <div class="mt-6 pt-5 border-t border-brand-border/70 space-y-2 text-xs sm:text-sm">
                    <div class="flex justify-between items-center text-brand-inkLight">
                        <span>Total Quantity</span>
                        <span class="font-semibold text-brand-ink">@order.TotalQuantity @(order.TotalQuantity == 1 ? "book" : "books")</span>
                    </div>
                    <div class="flex justify-between items-baseline pt-2 border-t border-brand-border/40">
                        <span class="font-heading font-bold text-base text-brand-ink">Grand Total</span>
                        <div class="text-right">
                            <span class="font-heading font-bold text-2xl text-brand-ink">@order.TotalPrice.ToString("N0")</span>
                            <span class="text-xs font-semibold text-brand-accent ml-1">MMK</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Right: Shipping & Payment Information (5 Cols) -->
        <div class="lg:col-span-5 space-y-6">
            <!-- Shipping Card -->
            <div class="bg-white rounded-3xl border border-brand-border/80 p-6 shadow-xs space-y-3">
                <div class="flex items-center gap-2 pb-2 border-b border-brand-border/60 text-xs font-bold uppercase tracking-wider text-brand-accent">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    <span>Delivery Details</span>
                </div>
                <div class="space-y-1.5 text-xs text-brand-inkLight">
                    <div>Recipient: <strong class="text-brand-ink">@(order.CustomerName ?? "Customer")</strong></div>
                    <div>Phone: <strong class="text-brand-ink">@(order.CustomerPhone ?? "Not provided")</strong></div>
                    <div>Address: <span class="font-medium text-brand-ink">@(order.ShippingAddress ?? "Standard Delivery")</span></div>
                    @if (!string.IsNullOrWhiteSpace(order.Notes))
                    {
                        <div class="pt-1 text-[11px] italic text-brand-inkLight">Notes: "@order.Notes"</div>
                    }
                </div>
            </div>

            <!-- Payment Card -->
            <div class="bg-white rounded-3xl border border-brand-border/80 p-6 shadow-xs space-y-3">
                <div class="flex items-center gap-2 pb-2 border-b border-brand-border/60 text-xs font-bold uppercase tracking-wider text-brand-accent">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
                    <span>Payment Information</span>
                </div>
                <div class="space-y-1.5 text-xs text-brand-inkLight">
                    <div>Method: <strong class="text-brand-ink">@(string.IsNullOrWhiteSpace(order.PaymentMethod) ? "Online Transfer" : order.PaymentMethod)</strong></div>
                    <div>
                        Payment Status: 
                        @if (order.PaymentStatus == PaymentStatus.Verified)
                        {
                            <span class="font-bold text-emerald-700">Verified</span>
                        }
                        else if (order.PaymentStatus == PaymentStatus.Submitted)
                        {
                            <span class="font-bold text-blue-700">Slip Submitted</span>
                        }
                        else if (order.PaymentStatus == PaymentStatus.Rejected)
                        {
                            <span class="font-bold text-rose-700">Slip Declined</span>
                        }
                        else
                        {
                            <span class="font-bold text-amber-700">Unpaid</span>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(order.PaymentScreenshotUrl))
                {
                    <div class="pt-3 border-t border-brand-border/60">
                        <span class="text-[11px] font-semibold text-brand-inkLight block mb-2">Uploaded Transfer Slip:</span>
                        <a href="@order.PaymentScreenshotUrl" target="_blank" rel="noopener noreferrer" class="group relative block rounded-2xl overflow-hidden border border-brand-border shadow-2xs hover:border-brand-accent transition-all">
                            <img src="@order.PaymentScreenshotUrl" alt="Payment Transfer Slip" class="w-full max-h-48 object-cover group-hover:scale-105 transition-transform duration-300" />
                            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white text-xs font-bold gap-1.5">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                                <span>View Full Image</span>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

