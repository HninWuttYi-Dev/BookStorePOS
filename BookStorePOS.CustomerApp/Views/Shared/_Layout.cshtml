<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Babylon BookStore</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Elegant Typography -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&family=Noto+Sans+Myanmar:wght@400;500;600&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            bg: '#FDFBF7',         
                            surface: '#F4F1EA',    
                            border: '#E2DCD0',     
                            ink: '#2C2621',        
                            inkLight: '#59534E',   
                            accent: '#8C6F45',     
                            accentHover: '#705734',
                            danger: '#8A3324'      
                        }
                    },
                    fontFamily: {
                        heading: ['"Playfair Display"', 'serif'],
                        body: ['"Inter"', '"Noto Sans Myanmar"', '"Pyidaungsu"', 'sans-serif'],
                        serif: ['"Playfair Display"', 'serif'],
                        sans: ['"Inter"', '"Noto Sans Myanmar"', '"Pyidaungsu"', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    
    <style>
        body {
            background-color: theme('colors.brand.bg');
            color: theme('colors.brand.ink');
            font-family: theme('fontFamily.body');
        }
        h1, h2, h3, h4, h5, h6, .font-heading {
            font-family: theme('fontFamily.heading');
        }
    </style>
</head>
<body class="min-h-screen flex flex-col">

    @{
        var rawPath = Context.Request.Path.Value?.TrimEnd('/')?.ToLower() ?? "";
        var currentController = ViewContext.RouteData.Values["Controller"]?.ToString()?.ToLower() ?? "";
        var currentAction = ViewContext.RouteData.Values["Action"]?.ToString()?.ToLower() ?? "";

        bool isHome = string.IsNullOrEmpty(rawPath) || rawPath == "/home" || (currentController == "home" && currentAction == "index");
        bool isBrowse = rawPath == "/books" || rawPath.StartsWith("/books/") || (currentController == "books" && rawPath != "/authors" && rawPath != "/genres");
        bool isAuthors = rawPath == "/authors" || rawPath.StartsWith("/authors/") || currentController == "authors" || currentController == "author";
        bool isGenres = rawPath == "/genres" || rawPath.StartsWith("/genres/") || currentController == "genres" || currentController == "genre";

        bool isCustomerAuth = !string.IsNullOrEmpty(Context.Request.Cookies["customer_token"]) ||
                              !string.IsNullOrEmpty(Context.Request.Cookies["customer_user"]);
        string serverCustomerUser = Context.Request.Cookies["customer_user"] ?? "";
        if (!string.IsNullOrEmpty(serverCustomerUser))
        {
            try { serverCustomerUser = Uri.UnescapeDataString(serverCustomerUser); } catch { }
            serverCustomerUser = serverCustomerUser.Replace("%20", " ").Replace("+", " ").Trim();
        }
        else
        {
            serverCustomerUser = "Customer";
        }
        var userWords = serverCustomerUser.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        string serverInitials = userWords.Length >= 2 
            ? $"{userWords[0][0]}{userWords[^1][0]}".ToUpper() 
            : (serverCustomerUser.Length >= 2 ? serverCustomerUser.Substring(0, 2).ToUpper() : serverCustomerUser.ToUpper());
    }

    <header class="bg-brand-surface border-b border-brand-border shadow-sm sticky top-0 z-50">
        <!-- Desktop & Mobile Container -->
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center h-20">
            
            <!-- Logo -->
            <a href="/" class="text-3xl font-heading font-bold text-brand-ink flex items-center gap-3 shrink-0">
                <svg class="w-8 h-8 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                <span>BABYLON</span>
            </a>

            <!-- Desktop Navigation -->
            <nav class="hidden md:flex items-center gap-1 sm:gap-2 ml-6 lg:ml-10">
                <a href="/" class="group relative py-2 px-3 font-semibold text-base tracking-wider uppercase transition-colors @(isHome ? "text-brand-accent font-bold" : "text-brand-ink hover:text-brand-accent")">
                    <span>Home</span>
                    <span class="absolute bottom-0 left-3 right-3 h-[2.5px] bg-brand-accent rounded-full transition-all duration-200 @(isHome ? "opacity-100" : "opacity-0 group-hover:opacity-40")"></span>
                </a>
                <a href="/Books" class="group relative py-2 px-3 font-semibold text-base tracking-wider uppercase transition-colors @(isBrowse ? "text-brand-accent font-bold" : "text-brand-ink hover:text-brand-accent")">
                    <span>Browse</span>
                    <span class="absolute bottom-0 left-3 right-3 h-[2.5px] bg-brand-accent rounded-full transition-all duration-200 @(isBrowse ? "opacity-100" : "opacity-0 group-hover:opacity-40")"></span>
                </a>
                <a href="/Authors" class="group relative py-2 px-3 font-semibold text-base tracking-wider uppercase transition-colors @(isAuthors ? "text-brand-accent font-bold" : "text-brand-ink hover:text-brand-accent")">
                    <span>Authors</span>
                    <span class="absolute bottom-0 left-3 right-3 h-[2.5px] bg-brand-accent rounded-full transition-all duration-200 @(isAuthors ? "opacity-100" : "opacity-0 group-hover:opacity-40")"></span>
                </a>
                <a href="/Genres" class="group relative py-2 px-3 font-semibold text-base tracking-wider uppercase transition-colors @(isGenres ? "text-brand-accent font-bold" : "text-brand-ink hover:text-brand-accent")">
                    <span>Genres</span>
                    <span class="absolute bottom-0 left-3 right-3 h-[2.5px] bg-brand-accent rounded-full transition-all duration-200 @(isGenres ? "opacity-100" : "opacity-0 group-hover:opacity-40")"></span>
                </a>
            </nav>

            <!-- Search, Cart, Login (Desktop) -->
            <div class="hidden md:flex items-center gap-6 ml-auto">


                <a href="/Cart" class="flex items-center gap-2 text-brand-ink hover:text-brand-accent transition-colors relative">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
                    <span class="font-medium text-sm">Cart</span>
                    <span id="navCartBadge" class="hidden px-2 py-0.5 text-[11px] font-bold rounded-full bg-brand-accent text-white">0</span>
                </a>

                <!-- Customer Realtime Notifications -->
                <button type="button" onclick="window.openCustomerNotifDrawer()" class="relative p-2 text-brand-ink hover:text-brand-accent transition-colors cursor-pointer" title="Notifications">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
                    <span class="customer-notif-badge hidden absolute top-0.5 right-0.5 px-1.5 py-0.2 text-[10px] font-bold text-white bg-red-500 rounded-full min-w-[16px] text-center shadow-xs">0</span>
                </button>

                <!-- Guest State -->
                <a href="/Auth/Login" id="navLoginBtn" class="@(isCustomerAuth ? "hidden " : "")text-brand-bg bg-brand-ink hover:bg-brand-accent px-5 py-2.5 rounded-full transition-all font-medium text-sm shadow-sm hover:shadow">
                    Sign In
                </a>

                <!-- Logged In State: Account Dropdown -->
                <div id="navUserMenu" class="@(isCustomerAuth ? "relative flex " : "hidden ")items-center">
                    <button type="button" id="userMenuToggleBtn" onclick="window.toggleUserMenu(event)" class="group flex items-center gap-2 bg-brand-surface/90 hover:bg-brand-surface border border-brand-border hover:border-brand-accent/50 px-3 py-1.5 rounded-full shadow-xs transition-all cursor-pointer">
                        <span class="w-7 h-7 rounded-full bg-brand-accent text-white flex items-center justify-center font-bold text-xs shadow-xs tracking-wider" id="navUserInitials">@serverInitials</span>
                        <span id="navUsername" class="font-medium text-xs text-brand-ink max-w-[120px] truncate">@serverCustomerUser</span>
                        <svg class="w-3.5 h-3.5 text-brand-inkLight group-hover:text-brand-accent transition-transform duration-200" id="userMenuChevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                    </button>

                    <!-- Dropdown Menu Panel -->
                    <div id="userDropdownPanel" class="hidden absolute right-0 top-full mt-2 w-56 bg-white/95 backdrop-blur-md rounded-2xl border border-brand-border shadow-xl p-1.5 z-50 ring-1 ring-black/5">
                        <div class="px-3 py-2 border-b border-brand-border/60">
                            <p class="text-[10px] font-bold uppercase tracking-wider text-brand-inkLight">Signed in as</p>
                            <p class="text-xs font-bold text-brand-ink truncate mt-0.5" id="dropdownUsername">@serverCustomerUser</p>
                        </div>

                        <div class="py-1">
                            <a href="/Orders" class="flex items-center gap-2.5 px-3 py-2 text-xs font-semibold text-brand-ink hover:text-brand-accent hover:bg-brand-surface rounded-xl transition-colors">
                                <svg class="w-4 h-4 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
                                </svg>
                                <span>My Orders</span>
                            </a>
                        </div>

                        <div class="pt-1 border-t border-brand-border/60">
                            <button type="button" onclick="window.closeUserMenu(); window.openLogoutConfirmModal()" class="w-full flex items-center gap-2.5 px-3 py-2 text-xs font-semibold text-rose-700 hover:text-white hover:bg-rose-600 rounded-xl transition-colors text-left cursor-pointer">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                                </svg>
                                <span>Sign Out</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mobile Cart, Notifications & Toggle -->
            <div class="flex md:hidden items-center gap-3">
                <button type="button" onclick="window.openCustomerNotifDrawer()" class="text-brand-ink hover:text-brand-accent transition-colors relative p-1" title="Notifications">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
                    <span class="customer-notif-badge hidden absolute -top-1 -right-1 px-1.5 py-0.2 text-[10px] font-bold rounded-full bg-red-500 text-white min-w-[16px] text-center shadow-xs">0</span>
                </button>
                <a href="/Cart" class="text-brand-ink hover:text-brand-accent transition-colors relative">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
                    <span id="mobileCartBadge" class="hidden absolute -top-1 -right-2 px-1.5 py-0.2 text-[10px] font-bold rounded-full bg-brand-accent text-white">0</span>
                </a>
                <button id="mobileMenuBtn" class="text-brand-ink hover:text-brand-accent focus:outline-none" aria-label="Toggle menu">
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path id="menuIcon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </button>
            </div>
        </div>
        
        <!-- Mobile Drawer / Menu -->
        <div id="mobileMenu" class="hidden md:hidden bg-brand-surface border-t border-brand-border absolute w-full left-0 shadow-lg">
            <div class="flex flex-col px-6 py-4 gap-3">
                <a href="/" class="flex items-center justify-between font-medium text-base tracking-wide uppercase py-2.5 transition-colors @(isHome ? "text-brand-accent font-bold border-b-2 border-brand-accent" : "text-brand-ink border-b border-brand-border/50 hover:text-brand-accent")">
                    <span>Home</span>
                    @if (isHome) { <span class="w-1.5 h-1.5 rounded-full bg-brand-accent"></span> }
                </a>
                <a href="/Books" class="flex items-center justify-between font-medium text-base tracking-wide uppercase py-2.5 transition-colors @(isBrowse ? "text-brand-accent font-bold border-b-2 border-brand-accent" : "text-brand-ink border-b border-brand-border/50 hover:text-brand-accent")">
                    <span>Browse</span>
                    @if (isBrowse) { <span class="w-1.5 h-1.5 rounded-full bg-brand-accent"></span> }
                </a>
                <a href="/Authors" class="flex items-center justify-between font-medium text-base tracking-wide uppercase py-2.5 transition-colors @(isAuthors ? "text-brand-accent font-bold border-b-2 border-brand-accent" : "text-brand-ink border-b border-brand-border/50 hover:text-brand-accent")">
                    <span>Authors</span>
                    @if (isAuthors) { <span class="w-1.5 h-1.5 rounded-full bg-brand-accent"></span> }
                </a>
                <a href="/Genres" class="flex items-center justify-between font-medium text-base tracking-wide uppercase py-2.5 transition-colors @(isGenres ? "text-brand-accent font-bold border-b-2 border-brand-accent" : "text-brand-ink border-b border-brand-border/50 hover:text-brand-accent")">
                    <span>Genres</span>
                    @if (isGenres) { <span class="w-1.5 h-1.5 rounded-full bg-brand-accent"></span> }
                </a>
                <a href="/Cart" class="text-brand-ink font-medium text-base tracking-wide uppercase py-2.5 border-b border-brand-border/50 hover:text-brand-accent">Cart</a>
                
                <!-- Guest Mobile -->
                <a href="/Auth/Login" id="mobileLoginBtn" class="@(isCustomerAuth ? "hidden " : "")text-center mt-2 text-brand-bg bg-brand-ink hover:bg-brand-accent px-5 py-3 rounded-xl transition-colors font-medium text-base w-full shadow-sm">
                    Sign In
                </a>

                <!-- Logged In Mobile (Upgraded Modern UI) -->
                <div id="mobileUserMenu" class="@(isCustomerAuth ? "flex " : "hidden ")flex-col gap-2.5 pt-3 border-t border-brand-border/60">
                    <div class="flex items-center gap-3 bg-brand-bg border border-brand-border p-3 rounded-xl">
                        <span class="w-10 h-10 rounded-full bg-brand-accent text-white flex items-center justify-center font-bold text-xs tracking-wider shrink-0 shadow-xs" id="mobileUserInitials">@serverInitials</span>
                        <div class="flex flex-col min-w-0">
                            <span class="text-[11px] text-brand-inkLight uppercase tracking-wider font-semibold">Signed in as</span>
                            <span id="mobileUsername" class="text-sm font-bold text-brand-ink truncate">@serverCustomerUser</span>
                        </div>
                    </div>
                    <a href="/Orders" class="flex items-center gap-2.5 px-4 py-2.5 text-sm font-semibold text-brand-ink hover:text-brand-accent bg-brand-surface border border-brand-border rounded-xl transition-colors">
                        <svg class="w-4 h-4 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
                        </svg>
                        <span>My Orders</span>
                    </a>
                    <button type="button" onclick="window.openLogoutConfirmModal()" class="flex items-center justify-center gap-2 text-rose-700 bg-rose-50 hover:bg-rose-600 hover:text-white border border-rose-200 hover:border-rose-600 px-4 py-2.5 rounded-xl text-sm font-semibold transition-all shadow-xs w-full cursor-pointer">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                        </svg>
                        <span>Sign Out</span>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <main class="flex-1 w-full @(isHome ? "" : "max-w-7xl mx-auto px-6 py-12")">
        @RenderBody()
    </main>

    <footer class="bg-brand-ink text-brand-bg py-12 px-8 mt-auto border-t-4 border-brand-accent">
        <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8">
            <div>
                <h3 class="font-heading text-2xl font-bold mb-4 text-brand-surface">Babylon</h3>
                <p class="text-brand-border/80 text-sm leading-relaxed mb-4">
                    Providing timeless classics, rich non-fiction, and captivating stories for the discerning reader. Your ultimate destination for books.
                </p>
            </div>
            <div>
                <h4 class="font-heading text-lg font-semibold mb-4 text-brand-accent">Information</h4>
                <ul class="space-y-2 text-sm text-brand-border/80">
                    <li><a href="#" class="hover:text-brand-surface transition-colors">Shipping & Returns</a></li>
                    <li><a href="#" class="hover:text-brand-surface transition-colors">Privacy Policy</a></li>
                    <li><a href="#" class="hover:text-brand-surface transition-colors">Terms of Service</a></li>
                </ul>
            </div>
            <div>
                <h4 class="font-heading text-lg font-semibold mb-4 text-brand-accent">Newsletter</h4>
                <p class="text-brand-border/80 text-sm mb-4">Subscribe for updates on rare finds and new collections.</p>
                <div class="flex">
                    <input type="email" placeholder="Your email address" class="px-4 py-2 w-full bg-brand-inkLight/30 border border-brand-border/20 rounded-l text-white focus:outline-none focus:border-brand-accent">
                    <button class="bg-brand-accent hover:bg-brand-accentHover text-white px-4 py-2 rounded-r transition-colors">Subscribe</button>
                </div>
            </div>
        </div>
        <div class="max-w-7xl mx-auto mt-12 pt-6 border-t border-brand-inkLight/30 text-center text-xs text-brand-border/60">
            &copy; 2026 Babylon BookStore. All rights reserved.
        </div>
    </footer>

    <!-- Login Required Modal -->
    <dialog id="loginRequiredModal" class="m-auto rounded-3xl p-0 border border-brand-border bg-brand-surface shadow-2xl backdrop:bg-black/60 backdrop:backdrop-blur-xs max-w-md w-[92%] sm:w-full transition-all overflow-hidden">
        <div class="p-6 sm:p-8 text-center relative">
            <!-- Close Button -->
            <button type="button" onclick="window.closeLoginRequiredModal()" class="absolute top-4 right-4 text-brand-inkLight/60 hover:text-brand-ink p-1 rounded-lg transition-colors" aria-label="Close modal">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>

            <!-- Icon -->
            <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-brand-accent/15 border border-brand-accent/30 text-brand-accent flex items-center justify-center shadow-xs">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                </svg>
            </div>
            
            <h3 class="font-heading text-2xl font-bold text-brand-ink mb-2">Sign in to Add to Cart</h3>
            <p class="text-sm text-brand-inkLight leading-relaxed mb-6 font-body">
                Please sign in to your Babylon BookStore account or create a new account to add books to your shopping cart and place orders.
            </p>

            <div class="space-y-3">
                <a id="modalLoginBtn" href="/Auth/Login" class="w-full inline-flex items-center justify-center gap-2 bg-brand-ink hover:bg-brand-accent text-brand-bg font-medium py-3 px-5 rounded-xl transition-all shadow-sm text-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
                    </svg>
                    <span>Sign In</span>
                </a>
                
                <a id="modalRegisterBtn" href="/Auth/Register" class="w-full inline-flex items-center justify-center gap-2 bg-brand-bg hover:bg-brand-surface text-brand-ink font-medium py-3 px-5 rounded-xl border border-brand-border transition-all text-sm shadow-2xs">
                    <span>Create a New Account</span>
                </a>
                
                <button type="button" onclick="window.closeLoginRequiredModal()" class="w-full text-xs text-brand-inkLight/80 hover:text-brand-ink py-2 transition-colors">
                    Continue Browsing Books
                </button>
            </div>
        </div>
    </dialog>

    <!-- Logout Confirmation Modal -->
    <dialog id="logoutConfirmModal" class="m-auto rounded-3xl p-0 border border-brand-border bg-brand-surface shadow-2xl backdrop:bg-slate-900/60 backdrop:backdrop-blur-sm max-w-md w-[92%] sm:w-full transition-all overflow-hidden" aria-labelledby="logoutModalTitle" aria-describedby="logoutModalDesc">
        <div class="p-6 sm:p-8 text-center relative">
            <!-- Close Button -->
            <button type="button" onclick="window.closeLogoutConfirmModal()" class="absolute top-4 right-4 text-brand-inkLight/60 hover:text-brand-ink p-1.5 rounded-xl hover:bg-brand-bg transition-colors" aria-label="Close modal">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>

            <!-- Warning / Sign Out Icon -->
            <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-600 flex items-center justify-center shadow-xs">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                </svg>
            </div>
            
            <h3 id="logoutModalTitle" class="font-heading text-2xl font-bold text-brand-ink mb-2">Confirm Sign Out</h3>
            <p id="logoutModalDesc" class="text-sm text-brand-inkLight leading-relaxed mb-6 font-body">
                Are you sure you want to sign out of Babylon BookStore? You will need to sign in again with your phone number to access your account and cart.
            </p>

            <div class="flex flex-col sm:flex-row gap-3">
                <button type="button" onclick="window.closeLogoutConfirmModal()" class="w-full order-2 sm:order-1 inline-flex items-center justify-center py-2.5 px-5 rounded-xl border border-brand-border bg-brand-bg hover:bg-brand-border/30 text-brand-ink font-semibold text-sm transition-all shadow-xs cursor-pointer">
                    Cancel
                </button>
                <button type="button" onclick="window.performCustomerSignOut()" class="w-full order-1 sm:order-2 inline-flex items-center justify-center gap-2 bg-rose-600 hover:bg-rose-700 text-white font-semibold py-2.5 px-5 rounded-xl transition-all shadow-sm text-sm cursor-pointer">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                    </svg>
                    <span>Yes, Sign Out</span>
                </button>
            </div>
        </div>
    </dialog>

    <!-- Customer Clear Notifications Confirmation Modal -->
    <dialog id="customerClearNotifModal" class="m-auto rounded-3xl p-0 border border-brand-border bg-brand-surface shadow-2xl backdrop:bg-black/60 backdrop:backdrop-blur-xs max-w-md w-[92%] sm:w-full transition-all overflow-hidden" aria-labelledby="custClearNotifTitle" aria-describedby="custClearNotifDesc">
        <div class="p-6 sm:p-8 text-center relative">
            <button type="button" onclick="window.closeCustomerClearNotifModal()" class="absolute top-4 right-4 text-brand-inkLight/60 hover:text-brand-ink p-1.5 rounded-xl hover:bg-brand-bg transition-colors cursor-pointer" aria-label="Close modal">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>

            <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-600 flex items-center justify-center shadow-xs">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                </svg>
            </div>
            
            <h3 id="custClearNotifTitle" class="font-heading text-2xl font-bold text-brand-ink mb-2">Clear Notifications?</h3>
            <p id="custClearNotifDesc" class="text-sm text-brand-inkLight leading-relaxed mb-6 font-body">
                Are you sure you want to clear your notification history? This action cannot be undone.
            </p>

            <div class="flex flex-col sm:flex-row gap-3">
                <button type="button" onclick="window.closeCustomerClearNotifModal()" class="w-full order-2 sm:order-1 inline-flex items-center justify-center py-2.5 px-5 rounded-xl border border-brand-border bg-brand-bg hover:bg-brand-border/30 text-brand-ink font-semibold text-sm transition-all shadow-xs cursor-pointer">
                    Cancel
                </button>
                <button type="button" onclick="window.confirmClearCustomerNotifs()" class="w-full order-1 sm:order-2 inline-flex items-center justify-center gap-2 bg-rose-600 hover:bg-rose-700 text-white font-semibold py-2.5 px-5 rounded-xl transition-all shadow-sm text-sm cursor-pointer">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                    </svg>
                    <span>Clear All</span>
                </button>
            </div>
        </div>
    </dialog>

    <!-- Customer Announcement Detail Modal -->
    <dialog id="customerAnnouncementModal" class="m-auto rounded-3xl p-0 border border-brand-border bg-brand-surface shadow-2xl backdrop:bg-black/60 backdrop:backdrop-blur-xs max-w-lg w-[92%] sm:w-full transition-all overflow-hidden" aria-labelledby="custAnnTitle">
        <div class="p-6 sm:p-8 relative">
            <button type="button" onclick="window.closeCustomerAnnouncementModal()" class="absolute top-4 right-4 text-brand-inkLight/60 hover:text-brand-ink p-1.5 rounded-xl hover:bg-brand-bg transition-colors cursor-pointer" aria-label="Close modal">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>

            <div class="flex items-center gap-3 mb-4">
                <div class="w-12 h-12 rounded-2xl bg-[#F4F1EA] border border-[#E2DCD0] text-[#8C6F45] flex items-center justify-center shrink-0 shadow-2xs">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/>
                    </svg>
                </div>
                <div>
                    <span class="text-[10px] font-bold tracking-widest uppercase text-brand-accent bg-[#F4F1EA] px-2.5 py-1 rounded-full border border-brand-border">Store Announcement</span>
                    <p id="custAnnDate" class="text-xs text-stone-400 mt-1">-</p>
                </div>
            </div>

            <h3 id="custAnnTitle" class="font-heading text-xl font-bold text-brand-ink mb-3 leading-snug"></h3>
            <div id="custAnnContent" class="text-sm text-stone-600 leading-relaxed bg-[#F4F1EA]/60 p-4 rounded-2xl border border-brand-border max-h-60 overflow-y-auto whitespace-pre-wrap font-body"></div>

            <div class="mt-6 flex items-center justify-between gap-3">
                <a href="/Book" class="py-2.5 px-5 rounded-xl bg-brand-accent hover:bg-brand-accentHover text-white font-semibold text-xs transition-all shadow-xs inline-flex items-center gap-1.5">
                    <span>Browse Books</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </a>
                <button type="button" onclick="window.closeCustomerAnnouncementModal()" class="py-2.5 px-5 rounded-xl border border-brand-border bg-brand-bg hover:bg-brand-border/30 text-brand-ink font-semibold text-xs transition-all cursor-pointer">
                    Close
                </button>
            </div>
        </div>
    </dialog>

    <script>
        window.openCustomerClearNotifModal = function() {
            const modal = document.getElementById('customerClearNotifModal');
            if (!modal) return;
            if (typeof modal.showModal === 'function') {
                modal.showModal();
            } else {
                modal.setAttribute('open', '');
            }
        };

        window.closeCustomerClearNotifModal = function() {
            const modal = document.getElementById('customerClearNotifModal');
            if (!modal) return;
            if (typeof modal.close === 'function') {
                modal.close();
            } else {
                modal.removeAttribute('open');
            }
        };

        window.openCustomerAnnouncementModal = function(title, content, dateStr) {
            const modal = document.getElementById('customerAnnouncementModal');
            if (!modal) return;
            const titleEl = document.getElementById('custAnnTitle');
            const contentEl = document.getElementById('custAnnContent');
            const dateEl = document.getElementById('custAnnDate');
            if (titleEl) titleEl.textContent = title || 'Store Announcement';
            if (contentEl) contentEl.textContent = content || '';
            if (dateEl) {
                const d = dateStr ? new Date(dateStr) : new Date();
                dateEl.textContent = isNaN(d.getTime()) ? 'Just now' : d.toLocaleString();
            }
            if (typeof modal.showModal === 'function') {
                modal.showModal();
            } else {
                modal.setAttribute('open', '');
            }
        };

        window.closeCustomerAnnouncementModal = function() {
            const modal = document.getElementById('customerAnnouncementModal');
            if (!modal) return;
            if (typeof modal.close === 'function') {
                modal.close();
            } else {
                modal.removeAttribute('open');
            }
        };
        // Global Auth & Cart Modal Helpers
        window.isCustomerLoggedIn = function() {
            try {
                const match = document.cookie.match(/customer_user=([^;]+)/);
                return !!(match && match[1]);
            } catch(e) {
                return false;
            }
        };

        // User-scoped Cart Storage: preserves items per user across logins without database changes
        window.getCustomerCartKey = function() {
            try {
                const match = document.cookie.match(/customer_user=([^;]+)/);
                if (match && match[1]) {
                    let u = decodeURIComponent(match[1]).trim().toLowerCase().replace(/[^a-z0-9_]/g, '_');
                    if (u) return 'customer_cart_' + u;
                }
            } catch(e) {}
            return 'customer_cart_guest';
        };

        window.getCustomerCart = function() {
            if (!window.isCustomerLoggedIn()) return [];
            try {
                const key = window.getCustomerCartKey();
                let raw = localStorage.getItem(key);
                // Auto-migrate legacy generic cart into user's cart if present
                if (!raw) {
                    raw = localStorage.getItem('customer_cart');
                    if (raw) {
                        localStorage.setItem(key, raw);
                        localStorage.removeItem('customer_cart');
                    }
                }
                return raw ? JSON.parse(raw) : [];
            } catch(e) {
                return [];
            }
        };

        window.saveCustomerCart = function(cart) {
            if (!window.isCustomerLoggedIn()) return;
            try {
                const key = window.getCustomerCartKey();
                localStorage.setItem(key, JSON.stringify(cart));
                window.updateCartBadge();
            } catch(e) {}
        };

        window.clearCustomerCart = function() {
            try {
                const key = window.getCustomerCartKey();
                localStorage.removeItem(key);
                localStorage.removeItem('customer_cart');
                window.updateCartBadge();
            } catch(e) {}
        };

        window.openLoginRequiredModal = function(returnUrl) {
            const modal = document.getElementById('loginRequiredModal');
            if (!modal) return;
            const loginBtn = document.getElementById('modalLoginBtn');
            const targetUrl = returnUrl || window.location.pathname + window.location.search;
            if (loginBtn) {
                loginBtn.href = '/Auth/Login?returnUrl=' + encodeURIComponent(targetUrl);
            }
            if (typeof modal.showModal === 'function') {
                modal.showModal();
            } else {
                modal.setAttribute('open', '');
            }
        };

        window.closeLoginRequiredModal = function() {
            const modal = document.getElementById('loginRequiredModal');
            if (!modal) return;
            if (typeof modal.close === 'function') {
                modal.close();
            } else {
                modal.removeAttribute('open');
            }
        };

        window.toggleUserMenu = function(e) {
            if (e) e.stopPropagation();
            const panel = document.getElementById('userDropdownPanel');
            const chevron = document.getElementById('userMenuChevron');
            if (!panel) return;
            const isHidden = panel.classList.contains('hidden');
            if (isHidden) {
                panel.classList.remove('hidden');
                if (chevron) chevron.classList.add('rotate-180');
            } else {
                panel.classList.add('hidden');
                if (chevron) chevron.classList.remove('rotate-180');
            }
        };

        window.closeUserMenu = function() {
            const panel = document.getElementById('userDropdownPanel');
            const chevron = document.getElementById('userMenuChevron');
            if (panel) panel.classList.add('hidden');
            if (chevron) chevron.classList.remove('rotate-180');
        };

        document.addEventListener('click', function(e) {
            const menu = document.getElementById('navUserMenu');
            if (menu && !menu.contains(e.target)) {
                window.closeUserMenu();
            }
        });

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                window.closeUserMenu();
            }
        });

        window.openLogoutConfirmModal = function() {
            const modal = document.getElementById('logoutConfirmModal');
            if (!modal) return;
            if (typeof modal.showModal === 'function') {
                modal.showModal();
            } else {
                modal.setAttribute('open', '');
            }
        };

        window.closeLogoutConfirmModal = function() {
            const modal = document.getElementById('logoutConfirmModal');
            if (!modal) return;
            if (typeof modal.close === 'function') {
                modal.close();
            } else {
                modal.removeAttribute('open');
            }
        };

        window.performCustomerSignOut = function() {
            try {
                sessionStorage.setItem('customer_logged_out', 'true');
            } catch(e) {}

            // Immediately clear auth cookies on client side
            document.cookie = "customer_user=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT; max-age=0";
            document.cookie = "customer_token=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT; max-age=0";
            document.cookie = "customer_refresh=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT; max-age=0";

            window.closeLogoutConfirmModal();
            window.closeLoginRequiredModal();

            const navLoginBtn = document.getElementById('navLoginBtn');
            const navUserMenu = document.getElementById('navUserMenu');
            if (navLoginBtn) navLoginBtn.classList.remove('hidden');
            if (navUserMenu) {
                navUserMenu.classList.add('hidden');
                navUserMenu.classList.remove('flex');
            }
            window.updateCartBadge();

            window.location.replace('/Auth/SignOut');
        };
        window.performCustomerLogout = window.performCustomerSignOut;

        window.handleAddToCart = function(bookId, e) {
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }
            if (!window.isCustomerLoggedIn()) {
                window.openLoginRequiredModal(window.location.pathname + window.location.search);
                return false;
            }
            if (bookId) {
                window.location.href = '/Books/Detail/' + bookId;
            } else {
                window.location.href = '/Cart';
            }
            return true;
        };

        document.addEventListener('DOMContentLoaded', () => {
            // Mobile Menu Toggle
            const mobileBtn = document.getElementById('mobileMenuBtn');
            const mobileMenu = document.getElementById('mobileMenu');
            const icon = document.getElementById('menuIcon');

            if(mobileBtn && mobileMenu) {
                mobileBtn.addEventListener('click', () => {
                    const isExpanded = !mobileMenu.classList.contains('hidden');
                    if(isExpanded) {
                        mobileMenu.classList.add('hidden');
                        icon.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
                    } else {
                        mobileMenu.classList.remove('hidden');
                        icon.setAttribute('d', 'M6 18L18 6M6 6l12 12');
                    }
                });
            }

            // Debounce Search Logic
            let debounceTimer;
            const searchForms = document.querySelectorAll('.debounce-search-form');
            
            searchForms.forEach(form => {
                const input = form.querySelector('.debounce-search-input');
                const clearBtn = form.querySelector('.debounce-clear-btn');
                
                if(!input) return;

                const toggleClearBtn = () => {
                    if(clearBtn) {
                        if(input.value.length > 0) {
                            clearBtn.classList.remove('hidden');
                        } else {
                            clearBtn.classList.add('hidden');
                        }
                    }
                };

                toggleClearBtn();

                input.addEventListener('input', () => {
                    toggleClearBtn();
                    clearTimeout(debounceTimer);
                    debounceTimer = setTimeout(() => {
                        form.submit();
                    }, 500);
                });

                if(clearBtn) {
                    clearBtn.addEventListener('click', () => {
                        input.value = '';
                        toggleClearBtn();
                        form.submit();
                    });
                }
            });

            // Customer Auth state check & UI synchronization
            window.syncCustomerAuthState();

            // Active Navigation Tab Indicator based on URL
            try {
                const currentPath = window.location.pathname.toLowerCase().replace(/\/$/, '') || '/';
                document.querySelectorAll('nav a, #mobileMenu a').forEach(function(link) {
                    const href = (link.getAttribute('href') || '').toLowerCase().replace(/\/$/, '') || '/';
                    const isCurrent = (href === '/' && (currentPath === '/' || currentPath === '/home')) ||
                                      (href !== '/' && currentPath.startsWith(href));
                    if (isCurrent) {
                        link.classList.add('text-brand-accent', 'font-bold');
                        const line = link.querySelector('span.absolute');
                        if (line) {
                            line.classList.remove('opacity-0');
                            line.classList.add('opacity-100');
                        }
                    }
                });
            } catch(e) {}

            // Close modal when clicking backdrop
            const modal = document.getElementById('loginRequiredModal');
            if (modal) {
                modal.addEventListener('click', function(e) {
                    if (e.target === modal) {
                        window.closeLoginRequiredModal();
                    }
                });
            }

            const logoutModal = document.getElementById('logoutConfirmModal');
            if (logoutModal) {
                logoutModal.addEventListener('click', function(e) {
                    if (e.target === logoutModal) {
                        window.closeLogoutConfirmModal();
                    }
                });
            }

            // Intercept top-level Cart links when guest
            document.querySelectorAll('a[href="/Cart"]').forEach(function(cartLink) {
                cartLink.addEventListener('click', function(e) {
                    if (!window.isCustomerLoggedIn()) {
                        e.preventDefault();
                        window.openLoginRequiredModal('/Cart');
                    }
                });
            });
        });

        // Synchronize customer authentication UI & cart badge across pages and back-forward navigation
        window.syncCustomerAuthState = function() {
            // Guarantee confirmation modals are closed on back-navigation
            window.closeLogoutConfirmModal();
            window.closeLoginRequiredModal();

            const navLoginBtn = document.getElementById('navLoginBtn');
            const navUserMenu = document.getElementById('navUserMenu');
            const navUsername = document.getElementById('navUsername');
            const navUserInitials = document.getElementById('navUserInitials');

            const mobileLoginBtn = document.getElementById('mobileLoginBtn');
            const mobileUserMenu = document.getElementById('mobileUserMenu');
            const mobileUsername = document.getElementById('mobileUsername');
            const mobileUserInitials = document.getElementById('mobileUserInitials');

            const isLoggedIn = window.isCustomerLoggedIn();

            if (isLoggedIn) {
                try {
                    sessionStorage.removeItem('customer_logged_out');
                } catch(e) {}

                try {
                    const userMatch = document.cookie.match(/customer_user=([^;]+)/);
                    let cleanUser = userMatch && userMatch[1] ? userMatch[1] : 'Customer';
                    try {
                        cleanUser = decodeURIComponent(cleanUser);
                        if (cleanUser.includes('%')) {
                            cleanUser = decodeURIComponent(cleanUser);
                        }
                    } catch(e) {}
                    cleanUser = cleanUser.replace(/%20/g, ' ').replace(/\+/g, ' ').trim();

                    const words = cleanUser.split(/\s+/).filter(Boolean);
                    const initials = words.length >= 2 
                        ? (words[0][0] + words[words.length - 1][0]).toUpperCase()
                        : cleanUser.substring(0, 2).toUpperCase();

                    if (navLoginBtn) navLoginBtn.classList.add('hidden');
                    if (navUserMenu) {
                        navUserMenu.classList.remove('hidden');
                        navUserMenu.classList.add('flex');
                    }
                    if (navUsername) navUsername.textContent = cleanUser;
                    if (navUserInitials) navUserInitials.textContent = initials;
                    const dropdownUsername = document.getElementById('dropdownUsername');
                    if (dropdownUsername) dropdownUsername.textContent = cleanUser;

                    if (mobileLoginBtn) mobileLoginBtn.classList.add('hidden');
                    if (mobileUserMenu) {
                        mobileUserMenu.classList.remove('hidden');
                        mobileUserMenu.classList.add('flex');
                    }
                    if (mobileUsername) mobileUsername.textContent = cleanUser;
                    if (mobileUserInitials) mobileUserInitials.textContent = initials;
                } catch(e) {}
            } else {
                if (navLoginBtn) navLoginBtn.classList.remove('hidden');
                if (navUserMenu) {
                    navUserMenu.classList.add('hidden');
                    navUserMenu.classList.remove('flex');
                }
                if (mobileLoginBtn) mobileLoginBtn.classList.remove('hidden');
                if (mobileUserMenu) {
                    mobileUserMenu.classList.add('hidden');
                    mobileUserMenu.classList.remove('flex');
                }

                // If user is logged out and on any Cart/Order route (via Back button or cached state), redirect to Home
                const currentPath = window.location.pathname.toLowerCase();
                if (currentPath.startsWith('/cart')) {
                    window.location.replace('/');
                    return;
                }

                // If user logged out and Back button navigates into past session pages, force return to Home
                if (sessionStorage.getItem('customer_logged_out') === 'true') {
                    if (currentPath !== '/' && currentPath !== '/home' && !currentPath.startsWith('/auth/login')) {
                        window.location.replace('/');
                        return;
                    } else if (window.history && window.history.pushState) {
                        window.history.pushState(null, '', window.location.href);
                    }
                }
            }

            window.updateCartBadge();
        };

        // Handle Back/Forward cache navigation (bfcache) & Tab switching
        window.addEventListener('pageshow', function() {
            window.syncCustomerAuthState();
        });

        window.addEventListener('popstate', function() {
            if (!window.isCustomerLoggedIn() && sessionStorage.getItem('customer_logged_out') === 'true') {
                const currentPath = window.location.pathname.toLowerCase();
                if (currentPath !== '/' && currentPath !== '/home') {
                    window.location.replace('/');
                    return;
                }
                if (window.history && window.history.pushState) {
                    window.history.pushState(null, '', window.location.href);
                }
            }
            window.syncCustomerAuthState();
        });

        // When guest intentionally clicks any link or button, unlock regular guest navigation
        document.addEventListener('click', function(e) {
            const link = e.target.closest('a');
            if (link && link.href) {
                try {
                    sessionStorage.removeItem('customer_logged_out');
                } catch(e) {}
            }
        });

        document.addEventListener('visibilitychange', function() {
            if (!document.hidden) {
                window.syncCustomerAuthState();
            }
        });

        window.addEventListener('focus', function() {
            window.syncCustomerAuthState();
        });

        // Global Cart Badge Update
        window.updateCartBadge = function() {
            try {
                const navBadge = document.getElementById('navCartBadge');
                const mobBadge = document.getElementById('mobileCartBadge');

                // If not logged in, guests cannot have a cart
                if (!window.isCustomerLoggedIn()) {
                    if (navBadge) navBadge.classList.add('hidden');
                    if (mobBadge) mobBadge.classList.add('hidden');
                    return;
                }

                const cart = typeof window.getCustomerCart === 'function' ? window.getCustomerCart() : [];
                const total = cart.reduce((sum, item) => sum + (parseInt(item.quantity, 10) || 1), 0);
                
                if (navBadge) {
                    if (total > 0) {
                        navBadge.textContent = total;
                        navBadge.classList.remove('hidden');
                    } else {
                        navBadge.classList.add('hidden');
                    }
                }
                if (mobBadge) {
                    if (total > 0) {
                        mobBadge.textContent = total;
                        mobBadge.classList.remove('hidden');
                    } else {
                        mobBadge.classList.add('hidden');
                    }
                }
            } catch(e) {}
        };

        // Global Toast Notification System
        let toastTimeout = null;
        window.showToast = function(message, isSuccess = true) {
            const container = document.getElementById('globalToastContainer');
            const cardEl = document.getElementById('globalToastCard');
            const titleEl = document.getElementById('globalToastTitle');
            const messageEl = document.getElementById('globalToastMessage');
            const iconContainer = document.getElementById('globalToastIconContainer');
            if (!container || !messageEl || !iconContainer) return;

            messageEl.textContent = message;

            const isSuccessBool = (isSuccess === true || isSuccess === 'success' || isSuccess === 1 || isSuccess === '1');

            if (isSuccessBool) {
                if (titleEl) {
                    titleEl.textContent = "SUCCESS";
                    titleEl.className = "text-[10px] font-bold tracking-widest uppercase text-emerald-600 mb-0.5 font-body";
                }
                if (cardEl) {
                    cardEl.className = "bg-white/95 backdrop-blur-md border border-emerald-200 shadow-2xl rounded-2xl px-5 py-4 flex items-center gap-3.5 max-w-md ring-1 ring-emerald-500/15";
                }
                iconContainer.className = "w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 border border-emerald-200 flex items-center justify-center shrink-0 shadow-2xs";
                iconContainer.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>';
            } else {
                if (titleEl) {
                    titleEl.textContent = "ATTENTION";
                    titleEl.className = "text-[10px] font-bold tracking-widest uppercase text-rose-600 mb-0.5 font-body";
                }
                if (cardEl) {
                    cardEl.className = "bg-white/95 backdrop-blur-md border border-rose-200 shadow-2xl rounded-2xl px-5 py-4 flex items-center gap-3.5 max-w-md ring-1 ring-rose-500/15";
                }
                iconContainer.className = "w-9 h-9 rounded-xl bg-rose-50 text-rose-600 border border-rose-200 flex items-center justify-center shrink-0 shadow-2xs";
                iconContainer.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>';
            }

            container.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-3');
            container.classList.add('opacity-100', 'translate-y-0');

            if (toastTimeout) clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                window.hideToast();
            }, 4500);
        };

        window.hideToast = function() {
            const container = document.getElementById('globalToastContainer');
            if (container) {
                container.classList.add('opacity-0', 'pointer-events-none', 'translate-y-3');
                container.classList.remove('opacity-100', 'translate-y-0');
            }
        };
    </script>

    <!-- Global Toast Container Element -->
    <div id="globalToastContainer" class="fixed bottom-6 right-6 z-50 transition-all duration-300 transform translate-y-3 opacity-0 pointer-events-none font-body">
        <div id="globalToastCard" class="bg-white/95 backdrop-blur-md border border-slate-200/80 shadow-2xl rounded-2xl px-5 py-4 flex items-center gap-3.5 max-w-md ring-1 ring-slate-900/5">
            <div id="globalToastIconContainer" class="w-9 h-9 rounded-xl flex items-center justify-center shrink-0"></div>
            <div class="pr-2">
                <div id="globalToastTitle" class="text-[10px] font-bold tracking-widest uppercase mb-0.5"></div>
                <div id="globalToastMessage" class="text-xs text-slate-800 font-semibold leading-relaxed"></div>
            </div>
            <button type="button" onclick="window.hideToast()" class="ml-auto text-slate-400 hover:text-slate-700 hover:bg-slate-100 p-1.5 rounded-lg transition-colors cursor-pointer shrink-0" aria-label="Close notification">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>
    </div>

    @{
        bool hasGlobalToast = false;
        bool globalToastSuccess = true;
        string globalToastMsg = "";

        if (TempData["Message"] != null)
        {
            hasGlobalToast = true;
            globalToastMsg = TempData["Message"]?.ToString() ?? "";
            var rawSuccess = TempData["isSuccess"] ?? TempData["IsSuccess"];
            globalToastSuccess = rawSuccess == null || Convert.ToBoolean(rawSuccess);
        }
    }
    @if (hasGlobalToast && !string.IsNullOrWhiteSpace(globalToastMsg))
    {
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                if (typeof window.showToast === 'function') {
                    window.showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(globalToastMsg)), @(globalToastSuccess ? "true" : "false"));
                }
            });
        </script>
    }

    <!-- Customer Notification Slide-over Drawer Overlay -->
    <div id="customerNotifOverlay" onclick="window.closeCustomerNotifDrawer()" class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs z-[60] transition-opacity duration-300 opacity-0 pointer-events-none"></div>

    <!-- Customer Notification Slide-over Drawer -->
    <aside id="customerNotifDrawer" class="fixed top-0 right-0 h-full w-full sm:w-[400px] max-w-full bg-[#FDFBF7] border-l border-brand-border shadow-2xl z-[70] transition-transform duration-300 ease-in-out translate-x-full flex flex-col overflow-hidden">
        <div class="px-6 py-5 border-b border-brand-border bg-white flex items-center justify-between shrink-0">
            <div class="flex items-center gap-3">
                <button type="button" onclick="window.closeCustomerNotifDrawer()" class="p-1.5 -ml-1.5 rounded-xl hover:bg-stone-100 text-stone-600 transition-colors cursor-pointer" aria-label="Close">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
                </button>
                <div class="flex items-center gap-2.5">
                    <h2 class="text-2xl font-heading font-bold text-brand-ink">Notifications</h2>
                    <span id="customerNotifDrawerPill" class="hidden w-5 h-5 text-[11px] font-bold rounded-full bg-rose-500 text-white items-center justify-center shadow-xs">0</span>
                </div>
            </div>
            <div class="flex items-center gap-1.5">
                <button type="button" onclick="window.markAllCustomerNotifsRead()" class="text-xs font-bold text-brand-accent hover:text-brand-accentHover px-2.5 py-1.5 rounded-lg transition-colors cursor-pointer">
                    Mark all read
                </button>
                <button type="button" onclick="window.openCustomerClearNotifModal()" title="Clear notifications" class="p-1.5 rounded-lg text-stone-400 hover:text-rose-600 hover:bg-stone-100 transition-colors cursor-pointer">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                </button>
            </div>
        </div>

        <div id="customerNotifItems" class="flex-1 overflow-y-auto px-5 py-4 space-y-3">
            <!-- Dynamically populated by customer-notification.js -->
        </div>

        <div class="p-4 border-t border-brand-border bg-white flex items-center justify-between text-xs text-stone-500">
            <a href="/Orders" onclick="window.closeCustomerNotifDrawer()" class="font-semibold text-brand-accent hover:underline flex items-center gap-1">
                <span>View Order History</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <button type="button" onclick="window.closeCustomerNotifDrawer()" class="text-xs text-stone-400 hover:text-stone-600 font-medium cursor-pointer">
                Close
            </button>
        </div>
    </aside>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/js/auth-api.js" asp-append-version="true"></script>
    <!-- SignalR Client -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/customer-notification.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
