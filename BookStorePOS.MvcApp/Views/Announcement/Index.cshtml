@model BookStorePOS.Shared.Models.Notification.AnnouncementRequestModel
@{
    ViewData["Title"] = "Broadcast Announcement";
}

<div class="space-y-6 max-w-3xl mx-auto">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#F6DFFB] text-[#9F54A6] border border-[#F3E2F6] shadow-2xs">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" />
            </svg>
        </span>
        <div>
            <h1 class="text-2xl sm:text-3xl font-bold text-[#18181B] tracking-tight">Broadcast Announcement</h1>
            <p class="text-[#9C8EA4] text-xs sm:text-sm font-medium">Send real-time alerts and promotional updates to active customers and staff</p>
        </div>
    </div>

    <!-- Form Section -->
    <div class="bg-white rounded-3xl border border-[#F3E2F6] p-6 sm:p-8 shadow-xs">
        <div class="mb-6 pb-4 border-b border-[#F3E2F6]">
            <h2 class="text-lg font-bold text-[#18181B]">Create Realtime Message</h2>
            <p class="text-xs text-[#9C8EA4] mt-0.5">Connected clients will immediately receive this notification on their screens.</p>
        </div>

        <form asp-action="Send" asp-controller="Announcement" method="post" class="space-y-5" id="announcementForm">
            @Html.AntiForgeryToken()

            <!-- Target Audience Selector (Interactive Radio Cards) -->
            <div>
                <label class="block text-xs font-bold text-[#18181B] uppercase tracking-wider mb-2">Target Audience</label>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3" id="audienceSelectorContainer">
                    <!-- Everyone -->
                    <div onclick="selectAudience('All')" id="audienceCard_All"
                         class="audience-card cursor-pointer p-4 rounded-2xl border-2 transition-all flex flex-col items-center justify-center text-center relative border-[#9F54A6] bg-[#FAF0FA] text-[#9F54A6] shadow-xs">
                        <input type="radio" name="TargetAudience" id="radio_All" value="All" checked class="sr-only" />
                        <span class="block text-sm font-bold">Everyone</span>
                        <span class="block text-xs text-slate-500 mt-0.5">Staff & Customers</span>
                        <div id="check_All" class="w-4 h-4 rounded-full bg-[#9F54A6] text-white flex items-center justify-center text-[10px] absolute top-2 right-2">✓</div>
                    </div>

                    <!-- Staff Only -->
                    <div onclick="selectAudience('Staff')" id="audienceCard_Staff"
                         class="audience-card cursor-pointer p-4 rounded-2xl border-2 transition-all flex flex-col items-center justify-center text-center relative border-[#F3E2F6] bg-white text-slate-700 hover:border-[#CE8FD4] hover:bg-[#FAF0FA]/50">
                        <input type="radio" name="TargetAudience" id="radio_Staff" value="Staff" class="sr-only" />
                        <span class="block text-sm font-bold">Staff Only</span>
                        <span class="block text-xs text-slate-500 mt-0.5">POS Users</span>
                        <div id="check_Staff" class="w-4 h-4 rounded-full bg-[#9F54A6] text-white hidden items-center justify-center text-[10px] absolute top-2 right-2">✓</div>
                    </div>

                    <!-- Customers Only -->
                    <div onclick="selectAudience('Customers')" id="audienceCard_Customers"
                         class="audience-card cursor-pointer p-4 rounded-2xl border-2 transition-all flex flex-col items-center justify-center text-center relative border-[#F3E2F6] bg-white text-slate-700 hover:border-[#CE8FD4] hover:bg-[#FAF0FA]/50">
                        <input type="radio" name="TargetAudience" id="radio_Customers" value="Customers" class="sr-only" />
                        <span class="block text-sm font-bold">Customers</span>
                        <span class="block text-xs text-slate-500 mt-0.5">Online Store</span>
                        <div id="check_Customers" class="w-4 h-4 rounded-full bg-[#9F54A6] text-white hidden items-center justify-center text-[10px] absolute top-2 right-2">✓</div>
                    </div>
                </div>
            </div>

            <!-- Quick Presets -->
            <div>
                <label class="block text-xs font-bold text-[#18181B] uppercase tracking-wider mb-2">Quick Templates</label>
                <div class="flex flex-wrap gap-2">
                    <button type="button" onclick="setTemplate('Flash Sale: 20% Off All Fiction Books!', 'Don\'t miss our weekend flash discount! All fiction novels are now 20% off. Shop online or visit our bookstore today.')" class="px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-[#FAF0FA] text-[#9F54A6] hover:bg-[#F6DFFB] transition-colors border border-[#F3E2F6] cursor-pointer">
                        Flash Sale
                    </button>
                    <button type="button" onclick="setTemplate('New Book Arrivals in Stock!', 'Check out our freshly arrived editions including international bestsellers and classics in stock right now.')" class="px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-[#FAF0FA] text-[#9F54A6] hover:bg-[#F6DFFB] transition-colors border border-[#F3E2F6] cursor-pointer">
                        New Arrivals
                    </button>
                    <button type="button" onclick="setTemplate('Scheduled System Maintenance Notice', 'Please be advised our checkout system will undergo a 10-minute scheduled maintenance tonight at 11:00 PM.')" class="px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-[#FAF0FA] text-[#9F54A6] hover:bg-[#F6DFFB] transition-colors border border-[#F3E2F6] cursor-pointer">
                        Maintenance
                    </button>
                </div>
            </div>

            <!-- Title -->
            <div>
                <label class="block text-xs font-bold text-[#18181B] uppercase tracking-wider mb-2" for="announcementTitle">Announcement Title <span class="text-rose-500">*</span></label>
                <input type="text" id="announcementTitle" name="Title" value="@Model?.Title" required placeholder="e.g. Special Weekend Book Festival" 
                       class="w-full px-4 py-3 rounded-2xl border border-[#F3E2F6] bg-white text-sm text-[#18181B] placeholder-[#9C8EA4] focus:outline-none focus:ring-2 focus:ring-[#9F54A6]/20 focus:border-[#9F54A6] transition-all" />
            </div>

            <!-- Content -->
            <div>
                <label class="block text-xs font-bold text-[#18181B] uppercase tracking-wider mb-2" for="announcementContent">Message Content <span class="text-rose-500">*</span></label>
                <textarea id="announcementContent" name="Content" rows="4" required placeholder="Write your announcement details here..."
                          class="w-full px-4 py-3 rounded-2xl border border-[#F3E2F6] bg-white text-sm text-[#18181B] placeholder-[#9C8EA4] focus:outline-none focus:ring-2 focus:ring-[#9F54A6]/20 focus:border-[#9F54A6] transition-all">@Model?.Content</textarea>
            </div>

            <!-- Submit Button -->
            <div class="pt-2">
                <button type="submit" id="submitBtn" class="w-full py-3.5 px-6 rounded-2xl bg-[#B875C2] hover:bg-[#9F54A6] text-white font-semibold text-sm transition-all shadow-md hover:shadow-lg inline-flex items-center justify-center gap-2 cursor-pointer">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
                    <span id="submitBtnText">Send Realtime Broadcast</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    // 1. Audience Selector Handler
    function selectAudience(audience) {
        const audiences = ['All', 'Staff', 'Customers'];
        audiences.forEach(a => {
            const card = document.getElementById('audienceCard_' + a);
            const radio = document.getElementById('radio_' + a);
            const check = document.getElementById('check_' + a);

            if (a === audience) {
                if (radio) radio.checked = true;
                if (card) {
                    card.className = "audience-card cursor-pointer p-4 rounded-2xl border-2 transition-all flex flex-col items-center justify-center text-center relative border-[#9F54A6] bg-[#FAF0FA] text-[#9F54A6] shadow-xs";
                }
                if (check) check.classList.remove('hidden');
            } else {
                if (radio) radio.checked = false;
                if (card) {
                    card.className = "audience-card cursor-pointer p-4 rounded-2xl border-2 transition-all flex flex-col items-center justify-center text-center relative border-[#F3E2F6] bg-white text-slate-700 hover:border-[#CE8FD4] hover:bg-[#FAF0FA]/50";
                }
                if (check) check.classList.add('hidden');
            }
        });
    }

    // 2. Template Preset Loader
    function setTemplate(title, content) {
        document.getElementById('announcementTitle').value = title;
        document.getElementById('announcementContent').value = content;
    }

    // 3. Realtime AJAX Broadcast (Keeps SignalR WebSocket Alive!)
    document.addEventListener('DOMContentLoaded', function () {
        const form = document.getElementById('announcementForm');
        if (!form) return;

        form.addEventListener('submit', async function (e) {
            e.preventDefault();

            const title = document.getElementById('announcementTitle').value.trim();
            const content = document.getElementById('announcementContent').value.trim();
            if (!title || !content) {
                if (typeof window.showToast === 'function') {
                    window.showToast('Please fill out both Title and Message content.', false);
                } else {
                    alert('Please fill out both Title and Message content.');
                }
                return;
            }

            const btn = document.getElementById('submitBtn');
            const btnText = document.getElementById('submitBtnText');
            btn.disabled = true;
            btnText.textContent = 'Broadcasting in realtime...';

            try {
                const formData = new FormData(form);
                const response = await fetch('/Announcement/Send', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                const result = await response.json().catch(() => null);

                if (response.ok && (!result || result.success !== false)) {
                    // Success! Form submitted without page reload -> SignalR socket stays 100% connected
                    document.getElementById('announcementTitle').value = '';
                    document.getElementById('announcementContent').value = '';
                    if (typeof window.showToast === 'function') {
                        window.showToast(`Announcement "${title}" broadcasted successfully!`, true);
                    }
                } else {
                    if (typeof window.showToast === 'function') {
                        window.showToast(result?.message || 'Failed to broadcast announcement.', false);
                    } else {
                        alert(result?.message || 'Failed to broadcast announcement.');
                    }
                }
            } catch (err) {
                console.error('Broadcast error:', err);
                if (typeof window.showToast === 'function') {
                    window.showToast('Network error while broadcasting announcement.', false);
                }
            } finally {
                btn.disabled = false;
                btnText.textContent = 'Send Realtime Broadcast';
            }
        });
    });
</script>
}
