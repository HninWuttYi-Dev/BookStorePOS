@{
    Layout = null;
    ViewData["Title"] = "Staff Login - BookStore POS";
    var returnUrl = ViewData["ReturnUrl"]?.ToString() ?? "/Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'Inter', 'sans-serif'],
                    },
                    colors: {
                        primary: {
                            DEFAULT: '#B875C2', // Exact Pastel Orchid from Mockup
                            50: '#FDF7FD',
                            100: '#F6DFFB',     // Soft Lilac Tint
                            200: '#ECC4F5',
                            300: '#DFADE4',
                            400: '#CE8FD4',
                            500: '#B875C2',     // Primary Button
                            600: '#A662B0',     // Hover Button
                            700: '#9F54A6',     // Accent Text
                            800: '#873693',
                            900: '#642870',
                        },
                        'primary-dark': '#18181B',
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
    </style>
</head>
<body class="bg-[#FAF0FA] text-[#18181B] min-h-screen flex items-center justify-center p-4 sm:p-6 antialiased relative overflow-x-hidden">

    <!-- Ambient Pastel Lighting in Background -->
    <div class="pointer-events-none absolute -top-40 -left-40 w-96 h-96 bg-[#F6DFFB]/70 rounded-full blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-40 -right-40 w-96 h-96 bg-[#F6DFFB]/60 rounded-full blur-3xl"></div>

    <div class="max-w-[460px] w-full my-8 relative z-10">
        <!-- Logo & Header -->
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center gap-3 mb-3">
                <div class="w-12 h-12 rounded-2xl bg-white border border-[#F3E2F6] flex items-center justify-center text-[#9F54A6] shadow-[0_4px_16px_rgba(184,117,194,0.15)]">
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                    </svg>
                </div>
                <span class="text-2xl font-bold tracking-tight text-[#18181B]">POS <span class="text-[#9F54A6]">System</span></span>
            </div>
            <h1 class="text-2xl font-bold text-[#18181B] tracking-tight">Staff &amp; Admin Portal</h1>
            <p class="text-[#9C8EA4] text-sm mt-1">Sign in to manage inventory, sales, and bookstore operations</p>
        </div>

        <!-- Login Card -->
        <div class="bg-white rounded-3xl p-8 sm:p-10 shadow-[0_16px_50px_-12px_rgba(184,117,194,0.12)] border border-[#F3E2F6]">
            <!-- Alert Banner -->
            <div id="loginAlert" class="hidden mb-6 p-4 rounded-2xl text-sm border flex items-start gap-3 bg-[#FBE8E8] border-[#F7D2D2] text-[#B84646]" role="alert">
                <svg class="w-5 h-5 text-[#B84646] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span id="loginAlertText"></span>
            </div>

            <form id="staffLoginForm" autocomplete="off" novalidate class="space-y-6">
                <!-- Phone Number -->
                <div>
                    <label for="phoneInput" class="block text-xs font-semibold uppercase tracking-wider text-[#71717A] mb-2 ml-0.5">
                        Phone Number <span class="text-[#B875C2]">*</span>
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#A1A1AA]">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                            </svg>
                        </div>
                        <input type="tel" id="phoneInput" name="Phone" autocomplete="tel" required
                               placeholder="09789456123"
                               class="w-full pl-11 pr-4 py-3 bg-[#FAF0FA]/50 border border-[#F3E2F6] hover:border-[#DFADE4] rounded-xl text-[#18181B] text-sm placeholder-[#A1A1AA] focus:outline-none focus:border-[#B875C2] focus:bg-white focus:ring-2 focus:ring-[#B875C2]/20 transition-all shadow-2xs" />
                    </div>
                    <span id="phoneError" class="hidden text-xs text-[#B84646] mt-1 ml-1 block">Phone number is required.</span>
                </div>

                <!-- Password -->
                <div>
                    <div class="flex items-center justify-between mb-2 ml-0.5">
                        <label for="passwordInput" class="block text-xs font-semibold uppercase tracking-wider text-[#71717A]">
                            Password <span class="text-[#B875C2]">*</span>
                        </label>
                    </div>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#A1A1AA]">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                            </svg>
                        </div>
                        <input type="password" id="passwordInput" name="Password" autocomplete="current-password" required
                               placeholder="••••••••"
                               class="w-full pl-11 pr-11 py-3 bg-[#FAF0FA]/50 border border-[#F3E2F6] hover:border-[#DFADE4] rounded-xl text-[#18181B] text-sm placeholder-[#A1A1AA] focus:outline-none focus:border-[#B875C2] focus:bg-white focus:ring-2 focus:ring-[#B875C2]/20 transition-all shadow-2xs" />
                        <button type="button" id="togglePasswordBtn" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-[#A1A1AA] hover:text-[#9F54A6] transition-colors cursor-pointer" aria-label="Toggle password visibility">
                            <svg id="eyeIconOpen" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                            </svg>
                            <svg id="eyeIconClosed" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"></path>
                            </svg>
                        </button>
                    </div>
                    <span id="passwordError" class="hidden text-xs text-[#B84646] mt-1 ml-1 block">Password is required.</span>
                </div>

                <!-- Submit Button -->
                <button type="submit" id="btnLoginSubmit"
                        class="w-full bg-[#B875C2] hover:bg-[#A662B0] text-white font-semibold py-3.5 px-4 rounded-xl transition-all shadow-[0_4px_16px_rgba(184,117,194,0.25)] flex items-center justify-center gap-2 text-sm mt-4 cursor-pointer">
                    <span>Sign In to POS</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                </button>
            </form>
        </div>

        <!-- Footer -->
        <p class="text-center text-xs text-[#9C8EA4] mt-6">
            &copy; 2026 BookStore POS System. All rights reserved.
        </p>
    </div>

    <!-- jQuery for AJAX -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
        $(document).ready(function() {
            const returnUrl = '@Html.Raw(returnUrl)';

            // If restored from browser bfcache (Back/Forward cache) or user pressed Back button
            window.addEventListener('pageshow', function (event) {
                if (event.persisted || (window.performance && window.performance.navigation && window.performance.navigation.type === 2)) {
                    $('#passwordInput').val('');
                    if (document.cookie.indexOf('pos_token=') !== -1 || localStorage.getItem('pos_user')) {
                        const role = (localStorage.getItem('pos_role') || '').toLowerCase();
                        let dest = returnUrl;
                        if (role === 'cashier') {
                            dest = '/Checkout';
                        }
                        window.location.replace(dest || '/Dashboard');
                    } else {
                        window.location.reload();
                    }
                }
            });

            // Myanmar phone normalization & validation
            function normalizeMyanmarPhone(phone) {
                let p = phone.trim().replace(/[\s-]/g, '');
                if (p.startsWith('+959')) p = '09' + p.substring(4);
                else if (p.startsWith('959')) p = '09' + p.substring(3);
                else if (p.startsWith('9') && p.length === 10) p = '0' + p;
                else if (p.length === 9 && !p.startsWith('0')) p = '09' + p;
                return p;
            }

            function isValidMyanmarPhone(phone) {
                const norm = normalizeMyanmarPhone(phone);
                return /^09\d{7,9}$/.test(norm);
            }


            // Toggle password visibility
            $('#togglePasswordBtn').on('click', function() {
                const $input = $('#passwordInput');
                const isPassword = $input.attr('type') === 'password';
                $input.attr('type', isPassword ? 'text' : 'password');
                $('#eyeIconOpen').toggleClass('hidden', isPassword);
                $('#eyeIconClosed').toggleClass('hidden', !isPassword);
            });

            // Clear errors on input
            $('#phoneInput').on('input', function() {
                $(this).removeClass('border-red-500 focus:ring-red-500/20');
                $('#phoneError').addClass('hidden');
                $('#loginAlert').addClass('hidden');
            });

            $('#passwordInput').on('input', function() {
                $(this).removeClass('border-red-500 focus:ring-red-500/20');
                $('#passwordError').addClass('hidden');
                $('#loginAlert').addClass('hidden');
            });

            // Form Submit via AJAX to /Auth/Login
            $('#staffLoginForm').on('submit', function(e) {
                e.preventDefault();

                const phone = $('#phoneInput').val().trim();
                const password = $('#passwordInput').val();
                let hasError = false;

                if (!phone) {
                    $('#phoneInput').addClass('border-red-500 focus:ring-red-500/20');
                    $('#phoneError').text("Phone number is required.").removeClass('hidden');
                    hasError = true;
                } else if (!isValidMyanmarPhone(phone)) {
                    $('#phoneInput').addClass('border-red-500 focus:ring-red-500/20');
                    $('#phoneError').text("Valid Myanmar phone number is required (09...).").removeClass('hidden');
                    hasError = true;
                }

                if (!password) {
                    $('#passwordInput').addClass('border-red-500 focus:ring-red-500/20');
                    $('#passwordError').removeClass('hidden');
                    hasError = true;
                }

                if (hasError) return;

                const normalizedPhone = normalizeMyanmarPhone(phone);

                const $btn = $('#btnLoginSubmit');
                $btn.prop('disabled', true).html(`
                    <svg class="animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                    </svg>
                    <span>Signing in...</span>
                `);

                $.ajax({
                    type: 'POST',
                    url: '/Auth/Login',
                    data: {
                        Phone: normalizedPhone,
                        Password: password
                    },
                    success: function(response) {
                        if (response.isSuccess) {
                            const displayName = response.fullName || response.FullName || response.username || response.Username || normalizedPhone;
                            localStorage.setItem('pos_user', displayName);
                            localStorage.setItem('pos_role', response.role || response.Role || 'Staff');
                            localStorage.setItem('pos_permissions', JSON.stringify(response.permissions || response.Permissions || []));

                            // Clear password immediately so it's not held in memory
                            $('#passwordInput').val('');

                            // Resolve target destination based on assigned permissions
                            const perms = response.permissions || response.Permissions || [];
                            const permsLower = perms.map(p => (p || '').toLowerCase());
                            const role = (response.role || response.Role || '').toLowerCase();

                            let dest = returnUrl;
                            const isDashboardDest = !dest || dest === '/' || dest.toLowerCase().startsWith('/dashboard');

                            if (role === 'cashier' || (role !== 'admin' && !permsLower.includes('dashboard.view'))) {
                                if (isDashboardDest) {
                                    if (role === 'cashier' || permsLower.includes('order.create')) {
                                        dest = '/Checkout';
                                    } else if (permsLower.includes('book.view')) {
                                        dest = '/Book';
                                    } else if (permsLower.includes('order.view')) {
                                        dest = '/Orders';
                                    } else {
                                        dest = '/Checkout';
                                    }
                                }
                            }

                            // Redirect using replace() so Back button doesn't revisit login
                            window.location.replace(dest || '/Checkout');
                        } else {
                            $('#loginAlertText').text(response.message || response.Message || "Invalid phone number or password.");
                            $('#loginAlert').removeClass('hidden');

                            // Clear password and refocus
                            $('#passwordInput').val('').focus().addClass('border-red-500 focus:ring-red-500/20');

                            $btn.prop('disabled', false).html(`
                                <span>Sign In to POS</span>
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                                </svg>
                            `);
                        }
                    },
                    error: function(xhr) {
                        const errMsg = (xhr.responseJSON && xhr.responseJSON.message) || "Network or server error occurred.";
                        $('#loginAlertText').text(errMsg);
                        $('#loginAlert').removeClass('hidden');

                        // Clear password and refocus
                        $('#passwordInput').val('').focus().addClass('border-red-500 focus:ring-red-500/20');

                        $btn.prop('disabled', false).html(`
                            <span>Sign In to POS</span>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                            </svg>
                        `);
                    }
                });
            });
        });
    </script>
</body>
</html>
