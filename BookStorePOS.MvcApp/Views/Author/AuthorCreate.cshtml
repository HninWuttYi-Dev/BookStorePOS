@{
    ViewData["Title"] = "New Author";
}

<div class="max-w-2xl mx-auto w-full">
    <div class="mb-8 flex items-center">
        <a href="/Author" class="mr-4 p-2 text-slate-400 hover:text-teal-600 hover:bg-teal-50 rounded-full transition-colors flex-shrink-0" title="Back to Authors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        </a>
        <div>
            <div class="flex items-center gap-2 text-sm text-slate-500 mb-1">
                <a href="/Author" class="hover:text-teal-600 transition-colors">Authors</a>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                <span class="text-slate-900 font-medium">Create</span>
            </div>
            <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Create New Author</h1>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-[0_4px_24px_-4px_rgba(42,36,33,0.06)] border border-[#EDE7DF] overflow-hidden">
        <div class="p-6 md:p-8">
            <div class="mb-6">
                <label for="AuthorName" class="text-sm font-semibold text-slate-700 mb-1.5 block">Author Name <span class="text-red-500">*</span></label>
                <input type="text" id="AuthorName" name="AuthorName" required
                       class="px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all w-full" 
                       placeholder="Enter author's name" />
                <span class="text-red-500 text-xs mt-1 hidden error-msg" id="authorNameError">Author Name is required.</span>
            </div>

            <div class="flex gap-4 pt-4 border-t border-slate-100 justify-end">
                <a href="/Author" class="px-6 py-2.5 bg-slate-100 text-slate-700 font-semibold rounded-xl hover:bg-slate-200 transition-colors flex items-center justify-center min-w-[120px]">
                    Cancel
                </a>
                <button type="button" id="btnSave" class="px-6 py-2.5 bg-teal-600 text-white font-semibold rounded-xl hover:bg-teal-700 transition-colors shadow-sm flex items-center justify-center min-w-[120px]">
                    Save Author
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showToast(message, isSuccess = false) {
            if (typeof window.showToast === 'function') {
                window.showToast(message, isSuccess);
            }
        }

        $(document).ready(function() {
            let isSubmitting = false;
            $('#AuthorName').on('input', function() {
                $(this).removeClass('border-red-500 focus:ring-red-500/50 focus:border-red-500');
                $('#authorNameError').addClass('hidden');
            });

            $('#btnSave').on('click', function () {
                if (isSubmitting) return;
                const authorName = $('#AuthorName').val().trim();
                
                if (!authorName) {
                    $('#authorNameError').removeClass('hidden');
                    $('#AuthorName').addClass('border-red-500 focus:ring-red-500/50 focus:border-red-500');
                    return;
                }

                const $btn = $(this);
                $btn.prop('disabled', true).text('Saving...');

                const _requestModel = {
                    AuthorName: authorName
                };

                isSubmitting = true;
                $.ajax({
                    type: 'POST',
                    url: '/Author/Save',
                    data: { requestModel: _requestModel },
                    success: function(response) {
                        if (response.isSuccess) {
                            window.location.href = '/Author';
                        } else {
                            showToast(response.message || response.Message || "Failed to create author.");
                            isSubmitting = false;
                            $btn.prop('disabled', false).text('Save Author');
                        }
                    },
                    error: function(xhr) {
                        showToast("Error: " + xhr.statusText);
                        isSubmitting = false;
                        $btn.prop('disabled', false).text('Save Author');
                    }
                });
            });
        });
    </script>
}
