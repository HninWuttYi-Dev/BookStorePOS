@{
    ViewData["Title"] = "Create Book";
}

<div class="max-w-3xl mx-auto">
    <div class="mb-8 flex items-center gap-4">
        <a href="/Book" class="p-2 text-slate-400 hover:text-teal-600 hover:bg-teal-50 rounded-xl transition-colors focus:outline-none" title="Back to Book List">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        </a>
        <div>
            <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Create New Book</h1>
            <p class="text-slate-500 mt-1 text-sm font-medium">Add a new book to the inventory</p>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)] border border-slate-100 overflow-hidden p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        <div>
            <label for="title" class="block text-sm font-semibold text-slate-700 mb-2">Title <span class="text-red-500">*</span></label>
            <input type="text" id="title" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all" placeholder="e.g. The Great Gatsby">
            <span class="text-red-500 text-xs mt-1 hidden error-msg" id="titleError">Title is required.</span>
        </div>
        <div>
            <label for="author" class="block text-sm font-semibold text-slate-700 mb-2">Author <span class="text-red-500">*</span></label>
            <input type="text" id="author" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all" placeholder="e.g. F. Scott Fitzgerald">
            <span class="text-red-500 text-xs mt-1 hidden error-msg" id="authorError">Author is required.</span>
        </div>
        <div>
            <label for="genre" class="block text-sm font-semibold text-slate-700 mb-2">Genre <span class="text-red-500">*</span></label>
            <input type="text" id="genre" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all" placeholder="e.g. Classic">
            <span class="text-red-500 text-xs mt-1 hidden error-msg" id="genreError">Genre is required.</span>
        </div>
        <div>
            <label for="isbn" class="block text-sm font-semibold text-slate-700 mb-2">ISBN</label>
            <input type="text" id="isbn" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all" placeholder="e.g. 9780743273565">
            <span class="text-red-500 text-xs mt-1 hidden error-msg" id="isbnError">ISBN must be 10 or 13 digits.</span>
        </div>
        <div>
            <label for="price" class="block text-sm font-semibold text-slate-700 mb-2">Price (MMK) <span class="text-red-500">*</span></label>
            <input type="number" id="price" min="100" step="100" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all" placeholder="e.g. 15000">
            <span class="text-red-500 text-xs mt-1 hidden error-msg" id="priceError">Price must be greater than zero.</span>
        </div>
        <div>
            <label for="stockQuantity" class="block text-sm font-semibold text-slate-700 mb-2">Stock Quantity <span class="text-red-500">*</span></label>
            <input type="number" id="stockQuantity" min="0" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all" placeholder="e.g. 50">
            <span class="text-red-500 text-xs mt-1 hidden error-msg" id="stockError">Stock must be valid.</span>
        </div>
        <div>
            <label for="reorderLevel" class="block text-sm font-semibold text-slate-700 mb-2">Reorder Level</label>
            <input type="number" id="reorderLevel" min="0" value="5" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all">
        </div>
    </div>
    
    <div class="mb-6">
        <label for="photo" class="block text-sm font-semibold text-slate-700 mb-2">Cover Image</label>
        <div class="flex items-center gap-4">
            <input type="file" id="photo" accept="image/*" class="flex-1 px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all bg-slate-50 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-teal-50 file:text-teal-700 hover:file:bg-teal-100">
            <button type="button" id="btnClearPhoto" class="hidden px-4 py-2.5 bg-red-50 text-red-600 rounded-xl text-sm font-semibold hover:bg-red-100 transition-colors shadow-sm">
                Clear
            </button>
        </div>
    </div>

    <div class="mb-8">
        <label for="description" class="block text-sm font-semibold text-slate-700 mb-2">Description</label>
        <textarea id="description" rows="4" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all" placeholder="Enter book description here..."></textarea>
    </div>

    <div class="flex gap-4 justify-end">
        <a href="/Book" class="px-6 py-2.5 bg-slate-100 text-slate-700 rounded-xl text-sm font-semibold hover:bg-slate-200 transition-colors text-center">
            Back
        </a>
        <button type="button" id="btnSave" class="px-6 py-2.5 bg-teal-600 text-white rounded-xl text-sm font-semibold hover:bg-teal-700 transition-colors shadow-sm">
            Save Book
        </button>
    </div>
</div>
</div>

<!-- Toast Container for Errors -->
<div id="toastContainer" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 transition-opacity duration-300 opacity-0 pointer-events-none">
    <div class="bg-red-600 text-white px-6 py-3 rounded-full shadow-lg flex items-center gap-3">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span class="font-medium text-sm" id="toastText">Error message</span>
    </div>
</div>

@section Scripts {
    <script>
        function showToast(message) {
            $('#toastText').text(message);
            $('#toastContainer').removeClass('opacity-0 pointer-events-none');
            setTimeout(() => {
                $('#toastContainer').addClass('opacity-0 pointer-events-none');
            }, 4000);
        }

        // Clear error on typing
        $('input, textarea').on('input', function() {
            $(this).removeClass('border-red-500 focus:ring-red-500/50 focus:border-red-500');
            $(this).siblings('.error-msg').addClass('hidden');
        });

        // Photo file selection logic
        $('#photo').on('change', function() {
            if (this.files && this.files.length > 0) {
                $('#btnClearPhoto').removeClass('hidden');
            } else {
                $('#btnClearPhoto').addClass('hidden');
            }
        });

        $('#btnClearPhoto').on('click', function() {
            $('#photo').val(''); // Clear the file input
            $(this).addClass('hidden');
        });

        $('#btnSave').on('click', function() {
            // Reset errors
            $('.error-msg').addClass('hidden');
            $('input').removeClass('border-red-500 focus:ring-red-500/50 focus:border-red-500');

            let isValid = true;
            
            const title = $('#title').val().trim();
            const author = $('#author').val().trim();
            const genre = $('#genre').val().trim();
            const price = parseFloat($('#price').val() || 0);
            const stock = parseInt($('#stockQuantity').val() || 0);
            const isbn = $('#isbn').val().trim();

            if (!title) { $('#titleError').removeClass('hidden'); $('#title').addClass('border-red-500 focus:ring-red-500/50 focus:border-red-500'); isValid = false; }
            if (!author) { $('#authorError').removeClass('hidden'); $('#author').addClass('border-red-500 focus:ring-red-500/50 focus:border-red-500'); isValid = false; }
            if (!genre) { $('#genreError').removeClass('hidden'); $('#genre').addClass('border-red-500 focus:ring-red-500/50 focus:border-red-500'); isValid = false; }
            if (price <= 0) { $('#priceError').removeClass('hidden'); $('#price').addClass('border-red-500 focus:ring-red-500/50 focus:border-red-500'); isValid = false; }
            if (stock < 0 || $('#stockQuantity').val() === '') { $('#stockError').removeClass('hidden'); $('#stockQuantity').addClass('border-red-500 focus:ring-red-500/50 focus:border-red-500'); isValid = false; }
            
            if (isbn) {
                const cleanIsbn = isbn.replace(/-/g, '').replace(/ /g, '');
                if (cleanIsbn.length !== 10 && cleanIsbn.length !== 13) {
                    $('#isbnError').removeClass('hidden'); 
                    $('#isbn').addClass('border-red-500 focus:ring-red-500/50 focus:border-red-500'); 
                    isValid = false;
                }
            }

            if (!isValid) return;

            const $btn = $(this);
            $btn.prop('disabled', true).text('Saving...');

            const formData = new FormData();
            formData.append("Title", title);
            formData.append("Author", author);
            formData.append("Genre", genre);
            formData.append("Isbn", isbn);
            formData.append("Price", price);
            formData.append("StockQuantity", stock);
            formData.append("ReorderLevel", $('#reorderLevel').val() || 0);
            formData.append("Description", $('#description').val());

            const photoFile = $('#photo')[0].files[0];
            if (photoFile) {
                formData.append("photo", photoFile);
            }

            $.ajax({
                type: "POST",
                url: '/Book/Save',
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    if (response.isSuccess) {
                        // TempData in controller will handle the success toast on redirect
                        window.location.href = '/Book';
                    } else {
                        showToast(response.message || response.Message || "Failed to create book.");
                        $btn.prop('disabled', false).text('Save Book');
                    }
                },
                error: function(xhr) {
                    showToast("Server Error: " + xhr.statusText);
                    $btn.prop('disabled', false).text('Save Book');
                }
            });
        });
    </script>
}
