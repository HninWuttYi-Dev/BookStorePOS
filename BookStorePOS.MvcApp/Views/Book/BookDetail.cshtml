@using BookStorePOS.Shared.Models.Book
@{
    ViewData["Title"] = "Book Detail";
    var book = ViewData["Book"] as BookModel;
    if (book == null) return;
    
    var stockBg = book.TotalStockQuantity == 0 ? "bg-red-100 text-red-800 border-red-200" : (book.TotalStockQuantity <= (book.Editions?.FirstOrDefault()?.ReorderLevel ?? 0) ? "bg-amber-100 text-amber-800 border-amber-200" : "bg-emerald-100 text-emerald-800 border-emerald-200");
}

<div class="max-w-4xl mx-auto">
    <div class="mb-8 flex items-center justify-between">
        <div class="flex items-center gap-4">
            <a href="/Book" class="p-2 text-slate-400 hover:text-teal-600 hover:bg-teal-50 rounded-xl transition-colors focus:outline-none" title="Back to Book List">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            </a>
            <div>
                <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Book Details</h1>
                <p class="text-slate-500 mt-1 text-sm font-medium">View complete information for this book</p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <button type="button" id="btnAddEdition" class="px-5 py-2.5 bg-indigo-50 text-indigo-600 font-semibold rounded-xl hover:bg-indigo-100 transition-colors shadow-sm flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                Add Edition
            </button>
            <a href="/Book/Edit/@book.BookId" class="px-5 py-2.5 bg-white border border-slate-200 text-teal-600 font-semibold rounded-xl hover:bg-teal-50 hover:border-teal-200 transition-colors shadow-sm flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                Edit
            </a>
            <button type="button" data-id="@book.BookId" class="btnDelete px-5 py-2.5 bg-red-50 text-red-600 font-semibold rounded-xl hover:bg-red-100 transition-colors shadow-sm flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                Delete
            </button>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)] border border-slate-100 overflow-hidden flex flex-col md:flex-row">
        <!-- Cover Image -->
        <div class="w-full md:w-1/3 bg-slate-50 flex items-center justify-center p-8 border-b md:border-b-0 md:border-r border-slate-100">
            @if (!string.IsNullOrEmpty(book.Editions?.FirstOrDefault()?.CoverImageUrl))
            {
                <img src="@(book.Editions?.FirstOrDefault()?.CoverImageUrl)" alt="@book.Title Cover" class="w-full max-w-[240px] h-auto object-cover rounded-lg shadow-md aspect-[2/3]" />
            }
            else
            {
                <div class="w-full max-w-[240px] aspect-[2/3] bg-slate-200 rounded-lg shadow-inner flex flex-col items-center justify-center text-slate-400">
                    <svg class="w-16 h-16 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    <span class="font-medium text-sm">No Cover Image</span>
                </div>
            }
        </div>
        
        <!-- Book Details -->
        <div class="w-full md:w-2/3 p-8 flex flex-col">
            <div class="mb-2">
                <span class="inline-block px-3 py-1 bg-slate-100 text-slate-600 text-xs font-bold rounded-full mb-3 uppercase tracking-wider">@book.Genre</span>
                <h2 class="text-3xl font-extrabold text-slate-900 leading-tight mb-2">@book.Title</h2>
                <p class="text-lg text-slate-600 font-medium">By <span class="text-teal-700">@book.Author</span></p>
            </div>
            
            <div class="mt-8 grid grid-cols-2 gap-y-6 gap-x-8">
                <div>
                    <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">ISBN</h4>
                    <p class="text-slate-800 font-medium">@(string.IsNullOrEmpty(book.Editions?.FirstOrDefault()?.Isbn) ? "N/A" : book.Editions?.FirstOrDefault()?.Isbn)</p>
                </div>
                <div>
                    <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Price</h4>
                    <p class="text-xl font-bold text-slate-900">@book.StartingPrice.ToString("#,##0") <span class="text-sm font-medium text-slate-500">MMK</span></p>
                </div>
                <div>
                    <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Stock Status</h4>
                    <span class="inline-flex items-center justify-center px-3 py-1 rounded-full text-sm font-bold border @stockBg">
                        @book.TotalStockQuantity in stock
                    </span>
                </div>
                <div>
                    <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Reorder Level</h4>
                    <p class="text-slate-800 font-medium">@(book.Editions?.FirstOrDefault()?.ReorderLevel ?? 0)</p>
                </div>
            </div>
            
            <div class="mt-8 pt-8 border-t border-slate-100 flex-1">
                <h4 class="text-sm font-bold text-slate-900 mb-3">Description</h4>
                <div class="text-slate-600 leading-relaxed text-sm">
                    @(string.IsNullOrEmpty(book.Description) ? "No description available." : book.Description)
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal (Same as BookList) -->
<div id="deleteModal" class="fixed inset-0 z-50 flex items-center justify-center hidden">
    <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm transition-opacity" id="deleteModalBackdrop"></div>
    <div class="relative bg-white rounded-2xl shadow-xl w-full max-w-md mx-4 p-6 overflow-hidden transform transition-all flex flex-col items-center text-center">
        <div class="w-12 h-12 rounded-full bg-red-100 flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
        </div>
        <h3 class="text-lg font-bold text-slate-900 mb-2">Delete Book</h3>
        <p class="text-sm text-slate-500 mb-6">Are you sure you want to delete this book? This action cannot be undone.</p>
        <div class="flex gap-3 w-full">
            <button type="button" id="btnCancelDelete" class="flex-1 px-4 py-2.5 bg-slate-100 text-slate-700 rounded-xl text-sm font-semibold hover:bg-slate-200 transition-colors">Cancel</button>
            <button type="button" id="btnConfirmDelete" class="flex-1 px-4 py-2.5 bg-red-600 text-white rounded-xl text-sm font-semibold hover:bg-red-700 transition-colors shadow-sm">Delete</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            let bookIdToDelete = null;
            const $deleteModal = $('#deleteModal');

            function closeDeleteModal() {
                $deleteModal.addClass('hidden');
                bookIdToDelete = null;
            }

            $('.btnDelete').on('click', function() {
                bookIdToDelete = $(this).data('id');
                $deleteModal.removeClass('hidden');
            });

            $('#btnCancelDelete, #deleteModalBackdrop').on('click', function() {
                closeDeleteModal();
            });

            $('#btnConfirmDelete').on('click', function() {
                if (!bookIdToDelete) return;
                const $btn = $(this);
                $btn.prop('disabled', true).text('Deleting...');

                $.ajax({
                    type: 'POST',
                    url: '/Book/Delete',
                    data: { BookId: bookIdToDelete },
                    success: function(response) {
                        if (response.isSuccess) {
                            window.location.href = '/Book';
                        } else {
                            alert(response.message || response.Message || "Failed to delete book.");
                            $btn.prop('disabled', false).text('Delete');
                            closeDeleteModal();
                        }
                    },
                    error: function(xhr) {
                        alert("Server Error: " + xhr.statusText);
                        $btn.prop('disabled', false).text('Delete');
                        closeDeleteModal();
                    }
                });
            });

            // Add Edition Logic
            const $editionModalContainer = $('#editionModalContainer');

            $('#btnAddEdition').on('click', function() {
                $.ajax({
                    url: '/Book/GetBookEditionModal?bookId=@book.BookId',
                    type: 'GET',
                    success: function(html) {
                        $editionModalContainer.html(html);
                        
                        const $addEditionModal = $('#addEditionModal');
                        const $addEditionForm = $('#addEditionForm');
                        
                        $addEditionModal.removeClass('hidden');

                        function closeAddEditionModal() {
                            $addEditionModal.addClass('hidden');
                            $addEditionForm[0].reset();
                            setTimeout(() => $editionModalContainer.empty(), 300); // Clear after animation
                        }

                        $('#btnCancelAddEdition, #addEditionModalBackdrop').on('click', function() {
                            closeAddEditionModal();
                        });

                        // Photo file selection logic
                        $('#photo').on('change', function() {
                            if (this.files && this.files.length > 0) {
                                $('#btnClearPhoto').removeClass('hidden');
                            } else {
                                $('#btnClearPhoto').addClass('hidden');
                            }
                        });

                        $('#btnClearPhoto').on('click', function() {
                            $('#photo').val(''); // Clear the file input
                            $(this).addClass('hidden');
                        });

                        $('#btnSaveEdition').on('click', function() {
                            const $btn = $(this);
                            const bookId = $btn.data('bookid');
                            $btn.prop('disabled', true).text('Saving...');
                            
                            const formData = new FormData($addEditionForm[0]);

                            $.ajax({
                                type: 'POST',
                                url: '/Book/CreateEdition/' + bookId,
                                data: formData,
                                processData: false,
                                contentType: false,
                                success: function(response) {
                                    if (response.isSuccess) {
                                        window.location.reload();
                                    } else {
                                        alert(response.message || response.Message || "Failed to create edition.");
                                        $btn.prop('disabled', false).text('Save Edition');
                                    }
                                },
                                error: function(xhr) {
                                    alert("Server Error: " + xhr.statusText);
                                    $btn.prop('disabled', false).text('Save Edition');
                                }
                            });
                        });
                    },
                    error: function() {
                        alert("Failed to load edition modal.");
                    }
                });
            });
        });
    </script>
}

<div id="editionModalContainer"></div>


