@{
    ViewData["Title"] = "Edit Book";

    int bookId = 0;
    if (ViewData["Id"] != null)
    {
        bookId = Convert.ToInt32(ViewData["Id"]);
    }
    string title = ViewData["BookTitle"]?.ToString() ?? "";
    string author = ViewData["Author"]?.ToString() ?? "";
    string genre = ViewData["Genre"]?.ToString() ?? "";
    string isbn = ViewData["Isbn"]?.ToString() ?? "";
    string description = ViewData["Description"]?.ToString() ?? "";
    string coverImageUrl = ViewData["CoverImageUrl"]?.ToString() ?? "";
    decimal price = 0;
    if (ViewData["Price"] != null)
    {
        price = Convert.ToDecimal(ViewData["Price"]);
    }
    int stockQuantity = 0;
    if (ViewData["StockQuantity"] != null)
    {
        stockQuantity = Convert.ToInt32(ViewData["StockQuantity"]);
    }
    int reorderLevel = 0;
    if (ViewData["ReorderLevel"] != null)
    {
        reorderLevel = Convert.ToInt32(ViewData["ReorderLevel"]);
    }
}

<div class="max-w-3xl mx-auto">
    <div class="mb-8 flex items-center gap-4">
        <a href="/Book" class="p-2 text-slate-400 hover:text-teal-600 hover:bg-teal-50 rounded-xl transition-colors focus:outline-none" title="Back to Book List">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        </a>
        <div>
            <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Edit Book</h1>
            <p class="text-slate-500 mt-1 text-sm font-medium">Update the details of the book</p>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)] border border-slate-100 overflow-hidden p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        <div>
            <label for="title" class="block text-sm font-semibold text-slate-700 mb-2">Title <span class="text-red-500">*</span></label>
            <input type="text" id="title" value="@title" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all" placeholder="e.g. The Great Gatsby">
            <span class="text-red-500 text-xs mt-1 hidden error-msg" id="titleError">Title is required.</span>
        </div>
        <div class="relative" id="authorSelectContainer">
            <label class="block text-sm font-semibold text-slate-700 mb-2">Author <span class="text-red-500">*</span></label>
            <button type="button" id="authorSelectBtn" class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all flex items-center justify-between text-left">
                <span id="authorSelectText" class="truncate text-slate-900">@(string.IsNullOrEmpty(author) ? "Choose an author..." : author)</span>
                <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>
            <input type="hidden" id="authorId" value="0">
            <input type="hidden" id="author" value="@author">
            
            <div id="authorDropdownMenu" class="hidden absolute z-50 w-full mt-1 bg-white rounded-xl shadow-lg border border-slate-100 overflow-hidden flex flex-col">
                <div class="p-2 border-b border-slate-100 bg-slate-50/50">
                    <input type="text" id="authorSearchInput" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all" placeholder="Search authors..." autocomplete="off">
                </div>
                <ul id="authorList" class="py-1 text-sm text-slate-700 max-h-60 overflow-y-auto">
                    <!-- Items injected by JS -->
                </ul>
            </div>
            <span class="text-red-500 text-xs mt-1 hidden error-msg" id="authorError">Author is required.</span>
        </div>
        <div class="relative" id="genreSelectContainer">
            <label class="block text-sm font-semibold text-slate-700 mb-2">Genre <span class="text-red-500">*</span></label>
            <button type="button" id="genreSelectBtn" class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all flex items-center justify-between text-left">
                <span id="genreSelectText" class="truncate text-slate-900">@(string.IsNullOrEmpty(genre) ? "Choose a genre..." : genre)</span>
                <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>
            <input type="hidden" id="genreId" value="0">
            <input type="hidden" id="genre" value="@genre">
            
            <div id="genreDropdownMenu" class="hidden absolute z-50 w-full mt-1 bg-white rounded-xl shadow-lg border border-slate-100 overflow-hidden flex flex-col">
                <div class="p-2 border-b border-slate-100 bg-slate-50/50">
                    <input type="text" id="genreSearchInput" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all" placeholder="Search genres..." autocomplete="off">
                </div>
                <ul id="genreList" class="py-1 text-sm text-slate-700 max-h-60 overflow-y-auto">
                    <!-- Items injected by JS -->
                </ul>
            </div>
            <span class="text-red-500 text-xs mt-1 hidden error-msg" id="genreError">Genre is required.</span>
        </div>
        <div>
            <label for="isbn" class="block text-sm font-semibold text-slate-700 mb-2">ISBN</label>
            <input type="text" id="isbn" value="@isbn" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all" placeholder="e.g. 9780743273565">
            <span class="text-red-500 text-xs mt-1 hidden error-msg" id="isbnError">ISBN must be 10 or 13 digits.</span>
        </div>
        <div>
            <label for="price" class="block text-sm font-semibold text-slate-700 mb-2">Price (MMK) <span class="text-red-500">*</span></label>
            <input type="number" id="price" value="@price" min="100" step="100" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all" placeholder="e.g. 15000">
            <span class="text-red-500 text-xs mt-1 hidden error-msg" id="priceError">Price must be greater than zero.</span>
        </div>
        <div>
            <label for="stockQuantity" class="block text-sm font-semibold text-slate-700 mb-2">Stock Quantity <span class="text-red-500">*</span></label>
            <input type="number" id="stockQuantity" value="@stockQuantity" min="0" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all" placeholder="e.g. 50">
            <span class="text-red-500 text-xs mt-1 hidden error-msg" id="stockError">Stock must be valid.</span>
        </div>
        <div>
            <label for="reorderLevel" class="block text-sm font-semibold text-slate-700 mb-2">Reorder Level</label>
            <input type="number" id="reorderLevel" value="@reorderLevel" min="0" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all">
        </div>
    </div>
    
    <div class="mb-6">
        <label for="photo" class="block text-sm font-semibold text-slate-700 mb-2">Update Cover Image (Optional)</label>
        
        @if (!string.IsNullOrEmpty(coverImageUrl))
        {
            <div class="mb-3 flex items-center gap-4 p-3 border border-slate-100 rounded-xl bg-slate-50">
                <img src="@coverImageUrl" alt="Current Cover" class="w-12 h-16 object-cover rounded shadow-sm border border-slate-200">
                <div>
                    <p class="text-sm font-medium text-slate-700">Current Image Exists</p>
                    <p class="text-xs text-slate-500">Uploading a new file will replace this image.</p>
                </div>
            </div>
        }
        
        <div class="flex items-center gap-4">
            <input type="file" id="photo" accept="image/*" class="flex-1 px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all bg-slate-50 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-teal-50 file:text-teal-700 hover:file:bg-teal-100">
            <button type="button" id="btnClearPhoto" class="hidden px-4 py-2.5 bg-red-50 text-red-600 rounded-xl text-sm font-semibold hover:bg-red-100 transition-colors shadow-sm">
                Clear
            </button>
        </div>
    </div>

    <div class="mb-8">
        <label for="description" class="block text-sm font-semibold text-slate-700 mb-2">Description</label>
        <textarea id="description" rows="4" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all" placeholder="Enter book description here...">@description</textarea>
    </div>

    <div class="flex justify-end gap-3 mt-8 pt-6 border-t border-slate-100">
        <a href="/Book" class="px-6 py-2.5 bg-white border border-slate-200 text-slate-700 rounded-xl text-sm font-semibold hover:bg-slate-50 hover:text-slate-900 transition-colors text-center shadow-sm">
            Cancel
        </a>
        <button type="button" id="btnUpdate" class="px-6 py-2.5 bg-teal-600 text-white rounded-xl text-sm font-semibold hover:bg-teal-700 transition-colors shadow-sm">
            Update Book
        </button>
    </div>
</div>
</div>

<!-- Toast Container for Errors -->
<div id="toastContainer" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 transition-opacity duration-300 opacity-0 pointer-events-none">
    <div class="bg-red-600 text-white px-6 py-3 rounded-full shadow-lg flex items-center gap-3">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span class="font-medium text-sm" id="toastText">Error message</span>
    </div>
</div>

@section Scripts {
    <script>
        function showToast(message) {
            $('#toastText').text(message);
            $('#toastContainer').removeClass('opacity-0 pointer-events-none');
            setTimeout(() => {
                $('#toastContainer').addClass('opacity-0 pointer-events-none');
            }, 4000);
        }

        // Clear error on typing
        $('input, textarea').on('input', function() {
            $(this).removeClass('border-red-500 focus:ring-red-500/50 focus:border-red-500');
            $(this).siblings('.error-msg').addClass('hidden');
            $(this).parent().siblings('.error-msg').addClass('hidden');
        });

        // Author Select Logic
        const $authorBtn = $('#authorSelectBtn');
        const $authorText = $('#authorSelectText');
        const $authorMenu = $('#authorDropdownMenu');
        const $authorSearch = $('#authorSearchInput');
        const $authorList = $('#authorList');
        let authorDebounceTimer;

        $authorBtn.on('click', function(e) {
            e.stopPropagation();
            $authorMenu.toggleClass('hidden');
            if (!$authorMenu.hasClass('hidden')) {
                $authorSearch.val('').focus();
                loadAuthors('');
            }
        });

        $authorSearch.on('click', function(e) {
            e.stopPropagation();
        });

        $authorSearch.on('input', function() {
            const query = $(this).val();
            clearTimeout(authorDebounceTimer);
            
            authorDebounceTimer = setTimeout(() => {
                loadAuthors(query);
            }, 300);
        });

        function loadAuthors(query) {
            $.ajax({
                url: '/Author/Search',
                type: 'GET',
                data: { query: query },
                success: function(data) {
                    $authorList.empty();
                    let exactMatch = false;

                    if (data && data.length > 0) {
                        data.forEach(item => {
                            if (item.authorName.toLowerCase() === query.trim().toLowerCase()) {
                                exactMatch = true;
                            }
                            $authorList.append(`
                                <li>
                                    <button type="button" class="author-option w-full text-left px-4 py-2 hover:bg-slate-50 focus:bg-slate-50 focus:outline-none transition-colors" data-id="${item.authorId}" data-name="${item.authorName}">
                                        ${item.authorName}
                                    </button>
                                </li>
                            `);
                        });
                    } else if (!query.trim()) {
                        $authorList.append(`<li class="px-4 py-3 text-slate-500 text-center text-xs">Type to search authors</li>`);
                    } else {
                        $authorList.append(`<li class="px-4 py-2 text-slate-500 text-center text-xs">No matches found</li>`);
                    }

                    if (query.trim() && !exactMatch) {
                        $authorList.append(`
                            <li class="border-t border-slate-100">
                                <button type="button" class="author-option w-full text-left px-4 py-2 hover:bg-teal-50 focus:bg-teal-50 focus:outline-none transition-colors text-teal-600 font-medium flex items-center gap-2" data-id="0" data-name="${query.trim()}">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                                    Add "${query.trim()}"
                                </button>
                            </li>
                        `);
                    }
                }
            });
        }

        $(document).on('click', '.author-option', function(e) {
            e.stopPropagation();
            const id = $(this).data('id');
            const name = $(this).data('name');
            
            $('#author').val(name);
            $('#authorId').val(id);
            $authorText.text(name).removeClass('text-slate-500').addClass('text-slate-900');
            $authorMenu.addClass('hidden');
            
            $authorBtn.removeClass('border-red-500 focus:ring-red-500/50 focus:border-red-500');
            $('#authorError').addClass('hidden');
        });

        $(document).on('click', function(e) {
            if (!$(e.target).closest('#authorSelectContainer').length) {
                $authorMenu.addClass('hidden');
            }
        });

        // Genre Select Logic
        const $genreBtn = $('#genreSelectBtn');
        const $genreText = $('#genreSelectText');
        const $genreMenu = $('#genreDropdownMenu');
        const $genreSearch = $('#genreSearchInput');
        const $genreList = $('#genreList');
        let genreDebounceTimer;

        $genreBtn.on('click', function(e) {
            e.stopPropagation();
            $genreMenu.toggleClass('hidden');
            if (!$genreMenu.hasClass('hidden')) {
                $genreSearch.val('').focus();
                loadGenres('');
            }
        });

        $genreSearch.on('click', function(e) {
            e.stopPropagation();
        });

        $genreSearch.on('input', function() {
            const query = $(this).val();
            clearTimeout(genreDebounceTimer);
            
            genreDebounceTimer = setTimeout(() => {
                loadGenres(query);
            }, 300);
        });

        function loadGenres(query) {
            $.ajax({
                url: '/Genre/Search',
                type: 'GET',
                data: { query: query },
                success: function(data) {
                    $genreList.empty();
                    let exactMatch = false;

                    if (data && data.length > 0) {
                        data.forEach(item => {
                            if (item.genreName.toLowerCase() === query.trim().toLowerCase()) {
                                exactMatch = true;
                            }
                            $genreList.append(`
                                <li>
                                    <button type="button" class="genre-option w-full text-left px-4 py-2 hover:bg-slate-50 focus:bg-slate-50 focus:outline-none transition-colors" data-id="${item.genreId}" data-name="${item.genreName}">
                                        ${item.genreName}
                                    </button>
                                </li>
                            `);
                        });
                    } else if (!query.trim()) {
                        $genreList.append(`<li class="px-4 py-3 text-slate-500 text-center text-xs">Type to search genres</li>`);
                    } else {
                        $genreList.append(`<li class="px-4 py-2 text-slate-500 text-center text-xs">No matches found</li>`);
                    }

                    if (query.trim() && !exactMatch) {
                        $genreList.append(`
                            <li class="border-t border-slate-100">
                                <button type="button" class="genre-option w-full text-left px-4 py-2 hover:bg-teal-50 focus:bg-teal-50 focus:outline-none transition-colors text-teal-600 font-medium flex items-center gap-2" data-id="0" data-name="${query.trim()}">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                                    Add "${query.trim()}"
                                </button>
                            </li>
                        `);
                    }
                }
            });
        }

        $(document).on('click', '.genre-option', function(e) {
            e.stopPropagation();
            const id = $(this).data('id');
            const name = $(this).data('name');
            
            $('#genre').val(name);
            $('#genreId').val(id);
            $genreText.text(name).removeClass('text-slate-500').addClass('text-slate-900');
            $genreMenu.addClass('hidden');
            
            $genreBtn.removeClass('border-red-500 focus:ring-red-500/50 focus:border-red-500');
            $('#genreError').addClass('hidden');
        });

        $(document).on('click', function(e) {
            if (!$(e.target).closest('#genreSelectContainer').length) {
                $genreMenu.addClass('hidden');
            }
        });

        // Photo file selection logic
        $('#photo').on('change', function() {
            if (this.files && this.files.length > 0) {
                $('#btnClearPhoto').removeClass('hidden');
            } else {
                $('#btnClearPhoto').addClass('hidden');
            }
        });

        $('#btnClearPhoto').on('click', function() {
            $('#photo').val(''); // Clear the file input
            $(this).addClass('hidden');
        });

        $('#btnUpdate').on('click', function() {
            // Reset errors
            $('.error-msg').addClass('hidden');
            $('input').removeClass('border-red-500 focus:ring-red-500/50 focus:border-red-500');

            let isValid = true;
            
            const title = $('#title').val().trim();
            const author = $('#author').val().trim();
            const genre = $('#genre').val().trim();
            const price = parseFloat($('#price').val() || 0);
            const stock = parseInt($('#stockQuantity').val() || 0);
            const isbn = $('#isbn').val().trim();

            if (!title) { $('#titleError').removeClass('hidden'); $('#title').addClass('border-red-500 focus:ring-red-500/50 focus:border-red-500'); isValid = false; }
            if (!author) { $('#authorError').removeClass('hidden'); $authorBtn.addClass('border-red-500 focus:ring-red-500/50 focus:border-red-500'); isValid = false; }
            if (!genre) { $('#genreError').removeClass('hidden'); $genreBtn.addClass('border-red-500 focus:ring-red-500/50 focus:border-red-500'); isValid = false; }
            if (price <= 0) { $('#priceError').removeClass('hidden'); $('#price').addClass('border-red-500 focus:ring-red-500/50 focus:border-red-500'); isValid = false; }
            if (stock < 0 || $('#stockQuantity').val() === '') { $('#stockError').removeClass('hidden'); $('#stockQuantity').addClass('border-red-500 focus:ring-red-500/50 focus:border-red-500'); isValid = false; }
            
            if (isbn) {
                const cleanIsbn = isbn.replace(/-/g, '').replace(/ /g, '');
                if (cleanIsbn.length !== 10 && cleanIsbn.length !== 13) {
                    $('#isbnError').removeClass('hidden'); 
                    $('#isbn').addClass('border-red-500 focus:ring-red-500/50 focus:border-red-500'); 
                    isValid = false;
                }
            }

            if (!isValid) return;

            const $btn = $(this);
            $btn.prop('disabled', true).text('Updating...');

            const formData = new FormData();
            formData.append("Title", title);
            formData.append("Author", author);
            formData.append("AuthorId", $('#authorId').val());
            formData.append("Genre", genre);
            formData.append("GenreId", $('#genreId').val());
            formData.append("Isbn", isbn);
            formData.append("Price", price);
            formData.append("StockQuantity", stock);
            formData.append("ReorderLevel", $('#reorderLevel').val() || 0);
            formData.append("Description", $('#description').val());

            const photoFile = $('#photo')[0].files[0];
            if (photoFile) {
                formData.append("photo", photoFile);
            }

            $.ajax({
                type: "POST",
                url: '/Book/Update/@bookId',
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    if (response.isSuccess) {
                        // TempData in controller will handle the success toast on redirect
                        window.location.href = '/Book';
                    } else {
                        showToast(response.message || response.Message || "Failed to update book.");
                        $btn.prop('disabled', false).text('Update Book');
                    }
                },
                error: function(xhr) {
                    showToast("Server Error: " + xhr.statusText);
                    $btn.prop('disabled', false).text('Update Book');
                }
            });
        });
    </script>
}
