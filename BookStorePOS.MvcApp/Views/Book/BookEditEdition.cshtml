@model BookModel
@{
    ViewData["Title"] = "Edit Edition";
    var editionId = ViewData["EditionId"]?.ToString();
    var editionName = ViewData["EditionName"]?.ToString();
    var isbn = ViewData["Isbn"]?.ToString();
    var price = ViewData["Price"]?.ToString();
    var stockQuantity = ViewData["StockQuantity"]?.ToString();
    var reorderLevel = ViewData["ReorderLevel"]?.ToString();
    var coverImageUrl = ViewData["CoverImageUrl"]?.ToString();
    var pubDate = ViewData["PublishDate"] as DateTime?;
    var publishDate = pubDate.HasValue ? pubDate.Value.ToString("yyyy-MM-dd") : "";
    var pageCount = ViewData["PageCount"]?.ToString();
    var editionNote = ViewData["EditionNote"]?.ToString();
}

<div class="max-w-3xl mx-auto">
    <div class="mb-8 flex items-center gap-4">
        <a href="/Book" class="p-2 text-slate-400 hover:text-teal-600 hover:bg-teal-50 rounded-xl transition-colors focus:outline-none" title="Back to Book List">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        </a>
        <div>
            <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Edit Edition</h1>
            <p class="text-sm text-slate-500 mt-1 font-medium">Edit edition for <strong>@ViewData["BookTitle"]</strong> by @ViewData["Author"]</p>
        </div>
    </div>

<div class="bg-white rounded-2xl shadow-[0_4px_24px_-4px_rgba(42,36,33,0.06)] border border-[#EDE7DF] overflow-hidden">
    <div class="p-8">
        <form id="editEditionForm" enctype="multipart/form-data">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Edition Name <span class="text-red-500">*</span></label>
                    <input type="text" name="EditionName" value="@editionName" required class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all" placeholder="e.g. 2nd Edition">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">ISBN</label>
                    <input type="text" name="Isbn" value="@isbn" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all" placeholder="e.g. 9781234567890">
                </div>
                
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Price (MMK) <span class="text-red-500">*</span></label>
                    <input type="number" name="Price" value="@price" required min="100" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all" placeholder="e.g. 15000">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Stock Quantity <span class="text-red-500">*</span></label>
                    <input type="number" name="StockQuantity" value="@stockQuantity" required min="0" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all" placeholder="e.g. 50">
                </div>
                
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Reorder Level</label>
                    <input type="number" name="ReorderLevel" value="@reorderLevel" min="0" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all">
                </div>
                <div>
                    <label for="publishDate" class="block text-sm font-semibold text-slate-700 mb-2">Publication Date</label>
                    <input type="text" id="publishDate" name="PublishDate" value="@publishDate" placeholder="dd/mm/yyyy" max="@DateTime.Today.ToString("yyyy-MM-dd")" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all bg-white" autocomplete="off">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Page Count</label>
                    <input type="number" name="PageCount" value="@pageCount" min="1" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all" placeholder="e.g. 350">
                </div>
            </div>

            <div class="mb-6">
                <label class="block text-sm font-semibold text-slate-700 mb-2">About this Edition (Edition Notes)</label>
                <textarea name="EditionNote" rows="3" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all" placeholder="e.g. Includes 15 full-color illustrations...">@editionNote</textarea>
            </div>
            
            <div class="mb-6">
                <label for="photo" class="block text-sm font-semibold text-slate-700 mb-2">Update Cover Image</label>
                
                @if (!string.IsNullOrEmpty(coverImageUrl))
                {
                    <div class="mb-3 flex items-center gap-4 p-3 border border-slate-100 rounded-xl bg-slate-50">
                        <img src="@coverImageUrl" alt="Current Cover" class="w-12 h-16 object-cover rounded shadow-sm border border-slate-200">
                        <div>
                            <p class="text-sm font-medium text-slate-700">Current Image Exists</p>
                            <p class="text-xs text-slate-500">Uploading a new file will replace this image.</p>
                        </div>
                    </div>
                }
                
                <div class="flex items-center gap-4">
                    <input type="file" name="photo" id="photo" accept="image/*" class="flex-1 px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all bg-slate-50 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-teal-50 file:text-teal-700 hover:file:bg-teal-100">
                    <button type="button" id="btnClearPhoto" class="hidden px-4 py-2.5 bg-red-50 text-red-600 rounded-xl text-sm font-semibold hover:bg-red-100 transition-colors shadow-sm">
                        Clear
                    </button>
                </div>
            </div>
        </form>
    </div>
    
    <div class="px-8 py-4 bg-slate-50 border-t border-slate-100 flex justify-end gap-3">
        <a href="/Book" class="px-6 py-2.5 bg-white text-slate-700 border border-slate-200 rounded-xl text-sm font-semibold hover:bg-slate-50 transition-colors">
            Cancel
        </a>
        <button type="button" id="btnSaveEdition" class="px-6 py-2.5 bg-teal-600 text-white rounded-xl text-sm font-semibold hover:bg-teal-700 transition-colors shadow-sm">
            Update Edition
        </button>
    </div>
</div>
</div>

@section Scripts {
    <script>
        function showToast(message, isSuccess = false) {
            if (typeof window.showToast === 'function') {
                window.showToast(message, isSuccess);
            }
        }

        $(document).ready(function() {
            const bookId = @Model.BookId;
            const editionId = @editionId;

            $('#photo').on('change', function() {
                if (this.files && this.files.length > 0) {
                    $('#btnClearPhoto').removeClass('hidden');
                } else {
                    $('#btnClearPhoto').addClass('hidden');
                }
            });

            $('#btnClearPhoto').on('click', function() {
                $('#photo').val(''); 
                $(this).addClass('hidden');
            });

            if (typeof flatpickr === 'function') {
                flatpickr('#publishDate', {
                    dateFormat: "Y-m-d",
                    altInput: true,
                    altFormat: "d/m/Y",
                    maxDate: "today",
                    @if (!string.IsNullOrEmpty(publishDate))
                    {
                        <text>defaultDate: "@publishDate",</text>
                    }
                    altInputClass: "w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all bg-white cursor-pointer"
                });
            }

            const initialFormData = $('#editEditionForm').serialize();

            let isSubmitting = false;

            $('#btnSaveEdition').on('click', function() {
                if (isSubmitting) return;

                const $btn = $(this);
                const $form = $('#editEditionForm');
                
                // HTML5 Validation
                if (!$form[0].checkValidity()) {
                    $form[0].reportValidity();
                    return;
                }

                const pubDateVal = $('#publishDate').val();
                if (pubDateVal) {
                    const selectedDate = new Date(pubDateVal);
                    const today = new Date();
                    today.setHours(23, 59, 59, 999);
                    if (selectedDate > today) {
                        showToast("Publication Date cannot be in the future.");
                        return;
                    }
                }

                // Check if anything actually changed
                if ($form.serialize() === initialFormData && !$('#photo').val()) {
                    showToast('Please update at least one field to update edition.');
                    return;
                }

                isSubmitting = true;
                $btn.prop('disabled', true).addClass('opacity-50 cursor-not-allowed pointer-events-none').text('Updating...');
                
                const formData = new FormData($form[0]);

                $.ajax({
                    type: 'POST',
                    url: '/Book/UpdateEditionSave/' + bookId + '?editionId=' + editionId,
                    data: formData,
                    processData: false,
                    contentType: false,
                    dataType: 'json',
                    success: function(response) {
                        if (response && (response.isSuccess || response.IsSuccess)) {
                            $btn.text('Updated!');
                            window.location.href = '/Book';
                        } else {
                            showToast(response?.message || response?.Message || "Failed to update edition.");
                            isSubmitting = false;
                            $btn.prop('disabled', false).removeClass('opacity-50 cursor-not-allowed pointer-events-none').text('Update Edition');
                        }
                    },
                    error: function(xhr) {
                        let errMsg = "Server Error: " + (xhr.statusText || "Failed to update edition");
                        try {
                            const errObj = JSON.parse(xhr.responseText);
                            if (errObj?.message) errMsg = errObj.message;
                        } catch (e) {}
                        showToast(errMsg);
                        isSubmitting = false;
                        $btn.prop('disabled', false).removeClass('opacity-50 cursor-not-allowed pointer-events-none').text('Update Edition');
                    }
                });
            });
        });
    </script>
}
