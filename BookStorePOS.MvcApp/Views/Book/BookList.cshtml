@model BookListResponseModel;
@{
    ViewData["Title"] = "Book List";
    var books = ViewData["Books"] as List<BookModel> ?? new List<BookModel>();
    int currentPage = ViewData["CurrentPage"] != null ? Convert.ToInt32(ViewData["CurrentPage"]) : 1;
    int totalPages = ViewData["TotalPages"] != null ? Convert.ToInt32(ViewData["TotalPages"]) : 1;
    
    bool hasMessage = TempData["Message"] != null;
    bool isSuccess = TempData["isSuccess"] != null ? Convert.ToBoolean(TempData["isSuccess"]) : false;
    string message = TempData["Message"]?.ToString() ?? string.Empty;

    int count = (currentPage - 1) * 20;
    string titleFilter = ViewData["TitleFilter"]?.ToString();
    string authorFilter = ViewData["AuthorFilter"]?.ToString();
    string genreFilter = ViewData["GenreFilter"]?.ToString();
    string isbnFilter = ViewData["IsbnFilter"]?.ToString();
}

<div class="mb-8 flex justify-between items-center">
    <div>
        <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Book List</h1>
        <p class="text-slate-500 mt-2 text-sm font-medium">Manage and view all books in the store</p>
    </div>
    <a href="/Book/Create" class="px-5 py-2.5 bg-teal-600 text-white font-semibold rounded-xl hover:bg-teal-700 transition-colors shadow-sm flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
        New Book
    </a>
</div>

@if (hasMessage)
{
    <div id="toastMessage" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 px-6 py-3 rounded-full shadow-lg flex items-center gap-3 transition-opacity duration-300 @(isSuccess ? "bg-emerald-600 text-white" : "bg-red-600 text-white")">
        @if (isSuccess)
        {
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
        }
        else
        {
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        }
        <span class="font-medium text-sm">@message</span>
        <button onclick="document.getElementById('toastMessage').remove()" class="ml-2 hover:opacity-75 focus:outline-none">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
    </div>
}

<form method="get" action="/Book" class="mb-6 w-full flex flex-col md:flex-row items-end gap-4 bg-white p-5 rounded-2xl border border-slate-100 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)]">
    <div class="flex flex-col flex-1 w-full">
        <label for="isbn" class="text-xs font-semibold text-slate-500 mb-1.5 ml-1">ISBN</label>
        <input type="text" id="isbn" name="Isbn" value="@isbnFilter" placeholder="Search by ISBN" class="px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all w-full" />
    </div>
    <div class="flex flex-col flex-1 w-full">
        <label for="title" class="text-xs font-semibold text-slate-500 mb-1.5 ml-1">Title</label>
        <input type="text" id="title" name="Title" value="@titleFilter" placeholder="Search by title" class="px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all w-full" />
    </div>
    <div class="flex flex-col flex-1 w-full">
        <label for="author" class="text-xs font-semibold text-slate-500 mb-1.5 ml-1">Author</label>
        <input type="text" id="author" name="Author" value="@authorFilter" placeholder="Search by author" class="px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all w-full" />
    </div>
    <div class="flex flex-col flex-1 w-full">
        <label for="genre" class="text-xs font-semibold text-slate-500 mb-1.5 ml-1">Genre</label>
        <input type="text" id="genre" name="Genre" value="@genreFilter" placeholder="Search by genre" class="px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all w-full" />
    </div>
    <div class="flex gap-3 w-full md:w-auto mt-4 md:mt-0">
        <a href="/Book" class="flex-1 md:flex-none px-6 py-2.5 bg-slate-100 text-slate-700 rounded-xl text-sm font-semibold hover:bg-slate-200 transition-colors text-center">
            Clear
        </a>
    </div>
</form>

<div class="bg-white rounded-2xl shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)] border border-slate-100 overflow-hidden flex flex-col">
    <div class="overflow-x-auto p-2">
        <table class="w-full text-left text-sm whitespace-nowrap">
            <thead class="text-slate-500 bg-slate-50/50 rounded-lg">
                <tr>
                    <th class="px-4 py-3 font-semibold w-12 text-center">No.</th>
                    <th class="px-4 py-3 font-semibold">Title</th>
                    <th class="px-4 py-3 font-semibold">Author</th>
                    <th class="px-4 py-3 font-semibold">Genre</th>
                    <th class="px-4 py-3 font-semibold text-center">Editions</th>
                    <th class="px-4 py-3 font-semibold text-center">Stock</th>
                    <th class="px-4 py-3 font-semibold rounded-r-lg">Actions</th>
                </tr>
            </thead>
            <tbody class="text-slate-700">
                @if (books == null || books.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="px-4 py-12 text-center text-slate-500 font-medium">
                            No books found.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var book in books)
                    {
                        var reorderLevel = book.Editions?.FirstOrDefault()?.ReorderLevel ?? 0;
                        var stockBg = book.TotalStockQuantity == 0 ? "bg-red-100 text-red-800 border-red-200" : (book.TotalStockQuantity <= reorderLevel ? "bg-amber-100 text-amber-800 border-amber-200" : "bg-emerald-100 text-emerald-800 border-emerald-200");
                        
                        <tr class="hover:bg-slate-50/80 transition-colors group border-b border-slate-50 last:border-0 cursor-pointer" onclick="document.getElementById('editions-@book.BookId').classList.toggle('hidden')">
                            <td class="px-4 py-4 font-medium text-slate-500 text-center rounded-l-xl">@(++count)</td>
                            <td class="px-4 py-4 font-semibold max-w-[200px] truncate" title="@book.Title">
                                @book.Title
                            </td>
                            <td class="px-4 py-4 text-slate-700 font-medium max-w-[150px] truncate" title="@book.Author">@book.Author</td>
                            <td class="px-4 py-4 text-slate-500 max-w-[150px] truncate" title="@book.Genre">@book.Genre</td>
                            <td class="px-4 py-4 text-center">
                                @if (book.Editions != null && book.Editions.Count > 0)
                                {
                                    <span class="inline-flex items-center gap-1 bg-slate-100 text-slate-600 px-2 py-1 rounded-md text-xs font-medium">
                                        @book.Editions.Count @(book.Editions.Count == 1 ? "Edition" : "Editions")
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                                    </span>
                                }
                                else
                                {
                                    <span class="text-slate-400">-</span>
                                }
                            </td>
                            <td class="px-4 py-4 text-center">
                                <span class="inline-flex items-center justify-center min-w-[2.5rem] px-2 py-1 rounded-full text-xs font-bold border @stockBg">
                                    @book.TotalStockQuantity
                                </span>
                            </td>
                            <td class="px-4 py-4 rounded-r-xl">
                                <div class="flex items-center gap-2">
                                    <a href="/Book/Edit/@book.BookId" onclick="event.stopPropagation();" class="p-1.5 text-slate-400 hover:text-teal-600 border border-slate-200 rounded hover:border-teal-200 hover:bg-teal-50 transition-colors" title="Edit">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                    </a>
                                    <!-- Add Edition Button -->
                                    <a href="/Book/CreateEdition/@book.BookId" class="p-1.5 text-slate-400 hover:text-indigo-600 border border-slate-200 rounded hover:border-indigo-200 hover:bg-indigo-50 transition-colors" title="Add Edition" onclick="event.stopPropagation();">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                                    </a>
                                    <button type="button" data-id="@book.BookId" onclick="event.stopPropagation();" class="btnDelete p-1.5 text-slate-400 hover:text-red-600 border border-slate-200 rounded hover:border-red-200 hover:bg-red-50 transition-colors" title="Delete">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        @if (book.Editions != null && book.Editions.Count > 0)
                        {
                            <tr id="editions-@book.BookId" class="hidden bg-slate-50/80 border-b border-slate-100">
                                <td></td>
                                <td colspan="6" class="p-4">
                                    <div class="rounded-xl border border-slate-200 bg-white overflow-hidden shadow-sm">
                                        <table class="w-full text-sm text-left">
                                            <thead class="bg-slate-50 text-slate-500 font-semibold">
                                                <tr>
                                                    <th class="px-4 py-3">Edition Name</th>
                                                    <th class="px-4 py-3">ISBN</th>
                                                    <th class="px-4 py-3">Price (MMK)</th>
                                                    <th class="px-4 py-3 text-center">Stock</th>
                                                    <th class="px-4 py-3">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-slate-100">
                                                @foreach (var edition in book.Editions.OrderByDescending(e => e.BookEditionId))
                                                {
                                                    <tr class="hover:bg-slate-50 transition-colors">
                                                        <td class="px-4 py-3 font-medium max-w-[200px] truncate" title="@edition.EditionName">
                                                            <a href="/Book/Detail/@book.BookId?editionId=@edition.BookEditionId" class="text-teal-700 hover:text-teal-900 transition-colors block truncate" onclick="event.stopPropagation();">@edition.EditionName</a>
                                                        </td>
                                                        <td class="px-4 py-3 text-slate-500">@edition.Isbn</td>
                                                        <td class="px-4 py-3 text-slate-700">@edition.Price.ToString("#,##0")</td>
                                                        <td class="px-4 py-3 text-center">
                                                            <span class="inline-flex items-center justify-center min-w-[2rem] px-2 py-0.5 rounded-full text-xs font-bold @(edition.StockQuantity <= edition.ReorderLevel ? "bg-red-100 text-red-700" : "bg-emerald-100 text-emerald-700")">
                                                                @edition.StockQuantity
                                                            </span>
                                                        </td>
                                                        <td class="px-4 py-3">
                                                            <div class="flex items-center gap-2">
                                                                <a href="/Book/EditEdition/@book.BookId?editionId=@edition.BookEditionId" onclick="event.stopPropagation();" class="p-1.5 text-slate-400 hover:text-teal-600 border border-slate-200 rounded hover:border-teal-200 hover:bg-teal-50 transition-colors" title="Edit Edition">
                                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                                                </a>
                                                                <button type="button" data-id="@edition.BookEditionId" data-book-id="@book.BookId" onclick="event.stopPropagation();" class="btnDeleteEdition p-1.5 text-slate-400 hover:text-red-600 border border-slate-200 rounded hover:border-red-200 hover:bg-red-50 transition-colors" title="Delete Edition">
                                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                                                </button>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>
    
    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <div class="px-6 py-4 border-t border-slate-100 flex items-center justify-center bg-slate-50/30">
            <div class="inline-flex items-center gap-1 bg-white rounded-full p-1.5 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)] border border-slate-100">
                @if (currentPage > 1)
                {
                    <a href="/Book?page=@(currentPage - 1)&Isbn=@isbnFilter&Title=@titleFilter&Author=@authorFilter&Genre=@genreFilter" class="w-8 h-8 flex items-center justify-center rounded-full bg-slate-100 text-slate-600 hover:bg-slate-200 transition-colors mr-1">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                    </a>
                }
                else
                {
                    <span class="w-8 h-8 flex items-center justify-center rounded-full bg-slate-50 text-slate-300 mr-1 cursor-not-allowed">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                    </span>
                }
                
                @for (int i = 1; i <= totalPages; i++)
                {
                    if (i == currentPage)
                    {
                        <span class="w-8 h-8 flex items-center justify-center rounded-full bg-teal-600 text-white text-sm font-semibold shadow-sm">@i</span>
                    }
                    else if (i == 1 || i == totalPages || Math.Abs(i - currentPage) <= 1)
                    {
                        <a href="/Book?page=@i&Isbn=@isbnFilter&Title=@titleFilter&Author=@authorFilter&Genre=@genreFilter" class="w-8 h-8 flex items-center justify-center rounded-full text-slate-600 text-sm hover:bg-slate-100 font-medium transition-colors">@i</a>
                    }
                    else if (Math.Abs(i - currentPage) == 2)
                    {
                        <span class="w-8 h-8 flex items-center justify-center text-slate-400 tracking-widest">...</span>
                    }
                }

                @if (currentPage < totalPages)
                {
                    <a href="/Book?page=@(currentPage + 1)&Isbn=@isbnFilter&Title=@titleFilter&Author=@authorFilter&Genre=@genreFilter" class="w-8 h-8 flex items-center justify-center rounded-full bg-teal-600 text-white hover:bg-teal-700 transition-colors ml-1 shadow-sm">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                    </a>
                }
                else
                {
                    <span class="w-8 h-8 flex items-center justify-center rounded-full bg-teal-600/50 text-white/70 ml-1 cursor-not-allowed shadow-sm">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                    </span>
                }
            </div>
        </div>
    }
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="fixed inset-0 z-50 flex items-center justify-center hidden">
    <!-- Backdrop -->
    <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm transition-opacity" id="deleteModalBackdrop"></div>
    
    <!-- Modal Panel -->
    <div class="relative bg-white rounded-2xl shadow-xl w-full max-w-md mx-4 p-6 overflow-hidden transform transition-all flex flex-col items-center text-center">
        <div class="w-12 h-12 rounded-full bg-red-100 flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
        </div>
        <h3 class="text-lg font-bold text-slate-900 mb-2">Delete Book</h3>
        <p class="text-sm text-red-600 mb-6 font-medium">Warning: Deleting this parent book will also erase all of its editions. Are you sure you want to proceed? This action cannot be undone.</p>
        
        <div class="flex gap-3 w-full">
            <button type="button" id="btnCancelDelete" class="flex-1 px-4 py-2.5 bg-slate-100 text-slate-700 rounded-xl text-sm font-semibold hover:bg-slate-200 transition-colors">
                Cancel
            </button>
            <button type="button" id="btnConfirmDelete" class="flex-1 px-4 py-2.5 bg-red-600 text-white rounded-xl text-sm font-semibold hover:bg-red-700 transition-colors shadow-sm">
                Delete
            </button>
        </div>
    </div>
</div>

<!-- Delete Edition Confirmation Modal -->
<div id="deleteEditionModal" class="fixed inset-0 z-50 flex items-center justify-center hidden">
    <!-- Backdrop -->
    <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm transition-opacity" id="deleteEditionModalBackdrop"></div>
    
    <!-- Modal Panel -->
    <div class="relative bg-white rounded-2xl shadow-xl w-full max-w-md mx-4 p-6 overflow-hidden transform transition-all flex flex-col items-center text-center">
        <div class="w-12 h-12 rounded-full bg-red-100 flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
        </div>
        <h3 class="text-lg font-bold text-slate-900 mb-2">Delete Edition</h3>
        <p class="text-sm text-slate-500 mb-6">Are you sure you want to delete this edition? This action cannot be undone.</p>
        
        <div class="flex gap-3 w-full">
            <button type="button" id="btnCancelDeleteEdition" class="flex-1 px-4 py-2.5 bg-slate-100 text-slate-700 rounded-xl text-sm font-semibold hover:bg-slate-200 transition-colors">
                Cancel
            </button>
            <button type="button" id="btnConfirmDeleteEdition" class="flex-1 px-4 py-2.5 bg-red-600 text-white rounded-xl text-sm font-semibold hover:bg-red-700 transition-colors shadow-sm">
                Delete
            </button>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            let debounceTimer;
            const filterForm = document.querySelector('form[action="/Book"]');
            const inputs = filterForm.querySelectorAll('input[type="text"]');

            inputs.forEach(input => {
                input.addEventListener('input', function() {
                    clearTimeout(debounceTimer);
                    debounceTimer = setTimeout(() => {
                        filterForm.submit();
                    }, 500); // 500ms delay
                });
            });

            // Auto-hide toast after 4 seconds
            const toast = document.getElementById('toastMessage');
            if (toast) {
                setTimeout(() => {
                    toast.style.opacity = '0';
                    setTimeout(() => toast.remove(), 300);
                }, 4000);
            }

            let bookIdToDelete = null;
            const $deleteModal = $('#deleteModal');

            function closeDeleteModal() {
                $deleteModal.addClass('hidden');
                bookIdToDelete = null;
            }

            $('.btnDelete').on('click', function() {
                bookIdToDelete = $(this).data('id');
                $deleteModal.removeClass('hidden');
            });

            $('#btnCancelDelete, #deleteModalBackdrop').on('click', function() {
                closeDeleteModal();
            });

            $('#btnConfirmDelete').on('click', function() {
                if (!bookIdToDelete) return;
                
                const $btn = $(this);
                $btn.prop('disabled', true).text('Deleting...');

                $.ajax({
                    type: 'POST',
                    url: '/Book/Delete',
                    data: { BookId: bookIdToDelete },
                    success: function(response) {
                        if (response.isSuccess) {
                            window.location.reload();
                        } else {
                            alert(response.message || response.Message || "Failed to delete book.");
                            $btn.prop('disabled', false).text('Delete');
                            closeDeleteModal();
                        }
                    },
                    error: function(xhr) {
                        alert("Server Error: " + xhr.statusText);
                        $btn.prop('disabled', false).text('Delete');
                        closeDeleteModal();
                    }
                });
            });



            // Delete Edition Logic
            let editionIdToDelete = null;
            let bookIdForEdition = null;
            const $deleteEditionModal = $('#deleteEditionModal');

            function closeDeleteEditionModal() {
                $deleteEditionModal.addClass('hidden');
                editionIdToDelete = null;
                bookIdForEdition = null;
            }

            $('.btnDeleteEdition').on('click', function() {
                editionIdToDelete = $(this).data('id');
                bookIdForEdition = $(this).data('book-id');
                $deleteEditionModal.removeClass('hidden');
            });

            $('#btnCancelDeleteEdition, #deleteEditionModalBackdrop').on('click', function() {
                closeDeleteEditionModal();
            });

            $('#btnConfirmDeleteEdition').on('click', function() {
                if (!editionIdToDelete || !bookIdForEdition) return;
                
                const $btn = $(this);
                $btn.prop('disabled', true).text('Deleting...');

                $.ajax({
                    type: 'POST',
                    url: '/Book/DeleteEdition/' + bookIdForEdition + '?editionId=' + editionIdToDelete,
                    success: function(response) {
                        if (response.isSuccess) {
                            window.location.reload();
                        } else {
                            alert(response.message || response.Message || "Failed to delete edition.");
                            $btn.prop('disabled', false).text('Delete');
                            closeDeleteEditionModal();
                        }
                    },
                    error: function(xhr) {
                        alert("Server Error: " + xhr.statusText);
                        $btn.prop('disabled', false).text('Delete');
                        closeDeleteEditionModal();
                    }
                });
            });
        });
    </script>
}
