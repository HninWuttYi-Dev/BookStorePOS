@{
    ViewData["Title"] = "Edit Edition";
    int editionId = 0;
    if (ViewData["Id"] != null)
    {
        editionId = Convert.ToInt32(ViewData["Id"]);
    }
    string editionName = string.Empty;
    if (ViewData["EditionName"] != null)
    {
        editionName = Convert.ToString(ViewData["EditionName"]);
    }
}

<div class="max-w-2xl mx-auto w-full">
    <div class="mb-8 flex items-center">
        <a href="/Edition" class="mr-4 p-2 text-slate-400 hover:text-teal-600 hover:bg-teal-50 rounded-full transition-colors flex-shrink-0" title="Back to Editions">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        </a>
        <div>
            <div class="flex items-center gap-2 text-sm text-slate-500 mb-1">
                <a href="/Edition" class="hover:text-teal-600 transition-colors">Editions</a>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                <span class="text-slate-900 font-medium">Edit</span>
            </div>
            <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Edit Edition</h1>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)] border border-slate-100 overflow-hidden">
        <div class="p-6 md:p-8">
            <input type="hidden" id="OriginalEditionName" value="@editionName" />
            <div class="mb-6">
                <label for="EditionName" class="text-sm font-semibold text-slate-700 mb-1.5 block">Edition Name <span class="text-red-500">*</span></label>
                <input type="text" id="EditionName" name="EditionName" value="@editionName" required
                       class="px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all w-full" 
                       placeholder="Enter edition's name" />
                <span class="text-red-500 text-xs mt-1 hidden error-msg" id="editionNameError">Edition Name is required.</span>
            </div>

            <div class="flex gap-4 pt-4 border-t border-slate-100 justify-end">
                <a href="/Edition" class="px-6 py-2.5 bg-slate-100 text-slate-700 font-semibold rounded-xl hover:bg-slate-200 transition-colors flex items-center justify-center min-w-[120px]">
                    Cancel
                </a>
                <button type="button" id="btnSave" class="px-6 py-2.5 bg-teal-600 text-white font-semibold rounded-xl hover:bg-teal-700 transition-colors shadow-sm flex items-center justify-center min-w-[120px]">
                    Update Edition
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Toast Container for Errors -->
<div id="toastContainer" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 transition-opacity duration-300 opacity-0 pointer-events-none">
    <div class="bg-red-600 text-white px-6 py-3 rounded-full shadow-lg flex items-center gap-3">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span class="font-medium text-sm" id="toastText">Error message</span>
    </div>
</div>

@section Scripts {
    <script>
        function showToast(message) {
            $('#toastText').text(message);
            $('#toastContainer').removeClass('opacity-0 pointer-events-none');
            setTimeout(() => {
                $('#toastContainer').addClass('opacity-0 pointer-events-none');
            }, 4000);
        }

        $(document).ready(function() {
            let isSubmitting = false;
            $('#EditionName').on('input', function() {
                $(this).removeClass('border-red-500 focus:ring-red-500/50 focus:border-red-500');
                $('#editionNameError').addClass('hidden');
            });

            $('#btnSave').on('click', function () {
                if (isSubmitting) return;
                const editionName = $('#EditionName').val().trim();
                const originalName = $('#OriginalEditionName').val().trim();
                
                if (!editionName) {
                    $('#editionNameError').removeClass('hidden');
                    $('#EditionName').addClass('border-red-500 focus:ring-red-500/50 focus:border-red-500');
                    return;
                }

                if (editionName === originalName) {
                    showToast("No changes detected.");
                    return;
                }

                const $btn = $(this);
                $btn.prop('disabled', true).text('Updating...');

                const _requestModel = {
                    EditionName: editionName
                };

                isSubmitting = true;
                $.ajax({
                    type: 'POST',
                    url: '/Edition/Update/@editionId',
                    data: { requestModel: _requestModel },
                    success: function(response) {
                        if (response.isSuccess) {
                            window.location.href = '/Edition';
                        } else {
                            showToast(response.message || response.Message || "Failed to update edition.");
                            isSubmitting = false;
                            $btn.prop('disabled', false).text('Update Edition');
                        }
                    },
                    error: function(xhr) {
                        showToast("Error: " + xhr.statusText);
                        isSubmitting = false;
                        $btn.prop('disabled', false).text('Update Edition');
                    }
                });
            });
        });
    </script>
}
