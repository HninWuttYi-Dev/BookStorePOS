@model GenreListResponseModel;
@{
    ViewData["Title"] = "Genre List";
    var genres = ViewData["Genres"] as List<GenreModel> ?? new List<GenreModel>();
    int currentPage = ViewData["CurrentPage"] != null ? Convert.ToInt32(ViewData["CurrentPage"]) : 1;
    int totalPages = ViewData["TotalPages"] != null ? Convert.ToInt32(ViewData["TotalPages"]) : 1;
    
    bool hasMessage = TempData["Message"] != null;
    bool isSuccess = TempData["isSuccess"] != null ? Convert.ToBoolean(TempData["isSuccess"]) : false;
    string message = TempData["Message"]?.ToString() ?? string.Empty;

    int count = (currentPage - 1) * 20;
    string nameFilter = ViewData["GenreNameFilter"]?.ToString();
}

<div class="mb-8 flex justify-between items-center">
    <div>
        <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Genre List</h1>
        <p class="text-slate-500 mt-2 text-sm font-medium">Manage and view all genres</p>
    </div>
    <a href="/Genre/Create" id="btnNewGenre" class="px-5 py-2.5 bg-teal-600 text-white font-semibold rounded-xl hover:bg-teal-700 transition-colors shadow-sm flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
        New Genre
    </a>
</div>

@if (hasMessage)
{
    <div id="toastMessage" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 px-6 py-3 rounded-full shadow-lg flex items-center gap-3 transition-opacity duration-300 @(isSuccess ? "bg-emerald-600 text-white" : "bg-red-600 text-white")">
        @if (isSuccess)
        {
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
        }
        else
        {
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        }
        <span class="font-medium text-sm">@message</span>
        <button onclick="document.getElementById('toastMessage').remove()" class="ml-2 hover:opacity-75 focus:outline-none">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
    </div>
}

<form method="get" action="/Genre" class="mb-6 w-full flex flex-col md:flex-row items-end gap-4 bg-white p-5 rounded-2xl border border-slate-100 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)]">
    <div class="flex flex-col flex-1 w-full">
        <label for="genreName" class="text-xs font-semibold text-slate-500 mb-1.5 ml-1">Genre Name</label>
        <input type="text" id="genreName" name="GenreName" value="@nameFilter" placeholder="Search by name" class="px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all w-full" />
    </div>
    <div class="flex gap-3 w-full md:w-auto mt-4 md:mt-0">
        <a href="/Genre" class="flex-1 md:flex-none px-6 py-2.5 bg-slate-100 text-slate-700 rounded-xl text-sm font-semibold hover:bg-slate-200 transition-colors text-center">
            Clear
        </a>
    </div>
</form>

<div class="bg-white rounded-2xl shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)] border border-slate-100 overflow-hidden flex flex-col">
    <div class="overflow-x-auto p-2">
        <table class="w-full text-left text-sm whitespace-nowrap">
            <thead class="text-slate-500 bg-slate-50/50 rounded-lg">
                <tr>
                    <th class="px-4 py-3 font-semibold w-12 text-center">No.</th>
                    <th class="px-4 py-3 font-semibold">Genre Name</th>
                    <th class="px-4 py-3 font-semibold w-24 text-center rounded-r-lg">Actions</th>
                </tr>
            </thead>
            <tbody class="text-slate-700">
                @if (genres == null || genres.Count == 0)
                {
                    <tr>
                        <td colspan="3" class="px-4 py-12 text-center text-slate-500 font-medium">
                            No genres found.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var genre in genres)
                    {
                        <tr class="hover:bg-slate-50/80 transition-colors group border-b border-slate-50 last:border-0">
                            <td class="px-4 py-4 font-medium text-slate-500 text-center rounded-l-xl">@(++count)</td>
                            <td class="px-4 py-4 font-semibold text-slate-900 truncate">@genre.GenreName</td>
                            <td class="px-4 py-4 rounded-r-xl">
                                <div class="flex items-center justify-center gap-2">
                                    <a href="/Genre/Edit/@genre.GenreId" class="btnEdit p-1.5 text-slate-400 hover:text-teal-600 border border-slate-200 rounded hover:border-teal-200 hover:bg-teal-50 transition-colors" title="Edit">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                    </a>
                                    <button type="button" data-id="@genre.GenreId" class="btnDelete p-1.5 text-slate-400 hover:text-red-600 border border-slate-200 rounded hover:border-red-200 hover:bg-red-50 transition-colors" title="Delete">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    
    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <div class="px-6 py-4 border-t border-slate-100 flex items-center justify-between bg-slate-50/30">
            <span class="text-sm text-slate-500 font-medium">Page @currentPage of @totalPages</span>
            <div class="flex gap-2">
                @if (currentPage > 1)
                {
                    <a href="/Genre?page=@(currentPage - 1)&GenreName=@nameFilter" class="px-4 py-2 text-sm font-semibold text-slate-700 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition-colors shadow-sm">Previous</a>
                }
                @if (currentPage < totalPages)
                {
                    <a href="/Genre?page=@(currentPage + 1)&GenreName=@nameFilter" class="px-4 py-2 text-sm font-semibold text-slate-700 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition-colors shadow-sm">Next</a>
                }
            </div>
        </div>
    }
</div>



<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="fixed inset-0 z-50 flex items-center justify-center hidden">
    <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm transition-opacity" id="deleteModalBackdrop"></div>
    <div class="relative bg-white rounded-2xl shadow-xl w-full max-w-md mx-4 p-6 overflow-hidden transform transition-all flex flex-col items-center text-center">
        <div class="w-12 h-12 rounded-full bg-red-100 flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
        </div>
        <h3 class="text-lg font-bold text-slate-900 mb-2">Delete Genre</h3>
        <p class="text-sm text-slate-500 mb-6">Are you sure you want to delete this genre? This action cannot be undone.</p>
        <div class="flex gap-3 w-full">
            <button type="button" id="btnCancelDelete" class="flex-1 px-4 py-2.5 bg-slate-100 text-slate-700 rounded-xl text-sm font-semibold hover:bg-slate-200 transition-colors">
                Cancel
            </button>
            <button type="button" id="btnConfirmDelete" class="flex-1 px-4 py-2.5 bg-red-600 text-white rounded-xl text-sm font-semibold hover:bg-red-700 transition-colors shadow-sm">
                Delete
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            let debounceTimer;
            const filterForm = document.querySelector('form[action="/Genre"]');
            const inputs = filterForm.querySelectorAll('input[type="text"]');

            inputs.forEach(input => {
                input.addEventListener('input', function() {
                    clearTimeout(debounceTimer);
                    debounceTimer = setTimeout(() => {
                        filterForm.submit();
                    }, 500);
                });
            });

            // Auto-hide toast after 4 seconds
            const toast = document.getElementById('toastMessage');
            if (toast) {
                setTimeout(() => {
                    toast.style.opacity = '0';
                    setTimeout(() => toast.remove(), 300);
                }, 4000);
            }

            // Delete Modal Logic
            let genreIdToDelete = null;
            const $deleteModal = $('#deleteModal');

            function closeDeleteModal() {
                $deleteModal.addClass('hidden');
                genreIdToDelete = null;
            }

            $('.btnDelete').on('click', function() {
                genreIdToDelete = $(this).data('id');
                $deleteModal.removeClass('hidden');
            });

            $('#btnCancelDelete, #deleteModalBackdrop').on('click', closeDeleteModal);

            $('#btnConfirmDelete').on('click', function() {
                if (!genreIdToDelete) return;
                
                const $btn = $(this);
                $btn.prop('disabled', true).text('Deleting...');

                $.ajax({
                    type: 'POST',
                    url: '/Genre/Delete',
                    data: { GenreId: genreIdToDelete },
                    success: function(response) {
                        if (response.isSuccess) {
                            window.location.reload();
                        } else {
                            alert(response.message || response.Message || "Failed to delete genre.");
                            $btn.prop('disabled', false).text('Delete');
                            closeDeleteModal();
                        }
                    },
                    error: function(xhr) {
                        alert("Server Error: " + xhr.statusText);
                        $btn.prop('disabled', false).text('Delete');
                        closeDeleteModal();
                    }
                });
            });
        });
    </script>
}
