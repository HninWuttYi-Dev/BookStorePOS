@{
    ViewData["Title"] = "Online Orders";
    var orders = ViewData["Orders"] as List<OrderModel> ?? new List<OrderModel>();
    string currentTab = ViewData["CurrentTab"]?.ToString() ?? "Pending";
    string search = ViewData["Search"]?.ToString() ?? "";
    int pendingCount = ViewData["PendingCount"] != null ? Convert.ToInt32(ViewData["PendingCount"]) : 0;
    int completedCount = ViewData["CompletedCount"] != null ? Convert.ToInt32(ViewData["CompletedCount"]) : 0;
    int rejectedCount = ViewData["RejectedCount"] != null ? Convert.ToInt32(ViewData["RejectedCount"]) : 0;
    decimal totalRevenue = ViewData["TotalRevenue"] != null ? Convert.ToDecimal(ViewData["TotalRevenue"]) : 0;
    int totalCount = pendingCount + completedCount + rejectedCount;

    string FormatOrderDateOnly(DateTime? date)
    {
        if (!date.HasValue) return "-";
        var d = date.Value;
        if (d.Date == DateTime.Today) return "Today";
        if (d.Date == DateTime.Today.AddDays(-1)) return "Yesterday";
        return d.ToString("d/M/yyyy");
    }

    string FormatOrderTimeOnly(DateTime? date)
    {
        if (!date.HasValue) return "-";
        return date.Value.ToString("hh:mm tt");
    }

    string FormatOrderNo(int id, DateTime? date)
    {
        var d = date ?? DateTime.Now;
        return $"C{d.ToString("yyMMdd")}{id.ToString("0000")}";
    }

    int rowNumber = 0;
}

<div class="space-y-6">
    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2.5">
                <span class="inline-flex items-center justify-center w-10 h-10 rounded-2xl bg-primary-100 text-primary-600 border border-primary-200/60 shadow-2xs">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                    </svg>
                </span>
                <div>
                    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">Online Orders</h1>
                    <p class="text-slate-500 text-xs sm:text-sm font-medium">Verify customer payment slips, manage inventory allocation, and process store fulfillment</p>
                </div>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <a href="/OnlineOrders?tab=@currentTab" class="inline-flex items-center gap-2 px-4 py-2.5 bg-white border border-[#EDE7DF] rounded-xl text-xs sm:text-sm font-semibold text-slate-700 hover:bg-slate-50 hover:border-slate-300 transition-all shadow-2xs">
                <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                <span>Refresh</span>
            </a>
        </div>
    </div>

    <!-- KPI Metric Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Pending Verification Card -->
        <a href="/OnlineOrders?tab=Pending" class="group bg-white rounded-2xl p-5 border @(currentTab == "Pending" ? "border-amber-400 ring-2 ring-amber-400/20 shadow-md" : "border-[#EDE7DF] shadow-[0_4px_24px_-4px_rgba(42,36,33,0.06)]") hover:-translate-y-0.5 transition-all">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Pending Review</span>
                <span class="w-8 h-8 rounded-xl bg-amber-50 text-amber-600 border border-amber-200/60 flex items-center justify-center">
                    <span class="relative flex h-3 w-3">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-3 w-3 bg-amber-500"></span>
                    </span>
                </span>
            </div>
            <div class="flex items-baseline gap-2">
                <span class="text-3xl font-extrabold text-slate-900 group-hover:text-amber-600 transition-colors">@pendingCount</span>
                <span class="text-xs font-medium text-slate-400">orders awaiting verification</span>
            </div>
            <p class="text-xs text-amber-700/80 font-medium mt-2 flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                Requires admin slip inspection
            </p>
        </a>

        <!-- Completed / Verified Card -->
        <a href="/OnlineOrders?tab=Completed" class="group bg-white rounded-2xl p-5 border @(currentTab == "Completed" ? "border-emerald-400 ring-2 ring-emerald-400/20 shadow-md" : "border-[#EDE7DF] shadow-[0_4px_24px_-4px_rgba(42,36,33,0.06)]") hover:-translate-y-0.5 transition-all">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Verified & Completed</span>
                <span class="w-8 h-8 rounded-xl bg-emerald-50 text-emerald-600 border border-emerald-200/60 flex items-center justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                </span>
            </div>
            <div class="flex items-baseline gap-2">
                <span class="text-3xl font-extrabold text-slate-900 group-hover:text-emerald-600 transition-colors">@completedCount</span>
                <span class="text-xs font-medium text-slate-400">fulfilled orders</span>
            </div>
            <p class="text-xs text-emerald-700/80 font-medium mt-2 flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                Stock deducted & confirmed
            </p>
        </a>

        <!-- Rejected Card -->
        <a href="/OnlineOrders?tab=Rejected" class="group bg-white rounded-2xl p-5 border @(currentTab == "Rejected" ? "border-rose-400 ring-2 ring-rose-400/20 shadow-md" : "border-[#EDE7DF] shadow-[0_4px_24px_-4px_rgba(42,36,33,0.06)]") hover:-translate-y-0.5 transition-all">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Rejected</span>
                <span class="w-8 h-8 rounded-xl bg-rose-50 text-rose-600 border border-rose-200/60 flex items-center justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </span>
            </div>
            <div class="flex items-baseline gap-2">
                <span class="text-3xl font-extrabold text-slate-900 group-hover:text-rose-600 transition-colors">@rejectedCount</span>
                <span class="text-xs font-medium text-slate-400">declined orders</span>
            </div>
            <p class="text-xs text-rose-700/80 font-medium mt-2 flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                With mandatory rejection notes
            </p>
        </a>

        <!-- Total Revenue Card -->
        <div class="bg-white rounded-2xl p-5 border border-[#EDE7DF] shadow-[0_4px_24px_-4px_rgba(42,36,33,0.06)]">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Online Revenue</span>
                <span class="w-8 h-8 rounded-xl bg-primary-50 text-primary-600 border border-primary-200/60 flex items-center justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </span>
            </div>
            <div class="flex items-baseline gap-1.5">
                <span class="text-2xl font-extrabold text-primary-700">@totalRevenue.ToString("#,##0")</span>
                <span class="text-xs font-bold text-primary-600">MMK</span>
            </div>
            <p class="text-xs text-slate-500 font-medium mt-2 flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                Verified orders total
            </p>
        </div>
    </div>

    <!-- Filter & Search Bar -->
    <div class="bg-white rounded-2xl p-4 sm:p-5 border border-[#EDE7DF] shadow-[0_4px_24px_-4px_rgba(42,36,33,0.06)] space-y-4">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
            <!-- Tabs -->
            <div class="inline-flex p-1 bg-slate-100/80 rounded-xl border border-slate-200/70 overflow-x-auto max-w-full">
                <a href="/OnlineOrders?tab=Pending&search=@search" class="px-3.5 py-2 rounded-lg text-xs font-bold transition-all whitespace-nowrap flex items-center gap-2 @(currentTab == "Pending" ? "bg-white text-slate-900 shadow-2xs" : "text-slate-600 hover:text-slate-900")">
                    <span>Pending Review</span>
                    <span class="px-1.5 py-0.5 rounded-full text-[10px] font-bold @(currentTab == "Pending" ? "bg-amber-100 text-amber-800" : "bg-slate-200 text-slate-600")">@pendingCount</span>
                </a>
                <a href="/OnlineOrders?tab=Completed&search=@search" class="px-3.5 py-2 rounded-lg text-xs font-bold transition-all whitespace-nowrap flex items-center gap-2 @(currentTab == "Completed" ? "bg-white text-slate-900 shadow-2xs" : "text-slate-600 hover:text-slate-900")">
                    <span>Completed</span>
                    <span class="px-1.5 py-0.5 rounded-full text-[10px] font-bold @(currentTab == "Completed" ? "bg-emerald-100 text-emerald-800" : "bg-slate-200 text-slate-600")">@completedCount</span>
                </a>
                <a href="/OnlineOrders?tab=Rejected&search=@search" class="px-3.5 py-2 rounded-lg text-xs font-bold transition-all whitespace-nowrap flex items-center gap-2 @(currentTab == "Rejected" ? "bg-white text-slate-900 shadow-2xs" : "text-slate-600 hover:text-slate-900")">
                    <span>Rejected</span>
                    <span class="px-1.5 py-0.5 rounded-full text-[10px] font-bold @(currentTab == "Rejected" ? "bg-rose-100 text-rose-800" : "bg-slate-200 text-slate-600")">@rejectedCount</span>
                </a>
                <a href="/OnlineOrders?tab=All&search=@search" class="px-3.5 py-2 rounded-lg text-xs font-bold transition-all whitespace-nowrap flex items-center gap-2 @(currentTab == "All" ? "bg-white text-slate-900 shadow-2xs" : "text-slate-600 hover:text-slate-900")">
                    <span>All Orders</span>
                    <span class="px-1.5 py-0.5 rounded-full text-[10px] font-bold @(currentTab == "All" ? "bg-primary-100 text-primary-800" : "bg-slate-200 text-slate-600")">@totalCount</span>
                </a>
            </div>

            <!-- Search Form -->
            <form method="get" action="/OnlineOrders" class="flex items-center gap-2 w-full lg:w-auto">
                <input type="hidden" name="tab" value="@currentTab" />
                <div class="relative flex-1 lg:w-72">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                    </span>
                    <input type="text" name="search" value="@search" placeholder="Search order, customer, phone..." class="w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-primary-500/30 focus:border-primary-500 transition-all" />
                </div>
                <button type="submit" class="px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white font-semibold rounded-xl text-xs sm:text-sm transition-all shadow-2xs">
                    Search
                </button>
                @if (!string.IsNullOrWhiteSpace(search))
                {
                    <a href="/OnlineOrders?tab=@currentTab" class="px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white font-semibold rounded-xl text-xs sm:text-sm transition-all shadow-2xs text-center" title="Clear Search">
                        Clear
                    </a>
                }
            </form>
        </div>
    </div>

    <!-- Orders Table Container -->
    <div class="bg-white rounded-2xl shadow-[0_4px_24px_-4px_rgba(42,36,33,0.06)] border border-[#EDE7DF] overflow-hidden flex flex-col">
        <div class="overflow-x-auto p-2">
            <table class="w-full text-left text-sm whitespace-nowrap">
                <thead class="text-slate-500 bg-slate-50/60 rounded-xl">
                    <tr>
                        <th class="px-4 py-3.5 font-bold text-xs uppercase tracking-wider w-12 text-center rounded-l-xl">No.</th>
                        <th class="px-4 py-3.5 font-bold text-xs uppercase tracking-wider text-left">Order ID</th>
                        <th class="px-4 py-3.5 font-bold text-xs uppercase tracking-wider text-left">Date & Time</th>
                        <th class="px-4 py-3.5 font-bold text-xs uppercase tracking-wider text-left">Customer</th>
                        <th class="px-4 py-3.5 font-bold text-xs uppercase tracking-wider text-left">Payment</th>
                        <th class="px-4 py-3.5 font-bold text-xs uppercase tracking-wider text-left">Slip Proof</th>
                        <th class="px-4 py-3.5 font-bold text-xs uppercase tracking-wider text-left">Total (MMK)</th>
                        <th class="px-4 py-3.5 font-bold text-xs uppercase tracking-wider text-left">Status</th>
                        <th class="px-4 py-3.5 font-bold text-xs uppercase tracking-wider text-left rounded-r-xl">Actions</th>
                    </tr>
                </thead>
                <tbody class="text-slate-700 divide-y divide-slate-100/70">
                    @if (orders == null || orders.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="px-6 py-16 text-center">
                                <div class="max-w-sm mx-auto flex flex-col items-center">
                                    <div class="w-16 h-16 rounded-3xl bg-slate-100 border border-slate-200/80 flex items-center justify-center text-slate-400 mb-4 shadow-2xs">
                                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                                        </svg>
                                    </div>
                                    <h3 class="text-base font-bold text-slate-800 mb-1">No online orders found</h3>
                                    <p class="text-xs text-slate-500 leading-relaxed">
                                        @if (!string.IsNullOrWhiteSpace(search))
                                        {
                                            <span>No orders matched your search "<strong>@search</strong>". Try a different keyword or clear the filter.</span>
                                        }
                                        else
                                        {
                                            <span>There are currently no orders in the <strong>@currentTab</strong> tab. When customers place orders in the online store, they will appear here.</span>
                                        }
                                    </p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var order in orders)
                        {
                            rowNumber++;
                            var orderNo = FormatOrderNo(order.OrderId, order.OrderDate);
                            var hasSlip = !string.IsNullOrWhiteSpace(order.PaymentScreenshotUrl);

                            <tr class="hover:bg-slate-50/70 transition-colors group" id="order-row-@order.OrderId">
                                <!-- No. -->
                                <td class="px-4 py-4 text-xs font-semibold text-slate-400 text-center rounded-l-xl">@rowNumber</td>

                                <!-- Order ID -->
                                <td class="px-4 py-4">
                                    <button type="button" onclick="openDetailModal(@order.OrderId)" class="font-bold text-sm text-primary-600 hover:text-primary-800 hover:underline transition-colors flex items-center gap-1.5 text-left">
                                        <span>@orderNo</span>
                                    </button>
                                    <span class="text-[11px] text-slate-400 font-medium">@order.TotalQuantity @(order.TotalQuantity == 1 ? "book" : "books")</span>
                                </td>

                                <!-- Date & Time -->
                                <td class="px-4 py-4">
                                    <div class="text-xs font-semibold text-slate-800">@FormatOrderDateOnly(order.OrderDate)</div>
                                    <div class="text-[11px] text-slate-400">@FormatOrderTimeOnly(order.OrderDate)</div>
                                </td>

                                <!-- Customer -->
                                <td class="px-4 py-4 max-w-[220px]">
                                    <div class="text-xs font-bold text-slate-900 truncate" title="@order.CustomerName">
                                        @(string.IsNullOrWhiteSpace(order.CustomerName) ? "Guest Customer" : order.CustomerName)
                                    </div>
                                    <div class="text-[11px] text-slate-500 font-medium flex items-center gap-1 mt-0.5">
                                        <svg class="w-3 h-3 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                                        <span>@(string.IsNullOrWhiteSpace(order.CustomerPhone) ? "No phone" : order.CustomerPhone)</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(order.ShippingAddress))
                                    {
                                        <div class="text-[11px] text-slate-400 truncate mt-0.5 flex items-center gap-1" title="@order.ShippingAddress">
                                            <svg class="w-3 h-3 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                                            <span class="truncate">@order.ShippingAddress</span>
                                        </div>
                                    }
                                </td>

                                <!-- Payment Method & PaymentStatus -->
                                <td class="px-4 py-4">
                                    <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-200/80">
                                        <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
                                        <span>@(string.IsNullOrWhiteSpace(order.PaymentMethod) ? "Transfer" : order.PaymentMethod)</span>
                                    </div>
                                    <div class="mt-1">
                                        @if (order.PaymentStatus == PaymentStatus.Verified)
                                        {
                                            <span class="inline-flex items-center text-[10px] font-bold text-emerald-700">
                                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1"></span> Verified
                                            </span>
                                        }
                                        else if (order.PaymentStatus == PaymentStatus.Submitted)
                                        {
                                            <span class="inline-flex items-center text-[10px] font-bold text-blue-700">
                                                <span class="w-1.5 h-1.5 rounded-full bg-blue-500 mr-1"></span> Slip Submitted
                                            </span>
                                        }
                                        else if (order.PaymentStatus == PaymentStatus.Rejected)
                                        {
                                            <span class="inline-flex items-center text-[10px] font-bold text-rose-700">
                                                <span class="w-1.5 h-1.5 rounded-full bg-rose-500 mr-1"></span> Slip Rejected
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center text-[10px] font-bold text-amber-700">
                                                <span class="w-1.5 h-1.5 rounded-full bg-amber-500 mr-1"></span> Unpaid
                                            </span>
                                        }
                                    </div>
                                </td>

                                <!-- Payment Slip Proof -->
                                <td class="px-4 py-4 text-left">
                                    @if (hasSlip)
                                    {
                                        <button type="button" onclick="openSlipModal('@order.PaymentScreenshotUrl', '@orderNo', '@(order.CustomerName ?? "Customer")', @(order.OrderStatus == OrderStatus.Pending ? "true" : "false"), @order.OrderId)" class="group/slip relative inline-block rounded-xl overflow-hidden border border-slate-200/90 shadow-2xs hover:border-primary-500 transition-all hover:scale-105" title="Click to view payment slip full size">
                                            <img src="@order.PaymentScreenshotUrl" alt="Slip" class="w-12 h-12 object-cover" />
                                            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover/slip:opacity-100 transition-opacity flex items-center justify-center text-white">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/></svg>
                                            </div>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-[11px] font-medium bg-slate-100 text-slate-500 border border-slate-200/60" title="No slip uploaded">
                                            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                                            No Slip
                                        </span>
                                    }
                                </td>

                                <!-- Total (MMK) -->
                                <td class="px-4 py-4 text-left">
                                    <span class="text-sm font-extrabold text-slate-900">@order.TotalPrice.ToString("#,##0")</span>
                                </td>

                                <!-- Order Status -->
                                <td class="px-4 py-4 text-left">
                                    @if (order.OrderStatus == OrderStatus.Pending)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-800 border border-amber-200/70 shadow-2xs">
                                            <span class="w-2 h-2 rounded-full bg-amber-500 mr-1.5 animate-pulse"></span>
                                            Pending
                                        </span>
                                    }
                                    else if (order.OrderStatus == OrderStatus.Completed)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-200/70 shadow-2xs">
                                            <span class="w-2 h-2 rounded-full bg-emerald-500 mr-1.5"></span>
                                            Completed
                                        </span>
                                    }
                                    else if (order.OrderStatus == OrderStatus.Rejected)
                                    {
                                        <div class="inline-flex flex-col items-start">
                                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-rose-50 text-rose-800 border border-rose-200/70 shadow-2xs">
                                                <span class="w-2 h-2 rounded-full bg-rose-500 mr-1.5"></span>
                                                Rejected
                                            </span>
                                            @if (!string.IsNullOrWhiteSpace(order.RejectReason))
                                            {
                                                <span class="text-[10px] text-rose-600 font-medium max-w-[130px] truncate mt-0.5" title="@order.RejectReason">
                                                    Reason: @order.RejectReason
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200/70">
                                            @order.OrderStatus
                                        </span>
                                    }
                                </td>

                                <!-- Actions -->
                                <td class="px-4 py-4 text-left rounded-r-xl">
                                    <div class="flex items-center gap-1.5">
                                        @if (order.OrderStatus == OrderStatus.Pending)
                                        {
                                            <!-- Verify & Confirm Button -->
                                            <button type="button" onclick="openConfirmDialog(@order.OrderId, '@orderNo', '@order.TotalPrice.ToString("#,##0") MMK')" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold transition-all shadow-2xs hover:shadow-xs flex items-center gap-1" title="Verify Payment & Deduct Inventory Stock">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                                                <span>Verify</span>
                                            </button>

                                            <!-- Reject Button -->
                                            <button type="button" onclick="openRejectDialog(@order.OrderId, '@orderNo')" class="px-3 py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-600 border border-rose-200 rounded-xl text-xs font-bold transition-all shadow-2xs flex items-center gap-1" title="Reject Order with reason">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                                                <span>Reject</span>
                                            </button>
                                        }

                                        <!-- Inspect / View Details Button -->
                                        <button type="button" onclick="openDetailModal(@order.OrderId)" class="p-2 text-slate-500 hover:text-slate-800 bg-slate-100/70 hover:bg-slate-200/70 border border-slate-200/60 rounded-xl transition-all" title="Inspect Order Details">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL 1: Payment Slip Zoom Viewer Dialog                 -->
<!-- ======================================================== -->
<dialog id="slipPreviewModal" class="m-auto rounded-3xl p-0 border border-slate-200 bg-white shadow-2xl backdrop:bg-slate-900/60 backdrop:backdrop-blur-sm max-w-2xl w-[94%] sm:w-full transition-all overflow-hidden" aria-labelledby="slipModalTitle">
    <div class="flex flex-col max-h-[90vh]">
        <!-- Header -->
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
