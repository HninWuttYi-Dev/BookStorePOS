            </div>
        </div>

        <p class="text-xs text-slate-600 leading-relaxed mb-4">
            Please select or specify why this order is rejected. <strong>This reason is required</strong> and will be preserved for store auditing and customer records.
        </p>

        <!-- Quick Reason Preset Chips -->
        <div class="mb-4">
            <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Quick Presets:</label>
            <div class="flex flex-wrap gap-1.5">
                <button type="button" onclick="setRejectReasonPreset('Invalid or blurry payment transfer slip')" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors">
                    Invalid / Blurry Slip
                </button>
                <button type="button" onclick="setRejectReasonPreset('Transfer amount does not match order total')" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors">
                    Amount Mismatch
                </button>
                <button type="button" onclick="setRejectReasonPreset('Duplicate screenshot already used for another order')" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors">
                    Duplicate Slip
                </button>
                <button type="button" onclick="setRejectReasonPreset('Customer requested cancellation')" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors">
                    Customer Cancelled
                </button>
                <button type="button" onclick="setRejectReasonPreset('Book edition out of stock / unavailable')" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors">
                    Out of Stock
                </button>
            </div>
        </div>

        <!-- Mandatory Reason Textarea -->
        <div class="mb-5">
            <label for="rejectReasonInput" class="block text-xs font-bold text-slate-700 mb-1.5">
                Rejection Reason Notes <span class="text-rose-500">*</span>
            </label>
            <textarea id="rejectReasonInput" rows="3" placeholder="Provide detailed notes on why this order cannot be confirmed..." class="w-full px-3.5 py-2.5 border border-slate-200 rounded-xl text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-rose-500/30 focus:border-rose-500 transition-all"></textarea>
            <p id="rejectReasonError" class="text-[11px] text-rose-600 font-medium mt-1 hidden">Please provide a rejection reason note before confirming.</p>
        </div>

        <div class="flex flex-col sm:flex-row gap-3">
            <button type="button" onclick="closeRejectDialog()" class="w-full order-2 sm:order-1 py-2.5 px-4 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-700 font-semibold text-xs sm:text-sm transition-all">
                Cancel
            </button>
            <button type="button" id="btnExecuteReject" onclick="executeRejectOrder()" class="w-full order-1 sm:order-2 inline-flex items-center justify-center gap-2 bg-rose-600 hover:bg-rose-700 text-white font-semibold py-2.5 px-4 rounded-xl transition-all shadow-sm text-xs sm:text-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                <span id="btnExecuteRejectText">Confirm Rejection</span>
            </button>
        </div>
    </div>
</dialog>

@section Scripts {
<script>
    // State
    let currentActiveOrderId = 0;
    let currentActiveOrderNo = '';
    let currentZoomScale = 1.0;

    // ----------------------------------------------------
    // Modal Helpers
    // ----------------------------------------------------
    function showModalDialog(modalId) {
        const modal = document.getElementById(modalId);
        if (!modal) return;
        if (typeof modal.showModal === 'function') {
            modal.showModal();
        } else {
            modal.setAttribute('open', '');
        }
    }

    function closeModalDialog(modalId) {
        const modal = document.getElementById(modalId);
        if (!modal) return;
        if (typeof modal.close === 'function') {
            modal.close();
        } else {
            modal.removeAttribute('open');
        }
    }

    // ----------------------------------------------------
    // 1. Payment Slip Modal
    // ----------------------------------------------------
    function openSlipModal(imageUrl, orderNo, customerName, isPending, orderId) {
        const img = document.getElementById('slipModalImg');
        const title = document.getElementById('slipModalTitle');
        const subtitle = document.getElementById('slipModalSubtitle');
        const openLink = document.getElementById('slipOpenNewTab');
        const actionsContainer = document.getElementById('slipPendingActions');

        img.src = imageUrl;
        title.textContent = 'Payment Slip Proof — ' + (orderNo || 'Order');
        subtitle.textContent = 'Customer: ' + (customerName || 'Online Store Customer');
        openLink.href = imageUrl;

        resetZoom();

        // Footer buttons if pending
        if (isPending && orderId) {
            actionsContainer.innerHTML = `
                <button type="button" onclick="closeSlipModal(); openRejectDialog(${orderId}, '${orderNo}')" class="px-3.5 py-2 bg-rose-50 hover:bg-rose-100 text-rose-600 border border-rose-200 rounded-xl text-xs font-bold transition-all">
                    Reject Slip
                </button>
                <button type="button" onclick="closeSlipModal(); openConfirmDialog(${orderId}, '${orderNo}', '')" class="px-3.5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold transition-all shadow-2xs">
                    Verify & Confirm
                </button>
            `;
        } else {
            actionsContainer.innerHTML = '';
        }

        showModalDialog('slipPreviewModal');
    }

    function closeSlipModal() {
        closeModalDialog('slipPreviewModal');
    }

    function adjustZoom(delta) {
        currentZoomScale = Math.min(Math.max(0.5, currentZoomScale + delta), 3.0);
        updateZoomDisplay();
    }

    function resetZoom() {
        currentZoomScale = 1.0;
        updateZoomDisplay();
    }

    function updateZoomDisplay() {
        const img = document.getElementById('slipModalImg');
        const display = document.getElementById('zoomLevelDisplay');
        if (img) img.style.transform = `scale(${currentZoomScale})`;
        if (display) display.textContent = `${Math.round(currentZoomScale * 100)}%`;
    }

    // ----------------------------------------------------
    // 2. Order Details Modal
    // ----------------------------------------------------
    async function openDetailModal(orderId) {
        try {
            const response = await fetch(`/OnlineOrders/Detail/${orderId}`);
            const result = await response.json();

            if (!result || !result.isSuccess || !result.data) {
                if (typeof window.showToast === 'function') {
                    window.showToast(result?.message || 'Failed to load order details.', false);
                } else {
                    alert(result?.message || 'Failed to load order details.');
                }
                return;
            }

            const o = result.data;
            const orderNo = `C${(o.orderDate ? new Date(o.orderDate).toISOString().slice(2,10).replace(/-/g,'') : '')}${String(o.orderId).padStart(4, '0')}`;

            document.getElementById('detailOrderNo').textContent = `Order #${orderNo}`;
            document.getElementById('detailOrderDate').textContent = o.orderDate ? new Date(o.orderDate).toLocaleString() : '-';

            // Status Badge
            const statusBadge = document.getElementById('detailStatusBadge');
            if (o.orderStatus === 1 || o.orderStatus === 'Pending') {
                statusBadge.innerHTML = `<span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800">Pending Review</span>`;
            } else if (o.orderStatus === 2 || o.orderStatus === 'Completed') {
                statusBadge.innerHTML = `<span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800">Completed & Verified</span>`;
            } else if (o.orderStatus === 3 || o.orderStatus === 'Rejected') {
                statusBadge.innerHTML = `<span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-100 text-rose-800">Rejected</span>`;
            } else {
                statusBadge.innerHTML = `<span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-800">${o.orderStatus}</span>`;
            }

            // Rejection banner
            const rejectBanner = document.getElementById('detailRejectBanner');
            if ((o.orderStatus === 3 || o.orderStatus === 'Rejected') && o.rejectReason) {
                document.getElementById('detailRejectReasonText').textContent = o.rejectReason;
                rejectBanner.classList.remove('hidden');
            } else {
                rejectBanner.classList.add('hidden');
            }

            // Customer
            document.getElementById('detailCustomerName').textContent = o.customerName || 'Guest Customer';
            document.getElementById('detailCustomerPhone').textContent = o.customerPhone || 'Not provided';
            document.getElementById('detailShippingAddress').textContent = o.shippingAddress || 'Not provided';

            const notesRow = document.getElementById('detailNotesRow');
            if (o.notes) {
                document.getElementById('detailNotes').textContent = o.notes;
                notesRow.classList.remove('hidden');
            } else {
                notesRow.classList.add('hidden');
            }

            // Payment
            document.getElementById('detailPaymentMethod').textContent = o.paymentMethod || 'Online Transfer';
            const payStatusEl = document.getElementById('detailPaymentStatus');
            if (o.paymentStatus === 2 || o.paymentStatus === 'Verified') {
                payStatusEl.className = 'font-bold text-emerald-700';
                payStatusEl.textContent = 'Verified';
            } else if (o.paymentStatus === 3 || o.paymentStatus === 'Rejected') {
                payStatusEl.className = 'font-bold text-rose-700';
                payStatusEl.textContent = 'Rejected';
            } else if (o.paymentStatus === 1 || o.paymentStatus === 'Submitted') {
                payStatusEl.className = 'font-bold text-blue-700';
                payStatusEl.textContent = 'Slip Submitted';
            } else {
                payStatusEl.className = 'font-bold text-amber-700';
                payStatusEl.textContent = 'Unpaid';
            }

            // Slip
            const slipAction = document.getElementById('detailSlipAction');
            if (o.paymentScreenshotUrl) {
                slipAction.innerHTML = `
                    <button type="button" onclick="closeDetailModal(); openSlipModal('${o.paymentScreenshotUrl}', '${orderNo}', '${(o.customerName || '').replace(/'/g, "\\'")}', ${o.orderStatus === 1 || o.orderStatus === 'Pending'}, ${o.orderId})" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-primary-50 hover:bg-primary-100 text-primary-700 rounded-xl text-xs font-bold border border-primary-200 transition-colors">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                        <span>Inspect Slip</span>
                    </button>
                `;
            } else {
                slipAction.innerHTML = `<span class="text-xs text-slate-400 font-medium italic">No slip attached</span>`;
            }

            // Items
            const itemsTbody = document.getElementById('detailItemsTableBody');
            itemsTbody.innerHTML = '';
            if (o.items && o.items.length > 0) {
                o.items.forEach(item => {
                    const row = document.createElement('tr');
                    const subtotal = item.subtotal ?? (item.quantity * item.unitPrice);
                    row.innerHTML = `
                        <td class="px-4 py-3 text-left">
                            <div class="font-bold text-slate-900">${item.bookTitle || 'Untitled Book'}</div>
                            <div class="text-[11px] text-slate-400 font-medium">${item.editionName ? item.editionName + ' Edition' : 'Standard Edition'}</div>
                        </td>
                        <td class="px-4 py-3 text-center font-bold text-slate-800">${item.quantity}</td>
                        <td class="px-4 py-3 text-left text-slate-700">${Number(item.unitPrice).toLocaleString()}</td>
                        <td class="px-4 py-3 text-left font-bold text-slate-900">${Number(subtotal).toLocaleString()}</td>
                    `;
                    itemsTbody.appendChild(row);
                });
            } else {
                itemsTbody.innerHTML = `<tr><td colspan="4" class="px-4 py-6 text-center text-slate-400">No items found for this order.</td></tr>`;
            }

            document.getElementById('detailOrderTotal').textContent = Number(o.totalPrice).toLocaleString();

            // Footer Actions
            const footerActions = document.getElementById('detailModalFooterActions');
            if (o.orderStatus === 1 || o.orderStatus === 'Pending') {
                footerActions.innerHTML = `
                    <button type="button" onclick="closeDetailModal(); openRejectDialog(${o.orderId}, '${orderNo}')" class="px-4 py-2 bg-rose-50 hover:bg-rose-100 text-rose-600 border border-rose-200 rounded-xl text-xs font-bold transition-all">
                        Reject Order
                    </button>
                    <button type="button" onclick="closeDetailModal(); openConfirmDialog(${o.orderId}, '${orderNo}', '${Number(o.totalPrice).toLocaleString()} MMK')" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold transition-all shadow-2xs">
                        Verify & Confirm
                    </button>
                `;
            } else {
                footerActions.innerHTML = '';
            }

            showModalDialog('orderDetailModal');
        } catch (err) {
            console.error('Error fetching order detail:', err);
            if (typeof window.showToast === 'function') {
                window.showToast('Network error while fetching order details.', false);
            }
        }
    }

    function closeDetailModal() {
        closeModalDialog('orderDetailModal');
    }

    // ----------------------------------------------------
    // 3. Confirm Dialog
    // ----------------------------------------------------
    function openConfirmDialog(orderId, orderNo, totalFormatted) {
        currentActiveOrderId = orderId;
        currentActiveOrderNo = orderNo;
        document.getElementById('confirmOrderNoText').textContent = '#' + orderNo;
        document.getElementById('confirmOrderTotalText').textContent = totalFormatted || '';
        showModalDialog('confirmOrderModal');
    }

    function closeConfirmDialog() {
        closeModalDialog('confirmOrderModal');
    }

    async function executeConfirmOrder() {
        if (!currentActiveOrderId) return;

        const btn = document.getElementById('btnExecuteConfirm');
        const btnText = document.getElementById('btnExecuteConfirmText');
        btn.disabled = true;
        btnText.textContent = 'Verifying...';

        try {
            const response = await fetch(`/OnlineOrders/Confirm/${currentActiveOrderId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const result = await response.json();

            if (result && result.isSuccess) {
                closeConfirmDialog();
                if (typeof window.showToast === 'function') {
                    window.showToast(result.message || 'Order payment verified and stock deducted successfully!', true);
                }
                setTimeout(() => window.location.reload(), 900);
            } else {
                if (typeof window.showToast === 'function') {
                    window.showToast(result?.message || 'Failed to confirm order.', false);
                } else {
                    alert(result?.message || 'Failed to confirm order.');
                }
                btn.disabled = false;
                btnText.textContent = 'Confirm & Deduct Stock';
            }
        } catch (err) {
            console.error('Error confirming order:', err);
            if (typeof window.showToast === 'function') {
                window.showToast('Network error occurred while confirming order.', false);
            }
            btn.disabled = false;
            btnText.textContent = 'Confirm & Deduct Stock';
        }
    }

    // ----------------------------------------------------
    // 4. Reject Dialog
    // ----------------------------------------------------
    function openRejectDialog(orderId, orderNo) {
        currentActiveOrderId = orderId;
        currentActiveOrderNo = orderNo;
        document.getElementById('rejectOrderNoText').textContent = '#' + orderNo;
        document.getElementById('rejectReasonInput').value = '';
        document.getElementById('rejectReasonError').classList.add('hidden');
        showModalDialog('rejectOrderModal');
    }

    function closeRejectDialog() {
        closeModalDialog('rejectOrderModal');
    }

    function setRejectReasonPreset(text) {
        const input = document.getElementById('rejectReasonInput');
        input.value = text;
        input.focus();
        document.getElementById('rejectReasonError').classList.add('hidden');
    }

    async function executeRejectOrder() {
        if (!currentActiveOrderId) return;

        const reasonInput = document.getElementById('rejectReasonInput');
        const reason = reasonInput.value ? reasonInput.value.trim() : '';

        if (!reason) {
            document.getElementById('rejectReasonError').classList.remove('hidden');
            reasonInput.focus();
            return;
        }

        const btn = document.getElementById('btnExecuteReject');
        const btnText = document.getElementById('btnExecuteRejectText');
        btn.disabled = true;
        btnText.textContent = 'Rejecting...';

        try {
            const response = await fetch(`/OnlineOrders/Reject/${currentActiveOrderId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ rejectReason: reason })
            });
            const result = await response.json();

            if (result && result.isSuccess) {
                closeRejectDialog();
                if (typeof window.showToast === 'function') {
                    window.showToast(result.message || 'Order rejected successfully.', true);
                }
                setTimeout(() => window.location.reload(), 900);
            } else {
                if (typeof window.showToast === 'function') {
                    window.showToast(result?.message || 'Failed to reject order.', false);
                } else {
                    alert(result?.message || 'Failed to reject order.');
                }
                btn.disabled = false;
                btnText.textContent = 'Confirm Rejection';
            }
        } catch (err) {
            console.error('Error rejecting order:', err);
            if (typeof window.showToast === 'function') {
                window.showToast('Network error occurred while rejecting order.', false);
            }
            btn.disabled = false;
            btnText.textContent = 'Confirm Rejection';
        }
    }
</script>
}

