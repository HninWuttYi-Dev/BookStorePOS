@model OrderHistoryResponseModel;
@{
    ViewData["Title"] = "Orders";
    var orders = ViewData["Orders"] as List<OrderModel> ?? new List<OrderModel>();
    var summary = ViewData["Summary"] as OrderHistorySummaryModel;
    int currentPage = ViewData["CurrentPage"] != null ? Convert.ToInt32(ViewData["CurrentPage"]) : 1;
    int totalPages = ViewData["TotalPages"] != null ? Convert.ToInt32(ViewData["TotalPages"]) : 1;
    
    bool hasMessage = TempData["Message"] != null;
    bool isSuccess = TempData["isSuccess"] != null ? Convert.ToBoolean(TempData["isSuccess"]) : false;
    string message = TempData["Message"]?.ToString() ?? string.Empty;

    string FormatOrderDateOnly(DateTime? date)
    {
        if (!date.HasValue) return "-";
        var d = date.Value;
        if (d.Date == DateTime.Today) return "Today";
        if (d.Date == DateTime.Today.AddDays(-1)) return "Yesterday";
        return d.ToString("d/M/yyyy");
    }

    string FormatOrderTimeOnly(DateTime? date)
    {
        if (!date.HasValue) return "-";
        return date.Value.ToString("hh:mm tt");
    }

    string FormatOrderNo(int id, DateTime? date)
    {
        var d = date ?? DateTime.Now;
        return $"C{d.ToString("yyMMdd")}{id.ToString("0000")}";
    }
    
    int count = (currentPage - 1) * 10;
    string startDate = ViewData["StartDate"]?.ToString();
    string endDate = ViewData["EndDate"]?.ToString();
    string maxDate = DateTime.Now.ToString("yyyy-MM-dd");
    var selectedSource = (string)(ViewData["SelectedSource"] ?? "All");

    var userRole = Context.Request.Cookies["pos_role"] ?? "";
    var userPerms = Context.Request.Cookies["pos_permissions"] ?? "";
    bool isAdmin = string.Equals(userRole, "Admin", StringComparison.OrdinalIgnoreCase);
    var permList = userPerms.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    bool canConfirmOrders = isAdmin || permList.Contains("Order.Confirm", StringComparer.OrdinalIgnoreCase);
    bool canRejectOrders = isAdmin || permList.Contains("Order.Reject", StringComparer.OrdinalIgnoreCase);
}

<div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Orders</h1>
    <p class="text-slate-500 mt-2 text-sm font-medium">View and manage all transaction history</p>
</div>

@if (summary != null)
{
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="bg-white rounded-2xl p-6 shadow-[0_4px_24px_-4px_rgba(184,117,194,0.06)] border border-[#F3E2F6] flex flex-col transition-all hover:-translate-y-1 hover:shadow-lg">
            <span class="text-sm font-semibold text-slate-500 mb-2">Total Orders</span>
            <span class="text-3xl font-bold text-slate-900">@summary.TotalOrders</span>
        </div>
        <div class="bg-white rounded-2xl p-6 shadow-[0_4px_24px_-4px_rgba(184,117,194,0.06)] border border-[#F3E2F6] flex flex-col transition-all hover:-translate-y-1 hover:shadow-lg">
            <span class="text-sm font-semibold text-slate-500 mb-2">Total Revenue</span>
            <span class="text-3xl font-bold text-teal-700">@summary.TotalRevenue.ToString("#,##0") <span class="text-sm font-bold ml-1 text-teal-600">MMK</span></span>
        </div>
        <div class="bg-white rounded-2xl p-6 shadow-[0_4px_24px_-4px_rgba(184,117,194,0.06)] border border-[#F3E2F6] flex flex-col transition-all hover:-translate-y-1 hover:shadow-lg">
            <span class="text-sm font-semibold text-slate-500 mb-2">Average Order Value</span>
            <span class="text-3xl font-bold text-slate-900">@summary.AverageOrderValue.ToString("#,##0") <span class="text-sm font-bold ml-1 text-slate-500">MMK</span></span>
        </div>
    </div>
}

<form method="get" action="/Orders" class="mb-6 w-full flex flex-col lg:flex-row lg:items-end justify-between gap-4 bg-white p-5 rounded-2xl border border-[#F3E2F6] shadow-[0_4px_24px_-4px_rgba(184,117,194,0.06)]">
    <!-- Channel Filter Pills -->
    <div class="flex flex-col">
        <label class="text-xs font-semibold text-slate-500 mb-1.5 ml-1">Channel</label>
        <div class="inline-flex p-1 bg-slate-100/80 rounded-xl border border-slate-200/60">
            <a href="/Orders?orderSource=All&startDate=@startDate&endDate=@endDate" 
               class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all @(selectedSource == "All" ? "bg-[#9F54A6] text-white shadow-xs" : "text-slate-600 hover:text-[#9F54A6]")">
                All Channels
            </a>
            <a href="/Orders?orderSource=POS&startDate=@startDate&endDate=@endDate" 
               class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all @(selectedSource == "POS" ? "bg-[#9F54A6] text-white shadow-xs" : "text-slate-600 hover:text-[#9F54A6]")">
                POS Store
            </a>
            <a href="/Orders?orderSource=Online&startDate=@startDate&endDate=@endDate" 
               class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all @(selectedSource == "Online" ? "bg-[#9F54A6] text-white shadow-xs" : "text-slate-600 hover:text-[#9F54A6]")">
                Online Orders
            </a>
        </div>
        <input type="hidden" name="orderSource" value="@selectedSource" />
    </div>

    <!-- Date Range Picker & Buttons -->
    <div class="flex flex-col sm:flex-row items-end gap-3 flex-1 lg:max-w-2xl">
        <div class="flex flex-col flex-1 w-full">
            <label for="startDate" class="text-xs font-semibold text-slate-500 mb-1.5 ml-1">Start Date</label>
            <div class="relative w-full">
                <input type="text" id="startDate" name="startDate" value="@startDate" max="@maxDate" placeholder="dd/mm/yyyy" class="datepicker-input px-4 py-2.5 pr-10 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-[#9F54A6]/30 focus:border-[#9F54A6] transition-all w-full bg-white cursor-pointer" autocomplete="off" />
                <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-[#9F54A6]">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                </div>
            </div>
        </div>
        <div class="flex flex-col flex-1 w-full">
            <label for="endDate" class="text-xs font-semibold text-slate-500 mb-1.5 ml-1">End Date</label>
            <div class="relative w-full">
                <input type="text" id="endDate" name="endDate" value="@endDate" max="@maxDate" placeholder="dd/mm/yyyy" class="datepicker-input px-4 py-2.5 pr-10 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-[#9F54A6]/30 focus:border-[#9F54A6] transition-all w-full bg-white cursor-pointer" autocomplete="off" />
                <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-[#9F54A6]">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                </div>
            </div>
        </div>
        <div class="flex gap-2 w-full sm:w-auto mt-2 sm:mt-0">
            <button type="submit" class="flex-1 sm:flex-none px-6 py-2.5 bg-[#9F54A6] hover:bg-[#8E4495] text-white rounded-xl text-sm font-semibold transition-colors shadow-sm cursor-pointer">
                Filter
            </button>
            <a href="/Orders" class="flex-1 sm:flex-none px-6 py-2.5 bg-[#9F54A6] hover:bg-[#8E4495] text-white rounded-xl text-sm font-semibold transition-colors shadow-sm text-center">
                Clear
            </a>
        </div>
    </div>
</form>

<div class="bg-white rounded-2xl shadow-[0_4px_24px_-4px_rgba(184,117,194,0.06)] border border-[#F3E2F6] overflow-hidden flex flex-col">
    <div class="overflow-x-auto p-2">
        <table class="w-full text-left text-sm">
            <thead class="text-slate-500 bg-slate-50/50 rounded-lg">
                <tr>
                    <th class="px-4 py-3 font-semibold w-12 text-center">No.</th>
                    <th class="px-4 py-3 font-semibold">Order ID</th>
                    <th class="px-4 py-3 font-semibold">Date</th>
                    <th class="px-4 py-3 font-semibold">Time</th>
                    <th class="px-4 py-3 font-semibold">Items</th>
                    <th class="px-4 py-3 font-semibold">Total (MMK)</th>
                    <th class="px-4 py-3 font-semibold">Source</th>
                    <th class="px-4 py-3 font-semibold rounded-r-lg">Status</th>
                </tr>
            </thead>
            <tbody class="text-slate-700">
                @if (orders == null || orders.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="px-4 py-12 text-center text-slate-500 font-medium">
                            No orders found.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var order in orders)
                    {
                        <tr class="hover:bg-slate-50/80 transition-colors group border-b border-slate-50 last:border-0">
                            <td class="px-4 py-4 font-medium text-slate-500 text-center rounded-l-xl">@(++count)</td>
                            <td class="px-4 py-4 font-semibold text-teal-700 group-hover:text-teal-800">
                                <button type="button" onclick="openOrderDetailModal(@order.OrderId)" class="hover:underline text-left font-semibold text-teal-700 hover:text-teal-900 transition-colors cursor-pointer">
                                    @FormatOrderNo(order.OrderId, order.OrderDate)
                                </button>
                            </td>
                            <td class="px-4 py-4 text-slate-700 font-medium">@FormatOrderDateOnly(order.OrderDate)</td>
                            <td class="px-4 py-4 text-slate-500">@FormatOrderTimeOnly(order.OrderDate)</td>
                            <td class="px-4 py-4 text-slate-600 font-medium">@order.TotalQuantity</td>
                            <td class="px-4 py-4 font-semibold text-slate-900">@order.TotalPrice.ToString("#,##0")</td>
                            <td class="px-4 py-4 text-slate-600 font-medium">@order.OrderSource</td>
                            <td class="px-4 py-4 rounded-r-xl">
                                @if (order.OrderStatus == OrderStatus.Completed)
                                {
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-100/80 text-emerald-800 border border-emerald-200/50">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5"></span>
                                        Completed
                                    </span>
                                }
                                else if (order.OrderStatus == OrderStatus.Pending)
                                {
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-100/80 text-amber-800 border border-amber-200/50">
                                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500 mr-1.5 animate-pulse"></span>
                                        Pending
                                    </span>
                                }
                                else if (order.OrderStatus == OrderStatus.Rejected)
                                {
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-rose-100/80 text-rose-800 border border-rose-200/50">
                                        <span class="w-1.5 h-1.5 rounded-full bg-rose-500 mr-1.5"></span>
                                        Rejected
                                    </span>
                                }
                                else if (order.OrderStatus == OrderStatus.Cancelled)
                                {
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-red-100/80 text-red-800 border border-red-200/50">
                                        <span class="w-1.5 h-1.5 rounded-full bg-red-500 mr-1.5"></span>
                                        Cancelled
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-100/80 text-slate-800 border border-slate-200/50">
                                        <span class="w-1.5 h-1.5 rounded-full bg-slate-500 mr-1.5"></span>
                                        @order.OrderStatus.ToString()
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    
    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <div class="px-6 py-4 border-t border-slate-100 flex items-center justify-center bg-slate-50/30">
            <div class="inline-flex items-center gap-1 bg-white rounded-full p-1.5 shadow-[0_4px_24px_-4px_rgba(184,117,194,0.06)] border border-[#F3E2F6]">
                @if (currentPage > 1)
                {
                    <a href="/Orders?page=@(currentPage - 1)&orderSource=@selectedSource&startDate=@startDate&endDate=@endDate" class="w-8 h-8 flex items-center justify-center rounded-full bg-slate-100 text-slate-600 hover:bg-slate-200 transition-colors mr-1">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                    </a>
                }
                else
                {
                    <span class="w-8 h-8 flex items-center justify-center rounded-full bg-slate-50 text-slate-300 mr-1 cursor-not-allowed">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                    </span>
                }
                
                @for (int i = 1; i <= totalPages; i++)
                {
                    if (i == currentPage)
                    {
                        <span class="w-8 h-8 flex items-center justify-center rounded-full bg-teal-600 text-white text-sm font-semibold shadow-sm">@i</span>
                    }
                    else if (i == 1 || i == totalPages || Math.Abs(i - currentPage) <= 1)
                    {
                        <a href="/Orders?page=@i&orderSource=@selectedSource&startDate=@startDate&endDate=@endDate" class="w-8 h-8 flex items-center justify-center rounded-full text-slate-600 text-sm hover:bg-slate-100 font-medium transition-colors">@i</a>
                    }
                    else if (Math.Abs(i - currentPage) == 2)
                    {
                        <span class="w-8 h-8 flex items-center justify-center text-slate-400 tracking-widest">...</span>
                    }
                }

                @if (currentPage < totalPages)
                {
                    <a href="/Orders?page=@(currentPage + 1)&orderSource=@selectedSource&startDate=@startDate&endDate=@endDate" class="w-8 h-8 flex items-center justify-center rounded-full bg-teal-600 text-white hover:bg-teal-700 transition-colors ml-1 shadow-sm">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                    </a>
                }
                else
                {
                    <span class="w-8 h-8 flex items-center justify-center rounded-full bg-teal-600/50 text-white/70 ml-1 cursor-not-allowed shadow-sm">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                    </span>
                }
            </div>
        </div>
    }
</div>

<!-- ======================================================== -->
<!-- MODAL 1: Payment Slip Viewer Modal                      -->
<!-- ======================================================== -->
<dialog id="orderSlipModal" class="m-auto rounded-3xl p-0 border border-slate-200 bg-white shadow-2xl backdrop:bg-slate-900/60 backdrop:backdrop-blur-sm max-w-2xl w-[94%] sm:w-full transition-all overflow-hidden" aria-labelledby="slipModalTitle">
    <div class="flex flex-col max-h-[90vh]">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
            <div class="flex items-center gap-3">
                <span class="w-9 h-9 rounded-xl bg-primary-100 text-primary-600 border border-primary-200 flex items-center justify-center">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                </span>
                <div>
                    <h3 id="orderSlipModalTitle" class="text-base sm:text-lg font-bold text-slate-900">Payment Slip Proof</h3>
                    <p id="orderSlipModalSubtitle" class="text-xs text-slate-500 font-medium"></p>
                </div>
            </div>
            <button type="button" onclick="closeSlipModal()" class="p-2 text-slate-400 hover:text-slate-600 rounded-xl hover:bg-slate-100 transition-colors" aria-label="Close dialog">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>

        <div class="flex-1 overflow-auto p-4 sm:p-6 bg-slate-900/5 flex items-center justify-center min-h-[340px] max-h-[62vh] relative select-none">
            <div class="overflow-hidden max-w-full max-h-full flex items-center justify-center">
                <img id="orderSlipModalImg" src="" alt="Bank Transfer Slip" class="max-w-full max-h-[58vh] object-contain rounded-xl shadow-md transition-transform duration-200 origin-center" />
            </div>
            <div class="absolute bottom-4 left-1/2 -translate-x-1/2 bg-white/90 backdrop-blur-md border border-slate-200/80 rounded-full px-3 py-1.5 shadow-md flex items-center gap-2 text-xs font-semibold text-slate-700">
                <button type="button" onclick="zoomSlip(-0.25)" class="w-6 h-6 flex items-center justify-center rounded-full hover:bg-slate-100 active:scale-95 transition-all text-slate-600 font-bold" title="Zoom Out">-</button>
                <span id="orderZoomLevelDisplay" class="w-12 text-center text-[11px] font-mono font-bold text-slate-600">100%</span>
                <button type="button" onclick="zoomSlip(0.25)" class="w-6 h-6 flex items-center justify-center rounded-full hover:bg-slate-100 active:scale-95 transition-all text-slate-600 font-bold" title="Zoom In">+</button>
                <span class="w-px h-3 bg-slate-200 mx-0.5"></span>
                <button type="button" onclick="resetZoom()" class="text-[11px] px-2 py-0.5 hover:bg-slate-100 rounded-md text-slate-600 font-medium transition-all">Reset</button>
            </div>
        </div>

        <div class="px-6 py-4 bg-white border-t border-slate-100 flex items-center justify-between gap-3">
            <button type="button" onclick="closeSlipModal()" class="px-4 py-2 border border-slate-200 text-slate-600 rounded-xl text-xs font-semibold hover:bg-slate-50 transition-all">
                Close Viewer
            </button>
        </div>
    </div>
</dialog>

<!-- ======================================================== -->
<!-- MODAL 2: Order Detail Full Inspection Dialog            -->
<!-- ======================================================== -->
<dialog id="orderDetailModal" class="m-auto rounded-3xl p-0 border border-slate-200 bg-white shadow-2xl backdrop:bg-slate-900/60 backdrop:backdrop-blur-sm max-w-3xl w-[94%] sm:w-full transition-all overflow-hidden" aria-labelledby="detailModalTitle">
    <div class="flex flex-col max-h-[90vh]">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
            <div class="flex items-center gap-3">
                <span class="w-9 h-9 rounded-xl bg-primary-100 text-primary-600 border border-primary-200 flex items-center justify-center">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                </span>
                <div>
                    <div class="flex items-center gap-2">
                        <h3 id="detailOrderNo" class="text-base sm:text-lg font-bold text-slate-900">Order Details</h3>
                        <span id="detailStatusBadge"></span>
                    </div>
                    <p id="detailOrderDate" class="text-xs text-slate-500 font-medium"></p>
                </div>
            </div>
            <button type="button" onclick="closeDetailModal()" class="p-2 text-slate-400 hover:text-slate-600 rounded-xl hover:bg-slate-100 transition-colors" aria-label="Close dialog">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>

        <div class="flex-1 overflow-y-auto p-6 space-y-6">
            <!-- Rejection Reason Banner (if order was rejected) -->
            <div id="detailRejectBanner" class="hidden rounded-2xl bg-rose-50 border border-rose-200 p-4">
                <div class="flex items-start gap-3">
                    <span class="w-6 h-6 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center shrink-0 mt-0.5">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                    </span>
                    <div>
                        <h4 class="text-xs font-bold text-rose-900 uppercase tracking-wider">Rejection Reason Note</h4>
                        <p id="detailRejectReasonText" class="text-xs sm:text-sm text-rose-700 font-medium mt-0.5"></p>
                    </div>
                </div>
            </div>

            <!-- Customer & Payment Cards Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- Customer Info Card -->
                <div class="rounded-2xl border border-slate-200/80 p-4 bg-slate-50/40">
                    <div class="flex items-center gap-2 mb-2 text-xs font-bold uppercase tracking-wider text-slate-500">
                        <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                        Customer Information
                    </div>
                    <div class="space-y-1.5 text-xs text-slate-700">
                        <div><span class="text-slate-400 font-medium">Name:</span> <strong id="detailCustomerName" class="text-slate-900"></strong></div>
                        <div><span class="text-slate-400 font-medium">Phone:</span> <strong id="detailCustomerPhone" class="text-slate-900"></strong></div>
                        <div><span class="text-slate-400 font-medium">Shipping Address:</span> <span id="detailShippingAddress" class="text-slate-800 font-medium"></span></div>
                    </div>
                </div>

                <!-- Payment Proof Card -->
                <div class="rounded-2xl border border-slate-200/80 p-4 bg-slate-50/40 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center gap-2 mb-2 text-xs font-bold uppercase tracking-wider text-slate-500">
                            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
                            Payment Proof
                        </div>
                        <div class="space-y-1.5 text-xs text-slate-700">
                            <div><span class="text-slate-400 font-medium">Payment Method:</span> <strong id="detailPaymentMethod" class="text-slate-900"></strong></div>
                            <div><span class="text-slate-400 font-medium">Payment Status:</span> <span id="detailPaymentStatus" class="font-bold"></span></div>
                        </div>
                    </div>

                    <div id="detailSlipThumbnailContainer" class="mt-3 pt-3 border-t border-slate-200/70 flex items-center justify-between">
                        <span class="text-xs text-slate-500 font-medium">Uploaded Slip:</span>
                        <div id="detailSlipAction"></div>
                    </div>
                </div>

                <!-- Dedicated Customer Notes Card (Shown when customer notes exist) -->
                <div id="detailNotesCard" class="hidden col-span-1 md:col-span-2 rounded-2xl border border-amber-200/80 p-4 bg-amber-50/60 shadow-2xs">
                    <div class="flex items-center gap-2 mb-1 text-xs font-bold uppercase tracking-wider text-amber-800">
                        <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"/></svg>
                        Customer Note & Special Instructions
                    </div>
                    <p id="detailNotes" class="text-xs sm:text-sm text-amber-950 font-medium leading-relaxed"></p>
                </div>
            </div>

            <!-- Ordered Book Editions Table -->
            <div class="space-y-2">
                <h4 class="text-xs font-bold text-slate-500 uppercase tracking-wider">Ordered Book Editions</h4>
                <div class="border border-slate-200 rounded-2xl overflow-hidden">
                    <table class="w-full text-left text-xs sm:text-sm">
                        <thead class="bg-slate-50 text-slate-500 border-b border-slate-200 font-semibold">
                            <tr>
                                <th class="px-4 py-3 text-left">Book Title & Edition</th>
                                <th class="px-4 py-3 text-center">Qty</th>
                                <th class="px-4 py-3 text-left">Unit Price (MMK)</th>
                                <th class="px-4 py-3 text-left">Subtotal (MMK)</th>
                            </tr>
                        </thead>
                        <tbody id="detailItemsTableBody" class="divide-y divide-slate-100 text-slate-700">
                            <!-- Items populated dynamically -->
                        </tbody>
                        <tfoot class="bg-slate-50/70 border-t border-slate-200">
                            <tr>
                                <td colspan="3" class="px-4 py-3 font-bold text-slate-700 text-left text-xs uppercase tracking-wider">Total (MMK):</td>
                                <td class="px-4 py-3 font-extrabold text-primary-700 text-left text-sm sm:text-base" id="detailOrderTotal"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <div class="px-6 py-4 bg-white border-t border-slate-100 flex items-center justify-between gap-3">
            <button type="button" onclick="closeDetailModal()" class="px-4 py-2 border border-slate-200 text-slate-600 rounded-xl text-xs font-semibold hover:bg-slate-50 transition-all cursor-pointer">
                Close
            </button>
            <div id="detailModalFooterActions" class="flex items-center gap-2">
                <!-- Dynamically populated -->
            </div>
        </div>
    </div>
</dialog>

<!-- ======================================================== -->
<!-- MODAL 3: Confirm & Verify Order Dialog                   -->
<!-- ======================================================== -->
<dialog id="confirmOrderModal" class="m-auto rounded-3xl p-0 border border-slate-200 bg-white shadow-2xl backdrop:bg-slate-900/60 backdrop:backdrop-blur-sm max-w-md w-[92%] sm:w-full transition-all overflow-hidden" aria-labelledby="confirmModalTitle">
    <div class="p-6 sm:p-8 text-center relative">
        <button type="button" onclick="closeConfirmDialog()" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 p-1.5 rounded-xl hover:bg-slate-100 transition-colors" aria-label="Close dialog">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>

        <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-primary-50 border border-primary-100 text-primary-600 flex items-center justify-center shadow-xs">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
        </div>

        <h3 id="confirmModalTitle" class="text-xl font-bold text-slate-900 mb-1">Verify Payment & Confirm</h3>
        <p class="text-xs text-slate-500 font-medium mb-4">
            Order <strong id="confirmOrderNoText" class="text-slate-800"></strong> &bull; Total: <strong id="confirmOrderTotalText" class="text-primary-700"></strong>
        </p>

        <div class="p-4 rounded-2xl bg-primary-50/60 border border-primary-200/70 text-left mb-6">
            <div class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-primary-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <div class="text-xs text-primary-800/90 leading-relaxed">
                    By verifying this order, payment is recorded as <strong>Verified</strong>, inventory stock will be immediately deducted for each book edition, and the order will move to <strong>Completed</strong>.
                </div>
            </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-3">
            <button type="button" onclick="closeConfirmDialog()" class="w-full order-2 sm:order-1 py-2.5 px-4 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-700 font-semibold text-xs sm:text-sm transition-all">
                Cancel
            </button>
            <button type="button" id="btnExecuteConfirm" onclick="executeConfirmOrder()" class="w-full order-1 sm:order-2 inline-flex items-center justify-center gap-2 bg-primary-500 hover:bg-primary-600 text-white font-semibold py-2.5 px-4 rounded-xl transition-all shadow-sm text-xs sm:text-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span id="btnExecuteConfirmText">Confirm & Deduct Stock</span>
            </button>
        </div>
    </div>
</dialog>

<!-- ======================================================== -->
<!-- MODAL 4: Reject Order with Mandatory Reason Dialog       -->
<!-- ======================================================== -->
<dialog id="rejectOrderModal" class="m-auto rounded-3xl p-0 border border-slate-200 bg-white shadow-2xl backdrop:bg-slate-900/60 backdrop:backdrop-blur-sm max-w-lg w-[92%] sm:w-full transition-all overflow-hidden" aria-labelledby="rejectModalTitle">
    <div class="p-6 sm:p-8 relative text-left">
        <button type="button" onclick="closeRejectDialog()" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 p-1.5 rounded-xl hover:bg-slate-100 transition-colors" aria-label="Close dialog">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>

        <div class="flex items-center gap-3 mb-4">
            <div class="w-12 h-12 rounded-2xl bg-rose-50 border border-rose-100 text-rose-600 flex items-center justify-center shrink-0 shadow-xs">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </div>
            <div>
                <h3 id="rejectModalTitle" class="text-lg font-bold text-slate-900">Reject Online Order</h3>
                <p class="text-xs text-slate-500 font-medium">Order <strong id="rejectOrderNoText" class="text-slate-800"></strong></p>
            </div>
        </div>

        <p class="text-xs text-slate-600 leading-relaxed mb-4">
            Please select or specify why this order is rejected. <strong>This reason is required</strong> and will be preserved for store auditing and customer records.
        </p>

        <!-- Quick Reason Preset Chips -->
        <div class="mb-4">
            <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Quick Presets:</label>
            <div class="flex flex-wrap gap-1.5">
                <button type="button" onclick="setRejectReasonPreset('Invalid or blurry payment transfer slip')" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors">
                    Invalid / Blurry Slip
                </button>
                <button type="button" onclick="setRejectReasonPreset('Transfer amount does not match order total')" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors">
                    Amount Mismatch
                </button>
                <button type="button" onclick="setRejectReasonPreset('Duplicate screenshot already used for another order')" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors">
                    Duplicate Slip
                </button>
                <button type="button" onclick="setRejectReasonPreset('Customer requested cancellation')" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors">
                    Customer Cancelled
                </button>
                <button type="button" onclick="setRejectReasonPreset('Book edition out of stock / unavailable')" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors">
                    Out of Stock
                </button>
            </div>
        </div>

        <div class="mb-6">
            <label for="rejectReasonInput" class="block text-xs font-bold text-slate-700 mb-1.5">
                Rejection Reason Note <span class="text-rose-500">*</span>
            </label>
            <textarea id="rejectReasonInput" rows="3" placeholder="Provide a detailed note explaining why this order was rejected..." class="w-full px-3.5 py-2.5 border border-slate-200 rounded-xl text-xs sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-rose-500/30 focus:border-rose-500 transition-all"></textarea>
            <p id="rejectReasonError" class="text-[11px] text-rose-600 font-medium mt-1 hidden">Please provide a rejection reason note.</p>
        </div>

        <div class="flex flex-col sm:flex-row gap-3">
            <button type="button" onclick="closeRejectDialog()" class="w-full order-2 sm:order-1 py-2.5 px-4 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-700 font-semibold text-xs sm:text-sm transition-all">
                Cancel
            </button>
            <button type="button" id="btnExecuteReject" onclick="executeRejectOrder()" class="w-full order-1 sm:order-2 inline-flex items-center justify-center gap-2 bg-rose-600 hover:bg-rose-700 text-white font-semibold py-2.5 px-4 rounded-xl transition-all shadow-sm text-xs sm:text-sm">
                <span id="btnExecuteRejectText">Confirm Rejection</span>
            </button>
        </div>
    </div>
</dialog>

<script>
    const canConfirmOrders = @(canConfirmOrders.ToString().ToLower());
    const canRejectOrders = @(canRejectOrders.ToString().ToLower());

    let currentActiveOrderId = null;
    let currentActiveOrderNo = '';
    let currentZoomScale = 1.0;

    function showModalDialog(id) {
        const dlg = document.getElementById(id);
        if (dlg) {
            if (typeof dlg.showModal === 'function') dlg.showModal();
            else dlg.setAttribute('open', '');
        }
    }

    function closeModalDialog(id) {
        const dlg = document.getElementById(id);
        if (dlg) {
            if (typeof dlg.close === 'function') dlg.close();
            else dlg.removeAttribute('open');
        }
    }

    // 1. Slip Viewer Modal
    function openSlipModal(imageUrl, orderNo, customerName) {
        document.getElementById('orderSlipModalImg').src = imageUrl;
        document.getElementById('orderSlipModalSubtitle').textContent = `${orderNo} • ${customerName}`;
        resetZoom();
        showModalDialog('orderSlipModal');
    }

    function closeSlipModal() {
        closeModalDialog('orderSlipModal');
    }

    function zoomSlip(delta) {
        currentZoomScale = Math.min(Math.max(0.5, currentZoomScale + delta), 3.0);
        updateZoomDisplay();
    }

    function resetZoom() {
        currentZoomScale = 1.0;
        updateZoomDisplay();
    }

    function updateZoomDisplay() {
        const img = document.getElementById('orderSlipModalImg');
        const display = document.getElementById('orderZoomLevelDisplay');
        if (img) img.style.transform = `scale(${currentZoomScale})`;
        if (display) display.textContent = `${Math.round(currentZoomScale * 100)}%`;
    }

    // 2. Order Detail Full Modal
    async function openOrderDetailModal(orderId) {
        try {
            const response = await fetch(`/Orders/Detail/${orderId}`);
            const result = await response.json();

            if (!result || !result.isSuccess || !result.data) {
                if (typeof window.showToast === 'function') {
                    window.showToast(result?.message || 'Failed to load order details.', false);
                }
                return;
            }

            const o = result.data;
            const orderNo = `C${(o.orderDate ? new Date(o.orderDate).toISOString().slice(2,10).replace(/-/g,'') : '')}${String(o.orderId).padStart(4, '0')}`;

            document.getElementById('detailOrderNo').textContent = `Order #${orderNo}`;
            document.getElementById('detailOrderDate').textContent = o.orderDate ? new Date(o.orderDate).toLocaleString() : '-';

            // Status Badge
            const statusBadge = document.getElementById('detailStatusBadge');
            if (o.orderStatus === 1 || o.orderStatus === 'Pending') {
                statusBadge.innerHTML = `<span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800">Pending Review</span>`;
            } else if (o.orderStatus === 2 || o.orderStatus === 'Completed') {
                statusBadge.innerHTML = `<span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800">Completed & Verified</span>`;
            } else if (o.orderStatus === 3 || o.orderStatus === 'Rejected') {
                statusBadge.innerHTML = `<span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-100 text-rose-800">Rejected</span>`;
            } else {
                statusBadge.innerHTML = `<span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-800">${o.orderStatus}</span>`;
            }

            // Rejection banner
            const rejectBanner = document.getElementById('detailRejectBanner');
            if ((o.orderStatus === 3 || o.orderStatus === 'Rejected') && o.rejectReason) {
                document.getElementById('detailRejectReasonText').textContent = o.rejectReason;
                rejectBanner.classList.remove('hidden');
            } else {
                rejectBanner.classList.add('hidden');
            }

            // Customer
            document.getElementById('detailCustomerName').textContent = o.customerName || 'In-Store Walk-in';
            document.getElementById('detailCustomerPhone').textContent = o.customerPhone || 'Not provided';
            document.getElementById('detailShippingAddress').textContent = o.shippingAddress || (o.orderSource === 'POS' ? 'In-Store POS' : 'Not provided');

            // Customer Notes Card (Dedicated card)
            const notesCard = document.getElementById('detailNotesCard');
            if (o.notes && o.notes.trim()) {
                document.getElementById('detailNotes').textContent = o.notes;
                notesCard.classList.remove('hidden');
            } else {
                notesCard.classList.add('hidden');
            }

            // Payment
            document.getElementById('detailPaymentMethod').textContent = o.paymentMethod || 'Cash';
            const payStatusEl = document.getElementById('detailPaymentStatus');
            if (o.paymentStatus === 2 || o.paymentStatus === 'Verified') {
                payStatusEl.className = 'font-bold text-emerald-700';
                payStatusEl.textContent = 'Verified / Paid';
            } else if (o.paymentStatus === 3 || o.paymentStatus === 'Rejected') {
                payStatusEl.className = 'font-bold text-rose-700';
                payStatusEl.textContent = 'Rejected';
            } else if (o.paymentStatus === 1 || o.paymentStatus === 'Submitted') {
                payStatusEl.className = 'font-bold text-blue-700';
                payStatusEl.textContent = 'Slip Submitted';
            } else {
                payStatusEl.className = 'font-bold text-amber-700';
                payStatusEl.textContent = 'Unpaid';
            }

            // Slip
            const slipAction = document.getElementById('detailSlipAction');
            if (o.paymentScreenshotUrl) {
                slipAction.innerHTML = `
                    <button type="button" onclick="closeDetailModal(); openSlipModal('${o.paymentScreenshotUrl}', '${orderNo}', '${(o.customerName || '').replace(/'/g, "\\'")}')" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-primary-50 hover:bg-primary-100 text-primary-700 rounded-xl text-xs font-bold border border-primary-200 transition-colors cursor-pointer">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                        <span>Inspect Slip</span>
                    </button>
                `;
            } else {
                slipAction.innerHTML = `<span class="text-xs text-slate-400 font-medium italic">No slip attached</span>`;
            }

            // Items
            const itemsTbody = document.getElementById('detailItemsTableBody');
            itemsTbody.innerHTML = '';
            if (o.items && o.items.length > 0) {
                o.items.forEach(item => {
                    const row = document.createElement('tr');
                    const subtotal = item.subtotal ?? (item.quantity * item.unitPrice);
                    row.innerHTML = `
                        <td class="px-4 py-3 text-left">
                            <div class="font-bold text-slate-900">${item.bookTitle || 'Untitled Book'}</div>
                            <div class="text-[11px] text-slate-400 font-medium">${item.editionName ? item.editionName + ' Edition' : 'Standard Edition'}</div>
                        </td>
                        <td class="px-4 py-3 text-center font-bold text-slate-800">${item.quantity}</td>
                        <td class="px-4 py-3 text-left text-slate-700">${Number(item.unitPrice).toLocaleString()}</td>
                        <td class="px-4 py-3 text-left font-bold text-slate-900">${Number(subtotal).toLocaleString()}</td>
                    `;
                    itemsTbody.appendChild(row);
                });
            } else {
                itemsTbody.innerHTML = `<tr><td colspan="4" class="px-4 py-6 text-center text-slate-400">No items found for this order.</td></tr>`;
            }

            document.getElementById('detailOrderTotal').textContent = Number(o.totalPrice).toLocaleString();

            // Footer Actions
            const footerActions = document.getElementById('detailModalFooterActions');
            let actionsHtml = '';
            if (o.orderStatus === 1 || o.orderStatus === 'Pending') {
                if (canRejectOrders) {
                    actionsHtml += `
                        <button type="button" onclick="closeDetailModal(); openRejectDialog(${o.orderId}, '${orderNo}')" class="px-4 py-2 bg-rose-50 hover:bg-rose-100 text-rose-600 border border-rose-200 rounded-xl text-xs font-bold transition-all cursor-pointer">
                            Reject Order
                        </button>
                    `;
                }
                if (canConfirmOrders) {
                    actionsHtml += `
                        <button type="button" onclick="closeDetailModal(); openConfirmDialog(${o.orderId}, '${orderNo}', '${Number(o.totalPrice).toLocaleString()} MMK')" class="px-4 py-2 bg-primary-500 hover:bg-primary-600 text-white rounded-xl text-xs font-bold transition-all shadow-2xs cursor-pointer">
                            Verify & Confirm
                        </button>
                    `;
                }
            } else if (o.orderStatus === 2 || o.orderStatus === 'Completed') {
                actionsHtml += `
                    <button type="button" onclick="printOrderReceipt(${o.orderId})" class="px-4 py-2 bg-slate-900 hover:bg-black text-white rounded-xl text-xs font-bold transition-all shadow-2xs flex items-center gap-1.5 cursor-pointer">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
                        <span>Print Receipt</span>
                    </button>
                `;
            }
            footerActions.innerHTML = actionsHtml;

            showModalDialog('orderDetailModal');
        } catch (err) {
            console.error('Error fetching order detail:', err);
            if (typeof window.showToast === 'function') {
                window.showToast('Network error while fetching order details.', false);
            }
        }
    }

    function closeDetailModal() {
        closeModalDialog('orderDetailModal');
    }

    // 3. Confirm Dialog
    function openConfirmDialog(orderId, orderNo, totalFormatted) {
        currentActiveOrderId = orderId;
        currentActiveOrderNo = orderNo;
        document.getElementById('confirmOrderNoText').textContent = '#' + orderNo;
        document.getElementById('confirmOrderTotalText').textContent = totalFormatted || '';
        showModalDialog('confirmOrderModal');
    }

    function closeConfirmDialog() {
        closeModalDialog('confirmOrderModal');
    }

    async function executeConfirmOrder() {
        if (!currentActiveOrderId) return;
        const btn = document.getElementById('btnExecuteConfirm');
        const btnText = document.getElementById('btnExecuteConfirmText');
        btn.disabled = true;
        btnText.textContent = 'Verifying...';

        try {
            const response = await fetch(`/OnlineOrders/Confirm/${currentActiveOrderId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const result = await response.json();

            if (result && result.isSuccess) {
                closeConfirmDialog();
                if (typeof window.showToast === 'function') {
                    window.showToast(result.message || 'Order payment verified and stock deducted successfully!', true);
                }
                setTimeout(() => window.location.reload(), 900);
            } else {
                if (typeof window.showToast === 'function') {
                    window.showToast(result?.message || 'Failed to confirm order.', false);
                }
                btn.disabled = false;
                btnText.textContent = 'Confirm & Deduct Stock';
            }
        } catch (err) {
            console.error(err);
            if (typeof window.showToast === 'function') {
                window.showToast('Network error while confirming order.', false);
            }
            btn.disabled = false;
            btnText.textContent = 'Confirm & Deduct Stock';
        }
    }

    // 4. Reject Dialog
    function setRejectReasonPreset(reason) {
        const input = document.getElementById('rejectReasonInput');
        if (input) {
            input.value = reason;
            document.getElementById('rejectReasonError').classList.add('hidden');
            input.focus();
        }
    }

    function openRejectDialog(orderId, orderNo) {
        currentActiveOrderId = orderId;
        currentActiveOrderNo = orderNo;
        document.getElementById('rejectOrderNoText').textContent = '#' + orderNo;
        document.getElementById('rejectReasonInput').value = '';
        document.getElementById('rejectReasonError').classList.add('hidden');
        showModalDialog('rejectOrderModal');
    }

    function closeRejectDialog() {
        closeModalDialog('rejectOrderModal');
    }

    async function executeRejectOrder() {
        if (!currentActiveOrderId) return;
        const reasonInput = document.getElementById('rejectReasonInput');
        const reasonError = document.getElementById('rejectReasonError');
        const reason = reasonInput.value ? reasonInput.value.trim() : '';

        if (!reason) {
            reasonError.classList.remove('hidden');
            reasonInput.focus();
            return;
        }

        const btn = document.getElementById('btnExecuteReject');
        const btnText = document.getElementById('btnExecuteRejectText');
        btn.disabled = true;
        btnText.textContent = 'Rejecting...';

        try {
            const response = await fetch(`/OnlineOrders/Reject/${currentActiveOrderId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ rejectReason: reason })
            });
            const result = await response.json();

            if (result && result.isSuccess) {
                closeRejectDialog();
                if (typeof window.showToast === 'function') {
                    window.showToast(result.message || 'Order rejected successfully.', true);
                }
                setTimeout(() => window.location.reload(), 900);
            } else {
                if (typeof window.showToast === 'function') {
                    window.showToast(result?.message || 'Failed to reject order.', false);
                }
                btn.disabled = false;
                btnText.textContent = 'Confirm Rejection';
            }
        } catch (err) {
            console.error(err);
            if (typeof window.showToast === 'function') {
                window.showToast('Network error while rejecting order.', false);
            }
            btn.disabled = false;
            btnText.textContent = 'Confirm Rejection';
        }
    }

    // 5. Silent Direct Printing without opening new tabs
    function printOrderReceipt(orderId) {
        let iframe = document.getElementById('receiptPrintIframe');
        if (!iframe) {
            iframe = document.createElement('iframe');
            iframe.id = 'receiptPrintIframe';
            iframe.style.position = 'fixed';
            iframe.style.right = '0';
            iframe.style.bottom = '0';
            iframe.style.width = '0';
            iframe.style.height = '0';
            iframe.style.border = '0';
            iframe.style.visibility = 'hidden';
            document.body.appendChild(iframe);
        }
        iframe.src = `/Orders/OrderDetail/${orderId}`;
        iframe.onload = function() {
            setTimeout(() => {
                try {
                    iframe.contentWindow.focus();
                    iframe.contentWindow.print();
                } catch (e) {
                    console.error('Print iframe error:', e);
                }
            }, 400);
        };
    }
</script>
