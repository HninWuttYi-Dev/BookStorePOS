@{
    ViewData["Title"] = "Orders";
    var orders = ViewData["Orders"] as List<OrderModel> ?? new List<OrderModel>();
    var summary = ViewData["Summary"] as OrderHistorySummaryModel;
    int currentPage = ViewData["CurrentPage"] != null ? Convert.ToInt32(ViewData["CurrentPage"]) : 1;
    int totalPages = ViewData["TotalPages"] != null ? Convert.ToInt32(ViewData["TotalPages"]) : 1;
    
    bool hasMessage = TempData["Message"] != null;
    bool isSuccess = TempData["isSuccess"] != null ? Convert.ToBoolean(TempData["isSuccess"]) : false;
    string message = TempData["Message"]?.ToString() ?? string.Empty;

    string FormatOrderDateOnly(DateTime? date)
    {
        if (!date.HasValue) return "-";
        var d = date.Value;
        if (d.Date == DateTime.Today) return "Today";
        if (d.Date == DateTime.Today.AddDays(-1)) return "Yesterday";
        return d.ToString("d/M/yyyy");
    }

    string FormatOrderTimeOnly(DateTime? date)
    {
        if (!date.HasValue) return "-";
        return date.Value.ToString("hh:mm tt");
    }

    string FormatOrderNo(int id, DateTime? date)
    {
        var d = date ?? DateTime.Now;
        return $"C{d.ToString("yyMMdd")}{id.ToString("0000")}";
    }
    
    int count = (currentPage - 1) * 10;
    string startDate = ViewData["StartDate"]?.ToString();
    string endDate = ViewData["EndDate"]?.ToString();
    string maxDate = DateTime.Now.ToString("yyyy-MM-dd");
}

<div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Orders</h1>
    <p class="text-slate-500 mt-2 text-sm font-medium">View and manage all transaction history</p>
</div>

@if (hasMessage)
{
    <div class="p-4 mb-4 text-sm rounded-lg @(isSuccess ? "bg-emerald-50 text-emerald-800" : "bg-red-50 text-red-800")">
        @message
    </div>
}

@if (summary != null)
{
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="bg-white rounded-2xl p-6 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)] border border-slate-100 flex flex-col transition-all hover:-translate-y-1 hover:shadow-lg">
            <span class="text-sm font-semibold text-slate-500 mb-2">Total Orders</span>
            <span class="text-3xl font-bold text-slate-900">@summary.TotalOrders</span>
        </div>
        <div class="bg-white rounded-2xl p-6 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)] border border-slate-100 flex flex-col transition-all hover:-translate-y-1 hover:shadow-lg">
            <span class="text-sm font-semibold text-slate-500 mb-2">Total Revenue</span>
            <span class="text-3xl font-bold text-teal-700">$@summary.TotalRevenue.ToString("0.00")</span>
        </div>
        <div class="bg-white rounded-2xl p-6 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)] border border-slate-100 flex flex-col transition-all hover:-translate-y-1 hover:shadow-lg">
            <span class="text-sm font-semibold text-slate-500 mb-2">Average Order Value</span>
            <span class="text-3xl font-bold text-slate-900">$@summary.AverageOrderValue.ToString("0.00")</span>
        </div>
    </div>
}

<form method="get" action="/Orders" class="mb-6 w-full flex flex-col md:flex-row items-end gap-4 bg-white p-5 rounded-2xl border border-slate-100 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)]">
    <div class="flex flex-col flex-1 w-full">
        <label for="startDate" class="text-xs font-semibold text-slate-500 mb-1.5 ml-1">Start Date</label>
        <input type="date" id="startDate" name="startDate" value="@startDate" max="@maxDate" class="px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all w-full" />
    </div>
    <div class="flex flex-col flex-1 w-full">
        <label for="endDate" class="text-xs font-semibold text-slate-500 mb-1.5 ml-1">End Date</label>
        <input type="date" id="endDate" name="endDate" value="@endDate" max="@maxDate" class="px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all w-full" />
    </div>
    <div class="flex gap-3 w-full md:w-auto mt-4 md:mt-0">
        <button type="submit" class="flex-1 md:flex-none px-6 py-2.5 bg-teal-600 text-white rounded-xl text-sm font-semibold hover:bg-teal-700 transition-colors shadow-sm">
            Filter
        </button>
        <a href="/Orders" class="flex-1 md:flex-none px-6 py-2.5 bg-slate-100 text-slate-700 rounded-xl text-sm font-semibold hover:bg-slate-200 transition-colors text-center">
            Clear
        </a>
    </div>
</form>

<div class="bg-white rounded-2xl shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)] border border-slate-100 overflow-hidden flex flex-col">
    <div class="overflow-x-auto p-2">
        <table class="w-full text-left text-sm">
            <thead class="text-slate-500 bg-slate-50/50 rounded-lg">
                <tr>
                    <th class="px-4 py-3 font-semibold w-12 text-center">No.</th>
                    <th class="px-4 py-3 font-semibold">Order ID</th>
                    <th class="px-4 py-3 font-semibold">Date</th>
                    <th class="px-4 py-3 font-semibold">Time</th>
                    <th class="px-4 py-3 font-semibold">Items</th>
                    <th class="px-4 py-3 font-semibold">Total</th>
                    <th class="px-4 py-3 font-semibold rounded-r-lg">Status</th>
                </tr>
            </thead>
            <tbody class="text-slate-700">
                @if (orders == null || orders.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="px-4 py-12 text-center text-slate-500 font-medium">
                            No orders found.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var order in orders)
                    {
                        <tr class="hover:bg-slate-50/80 transition-colors group border-b border-slate-50 last:border-0">
                            <td class="px-4 py-4 font-medium text-slate-500 text-center rounded-l-xl">@(++count)</td>
                            <td class="px-4 py-4 font-semibold text-teal-700 group-hover:text-teal-800">
                                @FormatOrderNo(order.OrderId, order.OrderDate)
                            </td>
                            <td class="px-4 py-4 text-slate-700 font-medium">@FormatOrderDateOnly(order.OrderDate)</td>
                            <td class="px-4 py-4 text-slate-500">@FormatOrderTimeOnly(order.OrderDate)</td>
                            <td class="px-4 py-4 text-slate-600 font-medium">@order.TotalQuantity</td>
                            <td class="px-4 py-4 font-semibold text-slate-900">$@order.TotalPrice.ToString("0.00")</td>
                            <td class="px-4 py-4 rounded-r-xl">
                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-100/80 text-emerald-800 border border-emerald-200/50">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5"></span>
                                    Completed
                                </span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    
    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <div class="px-6 py-4 border-t border-slate-100 flex items-center justify-between bg-slate-50/30">
            <span class="text-sm text-slate-500 font-medium">Page @currentPage of @totalPages</span>
            <div class="flex gap-2">
                @if (currentPage > 1)
                {
                    <a href="/Orders?page=@(currentPage - 1)&startDate=@startDate&endDate=@endDate" class="px-4 py-2 text-sm font-semibold text-slate-700 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition-colors shadow-sm">Previous</a>
                }
                @if (currentPage < totalPages)
                {
                    <a href="/Orders?page=@(currentPage + 1)&startDate=@startDate&endDate=@endDate" class="px-4 py-2 text-sm font-semibold text-slate-700 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition-colors shadow-sm">Next</a>
                }
            </div>
        </div>
    }
</div>
