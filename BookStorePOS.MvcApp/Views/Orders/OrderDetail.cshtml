@{
    ViewData["Title"] = "Order Details";
    var order = ViewData["OrderDetail"] as OrderModel ?? new OrderModel();

    string FormatOrderDateOnly(DateTime? date)
    {
        if (!date.HasValue) return "-";
        return date.Value.ToString("dd MMMM yyyy").ToUpper();
    }

    string FormatOrderTimeOnly(DateTime? date)
    {
        if (!date.HasValue) return "-";
        return date.Value.ToString("hh:mm tt");
    }

    string FormatOrderNo(int id, DateTime? date)
    {
        var d = date ?? DateTime.Now;
        return $"{d.ToString("yyMMdd")}{id.ToString("0000")}";
    }

    var userRole = Context.Request.Cookies["pos_role"] ?? "";
    var userPerms = Context.Request.Cookies["pos_permissions"] ?? "";
    bool isAdmin = string.Equals(userRole, "Admin", StringComparison.OrdinalIgnoreCase);
    var permList = userPerms.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    bool canViewOrders = isAdmin || permList.Contains("Order.View", StringComparer.OrdinalIgnoreCase);
    bool canConfirmOrders = isAdmin || permList.Contains("Order.Confirm", StringComparer.OrdinalIgnoreCase);
    bool canRejectOrders = isAdmin || permList.Contains("Order.Reject", StringComparer.OrdinalIgnoreCase);

    bool isCompleted = order.OrderStatus == OrderStatus.Completed;
    bool isOnlineOrder = string.Equals(order.OrderSource, "Online", StringComparison.OrdinalIgnoreCase);

    string backUrl = canViewOrders 
        ? "/Orders" 
        : "/Checkout";
    string backText = canViewOrders 
        ? "Back to Orders" 
        : "Back to Checkout";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400;1,700&display=swap');
    
    .receipt-font {
        font-family: 'Courier Prime', monospace;
        color: #000000;
    }
    
    .receipt-container {
        position: relative;
        background-color: #ffffff;
    }
    
    .receipt-container::before {
        content: "";
        position: absolute;
        top: -10px;
        left: 0;
        right: 0;
        height: 10px;
        background-size: 20px 20px;
        background-image: radial-gradient(circle at 10px 0, transparent 10px, #ffffff 11px);
    }
    
    .receipt-container::after {
        content: "";
        position: absolute;
        bottom: -10px;
        left: 0;
        right: 0;
        height: 10px;
        background-size: 20px 20px;
        background-image: radial-gradient(circle at 10px 20px, transparent 10px, #ffffff 11px);
    }
    
    .dashed-line {
        border-top: 1.5px dashed #000000;
    }
    
    @@media print {
        * {
            color: #000000 !important;
            border-color: #000000 !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
        body { background-color: white !important; }
        .no-print { display: none !important; }
        .receipt-wrapper { 
            background: none !important; 
            min-height: auto !important; 
            padding: 0 !important;
        }
        .receipt-container { 
            box-shadow: none !important; 
            margin: 0 auto !important; 
            border: 1px dashed #000000 !important;
            background-color: white !important;
        }
        aside, header, nav { display: none !important; }
        main, .flex-1, .overflow-y-auto { 
            overflow: visible !important; 
            height: auto !important; 
        }
    }
</style>

@if (isCompleted)
{
    <!-- ======================================================== -->
    <!-- 1. COMPLETED ORDER SALES VOUCHER (PRINTABLE RECEIPT)    -->
    <!-- ======================================================== -->
    <div class="mb-4 flex items-center justify-between no-print">
        <div class="flex items-center gap-3">
            <a href="@backUrl" class="text-neutral-500 hover:text-black transition-colors p-1.5 rounded-lg hover:bg-neutral-100">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 12H5M12 19l-7-7 7-7"/>
                </svg>
            </a>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">@backText</h1>
            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5"></span>
                Completed
            </span>
        </div>
        
        <button onclick="window.print()" class="px-5 py-2.5 bg-black hover:bg-neutral-800 text-white rounded-xl flex items-center gap-2 font-semibold text-sm transition-colors shadow-sm cursor-pointer">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
            Print Receipt
        </button>
    </div>

    <div class="bg-[#18181B] min-h-[calc(100vh-12rem)] rounded-2xl flex justify-center py-12 px-4 overflow-y-auto receipt-wrapper">
        <div class="w-full max-w-[420px] receipt-font text-black">
            <div class="receipt-container p-8 shadow-2xl relative mt-3 mb-3 border border-black/10">
                
                <div class="text-center mb-6">
                    <h1 class="text-3xl font-black tracking-[0.2em] mb-2 uppercase text-black">Bookstore</h1>
                    <p class="text-xs tracking-wider text-black uppercase font-medium">MONTHLY READING RECEIPT #@FormatOrderNo(order.OrderId, order.OrderDate)</p>
                    <p class="text-sm font-bold text-black mt-3 uppercase tracking-widest">@FormatOrderDateOnly(order.OrderDate)</p>
                </div>
                
                <div class="dashed-line my-5"></div>
                
                <div class="flex justify-between text-sm my-2 text-black">
                    <span class="uppercase tracking-wider">BOOKS PURCHASED</span>
                    <span class="font-bold">@order.TotalQuantity</span>
                </div>
                <div class="flex justify-between text-sm my-2 text-black">
                    <span class="uppercase tracking-wider">TOTAL AMOUNT</span>
                    <span class="font-bold">@order.TotalPrice.ToString("#,##0") MMK</span>
                </div>
                <div class="flex justify-between text-sm my-2 text-black">
                    <span class="uppercase tracking-wider">TIME</span>
                    <span class="font-bold">@FormatOrderTimeOnly(order.OrderDate)</span>
                </div>
                <div class="flex justify-between text-sm my-2 text-black">
                    <span class="uppercase tracking-wider">SOURCE</span>
                    <span class="font-bold">@order.OrderSource</span>
                </div>
                <div class="flex justify-between text-sm my-2 text-black">
                    <span class="uppercase tracking-wider">STATUS</span>
                    <span class="font-bold text-emerald-800">Completed</span>
                </div>
                
                <div class="dashed-line my-5"></div>
                
                <h2 class="uppercase font-bold text-sm tracking-wider mb-3 text-black">ITEMS PURCHASED</h2>
                
                <!-- Column Headers -->
                <div class="flex text-xs font-bold uppercase tracking-wider mb-3 border-b border-dashed border-black pb-2 text-black">
                    <div class="w-6 shrink-0">No</div>
                    <div class="flex-1">Book</div>
                    <div class="w-10 text-center">Qty</div>
                    <div class="w-[70px] text-right">Unit</div>
                    <div class="w-[75px] text-right">Price</div>
                </div>
                
                <div class="space-y-4">
                    @if (order.Items == null || !order.Items.Any())
                    {
                        <div class="text-center text-sm py-4 text-black">NO ITEMS</div>
                    }
                    else
                    {
                        for (int i = 0; i < order.Items.Count; i++)
                        {
                            var item = order.Items[i];
                            <div class="flex text-sm items-start gap-1 text-black">
                                <div class="text-black font-bold w-6 shrink-0 pt-0.5">@((i+1).ToString("D2"))</div>
                                <div class="flex-1 leading-tight pr-2 flex flex-col justify-center">
                                    <span class="font-bold text-black">@item.BookTitle</span>
                                    @if (!string.IsNullOrEmpty(item.EditionName))
                                    {
                                        <span class="text-[10px] text-neutral-800 font-normal mt-0.5">@item.EditionName</span>
                                    }
                                </div>
                                <div class="w-10 text-center pt-0.5 font-medium text-black">@item.Quantity</div>
                                <div class="w-[70px] text-right pt-0.5 text-xs text-black">@item.UnitPrice.ToString("#,##0")</div>
                                <div class="w-[75px] text-right font-bold pt-0.5 text-black">@((item.Subtotal ?? (item.Quantity * item.UnitPrice)).ToString("#,##0"))</div>
                            </div>
                        }
                    }
                </div>
                
                <div class="dashed-line my-6"></div>
                
                <div class="flex justify-between items-end mt-2 text-black">
                    <span class="uppercase font-bold text-lg tracking-widest">TOTAL</span>
                    <span class="text-black font-black text-2xl">@order.TotalPrice.ToString("#,##0") <span class="text-xs text-black font-bold ml-1">MMK</span></span>
                </div>
                
                <div class="mt-12 text-center text-black">
                    <p class="text-sm font-bold uppercase tracking-wider mb-2 text-black">Thank you for buying!</p>
                    <p class="text-xs text-neutral-800 uppercase tracking-[0.2em]">ISSUED BY BOOKSTORE</p>
                </div>
                
                <!-- Completed Stamp effect -->
                <div class="absolute top-32 right-6 border-4 border-emerald-700 text-emerald-700 px-3 py-1.5 rotate-[-12deg] font-black text-xl uppercase tracking-widest rounded-md pointer-events-none opacity-85">
                    PAID
                </div>
                
            </div>
        </div>
    </div>
}
else
{
    <!-- ======================================================== -->
    <!-- 2. PENDING / REJECTED ONLINE ORDER REVIEW PANEL          -->
    <!-- ======================================================== -->
    <div class="max-w-5xl mx-auto space-y-6 pb-12">
        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white p-5 rounded-2xl border border-[#F3E2F6] shadow-[0_4px_24px_-4px_rgba(184,117,194,0.06)]">
            <div class="flex items-center gap-3">
                <a href="@backUrl" class="text-slate-400 hover:text-slate-700 transition-colors p-2 rounded-xl hover:bg-slate-100">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 12H5M12 19l-7-7 7-7"/>
                    </svg>
                </a>
                <div>
                    <div class="flex items-center gap-2 flex-wrap">
                        <h1 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
                            Online Order #@FormatOrderNo(order.OrderId, order.OrderDate)
                        </h1>
                        @if (order.OrderStatus == OrderStatus.Pending)
                        {
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                                <span class="w-2 h-2 rounded-full bg-amber-500 mr-1.5 animate-pulse"></span>
                                Pending Payment Verification
                            </span>
                        }
                        else if (order.OrderStatus == OrderStatus.Rejected)
                        {
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200">
                                <span class="w-2 h-2 rounded-full bg-rose-500 mr-1.5"></span>
                                Order Rejected
                            </span>
                        }
                    </div>
                    <p class="text-xs text-slate-500 font-medium mt-1">
                        Placed on @FormatOrderDateOnly(order.OrderDate) at @FormatOrderTimeOnly(order.OrderDate) &bull; Source: <span class="font-bold text-slate-700">@order.OrderSource</span>
                    </p>
                </div>
            </div>

            @if (canViewOrders)
            {
                <a href="/OnlineOrders?tab=@(order.OrderStatus == OrderStatus.Rejected ? "Rejected" : "Pending")" 
                   class="inline-flex items-center gap-2 px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-semibold transition-all shadow-2xs">
                    <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                    Manage in Online Orders
                </a>
            }
        </div>

        @if (order.OrderStatus == OrderStatus.Rejected)
        {
            <!-- Rejection Details Banner -->
            <div class="p-5 rounded-2xl bg-rose-50 border border-rose-200 text-rose-900 flex items-start gap-4 shadow-sm">
                <span class="w-10 h-10 rounded-xl bg-rose-100 text-rose-600 flex items-center justify-center shrink-0 mt-0.5">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </span>
                <div class="flex-1">
                    <h3 class="text-sm font-bold text-rose-950">This online order was rejected</h3>
                    <p class="text-xs text-rose-800 mt-1 leading-relaxed">
                        Reason note: <strong class="font-bold text-rose-950">@(string.IsNullOrWhiteSpace(order.RejectReason) ? "No rejection note provided" : order.RejectReason)</strong>
                    </p>
                    @if (order.UpdatedAt.HasValue)
                    {
                        <p class="text-[11px] text-rose-600 mt-1.5 font-medium">
                            Processed at: @order.UpdatedAt.Value.ToString("dd MMMM yyyy, hh:mm tt")
                        </p>
                    }
                </div>
            </div>
        }

        <!-- Main Content Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left: Customer Details & Ordered Items (2 cols) -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Customer Details Card -->
                <div class="bg-white p-6 rounded-2xl border border-[#F3E2F6] shadow-[0_4px_24px_-4px_rgba(184,117,194,0.06)]">
                    <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-4 flex items-center gap-2">
                        <svg class="w-4 h-4 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                        Customer & Delivery Information
                    </h2>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                        <div class="p-3 bg-slate-50/70 rounded-xl border border-slate-100">
                            <span class="text-slate-400 block font-medium mb-0.5">Customer Name</span>
                            <span class="text-slate-900 font-bold text-sm">@(string.IsNullOrWhiteSpace(order.CustomerName) ? "Guest Customer" : order.CustomerName)</span>
                        </div>
                        <div class="p-3 bg-slate-50/70 rounded-xl border border-slate-100">
                            <span class="text-slate-400 block font-medium mb-0.5">Phone Number</span>
                            <span class="text-slate-900 font-bold text-sm font-mono">@(string.IsNullOrWhiteSpace(order.CustomerPhone) ? "N/A" : order.CustomerPhone)</span>
                        </div>
                        <div class="sm:col-span-2 p-3 bg-slate-50/70 rounded-xl border border-slate-100">
                            <span class="text-slate-400 block font-medium mb-0.5">Delivery Shipping Address</span>
                            <span class="text-slate-800 font-medium leading-relaxed">@(string.IsNullOrWhiteSpace(order.ShippingAddress) ? "In-Store Pickup" : order.ShippingAddress)</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(order.Notes))
                        {
                            <div class="sm:col-span-2 p-3 bg-primary-50/40 rounded-xl border border-primary-100/60">
                                <span class="text-primary-700 block font-semibold mb-0.5">Order Notes</span>
                                <span class="text-slate-700 font-medium">@order.Notes</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Ordered Items Card -->
                <div class="bg-white rounded-2xl border border-[#F3E2F6] shadow-[0_4px_24px_-4px_rgba(184,117,194,0.06)] overflow-hidden">
                    <div class="px-6 py-4 bg-slate-50/70 border-b border-slate-100 flex items-center justify-between">
                        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-700 flex items-center gap-2">
                            <svg class="w-4 h-4 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                            Ordered Items (@order.TotalQuantity books)
                        </h2>
                    </div>

                    <div class="overflow-x-auto p-4">
                        <table class="w-full text-left text-xs">
                            <thead class="text-slate-400 uppercase font-semibold border-b border-slate-100">
                                <tr>
                                    <th class="pb-3 pl-2">Book Title</th>
                                    <th class="pb-3 text-center">Qty</th>
                                    <th class="pb-3 text-right">Unit Price</th>
                                    <th class="pb-3 text-right pr-2">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 text-slate-700">
                                @if (order.Items != null && order.Items.Any())
                                {
                                    foreach (var item in order.Items)
                                    {
                                        <tr>
                                            <td class="py-3 pl-2">
                                                <div class="font-bold text-slate-900">@item.BookTitle</div>
                                                @if (!string.IsNullOrWhiteSpace(item.EditionName))
                                                {
                                                    <span class="text-[10px] text-slate-500 font-medium">@item.EditionName</span>
                                                }
                                            </td>
                                            <td class="py-3 text-center font-bold text-slate-800">@item.Quantity</td>
                                            <td class="py-3 text-right text-slate-600 font-mono">@item.UnitPrice.ToString("#,##0") MMK</td>
                                            <td class="py-3 text-right pr-2 font-bold text-slate-900 font-mono">@((item.Subtotal ?? (item.Quantity * item.UnitPrice)).ToString("#,##0")) MMK</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="py-6 text-center text-slate-400 font-medium">No order items recorded.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="px-6 py-4 bg-slate-50/50 border-t border-slate-100 flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Total Order Amount</span>
                        <span class="text-xl font-black text-primary-700 font-mono">@order.TotalPrice.ToString("#,##0") <span class="text-xs font-bold text-primary-600">MMK</span></span>
                    </div>
                </div>
            </div>

            <!-- Right: Payment Proof & Actions (1 col) -->
            <div class="space-y-6">
                <!-- Payment Proof Card -->
                <div class="bg-white p-6 rounded-2xl border border-[#F3E2F6] shadow-[0_4px_24px_-4px_rgba(184,117,194,0.06)]">
                    <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-4 flex items-center gap-2">
                        <svg class="w-4 h-4 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
                        Payment Proof Slip
                    </h2>

                    <div class="space-y-3 text-xs mb-4">
                        <div class="flex justify-between items-center py-2 border-b border-slate-100">
                            <span class="text-slate-400 font-medium">Method</span>
                            <span class="font-bold text-slate-800">@(string.IsNullOrWhiteSpace(order.PaymentMethod) ? "KBZPay / WavePay" : order.PaymentMethod)</span>
                        </div>
                        <div class="flex justify-between items-center py-2 border-b border-slate-100">
                            <span class="text-slate-400 font-medium">Status</span>
                            <span class="font-bold @(order.PaymentStatus == PaymentStatus.Verified ? "text-emerald-700" : (order.PaymentStatus == PaymentStatus.Rejected ? "text-rose-700" : "text-amber-700"))">
                                @order.PaymentStatus.ToString()
                            </span>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(order.PaymentScreenshotUrl))
                    {
                        <div class="relative group rounded-xl overflow-hidden border border-slate-200 bg-slate-900/5 aspect-[3/4] flex items-center justify-center">
                            <img src="@order.PaymentScreenshotUrl" alt="Payment Proof Slip" class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-105" />
                            <div class="absolute inset-0 bg-slate-900/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-2">
                                <a href="@order.PaymentScreenshotUrl" target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 bg-white text-slate-900 rounded-lg text-xs font-bold shadow-md hover:bg-slate-50 transition-all flex items-center gap-1">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                                    Full Size
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="p-8 rounded-xl border border-dashed border-slate-200 text-center bg-slate-50/50">
                            <svg class="w-8 h-8 text-slate-300 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                            <p class="text-xs text-slate-400 font-medium">No payment screenshot uploaded</p>
                        </div>
                    }
                </div>

                <!-- Staff Processing Actions (Only for Pending) -->
                @if (order.OrderStatus == OrderStatus.Pending)
                {
                    <div class="bg-white p-6 rounded-2xl border border-[#F3E2F6] shadow-[0_4px_24px_-4px_rgba(184,117,194,0.06)]">
                        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-4 flex items-center gap-2">
                            <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            Order Verification Actions
                        </h2>

                        <div class="space-y-3">
                            @if (canConfirmOrders)
                            {
                                <button type="button" onclick="executeConfirmOrder(@order.OrderId)" id="btnConfirmOrder" class="w-full py-3 px-4 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs sm:text-sm font-bold transition-all shadow-md hover:shadow-lg flex items-center justify-center gap-2 cursor-pointer">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                                    <span>Verify & Confirm Order</span>
                                </button>
                                <p class="text-[11px] text-slate-500 text-center font-medium">
                                    Deducts stock inventory and marks order as Completed.
                                </p>
                            }

                            @if (canRejectOrders)
                            {
                                <button type="button" onclick="openRejectDialog()" class="w-full py-2.5 px-4 bg-rose-50 hover:bg-rose-100 text-rose-600 border border-rose-200 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-2 cursor-pointer">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                                    <span>Reject Order</span>
                                </button>
                            }

                            @if (!canConfirmOrders && !canRejectOrders)
                            {
                                <div class="p-3 bg-slate-50 text-slate-500 rounded-xl text-xs text-center border border-slate-100">
                                    You have View-Only access for online orders.
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Reject Order Dialog Modal -->
    <dialog id="detailRejectDialog" class="m-auto rounded-3xl p-0 border border-slate-200 bg-white shadow-2xl backdrop:bg-slate-900/60 backdrop:backdrop-blur-sm max-w-md w-[92%] sm:w-full transition-all overflow-hidden">
        <div class="p-6 sm:p-8 text-center relative">
            <button type="button" onclick="closeRejectDialog()" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 p-1.5 rounded-xl hover:bg-slate-100 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>

            <div class="w-14 h-14 rounded-2xl bg-rose-100 text-rose-600 border border-rose-200 flex items-center justify-center mx-auto mb-4">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            </div>

            <h3 class="text-lg font-bold text-slate-900 mb-1">Reject Online Order</h3>
            <p class="text-xs text-slate-500 font-medium mb-4">Provide a reason for rejecting Order #@FormatOrderNo(order.OrderId, order.OrderDate)</p>

            <div class="mb-5 text-left">
                <label for="detailRejectReasonInput" class="block text-xs font-bold text-slate-700 mb-1.5">Rejection Reason <span class="text-rose-500">*</span></label>
                <textarea id="detailRejectReasonInput" rows="3" placeholder="e.g. Unverified bank slip, invalid amount transferred, out of stock..." class="w-full px-3.5 py-2.5 border border-slate-200 rounded-xl text-xs sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-rose-500/30 focus:border-rose-500 transition-all"></textarea>
                <p id="detailRejectReasonError" class="text-[11px] text-rose-600 font-medium mt-1 hidden">Please provide a rejection reason note.</p>
            </div>

            <div class="flex flex-col sm:flex-row gap-3">
                <button type="button" onclick="closeRejectDialog()" class="w-full py-2.5 px-4 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-700 font-semibold text-xs sm:text-sm transition-all">Cancel</button>
                <button type="button" onclick="executeRejectOrder(@order.OrderId)" id="btnExecuteReject" class="w-full py-2.5 px-4 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs sm:text-sm transition-all shadow-md">Confirm Rejection</button>
            </div>
        </div>
    </dialog>

    <script>
        function openRejectDialog() {
            const dlg = document.getElementById('detailRejectDialog');
            if (dlg) {
                document.getElementById('detailRejectReasonInput').value = '';
                document.getElementById('detailRejectReasonError').classList.add('hidden');
                if (typeof dlg.showModal === 'function') dlg.showModal();
                else dlg.setAttribute('open', '');
            }
        }

        function closeRejectDialog() {
            const dlg = document.getElementById('detailRejectDialog');
            if (dlg) {
                if (typeof dlg.close === 'function') dlg.close();
                else dlg.removeAttribute('open');
            }
        }

        async function executeConfirmOrder(orderId) {
            if (!confirm('Are you sure you want to verify payment and complete this order? Inventory stock will be deducted.')) {
                return;
            }

            const btn = document.getElementById('btnConfirmOrder');
            if (btn) btn.disabled = true;

            try {
                const res = await fetch('/OnlineOrders/Confirm/' + orderId, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const result = await res.json();
                if (result && result.isSuccess) {
                    alert(result.message || 'Order confirmed and completed successfully!');
                    window.location.reload();
                } else {
                    alert(result?.message || 'Failed to confirm order.');
                    if (btn) btn.disabled = false;
                }
            } catch (err) {
                console.error(err);
                alert('Network error while confirming order.');
                if (btn) btn.disabled = false;
            }
        }

        async function executeRejectOrder(orderId) {
            const input = document.getElementById('detailRejectReasonInput');
            const err = document.getElementById('detailRejectReasonError');
            const reason = input?.value?.trim() || '';

            if (!reason) {
                if (err) err.classList.remove('hidden');
                return;
            }

            const btn = document.getElementById('btnExecuteReject');
            if (btn) btn.disabled = true;

            try {
                const res = await fetch('/OnlineOrders/Reject/' + orderId, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ rejectReason: reason })
                });
                const result = await res.json();
                if (result && result.isSuccess) {
                    alert(result.message || 'Order rejected.');
                    closeRejectDialog();
                    window.location.reload();
                } else {
                    alert(result?.message || 'Failed to reject order.');
                    if (btn) btn.disabled = false;
                }
            } catch (err) {
                console.error(err);
                alert('Network error while rejecting order.');
                if (btn) btn.disabled = false;
            }
        }
    </script>
}
