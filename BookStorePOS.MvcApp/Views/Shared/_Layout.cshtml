    <!-- Clear Notifications Confirmation Modal -->
    <dialog id="clearNotifConfirmModal" class="m-auto rounded-3xl p-0 border border-[#F3E2F6] bg-white shadow-2xl backdrop:bg-slate-900/50 backdrop:backdrop-blur-sm max-w-md w-[92%] sm:w-full transition-all overflow-hidden" aria-labelledby="clearNotifTitle" aria-describedby="clearNotifDesc">
        <div class="p-6 sm:p-8 text-center relative">
            <button type="button" onclick="window.closeClearNotifModal()" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 p-1.5 rounded-xl hover:bg-[#FAF0FA] transition-colors cursor-pointer" aria-label="Close modal">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>

            <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-rose-50 border border-rose-100 text-rose-600 flex items-center justify-center shadow-xs">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
