            <div class="flex items-center gap-1.5">
                <button type="button" onclick="window.markAllNotificationsRead()" class="text-xs font-bold text-[#9F54A6] hover:text-[#7E3B89] hover:bg-[#FAF0FA] px-2.5 py-1.5 rounded-lg transition-colors cursor-pointer">
                    Mark all read
                </button>
                <button type="button" onclick="window.openClearNotifConfirmModal()" title="Clear all notifications" class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors cursor-pointer">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
