            <div class="flex flex-col sm:flex-row gap-3">
                <button type="button" onclick="window.closeClearNotifModal()" class="w-full order-2 sm:order-1 inline-flex items-center justify-center py-2.5 px-5 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-700 font-semibold text-sm transition-all shadow-xs cursor-pointer">
                    Cancel
                </button>
                <button type="button" onclick="window.confirmClearAllNotifications()" class="w-full order-1 sm:order-2 inline-flex items-center justify-center gap-2 bg-rose-600 hover:bg-rose-700 text-white font-semibold py-2.5 px-5 rounded-xl transition-all shadow-sm text-sm cursor-pointer">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                    </svg>
                    <span>Clear All</span>
                </button>
            </div>
        </div>
    </dialog>

    <!-- Announcement Detail Modal (Full view for broadcast notifications) -->
    <dialog id="announcementDetailModal" class="m-auto rounded-3xl p-0 border border-[#F3E2F6] bg-white shadow-2xl backdrop:bg-slate-900/50 backdrop:backdrop-blur-sm max-w-lg w-[92%] sm:w-full transition-all overflow-hidden" aria-labelledby="announcementDetailTitle">
        <div class="p-6 sm:p-8 relative">
            <button type="button" onclick="window.closeAnnouncementDetailModal()" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 p-1.5 rounded-xl hover:bg-[#FAF0FA] transition-colors cursor-pointer" aria-label="Close modal">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>

            <div class="flex items-center gap-3 mb-4">
                <div class="w-12 h-12 rounded-2xl bg-[#FAF0FA] border border-[#F3E2F6] text-[#9F54A6] flex items-center justify-center shrink-0 shadow-2xs">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/>
                    </svg>
                </div>
                <div>
                    <span class="text-[10px] font-bold tracking-widest uppercase text-[#9F54A6] bg-[#FAF0FA] px-2.5 py-1 rounded-full border border-[#F3E2F6]">Store Announcement</span>
                    <p id="announcementDetailDate" class="text-xs text-slate-400 mt-1">-</p>
                </div>
            </div>

            <h3 id="announcementDetailTitle" class="text-xl font-bold text-slate-900 mb-3 leading-snug"></h3>
            <div id="announcementDetailContent" class="text-sm text-slate-600 leading-relaxed bg-[#FAF0FA]/50 p-4 rounded-2xl border border-[#F3E2F6] max-h-60 overflow-y-auto whitespace-pre-wrap"></div>

            <div class="mt-6 flex justify-end">
                <button type="button" onclick="window.closeAnnouncementDetailModal()" class="py-2.5 px-6 rounded-xl bg-[#FAF0FA] hover:bg-[#F6DFFB] text-[#9F54A6] font-semibold text-sm transition-all border border-[#F3E2F6] cursor-pointer">
                    Close
