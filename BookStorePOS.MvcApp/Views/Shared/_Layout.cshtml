<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookStore POS</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'Inter', 'sans-serif'],
                    },
                    colors: {
                        primary: {
                            DEFAULT: '#B875C2', // Exact Pastel Orchid from Mockup
                            50: '#FDF7FD',
                            100: '#F6DFFB',     // Soft Lilac Squircles & Active Tabs
                            200: '#ECC4F5',
                            300: '#DFADE4',
                            400: '#CE8FD4',
                            500: '#B875C2',     // Primary Action Button
                            600: '#A662B0',     // Hover Button
                            700: '#9F54A6',     // Accent Icons & Active Text
                            800: '#873693',
                            900: '#642870',
                        },
                        orchid: {
                            DEFAULT: '#9F54A6',
                            accent: '#B875C2',
                            tint: '#F6DFFB',
                            canvas: '#FAF0FA',
                            border: '#F3E2F6',
                        },
                        'primary-dark': '#18181B', // High-Contrast Deep Charcoal
                        // Standard Meaningful Status Colors (Rule 2)
                        status: {
                            completed: { bg: '#E7F3EA', text: '#34764A' },
                            pending: { bg: '#FFF3D9', text: '#A66B17' },
                            cancelled: { bg: '#FBE8E8', text: '#B84646' },
                            processing: { bg: '#EAEFFD', text: '#4966A8' },
                        },
                        // Map teal to primary for existing subviews
                        teal: {
                            DEFAULT: '#B875C2',
                            50: '#FDF7FD',
                            100: '#F6DFFB',
                            200: '#ECC4F5',
                            300: '#DFADE4',
                            400: '#CE8FD4',
                            500: '#B875C2',
                            600: '#A662B0',
                            700: '#9F54A6',
                            800: '#873693',
                            900: '#642870',
                        },
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Flatpickr Date Picker -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        /* Lucide & SVG micro-interactions */
        .icon-hover-bounce {
            transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .icon-hover-bounce:hover {
            transform: translateY(-2px);
        }
        .icon-hover-rotate {
            transition: transform 0.25s ease-out;
        }
        .icon-hover-rotate:hover {
            transform: rotate(10deg) scale(1.08);
        }
        .icon-hover-scale {
            transition: transform 0.25s ease-out;
        }
        .icon-hover-scale:hover {
            transform: scale(1.12);
        }
        /* Flatpickr Pastel Purple Theme Overrides */
        .flatpickr-calendar {
            border-radius: 1rem !important;
            border: 1px solid #F3E2F6 !important;
            box-shadow: 0 10px 25px -5px rgba(159, 84, 166, 0.15), 0 8px 10px -6px rgba(159, 84, 166, 0.1) !important;
            font-family: 'Plus Jakarta Sans', sans-serif !important;
            padding: 0.5rem !important;
            background: #ffffff !important;
        }
        .flatpickr-calendar.arrowTop:before, .flatpickr-calendar.arrowTop:after {
            border-bottom-color: #ffffff !important;
        }
        .flatpickr-calendar.arrowBottom:before, .flatpickr-calendar.arrowBottom:after {
            border-top-color: #ffffff !important;
        }
        .flatpickr-months {
            padding: 4px 0 !important;
        }
        .flatpickr-months .flatpickr-prev-month, .flatpickr-months .flatpickr-next-month {
            color: #9F54A6 !important;
            fill: #9F54A6 !important;
            padding: 4px 8px !important;
            border-radius: 8px !important;
        }
        .flatpickr-months .flatpickr-prev-month:hover, .flatpickr-months .flatpickr-next-month:hover {
            background: #FAF0FA !important;
            color: #8E4495 !important;
            fill: #8E4495 !important;
        }
        .flatpickr-current-month {
            color: #18181B !important;
            font-weight: 700 !important;
        }
        .flatpickr-current-month .flatpickr-monthDropdown-months {
            font-weight: 700 !important;
            color: #18181B !important;
            background: transparent !important;
        }
        .flatpickr-current-month input.cur-year {
            font-weight: 700 !important;
            color: #18181B !important;
        }
        span.flatpickr-weekday {
            color: #9F54A6 !important;
            font-weight: 600 !important;
            font-size: 0.75rem !important;
        }
        .flatpickr-day {
            border-radius: 8px !important;
            color: #334155 !important;
            font-weight: 500 !important;
            border: 1px solid transparent !important;
        }
        .flatpickr-day:hover {
            background: #FAF0FA !important;
            border-color: #F3E2F6 !important;
            color: #9F54A6 !important;
        }
        .flatpickr-day.selected, .flatpickr-day.startRange, .flatpickr-day.endRange, .flatpickr-day.selected:focus, .flatpickr-day.selected:hover {
            background: #9F54A6 !important;
            border-color: #9F54A6 !important;
            color: #ffffff !important;
            font-weight: 700 !important;
        }
        .flatpickr-day.today {
            border-color: #9F54A6 !important;
            color: #9F54A6 !important;
            font-weight: 700 !important;
        }
        .flatpickr-day.today:hover {
            background: #FAF0FA !important;
            color: #9F54A6 !important;
        }
        .flatpickr-day.flatpickr-disabled, .flatpickr-day.flatpickr-disabled:hover {
            color: rgba(57,57,57,0.25) !important;
            cursor: not-allowed !important;
            background: transparent !important;
            border-color: transparent !important;
            pointer-events: none !important;
            opacity: 0.35 !important;
        }

        /* Native input[type="date"] calendar picker indicator purple tint for all date inputs */
        input[type="date"]::-webkit-calendar-picker-indicator {
            cursor: pointer;
            opacity: 0.75;
            filter: invert(41%) sepia(35%) saturate(1212%) hue-rotate(256deg) brightness(92%) contrast(88%);
            transition: opacity 0.2s;
        }
        input[type="date"]::-webkit-calendar-picker-indicator:hover {
            opacity: 1;
        }
        input[type="date"] {
            accent-color: #9F54A6 !important;
        }
        /* Ensure number input spin buttons (up/down stepper arrows) are always visible without focus or hover */
        input[type="number"]::-webkit-inner-spin-button,
        input[type="number"]::-webkit-outer-spin-button {
            opacity: 1 !important;
            cursor: pointer;
        }
        input[type="number"] {
            -moz-appearance: number-input;
        }
    </style>
</head>
<body class="bg-[#FAF0FA] text-[#18181B] flex h-screen overflow-hidden font-sans">
    <!-- Sidebar -->
    <aside class="w-64 bg-white border-r border-[#F3E2F6] flex flex-col shrink-0 z-10 shadow-[2px_0_16px_rgba(184,117,194,0.03)]">
        <div class="h-16 flex items-center px-6 border-b border-[#F7E7F9]">
            <svg class="w-8 h-8 text-[#9F54A6] mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
            <span class="text-xl font-bold tracking-tight text-[#18181B]">POS <span class="text-[#9F54A6]">System</span></span>
        </div>
        <nav class="flex-1 px-4 py-6 space-y-2 overflow-y-auto">
            @{
                var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
                var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
                
                string cookieUser = Context.Request.Cookies["pos_user"] ?? "";
                string cookieRole = Context.Request.Cookies["pos_role"] ?? "";
                string cookiePerms = Context.Request.Cookies["pos_permissions"] ?? "";

                string displayUser = !string.IsNullOrWhiteSpace(cookieUser) 
                    ? Uri.UnescapeDataString(cookieUser).Replace("+", " ") 
                    : "";
                string displayRole = !string.IsNullOrWhiteSpace(cookieRole) ? cookieRole : "Staff";
                bool isAdmin = string.Equals(displayRole, "Admin", StringComparison.OrdinalIgnoreCase);
                bool isCashier = string.Equals(displayRole, "Cashier", StringComparison.OrdinalIgnoreCase);

                var userPerms = cookiePerms.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                bool HasPermission(string permission)
                {
                    if (isAdmin) return true;
                    if (isCashier && permission.Equals("Order.Create", StringComparison.OrdinalIgnoreCase)) return true;
                    return userPerms.Contains(permission, StringComparer.OrdinalIgnoreCase);
                }

                bool canViewDashboard = !isCashier && HasPermission("Dashboard.View");
                bool canCreateOrder = HasPermission("Order.Create");
                bool canViewOrders = !isCashier && HasPermission("Order.View");
                bool canViewOnlineOrders = !isCashier && (HasPermission("Order.View") || HasPermission("OnlineOrder.View"));
                bool showSalesSection = canCreateOrder || canViewOrders || canViewOnlineOrders;

                bool canViewBooks = !isCashier && HasPermission("Book.View");
                bool canViewAuthors = !isCashier && HasPermission("Author.View");
                bool canViewGenres = !isCashier && HasPermission("Genre.View");
                bool canViewEditions = !isCashier && HasPermission("Edition.View");
                bool showInventorySection = canViewBooks || canViewAuthors || canViewGenres || canViewEditions;

                bool canViewSalesReports = isAdmin;
                bool showInsightsSection = isAdmin;

                string initials = "--";
                if (!string.IsNullOrWhiteSpace(displayUser))
                {
                    var words = displayUser.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                    initials = words.Length >= 2 
                        ? (words[0][0].ToString() + words[^1][0].ToString()).ToUpper()
                        : (displayUser.Length >= 2 ? displayUser.Substring(0, 2).ToUpper() : displayUser.ToUpper());
                }
                
                string GetActiveClass(string controller) {
                    return currentController == controller 
                        ? "bg-[#F6DFFB] text-[#9F54A6] font-semibold shadow-xs" 
                        : "text-[#71717A] hover:bg-[#FAF0FA] hover:text-[#9F54A6] font-medium";
                }
            }
            
            @if (canViewDashboard)
            {
                <a href="/Dashboard" data-permission="Dashboard.View" class="nav-item flex items-center px-4 py-3 rounded-2xl transition-colors @GetActiveClass("Dashboard")">
                    <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
                    Dashboard
                </a>
            }
            
            @if (showSalesSection)
            {
                <div class="nav-section-sales">
                    <div class="px-4 mt-6 mb-2 text-xs font-semibold text-[#9C8EA4] uppercase tracking-wider">SALES</div>
                    @if (canCreateOrder)
                    {
                        <a href="/Checkout" data-permission="Order.Create" class="nav-item flex items-center px-4 py-3 rounded-2xl transition-colors @GetActiveClass("Checkout")">
                            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                            POS Checkout
                        </a>
                    }
                    @if (canViewOrders)
                    {
                        <a href="/Orders" data-permission="Order.View" class="nav-item flex items-center px-4 py-3 rounded-2xl transition-colors @GetActiveClass("Orders")">
                            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
                            Orders
                        </a>
                    }
                    @if (canViewOnlineOrders)
                    {
                        <a href="/OnlineOrders" data-permission="Order.View" class="nav-item flex items-center px-4 py-3 rounded-2xl transition-colors @GetActiveClass("OnlineOrders")">
                            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
                            Online Orders
                        </a>
                    }
                </div>
            }

            @if (showInventorySection)
            {
                <div class="nav-section-inventory">
                    <div class="px-4 mt-6 mb-2 text-xs font-semibold text-[#9C8EA4] uppercase tracking-wider">INVENTORY</div>
                    @if (canViewBooks)
                    {
                        <a href="/Book" data-permission="Book.View" class="nav-item flex items-center px-4 py-3 rounded-2xl transition-colors @GetActiveClass("Book")">
                            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                            Books
                        </a>
                    }
                    @if (canViewAuthors)
                    {
                        <a href="/Author" data-permission="Author.View" class="nav-item flex items-center px-4 py-3 rounded-2xl transition-colors @GetActiveClass("Author")">
                            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                            Authors
                        </a>
                    }
                    @if (canViewGenres)
                    {
                        <a href="/Genre" data-permission="Genre.View" class="nav-item flex items-center px-4 py-3 rounded-2xl transition-colors @GetActiveClass("Genre")">
                            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path></svg>
                            Genres
                        </a>
                    }
                    @if (canViewEditions)
                    {
                        <a href="/Edition" data-permission="Edition.View" class="nav-item flex items-center px-4 py-3 rounded-2xl transition-colors @GetActiveClass("Edition")">
                            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                            Editions
                        </a>
                    }
                </div>
            }

            @if (isAdmin)
            {
                <div class="nav-section-insights">
                    <div class="px-4 mt-6 mb-2 text-xs font-semibold text-[#9C8EA4] uppercase tracking-wider">INSIGHTS</div>
                    <a href="/SalesReports" class="nav-item flex items-center px-4 py-3 rounded-2xl transition-colors @GetActiveClass("SalesReports")">
                        <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
                        Sales Reports
                    </a>
                </div>
            }

            @if (isAdmin)
            {
                <div class="nav-section-management">
                    <div class="px-4 mt-6 mb-2 text-xs font-semibold text-[#9C8EA4] uppercase tracking-wider">SETTINGS</div>
                    <a href="/User" data-permission="User.View" class="nav-item flex items-center px-4 py-3 rounded-2xl transition-colors @GetActiveClass("User")">
                        <svg class="w-5 h-5 mr-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                        </svg>
                        Staff Management
                    </a>
                    <a href="/Role" data-permission="Role.View" class="nav-item flex items-center px-4 py-3 rounded-2xl transition-colors @GetActiveClass("Role")">
                        <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                        Roles & Access
                    </a>
                    <a href="/PaymentMethod" class="nav-item flex items-center px-4 py-3 rounded-2xl transition-colors @GetActiveClass("PaymentMethod")">
                        <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
                        Payment Methods
                    </a>
                    <a href="/Announcement" class="nav-item flex items-center px-4 py-3 rounded-2xl transition-colors @GetActiveClass("Announcement")">
                        <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" /></svg>
                        Broadcast Alerts
                    </a>
                </div>
            }

            <div class="pt-2">
                @if (!isAdmin && !isCashier)
                {
                    <div class="px-4 mt-6 mb-2 text-xs font-semibold text-[#9C8EA4] uppercase tracking-wider">SETTINGS</div>
                    <a href="/Announcement" class="nav-item flex items-center px-4 py-3 rounded-2xl transition-colors @GetActiveClass("Announcement")">
                        <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" /></svg>
                        Broadcast Alerts
                    </a>
                }
                <button type="button" onclick="window.openLogoutConfirmModal()" class="nav-item flex items-center w-full px-4 py-3 rounded-2xl transition-colors text-[#71717A] hover:bg-[#FAF0FA] hover:text-[#9F54A6] font-medium cursor-pointer">
                    <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                    </svg>
                    Sign Out
                </button>
            </div>
        </nav>
        <div class="p-4 border-t border-[#F3E2F6] flex items-center">
            <div class="flex items-center gap-3 overflow-hidden w-full">
                <div class="w-10 h-10 rounded-full bg-[#F6DFFB] flex items-center justify-center text-[#9F54A6] font-bold shadow-2xs shrink-0 uppercase" id="sidebarUserInitials">
                    @(initials != "--" ? initials : "ST")
                </div>
                <div class="truncate min-w-0">
                    <p class="text-sm font-semibold text-[#18181B] truncate" id="sidebarUsername">@(string.IsNullOrWhiteSpace(displayUser) ? "Staff Member" : displayUser)</p>
                    <p class="text-xs text-[#9C8EA4] font-medium" id="sidebarUserRole">@(displayRole) Role</p>
                </div>
            </div>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col h-screen overflow-hidden relative">
        <!-- Top header for mobile -->
        <header class="h-16 bg-white border-b border-[#F3E2F6] flex items-center justify-between px-6 shrink-0 md:hidden shadow-sm z-10 relative">
            <div class="flex items-center">
                <svg class="w-6 h-6 text-[#9F54A6] mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                <span class="text-xl font-bold tracking-tight text-[#18181B]">POS <span class="text-[#9F54A6]">System</span></span>
            </div>
            <div class="flex items-center gap-2">
                @if (!isCashier && currentController == "Dashboard")
                {
                    <!-- Mobile Notification Bell (Only on Dashboard) -->
                    <button type="button" onclick="window.openNotificationDrawer()" title="Notifications" class="pos-notif-bell relative p-2 rounded-xl text-[#71717A] hover:text-[#9F54A6] hover:bg-[#FAF0FA] transition-colors cursor-pointer">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
                        <span class="pos-notif-badge hidden absolute top-1 right-1 px-1.5 py-0.5 text-[10px] font-bold text-white bg-red-500 rounded-full min-w-[18px] text-center shadow-xs">0</span>
                    </button>
                }
                <button type="button" onclick="window.openLogoutConfirmModal()" title="Sign Out"
                   class="text-[#71717A] hover:text-[#9F54A6] transition-colors p-2 cursor-pointer">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                </button>
            </div>
        </header>

        <!-- Content Area -->
        <div class="flex-1 overflow-y-auto p-6 md:p-8 w-full max-w-[1400px] mx-auto">
            @RenderBody()
        </div>
    </main>

