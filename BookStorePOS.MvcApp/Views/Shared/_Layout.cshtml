                <button type="button" onclick="window.closeNotificationDrawer()" class="p-1.5 -ml-1.5 rounded-xl hover:bg-[#FAF0FA] text-[#71717A] hover:text-[#18181B] transition-colors cursor-pointer" aria-label="Close notifications">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
