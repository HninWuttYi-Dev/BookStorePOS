        <!-- Drawer Footer Quick Link -->
        <div class="p-4 border-t border-[#F3E2F6] bg-white flex items-center justify-between text-xs text-[#9C8EA4]">
            <a href="/OnlineOrders" onclick="window.closeNotificationDrawer()" class="font-semibold text-[#9F54A6] hover:underline flex items-center gap-1">
                <span>Go to Online Orders</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
