    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/js/auth-api.js" asp-append-version="true"></script>
    <!-- Lucide Icons (Unified Icon Resource) -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        $(document).ready(function() {
            if (window.lucide) {
                lucide.createIcons();
            }
            try {
                let cookieUser = getCookie('pos_user');
                if (!cookieUser) {
                    // Not authenticated (cookie expired or cleared): purge local storage and redirect to login
                    try {
                        localStorage.removeItem('pos_user');
                        localStorage.removeItem('pos_role');
                        localStorage.removeItem('pos_permissions');
                    } catch(e) {}
                    window.location.replace('/Auth/Login');
                    return;
                }

                let posUser = cookieUser;
                let posRole = getCookie('pos_role') || localStorage.getItem('pos_role');

                // Detect browser Back/Forward (bfcache) navigation
                window.addEventListener('pageshow', function (event) {
                    if (event.persisted || (window.performance && window.performance.navigation && window.performance.navigation.type === 2)) {
                        if (!getCookie('pos_user')) {
                            window.location.replace('/Auth/Login');
                        }
                    }
                });

                if (posUser) {
                    let cleanUser = posUser;
                    try {
                        cleanUser = decodeURIComponent(cleanUser);
                        if (cleanUser.includes('%')) cleanUser = decodeURIComponent(cleanUser);
                    } catch(e) {}
                    cleanUser = cleanUser.replace(/%20/g, ' ').replace(/\+/g, ' ').trim();

                    const words = cleanUser.split(/\s+/).filter(Boolean);
                    const initials = words.length >= 2 
                        ? (words[0][0] + words[words.length - 1][0]).toUpperCase()
                        : cleanUser.substring(0, 2).toUpperCase();

                    $('#sidebarUsername').text(cleanUser);
                    $('#sidebarUserInitials').text(initials);
                    if (!localStorage.getItem('pos_user')) localStorage.setItem('pos_user', cleanUser);
                }
                if (posRole) {
                    $('#sidebarUserRole').text(posRole + ' Role');
                    if (!localStorage.getItem('pos_role')) localStorage.setItem('pos_role', posRole);
                }

                // If non-admin, ensure admin-only settings are removed
                const isAdmin = posRole && posRole.toLowerCase() === 'admin';
                if (!isAdmin) {
                    $('.nav-section-management').remove();
                }
            } catch(e) {}

            const logoutModal = document.getElementById('posLogoutModal');
            if (logoutModal) {
                logoutModal.addEventListener('click', function(e) {
                    if (e.target === logoutModal) {
                        window.closeLogoutConfirmModal();
                    }
                });
            }

            const clearModal = document.getElementById('clearNotifConfirmModal');
            if (clearModal) {
                clearModal.addEventListener('click', function(e) {
                    if (e.target === clearModal) {
                        window.closeClearNotifModal();
                    }
                });
            }

            const annModal = document.getElementById('announcementDetailModal');
            if (annModal) {
                annModal.addEventListener('click', function(e) {
                    if (e.target === annModal) {
                        window.closeAnnouncementDetailModal();
                    }
                });
            }
        });

        window.openAnnouncementDetailModal = function(title, content, dateStr) {
            const modal = document.getElementById('announcementDetailModal');
            if (!modal) return;
            const titleEl = document.getElementById('announcementDetailTitle');
            const contentEl = document.getElementById('announcementDetailContent');
            const dateEl = document.getElementById('announcementDetailDate');
            if (titleEl) titleEl.textContent = title || 'Announcement';
            if (contentEl) contentEl.textContent = content || '';
            if (dateEl) {
                const d = dateStr ? new Date(dateStr) : new Date();
                dateEl.textContent = isNaN(d.getTime()) ? 'Just now' : d.toLocaleString();
            }
            if (typeof modal.showModal === 'function') {
                modal.showModal();
            } else {
                modal.setAttribute('open', '');
            }
        };

        window.closeAnnouncementDetailModal = function() {
            const modal = document.getElementById('announcementDetailModal');
            if (!modal) return;
            if (typeof modal.close === 'function') {
                modal.close();
            } else {
                modal.removeAttribute('open');
            }
        };

        window.openClearNotifConfirmModal = function() {
            const modal = document.getElementById('clearNotifConfirmModal');
            if (!modal) return;
            if (typeof modal.showModal === 'function') {
                modal.showModal();
            } else {
                modal.setAttribute('open', '');
            }
        };

        window.closeClearNotifModal = function() {
            const modal = document.getElementById('clearNotifConfirmModal');
            if (!modal) return;
            if (typeof modal.close === 'function') {
                modal.close();
            } else {
                modal.removeAttribute('open');
            }
        };

        window.openLogoutConfirmModal = function() {
            const modal = document.getElementById('posLogoutModal');
            if (!modal) return;
            if (typeof modal.showModal === 'function') {
                modal.showModal();
            } else {
                modal.setAttribute('open', '');
            }
        };

        window.closeLogoutConfirmModal = function() {
            const modal = document.getElementById('posLogoutModal');
            if (!modal) return;
            if (typeof modal.close === 'function') {
                modal.close();
            } else {
                modal.removeAttribute('open');
            }
        };

        window.performPosLogout = function() {
            try {
                localStorage.removeItem('pos_user');
                localStorage.removeItem('pos_role');
                localStorage.removeItem('pos_permissions');
            } catch(e) {}
            window.location.replace('/Auth/Logout');
        };

        // Global Warm Clay & Linen Floating Card Toast System
        let toastTimeout = null;
        window.showToast = function(message, isSuccess = true) {
            const container = document.getElementById('globalToastContainer');
            const cardEl = document.getElementById('globalToastCard');
            const titleEl = document.getElementById('globalToastTitle');
            const messageEl = document.getElementById('globalToastMessage');
            const iconContainer = document.getElementById('globalToastIconContainer');
            if (!container || !messageEl || !iconContainer) return;

            messageEl.textContent = message;

            const isSuccessBool = (isSuccess === true || isSuccess === 'success' || isSuccess === 1 || isSuccess === '1');

            if (isSuccessBool) {
                if (titleEl) {
                    titleEl.textContent = "SUCCESS";
                    titleEl.className = "text-[10px] font-bold tracking-widest uppercase text-[#34764A] mb-0.5";
                }
                if (cardEl) {
                    cardEl.className = "bg-white/95 backdrop-blur-md border border-[#CDE5D2] shadow-[0_12px_36px_rgba(52,118,74,0.09)] rounded-2xl px-5 py-3.5 flex items-center gap-3.5 max-w-md ring-1 ring-[#34764A]/10";
                }
                iconContainer.className = "w-9 h-9 rounded-xl bg-[#E7F3EA] text-[#34764A] border border-[#CDE5D2] flex items-center justify-center shrink-0 shadow-2xs";
                iconContainer.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>';
            } else {
                if (titleEl) {
                    titleEl.textContent = "ATTENTION";
                    titleEl.className = "text-[10px] font-bold tracking-widest uppercase text-[#B84646] mb-0.5";
                }
                if (cardEl) {
                    cardEl.className = "bg-white/95 backdrop-blur-md border border-[#F7D2D2] shadow-[0_12px_36px_rgba(184,70,70,0.09)] rounded-2xl px-5 py-3.5 flex items-center gap-3.5 max-w-md ring-1 ring-[#B84646]/15";
                }
                iconContainer.className = "w-9 h-9 rounded-xl bg-[#FBE8E8] text-[#B84646] border border-[#F7D2D2] flex items-center justify-center shrink-0 shadow-2xs";
                iconContainer.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>';
            }

            container.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-3');
            container.classList.add('opacity-100', 'translate-y-0');

            if (toastTimeout) clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                window.hideToast();
            }, 4500);
        };

        window.hideToast = function() {
            const container = document.getElementById('globalToastContainer');
            if (container) {
                container.classList.add('opacity-0', 'pointer-events-none', 'translate-y-3');
                container.classList.remove('opacity-100', 'translate-y-0');
            }
        };

        // Alias for compatibility
        var showToast = window.showToast;
    </script>

    @{
        bool hasGlobalToast = false;
        bool globalToastSuccess = true;
        string globalToastMsg = "";

        if (TempData["Message"] != null)
        {
            hasGlobalToast = true;
            globalToastMsg = TempData["Message"]?.ToString() ?? "";
            var rawSuccess = TempData["isSuccess"] ?? TempData["IsSuccess"];
            globalToastSuccess = rawSuccess == null || Convert.ToBoolean(rawSuccess);
        }
        else if (TempData["SuccessMessage"] != null)
        {
            hasGlobalToast = true;
            globalToastMsg = TempData["SuccessMessage"]?.ToString() ?? "";
            globalToastSuccess = true;
        }
        else if (TempData["ErrorMessage"] != null)
        {
            hasGlobalToast = true;
            globalToastMsg = TempData["ErrorMessage"]?.ToString() ?? "";
            globalToastSuccess = false;
        }
    }
    @if (hasGlobalToast && !string.IsNullOrWhiteSpace(globalToastMsg))
    {
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                if (typeof window.showToast === 'function') {
                    window.showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(globalToastMsg)), @(globalToastSuccess ? "true" : "false"));
                }
            });
        </script>
    }

    <!-- Global Floating Card Toast -->
    <div id="globalToastContainer" class="fixed bottom-6 right-6 z-[100] transition-all duration-300 opacity-0 pointer-events-none translate-y-3">
        <div id="globalToastCard" class="bg-white/95 backdrop-blur-md border border-[#F3E2F6] shadow-[0_12px_36px_rgba(184,117,194,0.08)] rounded-2xl px-5 py-3.5 flex items-center gap-3.5 max-w-md ring-1 ring-[#9F54A6]/10">
            <div id="globalToastIconContainer" class="w-9 h-9 rounded-xl flex items-center justify-center shrink-0"></div>
            <div class="flex-1 pr-2 min-w-0">
                <p id="globalToastTitle" class="text-[10px] font-bold tracking-widest uppercase mb-0.5"></p>
                <p id="globalToastMessage" class="text-sm font-semibold text-[#18181B] leading-snug break-words"></p>
            </div>
            <button type="button" onclick="window.hideToast()" class="text-[#A59B94] hover:text-[#18181B] transition-colors p-1 cursor-pointer shrink-0" aria-label="Close">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
    </div>

    <!-- SignalR Realtime Client & Notification Hub -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/notification-hub.js" asp-append-version="true"></script>

    <!-- Global Flatpickr Date Picker Initialization -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof flatpickr === 'function') {
                const commonConfig = {
                    dateFormat: "Y-m-d",
                    altInput: true,
                    altFormat: "d/m/Y",
                    maxDate: "today",
                    disableMobile: true
                };

                const endPicker = flatpickr('#endDate.datepicker-input', {
                    ...commonConfig,
                    altInputClass: "w-full px-4 py-2.5 pr-10 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-[#9F54A6]/30 focus:border-[#9F54A6] transition-all bg-white cursor-pointer"
                });

                const startPicker = flatpickr('#startDate.datepicker-input', {
                    ...commonConfig,
                    altInputClass: "w-full px-4 py-2.5 pr-10 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-[#9F54A6]/30 focus:border-[#9F54A6] transition-all bg-white cursor-pointer",
                    onChange: function(selectedDates, dateStr) {
                        if (endPicker && dateStr) {
                            endPicker.set('minDate', dateStr);
                        }
                    }
                });

                const initialStartVal = document.getElementById('startDate')?.value;
                if (initialStartVal && endPicker) {
                    endPicker.set('minDate', initialStartVal);
                }

                // Generic datepicker inputs without specific ID
                flatpickr('.datepicker-input:not(#startDate):not(#endDate)', {
                    ...commonConfig,
                    altInputClass: "w-full px-4 py-2.5 pr-10 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-[#9F54A6]/30 focus:border-[#9F54A6] transition-all bg-white cursor-pointer"
                });
            }

            // Client-side DOM permission guard based on stored permissions
            try {
                const role = (localStorage.getItem('pos_role') || '').toLowerCase();
                const isCashier = role === 'cashier';
                if (role !== 'admin') {
                    let perms = [];
                    const raw = localStorage.getItem('pos_permissions');
                    try {
                        perms = JSON.parse(raw || '[]');
                        if (!Array.isArray(perms)) {
                            perms = (raw || '').split(',').map(s => s.trim());
                        }
                    } catch(e) {
                        perms = (raw || '').split(',').map(s => s.trim());
                    }
                    const permsLower = perms.map(p => (p || '').toLowerCase());

                    document.querySelectorAll('a[data-permission]').forEach(function(el) {
                        const req = (el.getAttribute('data-permission') || '').toLowerCase();
                        if (isCashier) {
                            if (req !== 'order.create') {
                                el.style.display = 'none';
                            }
                        } else if (req && !permsLower.includes(req)) {
                            el.style.display = 'none';
                        }
                    });

                    if (role !== 'admin') {
                        const srLink = document.querySelector('a[href="/SalesReports"]');
                        if (srLink) srLink.style.display = 'none';
                        const insSec = document.querySelector('.nav-section-insights');
                        if (insSec) insSec.style.display = 'none';
                    }

                    if (isCashier) {
                        const dLink = document.querySelector('a[href="/Dashboard"]');
                        if (dLink) dLink.style.display = 'none';
                        const bAlert = document.querySelector('a[href="/Announcement"]');
                        if (bAlert) {
                            bAlert.style.display = 'none';
                            const setH = bAlert.previousElementSibling;
                            if (setH && setH.textContent && setH.textContent.trim().toUpperCase() === 'SETTINGS') {
                                setH.style.display = 'none';
                            }
                        }
                    }

                    ['.nav-section-sales', '.nav-section-inventory', '.nav-section-insights', '.nav-section-management'].forEach(function(sel) {
                        const sec = document.querySelector(sel);
                        if (sec) {
                            const visibleLinks = Array.from(sec.querySelectorAll('a.nav-item')).filter(function(a) {
                                return a.style.display !== 'none' && window.getComputedStyle(a).display !== 'none';
                            });
                            if (visibleLinks.length === 0) {
                                sec.style.display = 'none';
                            }
                        }
                    });
                }
            } catch (err) {
                console.warn('Permission enforcement check:', err);
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
