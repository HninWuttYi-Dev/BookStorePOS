        </div>
    </dialog>
    <div id="notificationDrawerOverlay" onclick="window.closeNotificationDrawer()" class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs z-[60] transition-opacity duration-300 opacity-0 pointer-events-none"></div>

    <!-- Notification Slide-over Drawer (Matching Mobbin Mockup Design) -->
    <aside id="notificationDrawer" class="fixed top-0 right-0 h-full w-full sm:w-[420px] max-w-full bg-[#FCFBF9] border-l border-[#F3E2F6] shadow-2xl z-[70] transition-transform duration-300 ease-in-out translate-x-full flex flex-col overflow-hidden">
        <!-- Drawer Header -->
        <div class="px-6 py-5 border-b border-[#F3E2F6] bg-white/90 backdrop-blur-md flex items-center justify-between shrink-0">
