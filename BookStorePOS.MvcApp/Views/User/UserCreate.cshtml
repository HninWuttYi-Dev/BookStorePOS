@{
    ViewData["Title"] = "Add New Staff";
    var roles = ViewData["Roles"] as List<RoleModel> ?? new List<RoleModel>();
}

<div class="max-w-3xl mx-auto pb-16">
    <!-- Breadcrumb & Title -->
    <div class="mb-8">
        <a href="/User" class="group inline-flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-teal-600 transition-colors mb-2">
            <svg class="w-4 h-4 transition-transform duration-200 group-hover:-translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>
            </svg>
            Back to Staff List
        </a>
        <h1 class="text-3xl font-bold text-slate-900 tracking-tight flex items-center gap-3">
            <span class="w-10 h-10 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center border border-teal-100 shadow-2xs">
                <svg class="w-5 h-5 transition-transform duration-300 hover:scale-110" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <line x1="19" y1="8" x2="19" y2="14"/>
                    <line x1="22" y1="11" x2="16" y2="11"/>
                </svg>
            </span>
            Add New Staff / Cashier
        </h1>
        <p class="text-slate-500 mt-1.5 text-sm font-medium">
            Register a staff member, select their role, and set their initial login password for the POS terminal.
        </p>
    </div>

    <!-- Alert Banner -->
    <div id="userAlert" class="hidden mb-6 p-4 rounded-2xl text-sm border flex items-start gap-3 bg-red-50 border-red-200 text-red-800" role="alert">
        <svg class="w-5 h-5 text-red-600 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <span id="userAlertText"></span>
    </div>

    <form id="createStaffForm" novalidate class="space-y-6">
        <!-- Staff Details Card -->
        <div class="bg-white p-7 rounded-2xl border border-[#EDE7DF] shadow-[0_4px_24px_-4px_rgba(42,36,33,0.06)] space-y-6">
            <!-- Tip Box -->
            <div class="p-4 bg-teal-50/70 border border-teal-100 rounded-xl text-xs text-teal-900 leading-relaxed flex items-start gap-3">
                <svg class="w-5 h-5 text-teal-600 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>
                </svg>
                <div>
                    <strong class="font-bold text-teal-950">Direct Password Handover:</strong>
                    As the Store Admin, you set the initial password here and hand it to the staff member so they can log in at the POS terminal immediately.
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Full Name -->
                <div>
                    <label for="fullNameInput" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-2">
                        Full Name <span class="text-red-500">*</span>
                    </label>
                    <input type="text" id="fullNameInput" name="FullName" required
                           placeholder="e.g. Daw Su Su Win"
                           class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500/30 focus:border-teal-500 transition-all font-medium" />
                    <span id="fullNameError" class="hidden text-xs text-red-600 mt-1 block">Full name is required.</span>
                </div>

                <!-- Username -->
                <div>
                    <label for="usernameInput" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-2">
                        Login Username <span class="text-red-500">*</span>
                    </label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400 font-mono text-sm pointer-events-none">&#64;</span>
                        <input type="text" id="usernameInput" name="Username" required
                               placeholder="e.g. cashier1"
                               autocomplete="off"
                               class="w-full pl-8 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500/30 focus:border-teal-500 transition-all font-medium font-mono" />
                    </div>
                    <span id="usernameError" class="hidden text-xs text-red-600 mt-1 block">Username is required.</span>
                    <p class="text-[11px] text-slate-400 mt-1">No spaces allowed. Letters, numbers, and underscores only.</p>
                </div>

                <!-- Phone -->
                <div>
                    <label for="phoneInput" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-2">
                        Phone Number <span class="text-red-500">*</span>
                    </label>
                    <input type="text" id="phoneInput" name="Phone" required
                           placeholder="e.g. 09789456123"
                           class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500/30 focus:border-teal-500 transition-all font-medium font-mono" />
                    <span id="phoneError" class="hidden text-xs text-red-600 mt-1 block">Valid Myanmar phone number is required (09XXXXXXXXX).</span>
                </div>

                <!-- Email -->
                <div>
                    <label for="emailInput" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-2">
                        Email Address <span class="text-slate-400 font-normal lowercase">(optional)</span>
                    </label>
                    <input type="email" id="emailInput" name="Email"
                           placeholder="e.g. staff@bookstore.com"
                           class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500/30 focus:border-teal-500 transition-all font-medium" />
                </div>

                <!-- Role Selection -->
                <div>
                    <label for="roleIdSelect" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-2">
                        Store Role <span class="text-red-500">*</span>
                    </label>
                    <select id="roleIdSelect" name="RoleId" required
                            class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500/30 focus:border-teal-500 transition-all font-medium">
                        @foreach (var r in roles)
                        {
                            <option value="@r.RoleId">@r.RoleName</option>
                        }
                    </select>
                    <p class="text-[11px] text-slate-400 mt-1">Defines what permissions and POS features this staff member can access.</p>
                </div>

                <!-- Initial Password -->
                <div>
                    <label for="passwordInput" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-2">
                        Initial Password <span class="text-red-500">*</span>
                    </label>
                    <div class="relative">
                        <input type="password" id="passwordInput" name="Password" required minlength="3"
                               placeholder="Enter login password (e.g. 123456)"
                               class="w-full pl-4 pr-11 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500/30 focus:border-teal-500 transition-all font-medium" />
                        <button type="button" id="btnTogglePassword" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-teal-700 transition-colors" title="Toggle password visibility">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
                                <circle cx="12" cy="12" r="3"/>
                            </svg>
                        </button>
                    </div>
                    <span id="passwordError" class="hidden text-xs text-red-600 mt-1 block">Password must be at least 3 characters.</span>
                </div>
            </div>
        </div>

        <!-- Form Actions -->
        <div class="flex items-center justify-end gap-3 pt-2">
            <a href="/User" class="px-5 py-2.5 bg-slate-100 text-slate-700 font-semibold rounded-xl hover:bg-slate-200 text-sm transition-colors">
                Cancel
            </a>
            <button type="submit" id="btnSubmitStaff" class="px-6 py-2.5 bg-teal-600 text-white font-semibold rounded-xl hover:bg-teal-700 text-sm transition-all shadow-md flex items-center gap-2 group">
                <svg class="w-4 h-4 transition-transform duration-200 group-hover:scale-110" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 6L9 17l-5-5"/>
                </svg>
                <span>Save Staff Account</span>
            </button>
        </div>
    </form>
</div>

@section Scripts {
<script>
    $(document).ready(function() {
        // Toggle password visibility
        $('#btnTogglePassword').on('click', function() {
            const $pwd = $('#passwordInput');
            const type = $pwd.attr('type') === 'password' ? 'text' : 'password';
            $pwd.attr('type', type);
        });

        // Prevent typing spaces in username field
        $('#usernameInput').on('keydown', function(e) {
            if (e.which === 32 || e.key === ' ' || e.code === 'Space') {
                e.preventDefault();
                $('#usernameError').text('Spaces are not allowed in username.').removeClass('hidden');
                return false;
            }
        });

        // Strip any pasted spaces immediately
        $('#usernameInput').on('input', function() {
            const val = $(this).val();
            if (/\s/.test(val)) {
                $(this).val(val.replace(/\s+/g, ''));
                $('#usernameError').text('Spaces are not allowed and were removed.').removeClass('hidden');
            } else if (!val) {
                $('#usernameError').text('Username is required.').addClass('hidden');
            } else {
                $('#usernameError').addClass('hidden');
            }
        });

        $('#createStaffForm').on('submit', function(e) {
            e.preventDefault();

            let isValid = true;
            $('#userAlert').addClass('hidden');
            $('#fullNameError, #usernameError, #phoneError, #passwordError').addClass('hidden');

            const fullName = $('#fullNameInput').val().trim();
            const rawUsername = $('#usernameInput').val();
            const phone = $('#phoneInput').val().trim().replace(/[\s-]+/g, '');
            const email = $('#emailInput').val().trim();
            const roleId = parseInt($('#roleIdSelect').val(), 10);
            const password = $('#passwordInput').val();

            if (!fullName) {
                $('#fullNameError').removeClass('hidden');
                isValid = false;
            }
            if (!rawUsername || !rawUsername.trim()) {
                $('#usernameError').text('Username is required.').removeClass('hidden');
                isValid = false;
            } else if (/\s/.test(rawUsername)) {
                $('#usernameError').text('Username cannot contain spaces.').removeClass('hidden');
                isValid = false;
            }
            const username = rawUsername.trim().replace(/\s+/g, '');
            if (!phone || phone.length < 9) {
                $('#phoneError').removeClass('hidden');
                isValid = false;
            }
            if (!password || password.length < 3) {
                $('#passwordError').removeClass('hidden');
                isValid = false;
            }

            if (!isValid) return;

            const $btn = $('#btnSubmitStaff');
            $btn.prop('disabled', true).html(`
                <svg class="animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                </svg>
                <span>Saving...</span>
            `);

            $.ajax({
                type: 'POST',
                url: '/User/Save',
                contentType: 'application/json',
                data: JSON.stringify({
                    FullName: fullName,
                    Username: username,
                    Phone: phone,
                    Email: email,
                    RoleId: roleId,
                    Password: password
                }),
                success: function(res) {
                    if (res.isSuccess) {
                        window.location.href = '/User';
                    } else {
                        $('#userAlertText').text(res.message || "Failed to create staff account.");
                        $('#userAlert').removeClass('hidden');
                        $btn.prop('disabled', false).html(`
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                            <span>Save Staff Account</span>
                        `);
                    }
                },
                error: function(xhr) {
                    const msg = (xhr.responseJSON && xhr.responseJSON.message) || "An error occurred while creating staff account.";
                    $('#userAlertText').text(msg);
                    $('#userAlert').removeClass('hidden');
                    $btn.prop('disabled', false).html(`
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                        <span>Save Staff Account</span>
                    `);
                }
            });
        });
    });
</script>
}
