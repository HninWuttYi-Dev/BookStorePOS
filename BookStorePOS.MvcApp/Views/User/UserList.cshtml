@model UserListResponseModel
@{
    ViewData["Title"] = "Staff & Cashiers";
    var users = ViewData["Users"] as List<UserModel> ?? new List<UserModel>();
    var roles = ViewData["Roles"] as List<RoleModel> ?? new List<RoleModel>();
    int currentPage = ViewData["CurrentPage"] != null ? Convert.ToInt32(ViewData["CurrentPage"]) : 1;
    int totalPages = ViewData["TotalPages"] != null ? Convert.ToInt32(ViewData["TotalPages"]) : 1;
    int totalCount = ViewData["TotalCount"] != null ? Convert.ToInt32(ViewData["TotalCount"]) : users.Count;
    int pageSize = ViewData["PageSize"] != null ? Convert.ToInt32(ViewData["PageSize"]) : 10;
    
    bool hasMessage = TempData["Message"] != null;
    bool isSuccess = TempData["isSuccess"] != null ? Convert.ToBoolean(TempData["isSuccess"]) : false;
    string message = TempData["Message"]?.ToString() ?? string.Empty;

    int count = (currentPage - 1) * pageSize;
    string searchFilter = ViewData["SearchFilter"]?.ToString() ?? string.Empty;
    int? selectedRoleId = ViewData["SelectedRoleId"] as int?;
}

<!-- Page Header -->
<div class="mb-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
        <h1 class="text-3xl font-bold text-slate-900 tracking-tight flex items-center gap-3">
            <svg class="w-8 h-8 text-teal-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
            Staff & Cashier Management
        </h1>
        <p class="text-slate-500 mt-1.5 text-sm font-medium">
            Manage cashier logins, assign store roles, and set staff access passwords.
        </p>
    </div>
    <a href="/User/Create" id="btnNewStaff" class="px-5 py-2.5 bg-teal-600 text-white font-semibold rounded-xl hover:bg-teal-700 transition-colors shadow-sm flex items-center gap-2 text-sm shrink-0 group">
        <svg class="w-5 h-5 transition-transform duration-200 group-hover:scale-110" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <line x1="19" y1="8" x2="19" y2="14"/>
            <line x1="22" y1="11" x2="16" y2="11"/>
        </svg>
        <span>Add New Staff</span>
    </a>
</div>

<!-- Toast Alert -->
@if (hasMessage)
{
    <div id="toastMessage" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 px-6 py-3 rounded-full shadow-lg flex items-center gap-3 transition-opacity duration-300 @(isSuccess ? "bg-emerald-600 text-white" : "bg-red-600 text-white")">
        @if (isSuccess)
        {
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
        }
        else
        {
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        }
        <span class="font-medium text-sm">@message</span>
        <button onclick="document.getElementById('toastMessage').remove()" class="ml-2 hover:opacity-75 focus:outline-none">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
    </div>
}

<!-- Search & Role Filter Form -->
<form method="get" action="/User" class="mb-6 w-full flex flex-col md:flex-row items-end gap-4 bg-white p-5 rounded-2xl border border-slate-100 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)]">
    <div class="flex flex-col flex-1 w-full">
        <label for="searchInput" class="text-xs font-semibold text-slate-500 mb-1.5 ml-1">Search Staff</label>
        <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </div>
            <input type="text" id="searchInput" name="Search" value="@searchFilter" placeholder="Search by name, username, or phone number" class="pl-10 px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all w-full" />
        </div>
    </div>
    
    <div class="flex flex-col w-full md:w-56">
        <label for="roleFilter" class="text-xs font-semibold text-slate-500 mb-1.5 ml-1">Filter by Role</label>
        <select id="roleFilter" name="RoleId" class="px-4 py-2.5 border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all w-full bg-white">
            <option value="">All Staff Roles</option>
            @foreach (var r in roles)
            {
                <option value="@r.RoleId" selected="@(selectedRoleId == r.RoleId ? "selected" : null)">@r.RoleName</option>
            }
        </select>
    </div>

    <div class="flex gap-2 w-full md:w-auto mt-4 md:mt-0">
        <button type="submit" class="px-6 py-2.5 bg-teal-600 text-white rounded-xl text-sm font-semibold hover:bg-teal-700 transition-colors shadow-2xs">
            Search
        </button>
        <a href="/User" class="px-5 py-2.5 bg-slate-100 text-slate-700 rounded-xl text-sm font-semibold hover:bg-slate-200 transition-colors text-center">
            Clear
        </a>
    </div>
</form>

<!-- Staff Table Card -->
<div class="bg-white rounded-2xl shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)] border border-slate-100 overflow-hidden flex flex-col">
    <div class="overflow-x-auto p-2">
        <table class="w-full text-left text-sm">
            <thead class="text-slate-500 bg-slate-50/70 rounded-xl">
                <tr>
                    <th class="px-4 py-3.5 font-semibold w-14 text-left rounded-l-xl">No.</th>
                    <th class="px-4 py-3.5 font-semibold text-left">Staff Member</th>
                    <th class="px-4 py-3.5 font-semibold text-left w-44">Assigned Role</th>
                    <th class="px-4 py-3.5 font-semibold text-left w-40">Contact Phone</th>
                    <th class="px-4 py-3.5 font-semibold text-left">Email</th>
                    <th class="px-4 py-3.5 font-semibold text-left w-36">Account Status</th>
                    <th class="px-4 py-3.5 font-semibold w-24 text-left rounded-r-xl">Actions</th>
                </tr>
            </thead>
            <tbody class="text-slate-700 divide-y divide-slate-100">
                @if (users == null || users.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="px-4 py-12 text-center text-slate-500 font-medium">
                            <div class="flex flex-col items-center justify-center gap-3">
                                <div class="w-12 h-12 rounded-2xl bg-slate-100 flex items-center justify-center text-slate-400">
                                    <svg class="w-6 h-6 animate-pulse" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                                        <circle cx="9" cy="7" r="4"/>
                                        <line x1="17" y1="8" x2="23" y2="14"/>
                                        <line x1="23" y1="8" x2="17" y2="14"/>
                                    </svg>
                                </div>
                                <span>No staff accounts found matching your criteria.</span>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var u in users)
                    {
                        var isSystemAdmin = u.Username.Equals("admin", StringComparison.OrdinalIgnoreCase);
                        var roleName = string.IsNullOrWhiteSpace(u.RoleName) ? "Staff" : u.RoleName;

                        <tr class="hover:bg-slate-50/80 transition-colors group">
                            <!-- Index -->
                            <td class="px-4 py-3.5 font-medium text-slate-400 text-left rounded-l-xl">
                                @(++count)
                            </td>

                            <!-- Staff Member Info -->
                            <td class="px-4 py-3.5 text-left">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 font-bold text-xs transition-all duration-300 group-hover:scale-105 @(isSystemAdmin ? "bg-amber-50 text-amber-700 border border-amber-200" : "bg-teal-50 text-teal-700 border border-teal-200")">
                                        @u.FullName.Substring(0, Math.Min(2, u.FullName.Length)).ToUpper()
                                    </div>
                                    <div>
                                        <div class="font-bold text-slate-900 text-sm">@u.FullName</div>
                                        <div class="text-xs text-slate-400 flex items-center gap-1 font-mono">
                                            <span>&#64;</span>@u.Username
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <!-- Role Badge -->
                            <td class="px-4 py-3.5 text-left">
                                @if (isSystemAdmin)
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-800 border border-amber-200">
                                        <svg class="w-3.5 h-3.5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                            <path d="m9 12 2 2 4-4"/>
                                        </svg>
                                        Administrator
                                    </span>
                                }
                                else if (roleName.Equals("Cashier", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
                                        <svg class="w-3.5 h-3.5 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>
                                        </svg>
                                        @roleName
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-teal-50 text-teal-800 border border-teal-200">
                                        <svg class="w-3.5 h-3.5 text-teal-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
                                        </svg>
                                        @roleName
                                    </span>
                                }
                            </td>

                            <!-- Phone -->
                            <td class="px-4 py-3.5 text-left text-slate-600 font-medium text-xs font-mono">
                                @u.Phone
                            </td>

                            <!-- Email -->
                            <td class="px-4 py-3.5 text-left text-slate-500 text-xs">
                                @(string.IsNullOrWhiteSpace(u.Email) ? "-" : u.Email)
                            </td>

                            <!-- Status -->
                            <td class="px-4 py-3.5 text-left">
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                    Active
                                </span>
                            </td>

                            <!-- Actions -->
                            <td class="px-4 py-3.5 text-left rounded-r-xl">
                                <div class="flex items-center gap-2">
                                    <a href="/User/Edit/@u.UserId" class="p-2 text-slate-500 hover:text-teal-600 border border-slate-200 rounded-lg hover:border-teal-200 hover:bg-teal-50 transition-all hover:scale-105" title="Edit Staff & Reset Password">
                                        <svg class="w-4 h-4 transition-transform duration-200 hover:rotate-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                                            <path d="m15 5 4 4"/>
                                        </svg>
                                    </a>

                                    @if (isSystemAdmin)
                                    {
                                        <button type="button" disabled class="p-2 text-slate-300 border border-slate-100 rounded-lg cursor-not-allowed" title="System Administrator cannot be deleted">
                                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                                                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                            </svg>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" data-id="@u.UserId" data-name="@u.FullName" class="btnDeleteStaff p-2 text-slate-500 hover:text-red-600 border border-slate-200 rounded-lg hover:border-red-200 hover:bg-red-50 transition-all hover:scale-105" title="Delete Staff Account">
                                            <svg class="w-4 h-4 transition-transform duration-200 hover:rotate-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M3 6h18"/>
                                                <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                                                <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                                                <line x1="10" y1="11" x2="10" y2="17"/>
                                                <line x1="14" y1="11" x2="14" y2="17"/>
                                            </svg>
                                        </button>
                                    }
                                </div>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Footer -->
    @if (totalPages > 1)
    {
        <div class="px-6 py-4 bg-slate-50/50 border-t border-slate-100 flex items-center justify-between">
            <span class="text-xs text-slate-500">
                Page <span class="font-semibold text-slate-800">@currentPage</span> of <span class="font-semibold text-slate-800">@totalPages</span>
                (Total @totalCount staff)
            </span>
            <div class="flex items-center gap-2">
                @if (currentPage > 1)
                {
                    <a href="/User?Page=@(currentPage - 1)&Limit=@pageSize&Search=@searchFilter&RoleId=@selectedRoleId" class="px-3 py-1.5 rounded-lg border border-slate-200 text-xs font-semibold text-slate-600 hover:bg-white transition-colors">
                        Previous
                    </a>
                }
                @if (currentPage < totalPages)
                {
                    <a href="/User?Page=@(currentPage + 1)&Limit=@pageSize&Search=@searchFilter&RoleId=@selectedRoleId" class="px-3 py-1.5 rounded-lg border border-slate-200 text-xs font-semibold text-slate-600 hover:bg-white transition-colors">
                        Next
                    </a>
                }
            </div>
        </div>
    }
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-sm w-full p-6 text-center shadow-2xl border border-slate-100">
        <div class="w-12 h-12 rounded-2xl bg-red-50 text-red-600 flex items-center justify-center mx-auto mb-4 border border-red-100">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
            </svg>
        </div>
        <h3 class="text-lg font-bold text-slate-900 mb-1">Delete Staff Account</h3>
        <p class="text-xs text-slate-500 mb-6">
            Are you sure you want to delete <strong id="deleteStaffName" class="text-slate-800"></strong>? This staff member will no longer be able to log in to the POS system.
        </p>
        <div class="flex gap-3">
            <button type="button" id="btnCancelDelete" class="flex-1 px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold rounded-xl text-xs transition-colors">
                Cancel
            </button>
            <button type="button" id="btnConfirmDelete" class="flex-1 px-4 py-2.5 bg-red-600 hover:bg-red-700 text-white font-semibold rounded-xl text-xs transition-colors shadow-2xs">
                Delete Staff
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function() {
        let staffToDeleteId = null;

        $('.btnDeleteStaff').on('click', function() {
            staffToDeleteId = $(this).data('id');
            const staffName = $(this).data('name');
            $('#deleteStaffName').text(staffName);
            $('#deleteModal').removeClass('hidden');
        });

        $('#btnCancelDelete').on('click', function() {
            $('#deleteModal').addClass('hidden');
            staffToDeleteId = null;
        });

        $('#btnConfirmDelete').on('click', function() {
            if (!staffToDeleteId) return;

            const $btn = $(this);
            $btn.prop('disabled', true).text('Deleting...');

            $.ajax({
                type: 'POST',
                url: '/User/Delete/' + staffToDeleteId,
                success: function(res) {
                    window.location.reload();
                },
                error: function() {
                    alert('Failed to delete staff member.');
                    $btn.prop('disabled', false).text('Delete Staff');
                    $('#deleteModal').addClass('hidden');
                }
            });
        });
    });
</script>
}
